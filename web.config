<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- stdoutLogEnabled is false by default for production; toggle to true when debugging startup failures -->
      <aspNetCore processPath="dotnet" arguments=".\BookMyFun.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <!-- Explicitly set ASPNETCORE_ENVIRONMENT to Production on MonsterASP / IIS -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <staticContent>
        <remove fileExtension=".webp" />
        <mimeMap fileExtension=".webp" mimeType="image/webp" />
        <remove fileExtension=".avif" />
        <mimeMap fileExtension=".avif" mimeType="image/avif" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
