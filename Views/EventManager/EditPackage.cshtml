@model BookMyFun.Models.ViewModels.EventPackageEditViewModel
@{
    ViewData["Title"] = "Edit Décor Package";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center gap-2 mb-3">
                <a asp-action="Packages" class="text-decoration-none small text-muted">
                    <i class="bi bi-arrow-left me-1"></i> Back to Packages
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 bg-card p-4">
                <div class="border-bottom pb-3 mb-4">
                    <h3 class="fw-bold mb-1"><i class="bi bi-pencil-square text-warning me-2"></i>Edit Décor Package</h3>
                    <p class="text-muted small mb-0">Modify package pricing, components, or cover imagery.</p>
                </div>

                <form asp-action="EditPackage" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PackageID" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Name" class="form-label fw-semibold small">Package Title *</label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Category" class="form-label fw-semibold small">Category *</label>
                            <select asp-for="Category" class="form-select">
                                <option value="Birthday">Birthday Party</option>
                                <option value="Anniversary">Anniversary</option>
                                <option value="Wedding">Wedding / Reception</option>
                                <option value="Corporate">Corporate / Offsite</option>
                                <option value="Custom">Custom Gathering</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="BasePrice" class="form-label fw-semibold small">Base Setup Price (₹) *</label>
                            <div class="input-group">
                                <span class="input-group-text">₹</span>
                                <input asp-for="BasePrice" class="form-control" type="number" step="100" min="500" required />
                            </div>
                            <span asp-validation-for="BasePrice" class="text-danger small"></span>
                        </div>

                        <!-- Cover Imagery: Direct File Upload or External URL -->
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Package Cover Imagery *</label>
                            <div class="card border rounded-3 p-3 bg-light shadow-sm">
                                <div class="row g-3">
                                    <div class="col-md-6 border-end-md">
                                        <label asp-for="ImageFile" class="form-label fw-semibold small text-heading">
                                            <i class="bi bi-cloud-arrow-up-fill text-warning me-1"></i> Upload Replacement Image File
                                        </label>
                                        <input asp-for="ImageFile" type="file" class="form-control" accept="image/jpeg,image/png,image/webp,image/avif" id="coverImageInput" onchange="previewPackageFile(this)" />
                                        <span class="text-muted small d-block mt-1" style="font-size: 0.75rem;">
                                            JPEG, PNG, WebP or AVIF (auto-optimized &amp; compressed)
                                        </span>
                                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="MediaUrl" class="form-label fw-semibold small text-heading">
                                            <i class="bi bi-link-45deg text-primary me-1"></i> Or External Image / CDN URL
                                        </label>
                                        <input asp-for="MediaUrl" class="form-control" id="coverUrlInput" placeholder="https://images.unsplash.com/..." oninput="previewPackageUrl(this.value)" />
                                        <span class="text-muted small d-block mt-1" style="font-size: 0.75rem;">
                                            Direct hosted image link (Cloudinary, Unsplash, Imgur)
                                        </span>
                                        <span asp-validation-for="MediaUrl" class="text-danger small"></span>
                                    </div>
                                    <!-- Image Preview Thumbnail -->
                                    <div class="col-12 @(string.IsNullOrEmpty(Model.MediaUrl) ? "d-none" : "")" id="packagePreviewContainer">
                                        <div class="d-flex align-items-center gap-3 p-2 bg-white rounded-3 border">
                                            <img id="packagePreviewImg" src="@(Model.MediaUrl ?? "")" alt="Cover Preview" class="rounded-2 shadow-sm border" style="width: 100px; height: 60px; object-fit: cover;" />
                                            <div>
                                                <div class="fw-semibold small text-success"><i class="bi bi-check-circle-fill me-1"></i>Current / Staged Cover Image</div>
                                                <div class="text-muted small" style="font-size: 0.78rem;" id="packagePreviewCaption">@(string.IsNullOrEmpty(Model.MediaUrl) ? "Image ready for portfolio showcase." : "Currently published showcase image.")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-semibold small">Detailed Package Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="col-12">
                            <label asp-for="IncludedItems" class="form-label fw-semibold small">Included Setup Items (Comma-separated)</label>
                            <input asp-for="IncludedItems" class="form-control" />
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" />
                                <label class="form-check-label fw-semibold small" for="isActiveSwitch">
                                    Package is active for guest booking
                                </label>
                            </div>
                        </div>

                        <div class="col-12 pt-3 border-top d-flex justify-content-end gap-2">
                            <a asp-action="Packages" class="btn btn-light px-4">Cancel</a>
                            <button type="submit" class="btn btn-warning fw-bold px-4">Save Changes</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewPackageFile(input) {
            const container = document.getElementById('packagePreviewContainer');
            const img = document.getElementById('packagePreviewImg');
            const caption = document.getElementById('packagePreviewCaption');
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    img.src = e.target.result;
                    caption.textContent = `Direct upload: ${input.files[0].name} (${(input.files[0].size / 1024).toFixed(1)} KB)`;
                    container.classList.remove('d-none');
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewPackageUrl(url) {
            const container = document.getElementById('packagePreviewContainer');
            const img = document.getElementById('packagePreviewImg');
            const caption = document.getElementById('packagePreviewCaption');
            const fileInput = document.getElementById('coverImageInput');
            if (!fileInput.files || fileInput.files.length === 0) {
                if (url && url.trim().length > 10) {
                    img.src = url.trim();
                    caption.textContent = 'External media URL preview';
                    container.classList.remove('d-none');
                } else if (!img.getAttribute('src')) {
                    container.classList.add('d-none');
                }
            }
        }
    </script>
}
