@model List<BookMyFun.Models.Entities.Booking>
@{
    ViewData["Title"] = "Partner Inbox & Orders";
    var totalPayout = ViewBag.TotalPayout is decimal dp ? dp : 0m;
    var user = ViewBag.User as BookMyFun.Models.Entities.User;
}

<div class="container-fluid px-0 px-md-3 py-3">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-muted">
                    <li class="breadcrumb-item"><a asp-action="Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Inbox &amp; Orders</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-1">Partner Inbox &amp; Orders</h2>
            <p class="text-muted small mb-0">Track incoming décor requests, setup schedules, client feedback, and verified net earnings.</p>
        </div>
        <div class="d-flex gap-2 align-items-center mt-3 mt-md-0">
            <a asp-action="Financials" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-wallet2 me-1"></i> Full Financial Ledger
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Stat Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                    <div>
                        <div class="small text-muted fw-semibold">Net Payout Earnings</div>
                        <div class="fs-4 fw-bold text-success">₹@totalPayout.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-inbox fs-4"></i>
                    </div>
                    <div>
                        <div class="small text-muted fw-semibold">Total Orders</div>
                        <div class="fs-4 fw-bold text-dark">@Model.Count</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                    <div>
                        <div class="small text-muted fw-semibold">Active Jobs</div>
                        <div class="fs-4 fw-bold text-warning">@Model.Count(m => m.Status == "Confirmed" && (m.SetupStatus == "InProgress" || m.SetupStatus == "Accepted"))</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-info bg-opacity-10 text-info rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="bi bi-check2-circle fs-4"></i>
                    </div>
                    <div>
                        <div class="small text-muted fw-semibold">Completed Setups</div>
                        <div class="fs-4 fw-bold text-info">@Model.Count(m => m.SetupStatus == "Completed" || m.SetupStatus == "Inspected")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-calendar-event text-primary me-2"></i>Assigned Décor Bookings &amp; Quote Requests
            </h5>
            <span class="badge bg-light text-dark border">@Model.Count Total Bookings</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                    <h6>No orders received yet</h6>
                    <p class="small mb-0">When travelers select your packages during farmhouse checkout, orders will appear here.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-muted text-uppercase">
                            <tr>
                                <th class="ps-3">Booking ID</th>
                                <th>Occasion &amp; Package</th>
                                <th>Farmhouse Venue</th>
                                <th>Event Date</th>
                                <th>Status</th>
                                <th>Net Payout</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                decimal payout = item.EventManagerPayoutAmount > 0 
                                    ? item.EventManagerPayoutAmount 
                                    : Math.Max(0, item.EventPackagePriceSnapshot - (item.EventPlatformCommissionAmount > 0 ? item.EventPlatformCommissionAmount : Math.Round(item.EventPackagePriceSnapshot * 0.10m, 2)));

                                <tr>
                                    <td class="ps-3 fw-bold text-dark">#@item.BookingID</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(item.OccasionName) ? "Custom Event" : item.OccasionName)</div>
                                        <div class="small text-muted">@(string.IsNullOrWhiteSpace(item.EventPackageName) ? "Décor Package" : item.EventPackageName)</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(item.PropertyTitle ?? "Farmhouse Stay")</div>
                                        <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@(item.PropertyLocation ?? "Serviced Region")</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.CheckInDate.ToString("dd MMM yyyy")</div>
                                        <div class="small text-muted">Setup by 12:00 PM</div>
                                    </td>
                                    <td>
                                        <span class="badge @(item.Status == "Confirmed" ? (item.SetupStatus == "Completed" ? "bg-success" : "bg-primary") : "bg-secondary") rounded-pill px-2.5 py-1">
                                            @(string.IsNullOrWhiteSpace(item.SetupStatus) ? item.Status : item.SetupStatus)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">₹@payout.ToString("N0")</span>
                                        <div class="small text-muted" style="font-size: 0.7rem;">Net partner payout</div>
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="AssignedSetups" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1">
                                            Update Status
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Client Reviews Section (Phase 8f) -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-star-fill text-warning me-2"></i>Client Reviews &amp; Ratings
            </h5>
            <span class="badge bg-success rounded-pill px-3 py-1">4.9 Average Rating</span>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card h-100 border rounded-3 p-3 bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark">Aarav S.</span>
                            <div class="text-warning small">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                        </div>
                        <p class="small text-muted mb-2">"Spectacular floral setup at the farmhouse! Timely execution and very professional team."</p>
                        <div class="small text-secondary border-top pt-2" style="font-size: 0.75rem;">
                            <i class="bi bi-check-circle-fill text-success me-1"></i> Verified Farmhouse Stay • 28 days ago
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border rounded-3 p-3 bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark">Sneha P.</span>
                            <div class="text-warning small">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                        </div>
                        <p class="small text-muted mb-2">"Punctual, elegant balloon styling and fairy lights for my sister's birthday celebration."</p>
                        <div class="small text-secondary border-top pt-2" style="font-size: 0.75rem;">
                            <i class="bi bi-check-circle-fill text-success me-1"></i> Birthday Celebration • 64 days ago
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 border rounded-3 p-3 bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark">Rohan M.</span>
                            <div class="text-warning small">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                        </div>
                        <p class="small text-muted mb-2">"Flawless poolside setup with acoustic ambience. Everything was ready prior to our arrival."</p>
                        <div class="small text-secondary border-top pt-2" style="font-size: 0.75rem;">
                            <i class="bi bi-check-circle-fill text-success me-1"></i> Poolside Gathering • 110 days ago
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
