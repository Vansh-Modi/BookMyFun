@model List<BookMyFun.Models.Entities.Booking>
@{
    ViewData["Title"] = "Event Manager & Décor Studio";
    var packages = ViewBag.Packages as List<BookMyFun.Models.Entities.EventPackage> ?? new();
}

<div class="container py-4">
    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-bold">
                    <i class="bi bi-palette2 me-1"></i> 5th Dashboard: Event Decorator
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small">
                    <i class="bi bi-check-circle-fill me-1"></i> Active Crew
                </span>
            </div>
            <h2 class="fw-bold mb-0">Event Décor & Staging Studio</h2>
            <p class="text-muted small mb-0">Manage themed event packages, oversee farm setups, and submit on-ground photographic evidence.</p>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <a asp-action="CreatePackage" class="btn btn-warning fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Create Décor Package
            </a>
            <a asp-action="AssignedSetups" class="btn btn-outline-primary fw-semibold">
                <i class="bi bi-list-task me-1"></i> View All Setups
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-bold text-uppercase">Assigned Setups</span>
                    <div class="p-2 bg-primary-subtle rounded-3 text-primary">
                        <i class="bi bi-calendar-check fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-0">@ViewBag.TotalAssigned</h3>
                <span class="text-muted small">Total farm events assigned</span>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-bold text-uppercase">Pending Setup</span>
                    <div class="p-2 bg-warning-subtle rounded-3 text-warning">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-0 text-warning">@ViewBag.PendingJobs</h3>
                <span class="text-muted small">Awaiting crew dispatch</span>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-bold text-uppercase">In Progress</span>
                    <div class="p-2 bg-info-subtle rounded-3 text-info">
                        <i class="bi bi-tools fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-0 text-info">@ViewBag.InProgressJobs</h3>
                <span class="text-muted small">Active on-ground decorating</span>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-secondary small fw-bold text-uppercase">Completed / Inspected</span>
                    <div class="p-2 bg-success-subtle rounded-3 text-success">
                        <i class="bi bi-check-all fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-0 text-success">@ViewBag.CompletedJobs</h3>
                <span class="text-muted small">Proof submitted & verified</span>
            </div>
        </div>
    </div>

    <!-- Active Décor Packages Showcase -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-card">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center pt-3 px-4">
            <div>
                <h5 class="fw-bold mb-0"><i class="bi bi-boxes text-warning me-2"></i>Active Décor & Staging Packages</h5>
                <span class="text-muted small">Themed offerings available for guest booking selection</span>
            </div>
            <a asp-action="Packages" class="btn btn-sm btn-outline-secondary">Manage All (@ViewBag.ActivePackagesCount)</a>
        </div>
        <div class="card-body px-4 pb-4">
            <div class="row g-3">
                @foreach (var pkg in packages.Take(4))
                {
                    <div class="col-md-6 col-xl-3">
                        <div class="card h-100 border rounded-3 overflow-hidden shadow-sm">
                            <div style="height: 140px; background-size: cover; background-position: center; background-image: url('@(string.IsNullOrEmpty(pkg.MediaUrl) ? "https://images.unsplash.com/photo-1519741497674-611481863552" : pkg.MediaUrl)');">
                                <span class="badge bg-dark bg-opacity-75 text-white m-2">@pkg.Category</span>
                            </div>
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <h6 class="fw-bold mb-1 text-truncate" title="@pkg.Name">@pkg.Name</h6>
                                    <p class="text-muted small mb-2 line-clamp-2" style="font-size: 0.8rem;">@pkg.Description</p>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                    <span class="fw-bold text-warning">₹@pkg.BasePrice.ToString("N0")</span>
                                    <a asp-action="EditPackage" asp-route-id="@pkg.PackageID" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.75rem;">Edit</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Assigned Setups Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-card">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center pt-3 px-4">
            <div>
                <h5 class="fw-bold mb-0"><i class="bi bi-calendar-event text-primary me-2"></i>Upcoming Farm Setups</h5>
                <span class="text-muted small">Confirmed guest bookings requesting event decorations</span>
            </div>
            <a asp-action="AssignedSetups" class="btn btn-sm btn-outline-primary">View All Setups</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-4">Booking #</th>
                            <th>Farm Property</th>
                            <th>Client / Contact</th>
                            <th>Event Package</th>
                            <th>Event Date</th>
                            <th>Setup Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                    No assigned event setups found.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            var badgeClass = item.SetupStatus switch
                            {
                                "Completed" or "Inspected" => "bg-success text-white",
                                "InProgress" => "bg-info text-dark",
                                "Assigned" => "bg-primary text-white",
                                _ => "bg-warning text-dark"
                            };

                            <tr>
                                <td class="ps-4 fw-bold">#@item.BookingID</td>
                                <td>
                                    <div class="fw-semibold">@item.PropertyTitle</div>
                                    <span class="text-muted small">Check-in: @item.CheckInDate.ToString("dd MMM yyyy")</span>
                                </td>
                                <td>
                                    <div>@item.ClientName</div>
                                    <span class="text-muted small">@item.ClientPhone</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark border">
                                        @(string.IsNullOrEmpty(item.EventPackageName) ? "Custom Setup" : item.EventPackageName)
                                    </span>
                                </td>
                                <td class="fw-semibold text-primary">
                                    @(item.EventDate.HasValue ? item.EventDate.Value.ToString("dd MMM yyyy") : item.CheckInDate.ToString("dd MMM yyyy"))
                                </td>
                                <td>
                                    <span class="badge @badgeClass px-2 py-1 rounded-pill">
                                        @item.SetupStatus
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#updateStatusModal-@item.BookingID">
                                        <i class="bi bi-arrow-repeat me-1"></i> Update Status
                                    </button>
                                </td>
                            </tr>

                            <!-- Status & Proof Modal -->
                            <div class="modal fade" id="updateStatusModal-@item.BookingID" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content rounded-4 shadow border-0">
                                        <form asp-action="UpdateSetupStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="BookingID" value="@item.BookingID" />
                                            <div class="modal-header border-bottom">
                                                <h5 class="modal-title fw-bold">Update Setup Status: Booking #@item.BookingID</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold small">Current Farm</label>
                                                    <input type="text" class="form-control bg-light" value="@item.PropertyTitle" readonly />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold small">Setup Progress Status</label>
                                                    <select name="SetupStatus" class="form-select">
                                                        <option value="Assigned" selected="@(item.SetupStatus == "Assigned")">Assigned (Crew Notified)</option>
                                                        <option value="InProgress" selected="@(item.SetupStatus == "InProgress")">In Progress (Decorating)</option>
                                                        <option value="Completed" selected="@(item.SetupStatus == "Completed")">Completed (Setup Ready)</option>
                                                        <option value="Inspected" selected="@(item.SetupStatus == "Inspected")">Inspected (Host/Guest Approved)</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold small">Photo / Video Proof URLs</label>
                                                    <textarea name="SetupProofMediaUrls" class="form-control" rows="3" placeholder="Paste image links, Cloudinary/Drive URLs, or video walkthroughs...">@item.SetupProofMediaUrls</textarea>
                                                    <div class="form-text small">Enter external URLs or uploaded media links demonstrating completed décor.</div>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-top">
                                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-warning fw-bold px-4">Save & Submit Proof</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
