@model List<BookMyFun.Models.Entities.Booking>
@{
    ViewData["Title"] = "Assigned Event Setups";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-action="Dashboard" class="text-decoration-none small text-muted">
                    <i class="bi bi-arrow-left me-1"></i> Dashboard
                </a>
            </div>
            <h2 class="fw-bold mb-0">Assigned Farm Event Setups</h2>
            <p class="text-muted small mb-0">Track on-ground decoration progress, dispatch field crews, and submit photo/video completion proof.</p>
        </div>
        <a asp-action="Packages" class="btn btn-outline-secondary">
            <i class="bi bi-boxes me-1"></i> View Packages
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th class="ps-4">Farm Property</th>
                        <th>Client Details</th>
                        <th>Event Package</th>
                        <th>Event Date</th>
                        <th>Assigned Decorator</th>
                        <th>Status</th>
                        <th>Proof Submitted</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                                No event setup assignments found.
                            </td>
                        </tr>
                    }
                    @foreach (var b in Model)
                    {
                        var statusBadge = b.SetupStatus switch
                        {
                            "Completed" or "Inspected" => "bg-success text-white",
                            "InProgress" => "bg-info text-dark",
                            "Assigned" => "bg-primary text-white",
                            _ => "bg-warning text-dark"
                        };

                        <tr>
                            <td class="ps-4">
                                <div class="fw-semibold">@b.PropertyTitle</div>
                                <span class="text-muted small">Stay: @b.CheckInDate.ToString("dd MMM") - @b.CheckOutDate.ToString("dd MMM yyyy")</span>
                            </td>
                            <td>
                                <div>@b.ClientName</div>
                                <span class="text-muted small">@b.ClientPhone</span>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-dark border">
                                    @(string.IsNullOrEmpty(b.EventPackageName) ? "Custom Décor" : b.EventPackageName)
                                </span>
                                @if (b.EventPackagePriceSnapshot > 0)
                                {
                                    <div class="small text-muted">₹@b.EventPackagePriceSnapshot.ToString("N0")</div>
                                }
                            </td>
                            <td class="fw-bold text-primary">
                                @(b.EventDate.HasValue ? b.EventDate.Value.ToString("dd MMM yyyy") : b.CheckInDate.ToString("dd MMM yyyy"))
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(b.DecoratorName) ? "Unassigned" : b.DecoratorName)
                            </td>
                            <td>
                                <span class="badge @statusBadge px-2 py-1 rounded-pill">
                                    @b.SetupStatus
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(b.SetupProofMediaUrls))
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-camera-fill me-1"></i> Available
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">Pending</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-1">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#setupModal-@b.BookingID">
                                        <i class="bi bi-arrow-repeat me-1"></i> Update
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2" data-bs-toggle="modal" data-bs-target="#deleteAssignedEventModal-@b.BookingID" title="Delete Event Setup">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>

                        <!-- Modal for Setup Status & Proof Submission -->
                        <div class="modal fade" id="setupModal-@b.BookingID" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 shadow border-0">
                                    <form asp-action="UpdateSetupStatus" method="post" enctype="multipart/form-data">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="BookingID" value="@b.BookingID" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <div class="modal-header border-bottom">
                                            <h5 class="modal-title fw-bold">Update Setup: @b.PropertyTitle</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold small">Property & Location</label>
                                                <input type="text" class="form-control bg-light" value="@b.PropertyTitle" readonly />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold small">Guest Special Notes</label>
                                                <textarea class="form-control bg-light" rows="2" readonly>@(string.IsNullOrEmpty(b.CustomEventNotes) ? "None specified." : b.CustomEventNotes)</textarea>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold small">Setup Progress Status</label>
                                                <select name="SetupStatus" class="form-select">
                                                    <option value="Assigned" selected="@(b.SetupStatus == "Assigned")">Assigned (Crew Notified)</option>
                                                    <option value="InProgress" selected="@(b.SetupStatus == "InProgress")">In Progress (Decorating)</option>
                                                    <option value="Completed" selected="@(b.SetupStatus == "Completed")">Completed (Setup Ready)</option>
                                                    <option value="Inspected" selected="@(b.SetupStatus == "Inspected")">Inspected (Host/Guest Approved)</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold small text-heading">
                                                    <i class="bi bi-camera-fill text-warning me-1"></i> Direct Proof Photo Upload
                                                </label>
                                                <input type="file" name="ProofFiles" class="form-control" multiple accept="image/jpeg,image/png,image/webp,image/avif" />
                                                <div class="form-text small">Select photos of completed stage, flowers, or lighting from your device.</div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold small text-heading">
                                                    <i class="bi bi-link-45deg text-primary me-1"></i> Or External Photo / Video Proof URLs
                                                </label>
                                                <textarea name="SetupProofMediaUrls" class="form-control" rows="2" placeholder="Enter links to photos of the completed stage, floral canopy, or lighting...">@b.SetupProofMediaUrls</textarea>
                                                <div class="form-text small">Paste direct image/video links (comma or newline separated).</div>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-top">
                                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-warning fw-bold px-4">Save Progress</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Delete Event Setup Modal -->
                        <div class="modal fade" id="deleteAssignedEventModal-@b.BookingID" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 shadow border-0 bg-card">
                                    <form asp-action="DeleteEventOrder" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookingId" value="@b.BookingID" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <div class="modal-header border-bottom bg-danger-subtle text-danger">
                                            <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Event Setup</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body p-4">
                                            <p class="mb-2">Are you sure you want to remove the event décor setup for <strong>@b.PropertyTitle</strong>?</p>
                                            <div class="p-3 bg-light rounded-3 border small mb-3">
                                                <div><strong>Property:</strong> @b.PropertyTitle</div>
                                                <div><strong>Client:</strong> @b.ClientName (@b.ClientPhone)</div>
                                                <div><strong>Event Package:</strong> @(string.IsNullOrEmpty(b.EventPackageName) ? "Custom Décor" : b.EventPackageName)</div>
                                                <div><strong>Event Date:</strong> @(b.EventDate.HasValue ? b.EventDate.Value.ToString("dd MMM yyyy") : b.CheckInDate.ToString("dd MMM yyyy"))</div>
                                            </div>
                                            <p class="small text-muted mb-0">This will cancel and remove this event setup from the queue while keeping the guest's farm stay intact.</p>
                                        </div>
                                        <div class="modal-footer border-top">
                                            <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4">
                                                <i class="bi bi-trash-fill me-1"></i> Confirm Delete
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
