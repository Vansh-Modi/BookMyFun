@model BookMyFun.Models.ViewModels.OwnerDashboardViewModel
@{
    ViewData["Title"] = "Owner Partner Dashboard";
}

<!-- Page Header -->
<div class="dash-page-header">
    <div>
        <p class="dash-eyebrow">Partner Portal · Hosting Operations</p>
        <h1 class="dash-title">Owner Dashboard</h1>
        <p class="dash-subtitle">Welcome back, <strong>@Model.Owner.FullName</strong> · Track your property performance, subscription allowance, and net earnings.</p>
    </div>
    <div class="dash-actions">
        <a asp-action="CreateProperty" class="dash-btn dash-btn-primary">
            <i class="bi bi-plus-lg"></i> List New Property
        </a>
        <a asp-action="DamageClaims" class="dash-btn dash-btn-outline">
            <i class="bi bi-shield-shaded"></i> Damage Claims
        </a>
        <a asp-action="Subscriptions" class="dash-btn dash-btn-outline">
            <i class="bi bi-gem"></i> Subscription Plans
        </a>
    </div>
</div>

<!-- Stat Cards Grid -->
<div class="dash-stat-grid">
    <div class="dash-stat-card">
        <div class="dash-stat-top">
            <span class="dash-stat-label">Subscription Status</span>
            <span class="dash-stat-icon @(Model.ActiveSubscription != null ? "icon-emerald" : "icon-rose")">
                <i class="bi @(Model.ActiveSubscription != null ? "bi-patch-check-fill" : "bi-exclamation-triangle-fill")"></i>
            </span>
        </div>
        @if (Model.ActiveSubscription != null)
        {
            <div class="dash-stat-val text-success" style="font-size: 1.5rem;">@Model.ActiveSubscription.PlanName</div>
            <div class="dash-stat-sub"><i class="bi bi-calendar-check me-1"></i>Valid till @Model.ActiveSubscription.EndDate.ToString("MMM dd, yyyy")</div>
        }
        else
        {
            <div class="dash-stat-val text-danger" style="font-size: 1.4rem;">No Active Plan</div>
            <div class="dash-stat-sub"><a asp-action="Subscriptions" class="text-primary text-decoration-none fw-semibold">Choose a plan &rarr;</a></div>
        }
    </div>

    <div class="dash-stat-card">
        <div class="dash-stat-top">
            <span class="dash-stat-label">Listing Quota</span>
            <span class="dash-stat-icon icon-blue"><i class="bi bi-house-door-fill"></i></span>
        </div>
        <div class="dash-stat-val">@Model.ActiveListingsCount <span class="text-muted fs-5 fw-normal">/ @Model.MaxListingsAllowed</span></div>
        <div class="dash-stat-sub">Active Listings / Maximum Allowed</div>
    </div>

    <div class="dash-stat-card">
        <div class="dash-stat-top">
            <span class="dash-stat-label">Host Earnings</span>
            <span class="dash-stat-icon icon-amber"><i class="bi bi-wallet2"></i></span>
        </div>
        <div class="dash-stat-val text-success">₹@Model.TotalEarnings.ToString("N2")</div>
        <div class="dash-stat-sub">Total Payout for Completed Stays</div>
    </div>
</div>

<!-- Main Details Grid -->
<div class="row g-4">
    <!-- Property Listings -->
    <div class="col-lg-7">
        <div class="dash-card">
            <div class="dash-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 class="dash-card-title mb-0"><i class="bi bi-building me-2 text-primary"></i>My Property Listings</h3>
                <a asp-action="CreateProperty" class="dash-btn dash-btn-primary" style="padding: .35rem .85rem; font-size: .8rem;">
                    <i class="bi bi-plus-lg"></i> List New Farm
                </a>
            </div>

            <!-- Property Status Filter Pills -->
            <div class="p-3 border-bottom bg-light-subtle d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 filter-owner-prop-btn active" onclick="filterOwnerProps('all', this)">
                    All (@Model.Properties.Count)
                </button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 filter-owner-prop-btn text-success" onclick="filterOwnerProps('approved', this)">
                    <i class="bi bi-check-circle-fill me-1"></i> Live &amp; Active (@Model.Properties.Count(p => p.IsApproved))
                </button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 filter-owner-prop-btn text-warning" onclick="filterOwnerProps('waiting', this)">
                    <i class="bi bi-clock-fill me-1"></i> Waiting Review (@Model.Properties.Count(p => !p.IsApproved && p.ListingStatus != "Rejected"))
                </button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 filter-owner-prop-btn text-danger" onclick="filterOwnerProps('rejected', this)">
                    <i class="bi bi-x-circle-fill me-1"></i> Rejected (@Model.Properties.Count(p => p.ListingStatus == "Rejected"))
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Property</th>
                            <th>Rate</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Properties.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No properties listed yet. Add your first farmhouse or villa!</td>
                            </tr>
                        }
                        @foreach (var p in Model.Properties)
                        {
                            var propStatus = p.ListingStatus == "Rejected" ? "rejected" : (p.IsApproved ? "approved" : "waiting");
                            <tr class="owner-prop-row" data-status="@propStatus">
                                <td class="ps-3">
                                    <div class="fw-semibold text-dark">@p.Title</div>
                                    <small class="text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@p.Location</small>
                                </td>
                                <td><strong>₹@p.PricePerNight.ToString("N0")</strong> <small class="text-muted">/ night</small></td>
                                <td>
                                    @if (p.ListingStatus == "Rejected")
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-x-circle-fill me-1"></i>Rejected</span>
                                    }
                                    else if (p.IsApproved)
                                    {
                                        <span class="dash-badge dash-badge-success"><i class="bi bi-check-circle-fill"></i> Live &amp; Active</span>
                                    }
                                    else
                                    {
                                        <span class="dash-badge dash-badge-warning"><i class="bi bi-clock-fill"></i> Waiting Review</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="EditProperty" asp-route-id="@p.PropertyID" class="btn btn-sm btn-outline-primary rounded-pill py-1 px-3">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Guest Bookings & Requests with Financial Transparency -->
    <div class="col-lg-5">
        <div class="dash-card">
            <div class="dash-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 class="dash-card-title mb-0"><i class="bi bi-cash-stack me-2 text-success"></i>Bookings &amp; Earnings</h3>
                <span class="dash-badge dash-badge-neutral">@Model.Bookings.Count total</span>
            </div>

            <!-- Booking Filter Tabs -->
            <div class="p-2 border-bottom bg-light-subtle d-flex flex-wrap gap-1">
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-2 py-0 filter-booking-btn active" style="font-size: .75rem;" onclick="filterOwnerBookings('all', this)">All</button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-0 filter-booking-btn text-success" style="font-size: .75rem;" onclick="filterOwnerBookings('confirmed', this)">Confirmed</button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-0 filter-booking-btn text-danger" style="font-size: .75rem;" onclick="filterOwnerBookings('cancelled', this)">Cancelled</button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-0 filter-booking-btn text-warning" style="font-size: .75rem;" onclick="filterOwnerBookings('refunded', this)">Refunded</button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2 py-0 filter-booking-btn text-info" style="font-size: .75rem;" onclick="filterOwnerBookings('damage', this)">Damage Claimed</button>
            </div>

            <div class="list-group list-group-flush" id="ownerBookingsList">
                @if (!Model.Bookings.Any())
                {
                    <div class="p-4 text-center text-muted">No bookings received yet.</div>
                }
                @foreach (var b in Model.Bookings)
                {
                    var bookingStatusClass = b.Status.ToLowerInvariant();
                    var hasDamageClaim = b.SecurityDepositStatus.Contains("Claimed");
                    var category = hasDamageClaim ? "damage" : (b.Status == "Cancelled" ? "cancelled" : (b.Status == "Confirmed" ? "confirmed" : "other"));
                    var propertyStayGross = Math.Max(0, b.TotalAmount - b.EventPackagePriceSnapshot);
                    var commRate = b.CommissionRateSnapshot > 0 ? b.CommissionRateSnapshot : 10.0m;
                    var commission = (b.PlatformCommissionAmount > 0 && b.PlatformCommissionAmount <= propertyStayGross)
                        ? b.PlatformCommissionAmount 
                        : Math.Round(propertyStayGross * (commRate / 100m), 2);
                    var netPayout = (b.OwnerPayoutAmount > 0 && b.OwnerPayoutAmount <= propertyStayGross)
                        ? b.OwnerPayoutAmount 
                        : Math.Max(0, propertyStayGross - commission);

                    <div class="list-group-item p-3 owner-booking-card" data-category="@category">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div>
                                <strong class="text-heading text-dark">#@b.BookingID · @b.PropertyTitle</strong>
                                <div class="small text-muted"><i class="bi bi-calendar3 me-1"></i>@b.CheckInDate.ToString("MMM dd") - @b.CheckOutDate.ToString("MMM dd, yyyy")</div>
                            </div>
                            @if (b.Status == "Confirmed")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i>Confirmed</span>
                            }
                            else if (b.Status == "Cancelled")
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle-fill me-1"></i>Cancelled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@b.Status</span>
                            }
                        </div>

                        <div class="small text-muted mb-2">
                            <i class="bi bi-person me-1"></i>@b.ClientName · <i class="bi bi-telephone me-1"></i>@(b.ClientPhone ?? "N/A")
                        </div>

                        <!-- Itemized Financial Transparency Breakdown -->
                        <div class="bg-light p-3 rounded-3 mb-2 border">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Property Stay (Host Gross):</span>
                                <strong class="text-dark">₹@propertyStayGross.ToString("N2")</strong>
                            </div>
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Platform Commission (@commRate.ToString("0.#")%):</span>
                                <span class="text-danger">-₹@commission.ToString("N2")</span>
                            </div>
                            <div class="d-flex justify-content-between small fw-bold text-success border-top pt-2 mt-1">
                                <span>Your Net Host Payout:</span>
                                <span class="fs-6">₹@netPayout.ToString("N2")</span>
                            </div>

                            @if (b.IsEventBooking && b.EventPackagePriceSnapshot > 0)
                            {
                                <div class="border-top pt-2 mt-2 p-2 bg-white rounded border">
                                    <div class="d-flex justify-content-between small text-primary fw-semibold">
                                        <span><i class="bi bi-palette2 me-1"></i>Guest Décor Add-on:</span>
                                        <span>₹@b.EventPackagePriceSnapshot.ToString("N2")</span>
                                    </div>
                                    <div class="small text-muted mt-1" style="font-size: 0.76rem; line-height: 1.3;">
                                        <i class="bi bi-info-circle me-1 text-primary"></i>Package: <em>@(b.EventPackageName ?? "Event Staging")</em>. Paid 100% directly to Event Decorator Studio (not deducted from your host revenue).
                                    </div>
                                    <div class="d-flex justify-content-between small text-muted border-top pt-1 mt-1">
                                        <span>Guest Invoice Grand Total:</span>
                                        <span class="fw-bold text-dark">₹@b.TotalAmount.ToString("N2")</span>
                                    </div>
                                </div>
                            }

                            @if (b.SecurityDepositAmount > 0)
                            {
                                <div class="d-flex justify-content-between small text-muted pt-2 border-top mt-2">
                                    <span>Security Deposit:</span>
                                    <span>₹@b.SecurityDepositAmount.ToString("N0") <span class="badge bg-light text-dark border">@b.SecurityDepositStatus</span></span>
                                </div>
                            }
                        </div>

                        <!-- Action row -->
                        <div class="d-flex justify-content-between align-items-center pt-1">
                            <span class="badge bg-secondary-subtle text-dark border small">@b.BookingType (@(b.SlotType ?? "Standard"))</span>
                            <a asp-action="CreateClaim" asp-route-bookingId="@b.BookingID" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill" title="Report any property damages">
                                <i class="bi bi-shield-exclamation me-1"></i> Report Damage
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function filterOwnerProps(status, btn) {
        document.querySelectorAll('.filter-owner-prop-btn').forEach(b => {
            b.classList.remove('active', 'btn-primary');
            b.classList.add('btn-light', 'border');
        });
        btn.classList.add('active', 'btn-primary');
        btn.classList.remove('btn-light', 'border');

        document.querySelectorAll('.owner-prop-row').forEach(row => {
            if (status === 'all' || row.getAttribute('data-status') === status) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function filterOwnerBookings(cat, btn) {
        document.querySelectorAll('.filter-booking-btn').forEach(b => {
            b.classList.remove('active', 'btn-primary');
            b.classList.add('btn-light', 'border');
        });
        btn.classList.add('active', 'btn-primary');
        btn.classList.remove('btn-light', 'border');

        document.querySelectorAll('.owner-booking-card').forEach(card => {
            const c = card.getAttribute('data-category');
            if (cat === 'all' || c === cat) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>

