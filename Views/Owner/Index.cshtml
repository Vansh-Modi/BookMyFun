@model BookMyFun.Models.ViewModels.OwnerDashboardViewModel
@{
    ViewData["Title"] = "Owner Partner Dashboard";
}

<!-- Page Header -->
<div class="dash-page-header">
    <div>
        <p class="dash-eyebrow">Partner Portal · Hosting Operations</p>
        <h1 class="dash-title">Owner Dashboard</h1>
        <p class="dash-subtitle">Welcome back, <strong>@Model.Owner.FullName</strong> · Track your property performance, subscription allowance, and net earnings.</p>
    </div>
    <div class="dash-actions">
        <a asp-action="CreateProperty" class="dash-btn dash-btn-primary">
            <i class="bi bi-plus-lg"></i> List New Property
        </a>
        <a asp-action="DamageClaims" class="dash-btn dash-btn-outline">
            <i class="bi bi-shield-shaded"></i> Damage Claims
        </a>
        <a asp-action="Subscriptions" class="dash-btn dash-btn-outline">
            <i class="bi bi-gem"></i> Subscription Plans
        </a>
    </div>
</div>

<!-- Stat Cards Grid -->
<div class="dash-stat-grid">
    <a asp-action="Subscriptions" class="dash-stat-card text-decoration-none">
        <div class="dash-stat-top">
            <span class="dash-stat-label">Subscription Status</span>
            <span class="dash-stat-icon @(Model.ActiveSubscription != null ? "icon-emerald" : "icon-rose")">
                <i class="bi @(Model.ActiveSubscription != null ? "bi-patch-check-fill" : "bi-exclamation-triangle-fill")"></i>
            </span>
        </div>
        @if (Model.ActiveSubscription != null)
        {
            <div class="dash-stat-val text-success" style="font-size: 1.5rem;">@Model.ActiveSubscription.PlanName</div>
            <div class="dash-stat-sub"><i class="bi bi-calendar-check me-1"></i>Valid till @Model.ActiveSubscription.EndDate.ToString("MMM dd, yyyy")</div>
        }
        else
        {
            <div class="dash-stat-val text-danger" style="font-size: 1.4rem;">No Active Plan</div>
            <div class="dash-stat-sub"><span class="text-primary fw-semibold">Choose a plan &rarr;</span></div>
        }
    </a>

    <a asp-action="CreateProperty" class="dash-stat-card text-decoration-none">
        <div class="dash-stat-top">
            <span class="dash-stat-label">Listing Quota</span>
            <span class="dash-stat-icon icon-blue"><i class="bi bi-house-door-fill"></i></span>
        </div>
        <div class="dash-stat-val">@Model.ActiveListingsCount <span class="text-muted fs-5 fw-normal">/ @Model.MaxListingsAllowed</span></div>
        <div class="dash-stat-sub">Active Listings / Maximum Allowed</div>
    </a>

    <a asp-action="Subscriptions" class="dash-stat-card text-decoration-none">
        <div class="dash-stat-top">
            <span class="dash-stat-label">Host Earnings</span>
            <span class="dash-stat-icon icon-amber"><i class="bi bi-wallet2"></i></span>
        </div>
        <div class="dash-stat-val text-success">₹@Model.TotalEarnings.ToString("N2")</div>
        <div class="dash-stat-sub">Total Payout for Completed Stays</div>
    </a>
</div>

<!-- Main Details Grid -->
<div class="row g-4">
    <!-- Guest Bookings & Requests with Financial Transparency (Primary Section) -->
    <div class="col-lg-8">
        <div class="dash-card">
            <div class="dash-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h3 class="dash-card-title mb-0"><i class="bi bi-cash-stack me-2 text-success"></i>Bookings &amp; Earnings Overview</h3>
                    <small class="text-muted">Itemized stay revenue, platform commission deductions, and net host payouts</small>
                </div>
                <span class="dash-badge dash-badge-neutral">@Model.Bookings.Count total</span>
            </div>

            <!-- Booking Filter Tabs -->
            <div class="p-3 border-bottom bg-light-subtle d-flex flex-wrap gap-2 align-items-center">
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 filter-booking-btn active" onclick="filterOwnerBookings('all', this)">All (@Model.Bookings.Count)</button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 filter-booking-btn text-success" onclick="filterOwnerBookings('confirmed', this)">
                    <i class="bi bi-check-circle-fill me-1"></i> Confirmed (@Model.Bookings.Count(b => b.Status == "Confirmed"))
                </button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 filter-booking-btn text-danger" onclick="filterOwnerBookings('cancelled', this)">
                    <i class="bi bi-x-circle-fill me-1"></i> Cancelled (@Model.Bookings.Count(b => b.Status == "Cancelled"))
                </button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 filter-booking-btn text-warning" onclick="filterOwnerBookings('refunded', this)">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Refunded (@Model.Bookings.Count(b => b.Status == "Refunded"))
                </button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-3 filter-booking-btn text-info" onclick="filterOwnerBookings('damage', this)">
                    <i class="bi bi-shield-exclamation me-1"></i> Damage Claimed (@Model.Bookings.Count(b => b.SecurityDepositStatus.Contains("Claimed")))
                </button>
            </div>

            <div class="list-group list-group-flush" id="ownerBookingsList">
                @if (!Model.Bookings.Any())
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-calendar-x fs-1 d-block mb-3 text-muted opacity-50"></i>
                        <h5>No bookings received yet</h5>
                        <p class="small text-muted mb-0">Bookings placed by travelers for your farmhouses and villas will appear here in real time.</p>
                    </div>
                }
                @foreach (var b in Model.Bookings)
                {
                    var bookingStatusClass = b.Status.ToLowerInvariant();
                    var hasDamageClaim = b.SecurityDepositStatus.Contains("Claimed");
                    var category = hasDamageClaim ? "damage" : (b.Status == "Cancelled" ? "cancelled" : (b.Status == "Confirmed" ? "confirmed" : "other"));
                    var propertyStayGross = Math.Max(0, b.TotalAmount - b.EventPackagePriceSnapshot);
                    var commRate = b.CommissionRateSnapshot > 0 ? b.CommissionRateSnapshot : 10.0m;
                    var commission = (b.PlatformCommissionAmount > 0 && b.PlatformCommissionAmount <= propertyStayGross)
                        ? b.PlatformCommissionAmount 
                        : Math.Round(propertyStayGross * (commRate / 100m), 2);
                    var netPayout = (b.OwnerPayoutAmount > 0 && b.OwnerPayoutAmount <= propertyStayGross)
                        ? b.OwnerPayoutAmount 
                        : Math.Max(0, propertyStayGross - commission);

                    <div class="list-group-item p-4 owner-booking-card" data-category="@category">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <h5 class="fw-bold text-heading text-dark mb-1">
                                    <i class="bi bi-house-door text-primary me-1"></i>@b.PropertyTitle
                                </h5>
                                <div class="text-muted small">
                                    <i class="bi bi-calendar-event text-secondary me-1"></i>
                                    <strong>@b.CheckInDate.ToString("MMM dd") &ndash; @b.CheckOutDate.ToString("MMM dd, yyyy")</strong>
                                    <span class="mx-2">&bull;</span>
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-0.5 rounded-pill">@b.BookingType (@(b.SlotType ?? "Standard"))</span>
                                </div>
                            </div>
                            <div>
                                @if (b.Status == "Confirmed")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill"><i class="bi bi-check-circle-fill me-1"></i>Confirmed</span>
                                }
                                else if (b.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1.5 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-1.5 rounded-pill">@b.Status</span>
                                }
                            </div>
                        </div>

                        <div class="row g-3 align-items-center">
                            <!-- Left: Guest Details -->
                            <div class="col-md-5">
                                <div class="p-3 bg-light rounded-3 border h-100">
                                    <div class="text-uppercase small text-muted fw-bold mb-2" style="font-size: 0.72rem; letter-spacing: 0.05em;">Guest Information</div>
                                    <div class="fw-bold text-dark"><i class="bi bi-person-fill text-primary me-1"></i>@b.ClientName</div>
                                    <div class="small text-muted mt-1"><i class="bi bi-telephone me-1"></i>@(b.ClientPhone ?? "N/A")</div>
                                    @if (b.SecurityDepositAmount > 0)
                                    {
                                        <div class="mt-2 pt-2 border-top small text-muted">
                                            <span>Security Deposit:</span>
                                            <strong class="text-dark">₹@b.SecurityDepositAmount.ToString("N0")</strong>
                                            <span class="badge bg-light text-dark border ms-1">@b.SecurityDepositStatus</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Right: Financial Breakdown -->
                            <div class="col-md-7">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>Stay Subtotal (Host Gross):</span>
                                        <strong class="text-dark">₹@propertyStayGross.ToString("N2")</strong>
                                    </div>
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>Platform Commission (@commRate.ToString("0.#")%):</span>
                                        <span class="text-danger">-₹@commission.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between small fw-bold text-success border-top pt-2 mt-1">
                                        <span>Your Net Host Payout:</span>
                                        <span class="fs-5">₹@netPayout.ToString("N2")</span>
                                    </div>

                                    @if (b.IsEventBooking && b.EventPackagePriceSnapshot > 0)
                                    {
                                        <div class="border-top pt-2 mt-2 p-2 bg-white rounded border">
                                            <div class="d-flex justify-content-between small text-primary fw-semibold">
                                                <span><i class="bi bi-palette2 me-1"></i>Guest Décor Add-on:</span>
                                                <span>₹@b.EventPackagePriceSnapshot.ToString("N2")</span>
                                            </div>
                                            <div class="small text-muted mt-1" style="font-size: 0.75rem; line-height: 1.3;">
                                                Package: <em>@(b.EventPackageName ?? "Event Staging")</em> (paid directly to Décor Studio).
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (b.Status == "Confirmed")
                        {
                            <div class="d-flex justify-content-end gap-2 pt-2 mt-2 border-top">
                                <a asp-action="BookingReceipt" asp-route-id="@b.BookingID" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1" style="font-size: 0.78rem;" title="View Host Settlement Receipt">
                                    <i class="bi bi-receipt me-1"></i>Host Receipt
                                </a>
                                <a asp-action="DamageClaims" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" style="font-size: 0.78rem;">
                                    <i class="bi bi-shield-exclamation me-1"></i> File Damage Claim
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Property Listings (Secondary Section) -->
    <div class="col-lg-4">
        <div class="dash-card">
            <div class="dash-card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h3 class="dash-card-title mb-0"><i class="bi bi-building me-2 text-primary"></i>My Listings</h3>
                <a asp-action="CreateProperty" class="dash-btn dash-btn-primary" style="padding: .3rem .75rem; font-size: .8rem;">
                    <i class="bi bi-plus-lg"></i> Add
                </a>
            </div>

            <!-- Property Status Filter Pills -->
            <div class="p-2 border-bottom bg-light-subtle d-flex flex-wrap gap-1">
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-2.5 py-0 filter-owner-prop-btn active" style="font-size: .75rem;" onclick="filterOwnerProps('all', this)">
                    All (@Model.Properties.Count)
                </button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2.5 py-0 filter-owner-prop-btn text-success" style="font-size: .75rem;" onclick="filterOwnerProps('approved', this)">
                    Live (@Model.Properties.Count(p => p.IsApproved && p.ListingStatus == "Active"))
                </button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2.5 py-0 filter-owner-prop-btn text-secondary" style="font-size: .75rem;" onclick="filterOwnerProps('deactivated', this)">
                    Unpublished (@Model.Properties.Count(p => p.ListingStatus == "Deactivated"))
                </button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2.5 py-0 filter-owner-prop-btn text-warning" style="font-size: .75rem;" onclick="filterOwnerProps('waiting', this)">
                    Review (@Model.Properties.Count(p => !p.IsApproved && p.ListingStatus != "Rejected" && p.ListingStatus != "Deactivated"))
                </button>
                <button type="button" class="btn btn-sm btn-light border rounded-pill px-2.5 py-0 filter-owner-prop-btn text-danger" style="font-size: .75rem;" onclick="filterOwnerProps('rejected', this)">
                    Rejected (@Model.Properties.Count(p => p.ListingStatus == "Rejected"))
                </button>
            </div>

            <div class="list-group list-group-flush">
                @if (!Model.Properties.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-house-add fs-1 text-muted opacity-50 d-block mb-2"></i>
                        No properties listed yet.<br />
                        <a asp-action="CreateProperty" class="btn btn-sm btn-primary rounded-pill mt-2">List Your First Farm</a>
                    </div>
                }
                @foreach (var p in Model.Properties)
                {
                    var isDeactivated = p.ListingStatus == "Deactivated";
                    var propStatus = p.ListingStatus == "Rejected" ? "rejected" : (isDeactivated ? "deactivated" : (p.IsApproved && p.ListingStatus == "Active" ? "approved" : "waiting"));
                    <div class="list-group-item p-3 owner-prop-row" data-status="@propStatus">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h6 class="fw-bold mb-0 text-heading text-dark text-truncate" style="max-width: 170px;">@p.Title</h6>
                            <div class="d-flex align-items-center gap-1">
                                <a asp-action="EditProperty" asp-route-id="@p.PropertyID" class="btn btn-sm btn-outline-primary rounded-pill py-0.5 px-2" style="font-size: 0.75rem;">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                @if (p.ListingStatus == "Active")
                                {
                                    <form asp-action="DeactivateProperty" asp-route-id="@p.PropertyID" asp-route-deactivate="true" method="post" class="d-inline" onsubmit="return confirm('Unpublish @p.Title? It will be temporarily hidden from travelers and searches.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill py-0.5 px-2" style="font-size: 0.75rem;" title="Deactivate / Unpublish">
                                            <i class="bi bi-pause-circle me-1"></i>Unpublish
                                        </button>
                                    </form>
                                }
                                else if (p.ListingStatus == "Deactivated")
                                {
                                    <form asp-action="DeactivateProperty" asp-route-id="@p.PropertyID" asp-route-deactivate="false" method="post" class="d-inline" onsubmit="return confirm('Publish and reactivate @p.Title?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill py-0.5 px-2" style="font-size: 0.75rem;" title="Activate / Publish">
                                            <i class="bi bi-play-circle me-1"></i>Publish
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                        <div class="small text-muted mb-2 d-flex flex-wrap align-items-center gap-2">
                            <span><i class="bi bi-geo-alt-fill text-danger me-1"></i>@p.Location</span>
                            @if (!string.IsNullOrWhiteSpace(p.MapUrl))
                            {
                                <a href="@p.MapUrl" target="_blank" class="badge bg-success-subtle text-success border border-success-subtle text-decoration-none py-1 px-2" title="Open verified Google Maps location in new tab">
                                    <i class="bi bi-map-fill me-1"></i>Map Link
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border py-1 px-2">
                                    <i class="bi bi-geo me-1"></i>No Map URL
                                </span>
                            }
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2" style="font-size: 0.70rem;" data-bs-toggle="modal" data-bs-target="#modalUpdateMap_@p.PropertyID">
                                <i class="bi bi-pin-map me-1"></i>@(string.IsNullOrWhiteSpace(p.MapUrl) ? "Add Map Link" : "Update Map Link")
                            </button>
                        </div>
                        <div class="small text-muted mb-2 d-flex flex-wrap align-items-center gap-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle py-1 px-2" title="Property Category">
                                <i class="bi bi-tag-fill me-1"></i>@(string.IsNullOrWhiteSpace(p.PropertyTypeName) ? "Uncategorized" : p.PropertyTypeName)
                            </span>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2" style="font-size: 0.70rem;" data-bs-toggle="modal" data-bs-target="#modalAssignCategory_@p.PropertyID">
                                <i class="bi bi-tag me-1"></i>Assign Category
                            </button>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <strong class="text-success small">₹@p.PricePerNight.ToString("N0") <span class="text-muted fw-normal">/ night</span></strong>
                            <div>
                                @if (p.ListingStatus == "Rejected")
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle-fill me-1"></i>Rejected</span>
                                }
                                else if (p.ListingStatus == "Deactivated")
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-pause-circle-fill me-1"></i>Unpublished</span>
                                }
                                else if (p.IsApproved && p.ListingStatus == "Active")
                                {
                                    <span class="dash-badge dash-badge-success"><i class="bi bi-check-circle-fill"></i> Live</span>
                                }
                                else
                                {
                                    <span class="dash-badge dash-badge-warning"><i class="bi bi-clock-fill"></i> Review</span>
                                }
                            </div>
                        </div>

                        <!-- Modal: Update Map URL for @p.Title -->
                        <div class="modal fade" id="modalUpdateMap_@p.PropertyID" tabindex="-1" aria-labelledby="modalLabel_@p.PropertyID" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow-lg rounded-4">
                                    <div class="modal-header border-bottom py-3">
                                        <h6 class="modal-title fw-bold text-dark" id="modalLabel_@p.PropertyID">
                                            <i class="bi bi-pin-map-fill text-danger me-2"></i>Map Location Link — @p.Title
                                        </h6>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form asp-action="UpdateLocationUrl" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="propertyId" value="@p.PropertyID" />
                                        <input type="hidden" name="returnUrl" value="/Owner/Index" />
                                        <div class="modal-body p-4">
                                            <p class="text-muted small mb-3">
                                                Submit or update your listing's exact Google Maps location link (e.g. share pin, directions URL). Confirmed guests receive this direct navigation link.
                                            </p>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold small text-secondary">City / Region</label>
                                                <input type="text" class="form-control form-control-sm bg-light" value="@p.Location" readonly />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold small">Direct Google Maps / Location URL</label>
                                                <div class="input-group">
                                                    <span class="input-group-text bg-light"><i class="bi bi-link-45deg text-primary"></i></span>
                                                    <input type="url" name="mapUrl" class="form-control" placeholder="https://maps.app.goo.gl/... or https://goo.gl/maps/..." value="@p.MapUrl" />
                                                </div>
                                                <small class="form-text text-muted">Leave empty to remove the direct map link.</small>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(p.MapUrl))
                                            {
                                                <div class="alert alert-light border d-flex align-items-center justify-content-between p-2 mb-0">
                                                    <span class="small text-truncate" style="max-width: 280px;"><i class="bi bi-check-circle-fill text-success me-1"></i>Current: @p.MapUrl</span>
                                                    <a href="@p.MapUrl" target="_blank" class="btn btn-sm btn-outline-success py-0.5 px-2" style="font-size: 0.75rem;">
                                                        <i class="bi bi-box-arrow-up-right me-1"></i>Open
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                        <div class="modal-footer border-top py-2 px-4 d-flex justify-content-between">
                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">
                                                <i class="bi bi-save me-1"></i>Save Map Location Link
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <!-- Modal: Assign Category for @p.Title -->
                        <div class="modal fade" id="modalAssignCategory_@p.PropertyID" tabindex="-1" aria-labelledby="modalCatLabel_@p.PropertyID" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content border-0 shadow-lg rounded-4">
                                    <div class="modal-header border-bottom py-3">
                                        <h6 class="modal-title fw-bold text-dark" id="modalCatLabel_@p.PropertyID">
                                            <i class="bi bi-tag-fill text-primary me-2"></i>Assign Category — @p.Title
                                        </h6>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form asp-action="AssignCategory" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="propertyId" value="@p.PropertyID" />
                                        <input type="hidden" name="returnUrl" value="/Owner/Index" />
                                        <div class="modal-body p-4">
                                            <p class="text-muted small mb-3">
                                                Assign a standard category or create a custom category for your listing to increase discoverability on BookMyFun.
                                            </p>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold small text-secondary">Current Category</label>
                                                <input type="text" class="form-control form-control-sm bg-light" value="@(string.IsNullOrWhiteSpace(p.PropertyTypeName) ? "Uncategorized" : p.PropertyTypeName)" readonly />
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold small">Select Existing Category</label>
                                                <select name="propertyTypeId" class="form-select form-select-sm">
                                                    <option value="">-- Choose Category --</option>
                                                    @if (Model.AvailableCategories != null)
                                                    {
                                                        foreach (var cat in Model.AvailableCategories)
                                                        {
                                                            <option value="@cat.PropertyTypeID" selected="@(cat.PropertyTypeID == p.PropertyTypeID ? "selected" : null)">@cat.TypeName</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label fw-semibold small">Or Enter a Custom Category</label>
                                                <div class="input-group input-group-sm">
                                                    <span class="input-group-text bg-light"><i class="bi bi-plus-circle text-primary"></i></span>
                                                    <input type="text" name="customCategory" class="form-control" placeholder="e.g. Glamping, Treehouse, Eco-Stay, Beach House" maxlength="50" />
                                                </div>
                                                <small class="form-text text-muted">If specified, this new category will be created and assigned automatically.</small>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-top py-2 px-4 d-flex justify-content-between">
                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3">
                                                <i class="bi bi-check2-circle me-1"></i>Save Category
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function filterOwnerProps(status, btn) {
        document.querySelectorAll('.filter-owner-prop-btn').forEach(b => {
            b.classList.remove('active', 'btn-primary');
            b.classList.add('btn-light', 'border');
        });
        btn.classList.add('active', 'btn-primary');
        btn.classList.remove('btn-light', 'border');

        document.querySelectorAll('.owner-prop-row').forEach(row => {
            if (status === 'all' || row.getAttribute('data-status') === status) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    }

    function filterOwnerBookings(cat, btn) {
        document.querySelectorAll('.filter-booking-btn').forEach(b => {
            b.classList.remove('active', 'btn-primary');
            b.classList.add('btn-light', 'border');
        });
        btn.classList.add('active', 'btn-primary');
        btn.classList.remove('btn-light', 'border');

        document.querySelectorAll('.owner-booking-card').forEach(card => {
            const c = card.getAttribute('data-category');
            if (cat === 'all' || c === cat) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>

