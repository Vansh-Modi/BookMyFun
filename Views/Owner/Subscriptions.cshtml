@model IEnumerable<BookMyFun.Models.Entities.SubscriptionPlan>
@{
    ViewData["Title"] = "Owner Subscription Plans";
    var activeSub = ViewBag.ActiveSub as BookMyFun.Models.Entities.OwnerSubscription;
}

<div class="text-center mb-5">
    <h2 class="fw-bold">Monetization & Listing Plans for Property Owners</h2>
    <p class="text-muted">Choose a subscription to list farmhouses, cottages, and luxury villas on BookMyFun.</p>
</div>

@if (activeSub != null)
{
    <div class="alert alert-info text-center mb-4">
        <i class="bi bi-shield-check"></i> You currently hold an active <strong>@activeSub.PlanName</strong> valid until <strong>@activeSub.EndDate.ToString("MMMM dd, yyyy")</strong>.
    </div>
}

<div class="row row-cols-1 row-cols-md-3 g-4 justify-content-center">
    @foreach (var plan in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-2 text-center @(plan.PlanName.Contains("Gold") || plan.PlanName.Contains("Pro") ? "border-warning" : "border-light")">
                <div class="card-header bg-white border-0 pt-4">
                    <h4 class="card-title fw-bold">@plan.PlanName</h4>
                    <h2 class="display-6 fw-bold text-primary mt-2">₹@plan.Price.ToString("N0")</h2>
                    <span class="text-muted">/ @plan.DurationInDays Days</span>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i> List up to <strong>@plan.MaxListings Properties</strong></li>
                        <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i> Instant Guest WhatsApp Alerts</li>
                        <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i> Real-time Slot Availability Calendar</li>
                        <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i> Dedicated Partner Support</li>
                    </ul>

                    <form asp-action="Subscribe" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="planId" value="@plan.PlanID" />
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                            <i class="bi bi-credit-card-fill me-1"></i> Subscribe via Razorpay
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@{
    var history = ViewBag.History as List<BookMyFun.Models.Entities.OwnerSubscription>;
}
@if (history != null && history.Any())
{
    <div class="card shadow-sm border-0 rounded-4 mt-5">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i> Subscription &amp; Payment History</h5>
            <span class="badge bg-light text-dark border">@history.Count Records</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Subscription Ref</th>
                        <th>Plan Name</th>
                        <th>Billing Cycle</th>
                        <th>Payment Status</th>
                        <th>Razorpay Ref</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in history)
                    {
                        <tr>
                            <td class="fw-bold">#@item.SubscriptionID</td>
                            <td>
                                <span class="fw-semibold">@item.PlanName</span>
                            </td>
                            <td class="small text-muted">
                                @item.StartDate.ToString("MMM dd, yyyy") &rarr; @item.EndDate.ToString("MMM dd, yyyy")
                            </td>
                            <td>
                                @if (item.PaymentStatus == "Paid")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i> Paid
                                    </span>
                                }
                                else if (item.PaymentStatus == "Pending")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill">
                                        <i class="bi bi-hourglass-split me-1"></i> Pending
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-1 rounded-pill">@item.PaymentStatus</span>
                                }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrWhiteSpace(item.GatewayTransactionID))
                                {
                                    <code>@item.GatewayTransactionID</code>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.PaymentStatus == "Pending")
                                {
                                    <a asp-action="SubscriptionPayment" asp-route-id="@item.SubscriptionID" class="btn btn-sm btn-primary fw-bold">
                                        <i class="bi bi-shield-check me-1"></i> Pay with Razorpay
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="bi bi-shield-lock-fill text-success"></i> Active</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
