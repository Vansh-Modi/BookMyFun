@model BookMyFun.Models.ViewModels.OwnerNotificationPreferencesViewModel
@{
    ViewData["Title"] = "Notification Channels & Preferences";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <a asp-action="Index" class="text-decoration-none small text-muted">
                        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                    </a>
                    <h2 class="fw-bold mb-1 text-dark mt-1">Notification Channels &amp; Alerts</h2>
                    <p class="text-muted small mb-0">Configure instant guest booking, refund, payment, review, and subscription updates across your preferred communication channels.</p>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-card">
                <div class="card-header bg-dark text-white p-3.5">
                    <h5 class="fw-bold mb-0"><i class="bi bi-broadcast text-warning me-2"></i>Multi-Channel Fan-out Delivery</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="NotificationSettings" method="post" id="notifSettingsForm">
                        @Html.AntiForgeryToken()

                        <!-- Channel 1: In-App Notifications -->
                        <div class="p-3 bg-light rounded-4 border mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2.5">
                                        <i class="bi bi-bell-fill fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">Website &amp; In-App Dashboard Alerts</h6>
                                        <p class="small text-muted mb-0">Receive instant push notifications in your top navigation bell icon and dashboard ledger.</p>
                                    </div>
                                </div>
                                <div class="form-check form-switch fs-4">
                                    <input class="form-check-input" type="checkbox" role="switch" asp-for="InAppEnabled">
                                </div>
                            </div>
                        </div>

                        <!-- Channel 2: Email Notifications -->
                        <div class="p-3 bg-light rounded-4 border mb-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-2.5">
                                        <i class="bi bi-envelope-fill fs-4"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">Official Email Summaries</h6>
                                        <p class="small text-muted mb-0">Itemized guest vouchers, settlement receipts, listing review decisions, and financial invoices dispatched to your registered address.</p>
                                    </div>
                                </div>
                                <div class="form-check form-switch fs-4">
                                    <input class="form-check-input" type="checkbox" role="switch" asp-for="EmailEnabled">
                                </div>
                            </div>
                        </div>

                        <!-- Channel 3: WhatsApp Business Notifications -->
                        <div class="p-3 bg-light rounded-4 border mb-4">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-2.5">
                                        <i class="bi bi-whatsapp fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <h6 class="fw-bold mb-0 text-dark">WhatsApp Instant Business Alerts</h6>
                                            @if (Model.WhatsAppVerified)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small">
                                                    <i class="bi bi-patch-check-fill me-1"></i>Verified Number
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill small">
                                                    <i class="bi bi-exclamation-circle me-1"></i>Requires OTP Opt-in
                                                </span>
                                            }
                                        </div>
                                        <p class="small text-muted mb-0">Meta-approved WhatsApp message templates for high-priority events (new bookings, guest cancellations, urgent damage claims).</p>
                                    </div>
                                </div>
                                <div class="form-check form-switch fs-4">
                                    <input class="form-check-input" type="checkbox" role="switch" id="chkWaEnabled" asp-for="WhatsAppEnabled" disabled="@(!Model.WhatsAppVerified)">
                                </div>
                            </div>

                            <!-- Phone & Verification Row -->
                            <div class="row g-2 align-items-center pt-3 border-top">
                                <div class="col-md-7">
                                    <label class="form-label small fw-semibold text-muted mb-1">WhatsApp Mobile Number</label>
                                    <input asp-for="WhatsAppPhone" id="waPhoneInput" class="form-control form-control-sm" placeholder="10-digit mobile number" maxlength="10" />
                                </div>
                                <div class="col-md-5 pt-3 pt-md-4">
                                    @if (!Model.WhatsAppVerified)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success w-100 rounded-pill fw-semibold" data-bs-toggle="modal" data-bs-target="#modalWaOtp">
                                            <i class="bi bi-shield-check me-1"></i> Verify Phone via OTP
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 rounded-pill" data-bs-toggle="modal" data-bs-target="#modalWaOtp">
                                            Change Number / Re-verify
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- 9 Fanned-Out Notification Events Info Card -->
                        <div class="card border border-subtle rounded-4 p-3 mb-4 bg-body">
                            <h6 class="fw-bold small text-dark mb-2"><i class="bi bi-check2-all text-primary me-1"></i>Events Covered by Notification Fan-out Service</h6>
                            <div class="row g-2 small text-muted">
                                <div class="col-md-6"><i class="bi bi-dot text-primary"></i> 1. New Guest Booking Reservation</div>
                                <div class="col-md-6"><i class="bi bi-dot text-primary"></i> 2. Booking Cancelled by Guest</div>
                                <div class="col-md-6"><i class="bi bi-dot text-primary"></i> 3. Guest Refund Processed</div>
                                <div class="col-md-6"><i class="bi bi-dot text-primary"></i> 4. Host Payment Settlement Received</div>
                                <div class="col-md-6"><i class="bi bi-dot text-primary"></i> 5. Guest Review Received</div>
                                <div class="col-md-6"><i class="bi bi-dot text-primary"></i> 6. Farm Listing Approved / Rejected</div>
                                <div class="col-md-6"><i class="bi bi-dot text-primary"></i> 7. Host KYC Verification Status Change</div>
                                <div class="col-md-6"><i class="bi bi-dot text-primary"></i> 8. Subscription Expiring or Expired</div>
                                <div class="col-md-6"><i class="bi bi-dot text-primary"></i> 9. Security Deposit Damage Claim Raised</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                                <i class="bi bi-save me-1"></i> Save Notification Preferences
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: WhatsApp OTP Verification (Section 2A) -->
<div class="modal fade" id="modalWaOtp" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom py-3 bg-success text-white">
                <h6 class="modal-title fw-bold mb-0">
                    <i class="bi bi-whatsapp me-2"></i>Verify WhatsApp Phone Number
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="VerifyWhatsAppOtp" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="small text-muted mb-3">To comply with WhatsApp Business API security rules, you must opt-in and verify your phone number with a 6-digit OTP code before automated templates can be delivered.</p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Mobile Number (India)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">+91</span>
                            <input type="tel" name="phone" id="otpPhoneInput" class="form-control" value="@Model.WhatsAppPhone" placeholder="10-digit mobile number" maxlength="10" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">6-Digit Verification OTP Code</label>
                        <input type="text" name="otp" class="form-control form-control-sm text-center fw-bold letter-spacing-lg" placeholder="123456" maxlength="6" pattern="^[0-9]{6}$" required />
                        <small class="form-text text-muted">Enter verification code (Demo/Dev code: <strong>123456</strong>)</small>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light py-2.5">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-4 fw-bold">
                        Verify &amp; Activate WhatsApp Alerts
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
