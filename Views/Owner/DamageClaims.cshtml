@model IEnumerable<BookMyFun.Models.Entities.DamageClaim>
@{
    ViewData["Title"] = "Security Deposit Damage Claims";
}

<div class="container py-4">
    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-gradient text-white p-4" style="background: linear-gradient(135deg, #b91c1c 0%, #7f1d1d 100%);">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-white text-danger px-3 py-2 rounded-pill fw-bold mb-2">Host Protection</span>
                <h2 class="fw-bold mb-1"><i class="bi bi-shield-exclamation me-2"></i>Security Deposit & Damage Claims</h2>
                <p class="mb-0 text-white-50">Claims must be filed strictly within 24 hours of checkout with mandatory itemized costs and photographic/video proof.</p>
            </div>
            <div>
                <button type="button" class="btn btn-light text-danger fw-bold rounded-pill px-4 me-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#newClaimModal">
                    <i class="bi bi-plus-circle me-1"></i> File Damage Claim
                </button>
                <a asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- Active Claims Data Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white py-3 border-bottom border-light-subtle d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-clipboard-data text-danger me-2"></i>Your Submitted Claims</h5>
            <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill">Total: @(Model?.Count() ?? 0)</span>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Claim #</th>
                                <th>Booking Ref</th>
                                <th>Property</th>
                                <th>Claim Amount</th>
                                <th>Approved Amount</th>
                                <th>Status</th>
                                <th>Date Filed</th>
                                <th class="pe-4 text-end">Adjudication Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                var badgeClass = c.Status switch
                                {
                                    "UnderReview" => "bg-warning text-dark",
                                    "Approved" => "bg-success",
                                    "Rejected" => "bg-danger",
                                    "Settled" => "bg-info text-dark",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td class="ps-4 fw-bold">#@c.ClaimID</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">Booking #@c.BookingID</span>
                                    </td>
                                    <td class="fw-medium">@c.PropertyTitle</td>
                                    <td class="fw-bold text-danger">₹@c.ClaimAmount.ToString("N2")</td>
                                    <td class="fw-bold text-success">
                                        @(c.AdjudicatedAmount.HasValue ? $"₹{c.AdjudicatedAmount.Value:N2}" : "--")
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass px-3 py-2 rounded-pill">@c.Status</span>
                                    </td>
                                    <td class="text-muted small">@c.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td class="pe-4 text-end small text-muted">
                                        @(string.IsNullOrEmpty(c.AdjudicationNotes) ? "Pending staff review" : c.AdjudicationNotes)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-shield-check fs-1 text-success d-block mb-3"></i>
                    <h5 class="fw-bold text-secondary">No Damage Claims Filed</h5>
                    <p class="text-muted small mb-0">You have not raised any damage claims. Claims can be initiated from your Bookings list within 24 hours of checkout.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- File Damage Claim Modal -->
<div class="modal fade" id="newClaimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-action="CreateClaim" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white py-3">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-shield-exclamation me-2"></i>File New Property Damage Claim
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Submit incident details, damage description, and photographic/video evidence. Operations will review and adjudicate deductions.
                    </p>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Select Guest Booking <span class="text-danger">*</span></label>
                        @{
                            var bookings = ViewBag.EligibleBookings as List<BookMyFun.Models.Entities.Booking>;
                        }
                        @if (bookings != null && bookings.Any())
                        {
                            <select name="BookingID" class="form-select" required>
                                <option value="">-- Choose Booking to Claim Against --</option>
                                @foreach (var b in bookings)
                                {
                                    <option value="@b.BookingID">
                                        #@b.BookingID — @b.PropertyTitle (@b.ClientName, @b.CheckInDate.ToString("MMM dd")) — Deposit: ₹@b.SecurityDepositAmount.ToString("N0")
                                    </option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2 small">No active or past bookings found for your properties.</div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Claimed Damage Amount (₹) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="1" name="ClaimAmount" class="form-control" placeholder="e.g. 3500.00" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Itemized Description &amp; Cost Breakdown <span class="text-danger">*</span></label>
                        <textarea name="ItemizedDescription" class="form-control" rows="3" placeholder="Describe the damage specifically (e.g. Broken glass door in living room ₹2,500 + stained patio cushions dry cleaning ₹1,000)" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Photo / Video Evidence Proof URLs</label>
                        <textarea name="EvidenceUrlsInput" class="form-control" rows="2" placeholder="Paste media links (Cloudinary, Drive, Imgur, or direct URLs) separated by commas"></textarea>
                        <div class="form-text small">Provide direct links to inspection photos or videos showing the damaged assets.</div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-bold rounded-pill px-4">
                        <i class="bi bi-shield-check me-1"></i> Submit Damage Claim
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
