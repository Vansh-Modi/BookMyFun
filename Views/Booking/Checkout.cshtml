                                        Attach ID Photo / PDF <span class="text-danger" id="idFileRequiredStar" style="@(Model.IsClientAlreadyVerified || !string.IsNullOrEmpty(Model.ExistingDocumentKey) ? "display:none;" : "")">*</span>
                                        <span class="text-muted fw-normal" id="idFileOptionalHint" style="@(Model.IsClientAlreadyVerified || !string.IsNullOrEmpty(Model.ExistingDocumentKey) ? "" : "display:none;")">(Optional - verified ID already on record)</span>
                                    </label>
                                    <input asp-for="IdDocumentFile" type="file" id="idFileInput" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,.pdf" required />
                                    <span asp-validation-for="IdDocumentFile" class="text-danger small d-block mt-1"></span>
                                    <div class="inline-error-text" id="idFileError">Please upload a copy of your document (JPG, PNG, or PDF, max 5MB).</div>
                                    <small class="text-muted" style="font-size: 0.72rem;"><i class="bi bi-shield-lock me-1"></i>Stored encrypted in compliance vault. Only JPG, PNG, and PDF up to 5MB are accepted.</small>
                                </div>
                            </div>
                        </div>

                        <!-- 4. ORDER SUMMARY & BREAKDOWN (No Security Deposit!) (Section 7B) -->
                        <div class="card border-0 bg-light rounded-4 p-3.5 mb-4">
                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-receipt text-primary me-2"></i>Order Summary</h6>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted" id="summaryRateLabel">Base stay rate:</span>
                                <strong class="text-dark" id="summaryStayAmount">₹@Model.PricePerNight.ToString("N0")</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small text-primary d-none" id="summaryDecorRow">
                                <span><i class="bi bi-palette2 me-1"></i><span id="summaryDecorName">Décor Package:</span></span>
                                <strong id="summaryDecorAmount">+ ₹0</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small text-muted">
                                <span>Taxes &amp; Platform Fee</span>
                                <span>Included</span>
                            </div>
                            <hr class="my-2 border-secondary border-opacity-25" />
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small d-block">Total Payable Amount</span>
                                    <h3 class="fw-bold text-success mb-0" id="finalTotalPayable">₹@Model.PricePerNight.ToString("N0")</h3>
                                </div>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 small">
                                    <i class="bi bi-shield-check me-1"></i>No Hidden Fees
                                </span>
                            </div>
                        </div>

                        <!-- Policy Consent -->
                        <div class="mb-4">
                            <partial name="_PolicyConsentCheckbox" />
                            <div class="inline-error-text" id="policyConsentError">You must agree to the Terms of Service &amp; Policies to proceed.</div>
                        </div>

                        <!-- Submit Button ENABLED AT ALL TIMES on load (Section 7C) -->
                        <div class="d-grid">
                            <button type="submit" id="btnProceedPayment" class="btn btn-warning btn-lg fw-bold py-3 rounded-pill shadow-sm w-100">
                                <i class="bi bi-credit-card-2-front me-1"></i> Proceed to Payment
                            </button>
                        </div>
                    </form>
<!-- Bootstrap Modal: Stay & Celebrate Popup Menu -->
