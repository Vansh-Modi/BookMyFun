    const modalPackagesLoading = document.getElementById('modalPackagesLoading');
    const modalYouMightAlsoLikeSection = document.getElementById('modalYouMightAlsoLikeSection');
    const modalYouMightAlsoLikeList = document.getElementById('modalYouMightAlsoLikeList');
