    function loadStayAndCelebrateData() {
        if (modalPackagesLoading) modalPackagesLoading.classList.remove('d-none');
        if (modalPackagesList) modalPackagesList.classList.add('d-none');
        if (modalYouMightAlsoLikeSection) modalYouMightAlsoLikeSection.classList.add('d-none');

        fetch(`/Booking/GetEventManagersForOccasion?propertyId=${propId}`)
            .then(res => res.json())
            .then(data => {
                if (modalPackagesLoading) modalPackagesLoading.classList.add('d-none');
                cachedAreaResponse = data;

                if (data.success) {
                    renderOccasionChips(data.availableCategories || []);
                    renderCategoryPackages(data);
                }
            })
            .catch(err => {
                console.error('Failed to load celebration décor data:', err);
                if (modalPackagesLoading) modalPackagesLoading.classList.add('d-none');
            });
    }

    function renderOccasionChips(availableCategories) {
        if (!modalOccasionChipsList) return;

        // If currentCategory is not in available, select first available
        if (availableCategories.length > 0 && !availableCategories.includes(currentCategory)) {
            currentCategory = availableCategories[0];
        }

        let html = '';
        availableCategories.forEach(cat => {
            const isActive = cat === currentCategory;
            html += `<button type="button" class="occasion-chip ${isActive ? 'active' : ''}" data-category="${escapeHtml(cat)}">${escapeHtml(cat)}</button>`;
        });

        modalOccasionChipsList.innerHTML = html;

        // Attach click listener for chips
        modalOccasionChipsList.querySelectorAll('.occasion-chip').forEach(chip => {
            chip.addEventListener('click', function () {
                modalOccasionChipsList.querySelectorAll('.occasion-chip').forEach(c => c.classList.remove('active'));
                this.classList.add('active');
                currentCategory = this.getAttribute('data-category');
                tempModalEvent.category = currentCategory;
                if (cachedAreaResponse) {
                    renderCategoryPackages(cachedAreaResponse);
                }
            });
        });
    }

    function renderCategoryPackages(data) {
        if (!modalPackagesList) return;

        const managers = data.managers || [];
        // Flatten packages matching currentCategory
        let items = [];
        managers.forEach(mgr => {
            (mgr.packages || []).forEach(pkg => {
                if (matchesCategoryClient(pkg.category, currentCategory)) {
                    items.push({
                        pkg: pkg,
                        mgr: mgr
                    });
                }
            });
        });

        // Apply sort toggle
        sortPackages(items);

        if (items.length > 0) {
            // Show matching packages
            if (modalYouMightAlsoLikeSection) modalYouMightAlsoLikeSection.classList.add('d-none');
            modalPackagesList.classList.remove('d-none');

            let html = '';
            items.forEach(item => {
                html += renderSingleManagerCard(item.pkg, item.mgr, false);
            });
            modalPackagesList.innerHTML = html;
        } else {
            // 4. "You might also like" list: 3 to 7 packages from other categories in same area
            modalPackagesList.classList.add('d-none');
            if (modalYouMightAlsoLikeSection && modalYouMightAlsoLikeList) {
                modalYouMightAlsoLikeSection.classList.remove('d-none');

                let otherItems = [];
                (data.youMightAlsoLike || []).forEach(item => {
                    otherItems.push({
                        pkg: {
                            packageId: item.packageId,
                            name: item.name,
                            category: item.category,
                            basePrice: item.basePrice,
                            includedItems: item.includedItems
                        },
                        mgr: {
                            userId: item.managerId,
                            displayName: item.managerDisplayName,
                            averageRating: item.managerRating,
                            eventsCompleted: item.managerEventsCompleted
                        }
                    });
                });

                if (otherItems.length === 0) {
                    // Fallback from all packages in managers
                    managers.forEach(mgr => {
                        (mgr.packages || []).forEach(pkg => {
                            otherItems.push({ pkg, mgr });
                        });
                    });
                }

                sortPackages(otherItems);
                const sample = otherItems.slice(0, Math.min(7, Math.max(3, otherItems.length)));

                let likeHtml = '';
                sample.forEach(item => {
                    likeHtml += renderSingleManagerCard(item.pkg, item.mgr, true);
                });
                modalYouMightAlsoLikeList.innerHTML = likeHtml;
            }
        }

        updateModalSummaryDisplay();
    }

    function sortPackages(itemsList) {
        if (currentSort === 'top-rated') {
            itemsList.sort((a, b) => {
                const rA = Number(a.mgr.averageRating || 4.9);
                const rB = Number(b.mgr.averageRating || 4.9);
                if (rB !== rA) return rB - rA;
                return (b.mgr.eventsCompleted || 0) - (a.mgr.eventsCompleted || 0);
            });
        } else if (currentSort === 'lowest-price') {
            itemsList.sort((a, b) => Number(a.pkg.basePrice) - Number(b.pkg.basePrice));
        }
    }

    function renderSingleManagerCard(pkg, mgr, showCategory) {
        const isSelected = tempModalEvent.packageId && String(tempModalEvent.packageId) === String(pkg.packageId);
        const rating = Number(mgr.averageRating || 4.9).toFixed(1);
        const eventsCompleted = mgr.eventsCompleted || 25;
        const priceFormatted = Number(pkg.basePrice).toLocaleString('en-IN');
        const inclusions = escapeHtml(pkg.includedItems || pkg.description || 'Full farm staging, floral décor & lighting setup');

        return `
            <div class="card celebrate-manager-card modal-pkg-card ${isSelected ? 'selected-pkg-card' : ''}"
                 data-package-id="${pkg.packageId}"
                 data-package-name="${escapeHtml(pkg.name)}"
                 data-package-price="${pkg.basePrice}"
                 data-manager-id="${mgr.userId}"
                 data-manager-name="${escapeHtml(mgr.displayName)}"
                 data-category="${escapeHtml(pkg.category || currentCategory)}"
                 role="button" tabindex="0">
