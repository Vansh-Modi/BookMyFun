@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @{
        var checkoutConfigObj = new
        {
            propertyId = Model.PropertyID,
            basePrice = Model.PricePerNight,
            bookingType = string.IsNullOrEmpty(Model.BookingType) ? "FullDay" : Model.BookingType,
            isEventBooking = Model.IsEventBooking,
            isEventServiceAvailable = Model.IsEventServiceAvailable,
            blockedDates = Model.BlockedDates ?? new List<string>(),
            confirmedEvent = new
            {
                occasionId = Model.OccasionID,
                occasionName = (Model.OccasionID.HasValue && Model.AvailableOccasions != null && Model.AvailableOccasions.Any(o => o.OccasionID == Model.OccasionID.Value))
                    ? Model.AvailableOccasions.First(o => o.OccasionID == Model.OccasionID.Value).OccasionName
                    : "",
                category = "Birthday Party",
                packageId = Model.EventPackageID,
                packageName = (Model.EventPackageID.HasValue && Model.AvailableEventPackages != null && Model.AvailableEventPackages.Any(p => p.PackageID == Model.EventPackageID.Value))
                    ? Model.AvailableEventPackages.First(p => p.PackageID == Model.EventPackageID.Value).Name
                    : "",
                packagePrice = (Model.EventPackageID.HasValue && Model.AvailableEventPackages != null && Model.AvailableEventPackages.Any(p => p.PackageID == Model.EventPackageID.Value))
                    ? Model.AvailableEventPackages.First(p => p.PackageID == Model.EventPackageID.Value).BasePrice
                    : 0m,
                managerId = Model.DecoratorAssignedID,
                managerName = (Model.DecoratorAssignedID.HasValue && Model.AvailableEventManagers != null && Model.AvailableEventManagers.Any(m => m.UserID == Model.DecoratorAssignedID.Value))
                    ? Model.AvailableEventManagers.First(m => m.UserID == Model.DecoratorAssignedID.Value).DisplayName
                    : "",
                isConfirmed = Model.IsEventBooking && Model.EventPackageID.HasValue
            }
        };
    }
    <script type="application/json" id="checkoutPageConfig">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(checkoutConfigObj))
    </script>
<script>
    // ─────────────────────────────────────────────────────────────
    // Duration Type Segmented Control (Section 7A)
    // ─────────────────────────────────────────────────────────────
    const checkoutConfigEl = document.getElementById('checkoutPageConfig');
    const checkoutConfig = checkoutConfigEl ? JSON.parse(checkoutConfigEl.textContent || '{}') : {};
    let currentMode = checkoutConfig.bookingType || 'FullDay';
    const basePrice = Number(checkoutConfig.basePrice) || 0;
    const propId = Number(checkoutConfig.propertyId) || 0;
    const blockedDatesList = checkoutConfig.blockedDates || [];

    const segmentedBtns = document.querySelectorAll('.segmented-btn');
    const bookingTypeField = document.getElementById('bookingTypeField');
    const fullDayContainer = document.getElementById('fullDayInputContainer');
    const halfDayContainer = document.getElementById('halfDaySlotContainer');
    const hourlyContainer = document.getElementById('hourlyTimeContainer');
    const hourlyDurationField = document.getElementById('hourlyDurationField');
    const hourlyDurationReadonly = document.getElementById('hourlyDurationReadonly');

    const visibleCheckIn = document.getElementById('visibleCheckInDate');
    const visibleCheckOut = document.getElementById('visibleCheckOutDate');
    const visibleHalfDay = document.getElementById('visibleHalfDayDate');
    const visibleHourly = document.getElementById('visibleHourlyDate');

    segmentedBtns.forEach(btn => {
        btn.addEventListener('click', function () {
            segmentedBtns.forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            currentMode = this.getAttribute('data-type');
            bookingTypeField.value = currentMode;

            if (currentMode === 'FullDay') {
                fullDayContainer.classList.remove('d-none');
                halfDayContainer.classList.add('d-none');
                hourlyContainer.classList.add('d-none');
            } else if (currentMode === 'HalfDay') {
                fullDayContainer.classList.add('d-none');
                halfDayContainer.classList.remove('d-none');
                hourlyContainer.classList.add('d-none');
            } else if (currentMode === 'Hourly') {
                fullDayContainer.classList.add('d-none');
                halfDayContainer.classList.add('d-none');
                hourlyContainer.classList.remove('d-none');
                validateHourlyTimings();
            }

            
renderCompactCalendar();
            calculateLiveTotal();
        });
    });

    // Synchronize visible date pickers with calendar and hidden inputs
    if (visibleCheckIn) {
        visibleCheckIn.addEventListener('change', () => {
            if (visibleCheckIn.value) {
                selStart = new Date(visibleCheckIn.value + 'T00:00:00');
                if (visibleCheckOut && visibleCheckOut.value) {
                    const outDate = new Date(visibleCheckOut.value + 'T00:00:00');
                    if (outDate <= selStart) {
                        selEnd = new Date(selStart);
                        selEnd.setDate(selEnd.getDate() + 1);
                        visibleCheckOut.value = formatYmd(selEnd);
                    }
                }
                
renderCompactCalendar();
                calculateLiveTotal();
                scheduleDateChangeEligibility();
            }
        });
    }

    if (visibleCheckOut) {
        visibleCheckOut.addEventListener('change', () => {
            if (visibleCheckOut.value) {
                selEnd = new Date(visibleCheckOut.value + 'T00:00:00');
                if (selStart && selEnd <= selStart) {
                    document.getElementById('checkOutDateError').style.display = 'block';
                    visibleCheckOut.classList.add('field-error-highlight');
                } else {
                    document.getElementById('checkOutDateError').style.display = 'none';
                    visibleCheckOut.classList.remove('field-error-highlight');
                }
                
renderCompactCalendar();
                calculateLiveTotal();
                scheduleDateChangeEligibility();
            }
        });
    }

    if (visibleHalfDay) {
