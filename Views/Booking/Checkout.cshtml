    function matchesCategoryClient(pkgCat, targetCat) {
        if (!pkgCat || !targetCat) return true;
        const p = pkgCat.toLowerCase().trim();
        const t = targetCat.toLowerCase().trim();
        if (p === t || p.includes(t) || t.includes(p)) return true;

        const sep = /[\s\/\-,&]+/;
        const pTokens = p.split(sep);
        const tTokens = t.split(sep);
        return pTokens.some(pt => tTokens.includes(pt));
    }

    function updateModalSummaryDisplay() {
        let stayTotal = basePrice;
        if (currentMode === 'FullDay') {
            const nights = selEnd ? Math.max(1, Math.round((selEnd - selStart) / (1000 * 60 * 60 * 24))) : 1;
            stayTotal = basePrice * nights;
        } else if (currentMode === 'HalfDay') {
            stayTotal = Math.round(basePrice * 0.55);
        } else if (currentMode === 'Hourly') {
            const hours = parseInt(hourlyDurationField.value) || 4;
            stayTotal = Math.round(basePrice * 0.10 * hours);
        }

        const decorFee = Number(tempModalEvent.packagePrice) || 0;
        const grandTotal = stayTotal + decorFee;

        if (modalSummaryStayTotal) modalSummaryStayTotal.textContent = '₹' + stayTotal.toLocaleString('en-IN');
        if (modalSummaryDecorTotal) modalSummaryDecorTotal.textContent = '+ ₹' + decorFee.toLocaleString('en-IN') + ' (flat fee)';
        if (modalSummaryNewTotal) modalSummaryNewTotal.textContent = '₹' + grandTotal.toLocaleString('en-IN');

        if (modalSelectedDetailsText) {
            if (tempModalEvent.packageId && tempModalEvent.managerName) {
                modalSelectedDetailsText.textContent = `${tempModalEvent.managerName} · ${tempModalEvent.packageName}`;
            } else {
                modalSelectedDetailsText.textContent = 'None selected';
            }
        }

        if (btnConfirmPlanEvent) {
            btnConfirmPlanEvent.disabled = !(tempModalEvent.packageId && tempModalEvent.managerId);
        }
    }

    function confirmPlanEvent() {
        if (!tempModalEvent.packageId || !tempModalEvent.managerId) {
            return;
        }

        confirmedEvent = { ...tempModalEvent, isConfirmed: true };

        // Set hidden form fields
        if (selectedOccasionIdInput) selectedOccasionIdInput.value = confirmedEvent.occasionId || '';
        if (selectedEventPackageIdInput) selectedEventPackageIdInput.value = confirmedEvent.packageId;
        if (decoratorAssignedIdInput) decoratorAssignedIdInput.value = confirmedEvent.managerId;
        if (isEventBookingInput) isEventBookingInput.value = 'true';

        // Update UI
        if (toggleEventStay) toggleEventStay.checked = true;
        decorPrice = Number(confirmedEvent.packagePrice) || 0;
        decorName = confirmedEvent.packageName;

        if (eventStaySummaryText) {
            const teamInfo = confirmedEvent.managerName ? ` by ${confirmedEvent.managerName}` : '';
            eventStaySummaryText.textContent = `Stay & Celebrate · ${confirmedEvent.packageName}${teamInfo} · ₹${decorPrice.toLocaleString('en-IN')} flat fee`;
        }
        if (eventStaySummaryLine) {
            eventStaySummaryLine.classList.remove('d-none');
        }

        calculateLiveTotal();

        if (planEventModal) {
            planEventModal.hide();
        }
    }

    function cancelPlanEvent() {
        if (confirmedEvent.isConfirmed) {
            tempModalEvent = { ...confirmedEvent };
            if (toggleEventStay) toggleEventStay.checked = true;
        } else {
            switchToStandardStay();
        }

        if (planEventModal) {
            planEventModal.hide();
        }
    }

    function switchToStandardStay() {
        confirmedEvent = {
            occasionId: null,
            occasionName: '',
            category: 'Birthday Party',
            packageId: null,
            packageName: '',
            packagePrice: 0,
            managerId: null,
            managerName: '',
            isConfirmed: false
        };
        tempModalEvent = { ...confirmedEvent };

        // Clear hidden décor fields
        if (selectedOccasionIdInput) selectedOccasionIdInput.value = '';
        if (selectedEventPackageIdInput) selectedEventPackageIdInput.value = '';
        if (decoratorAssignedIdInput) decoratorAssignedIdInput.value = '';
        if (isEventBookingInput) isEventBookingInput.value = 'false';

        if (toggleStandardStay) toggleStandardStay.checked = true;
        if (toggleEventStay) toggleEventStay.checked = false;
        if (eventStaySummaryLine) eventStaySummaryLine.classList.add('d-none');

        decorPrice = 0;
        decorName = '';
        calculateLiveTotal();

        if (planEventModal) {
            planEventModal.hide();
        }
    }

    function escapeHtml(text) {
        if (!text) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return text.replace(/[&<>"']/g, m => map[m]);
    }

    // Modal Focus Trapping & Accessibility Setup
    if (planEventModalEl) {
        planEventModalEl.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                e.preventDefault();
                cancelPlanEvent();
                return;
            }

            if (e.key === 'Tab') {
                const focusables = planEventModalEl.querySelectorAll('button:not([disabled]):not([style*="display: none"]), [href], input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])');
                if (focusables.length === 0) return;

                const first = focusables[0];
                const last = focusables[focusables.length - 1];

                if (e.shiftKey) {
                    if (document.activeElement === first) {
                        e.preventDefault();
                        last.focus();
                    }
                } else {
                    if (document.activeElement === last) {
                        e.preventDefault();
                        first.focus();
                    }
                }
            }
        });

        planEventModalEl.addEventListener('hidden.bs.modal', function () {
            if (lastFocusedElement) {
                lastFocusedElement.focus();
            } else if (toggleEventStay && toggleEventStay.checked && !toggleEventStay.classList.contains('d-none')) {
                toggleEventStay.focus();
            } else if (toggleStandardStay) {
                toggleStandardStay.focus();
            }
        });
    }

