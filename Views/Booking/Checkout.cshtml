    function getKolkataNow() {
        const now = new Date();
        const kolkataStr = now.toLocaleString("en-US", { timeZone: "Asia/Kolkata" });
        return new Date(kolkataStr);
    }

    let latestEligibilitySeq = 0;
    let isUserDateChangeTriggered = false;
    let dateChangeDebounceTimer = null;
    let savedEventBeforeAutoSwitch = null;
    let autoSwitchedToStandard = false;
    let currentEligibilityIsUserChange = false;

    function scheduleDateChangeEligibility() {
        isUserDateChangeTriggered = true;
        if (dateChangeDebounceTimer) {
            clearTimeout(dateChangeDebounceTimer);
        }
        dateChangeDebounceTimer = setTimeout(() => {
            fetchCelebrationEligibility();
        }, 300);
    }

    function getDisplayedDates() {
        let inVal = '';
        let outVal = '';
        if (currentMode === 'FullDay') {
            inVal = (visibleCheckIn && visibleCheckIn.value) ? visibleCheckIn.value : (document.getElementById('checkInField')?.value || '');
            outVal = (visibleCheckOut && visibleCheckOut.value) ? visibleCheckOut.value : (document.getElementById('checkOutField')?.value || '');
        } else if (currentMode === 'HalfDay') {
            inVal = (visibleHalfDay && visibleHalfDay.value) ? visibleHalfDay.value : (document.getElementById('checkInField')?.value || '');
            outVal = inVal;
        } else if (currentMode === 'Hourly') {
            inVal = (visibleHourly && visibleHourly.value) ? visibleHourly.value : (document.getElementById('checkInField')?.value || '');
            outVal = inVal;
        }
        return { inVal: inVal.trim(), outVal: outVal.trim() };
    }

    async function fetchCelebrationEligibility() {
        const { inVal, outVal } = getDisplayedDates();
        if (!inVal || inVal.startsWith('0001') || (currentMode === 'FullDay' && (!outVal || outVal.startsWith('0001')))) {
            return;
        }

        const seq = ++latestEligibilitySeq;
        const isUserChange = isUserDateChangeTriggered;
        isUserDateChangeTriggered = false;

        try {
            const res = await fetch(`/Booking/CelebrationEligibility?propertyId=${propId}&checkIn=${encodeURIComponent(inVal)}&checkOut=${encodeURIComponent(outVal)}`);
            if (seq !== latestEligibilitySeq) return;
            if (!res.ok) return;
            const data = await res.json();
            if (seq !== latestEligibilitySeq) return;
            currentEligibilityIsUserChange = isUserChange;
            applyCelebrationEligibility(data);
        } catch (err) {
            console.error('Error checking celebration eligibility:', err);
        }
    }

    function applyCelebrationEligibility(data) {
        if (!data) return;

        const qualifies = data.allowed === true;
        const switchedAlert = document.getElementById('decorSwitchedAlert');
        const wasSelected = (toggleEventStay && toggleEventStay.checked) || confirmedEvent.isConfirmed;
        const isUserChange = currentEligibilityIsUserChange;
        const reasonCode = (data.reasonCode || '').toLowerCase();
        const stayPurposeSub = document.getElementById('stayPurposeSubtitle');

        if (hasActiveDecoratorInput) {
            hasActiveDecoratorInput.value = (data.reason && data.reason.indexOf("No active") !== -1) ? 'false' : 'true';
        }

        if (qualifies) {
            if (stayPurposeSub) {
                stayPurposeSub.textContent = 'Select standard accommodation or plan a stay with celebration décor.';
            }
            if (toggleEventStay) {
                toggleEventStay.classList.remove('d-none');
                toggleEventStay.style.display = '';
                toggleEventStay.disabled = false;
            }
            if (lblEventStay) {
                lblEventStay.classList.remove('d-none');
                lblEventStay.style.display = '';
            }
            if (switchedAlert) {
                switchedAlert.classList.add('d-none');
                switchedAlert.innerHTML = '';
            }

            // If we previously auto-switched to Standard Stay due to a date change, restore Event Stay
            if (autoSwitchedToStandard) {
                if (savedEventBeforeAutoSwitch) {
                    confirmedEvent = { ...savedEventBeforeAutoSwitch };
                    tempModalEvent = { ...confirmedEvent };
                    if (selectedOccasionIdInput) selectedOccasionIdInput.value = confirmedEvent.occasionId || '';
                    if (selectedEventPackageIdInput) selectedEventPackageIdInput.value = confirmedEvent.packageId || '';
                    if (decoratorAssignedIdInput) decoratorAssignedIdInput.value = confirmedEvent.managerId || '';
                    if (isEventBookingInput) isEventBookingInput.value = confirmedEvent.isConfirmed ? 'true' : 'false';
                    decorPrice = confirmedEvent.packagePrice || 0;
                    decorName = confirmedEvent.packageName || '';
                    if (eventStaySummaryLine && confirmedEvent.packageName) {
                        eventStaySummaryLine.classList.remove('d-none');
                    }
                }
                if (toggleEventStay) toggleEventStay.checked = true;
                if (toggleStandardStay) toggleStandardStay.checked = false;
                calculateLiveTotal();
                autoSwitchedToStandard = false;
            }

            if (data.availableCategories && data.availableCategories.length > 0) {
                renderOccasionChips(data.availableCategories);
            }
        } else {
            if (toggleEventStay) {
                toggleEventStay.classList.add('d-none');
                toggleEventStay.style.display = 'none';
            }
            if (lblEventStay) {
                lblEventStay.classList.add('d-none');
                lblEventStay.style.display = 'none';
            }
            if (stayPurposeSub) {
                stayPurposeSub.textContent = 'Select standard accommodation.';
            }

            if (reasonCode === 'too_soon') {
                // Show notice only if guest had Event Stay selected and changed the dates
                if (isUserChange && wasSelected) {
                    savedEventBeforeAutoSwitch = { ...confirmedEvent };
                    autoSwitchedToStandard = true;
                    switchToStandardStay();
                    if (switchedAlert) {
                        switchedAlert.innerHTML = `
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-info-circle-fill text-primary fs-5 flex-shrink-0"></i>
                                <div>Décor needs more than 48 hours' notice, so we've switched you to a standard stay.</div>
                            </div>`;
                        switchedAlert.classList.remove('d-none');
                    }
                } else {
                    if (switchedAlert) {
                        switchedAlert.classList.add('d-none');
                        switchedAlert.innerHTML = '';
                    }
                }
            } else {
                // no_area_coverage, no_verified_manager, no_approved_portfolio, property_not_live, etc.
                // Hide option and show nothing about Event Stay. No notice, no banner, no placeholder text, no greyed-out button.
                if (wasSelected) {
                    switchToStandardStay();
                }
                if (switchedAlert) {
                    switchedAlert.classList.add('d-none');
                    switchedAlert.innerHTML = '';
                }
            }
        }
    }

    function openPlanEventModal() {
        lastFocusedElement = document.activeElement;
        tempModalEvent = { ...confirmedEvent };

