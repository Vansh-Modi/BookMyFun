@model BookMyFun.Models.Entities.Booking
@{
    ViewData["Title"] = "Booking Confirmed!";
}

<div class="row justify-content-center">
    <div class="col-md-7 text-center">
        <div class="card shadow-sm border-0 p-4">
            <div class="mb-3">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-success mb-2">Booking Confirmed!</h2>
            <p class="text-muted">Your reservation request has been processed and your entry pass is generated.</p>

            <div class="card bg-light border-0 p-3 my-3 text-start">
                <div class="row g-2">
                    <div class="col-6"><strong>Booking Reference:</strong></div>
                    <div class="col-6 text-end">#@Model.BookingID</div>

                    <div class="col-6"><strong>Property:</strong></div>
                    <div class="col-6 text-end">@Model.PropertyTitle</div>

                    <div class="col-6"><strong>Booking Type:</strong></div>
                    <div class="col-6 text-end"><span class="badge bg-secondary">@Model.BookingType</span> @Model.SlotType</div>

                    <div class="col-6"><strong>Dates:</strong></div>
                    <div class="col-6 text-end">@Model.CheckInDate.ToString("MMM dd") - @Model.CheckOutDate.ToString("MMM dd, yyyy")</div>

                    <div class="col-6"><strong>Total Amount Paid:</strong></div>
                    <div class="col-6 text-end text-success fw-bold">₹@Model.TotalAmount.ToString("N2")</div>

                    <div class="col-6"><strong>Payment Status:</strong></div>
                    <div class="col-6 text-end"><span class="badge bg-success">Success</span></div>
                </div>
            </div>

            <div class="alert alert-info small text-start">
                <i class="bi bi-whatsapp text-success me-1"></i> Instant WhatsApp confirmation has been dispatched with check-in instructions.
            </div>

            <div class="d-flex justify-content-center gap-2 mt-2">
                <a asp-controller="Client" asp-action="Index" class="btn btn-outline-dark">Go to My Dashboard</a>
                <a asp-controller="Properties" asp-action="Index" class="btn btn-warning">Explore More Properties</a>
            </div>
        </div>
    </div>
</div>
