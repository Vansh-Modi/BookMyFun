@model BookMyFun.Models.ViewModels.PaymentPageViewModel
@{
    ViewData["Title"] = "Secure Checkout Payment - BookMyFun";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-lg border-0 overflow-hidden">
            <!-- Header -->
            <div class="card-header bg-dark text-white p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1 text-warning fw-bold"><i class="bi bi-shield-lock-fill"></i> Secure Payment Gateway</h4>
                    <p class="mb-0 text-white-50 small">Order ID: @Model.OrderId | Booking Ref: #@Model.BookingID</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-success p-2 fs-6">256-Bit SSL Encrypted</span>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-4 mb-4">
                    <!-- Reservation Summary Card -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100 border">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Reservation Details</h6>
                            <h5 class="fw-bold text-primary mb-1">@Model.PropertyTitle</h5>
                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger"></i> @Model.Location</p>
                            
                            <div class="small mb-2">
                                <strong>Booking Option:</strong> 
                                <span class="badge bg-secondary">@Model.BookingType</span> @Model.SlotType
                            </div>
                            
                            <div class="small mb-2">
                                <strong>Dates:</strong> 
                                @Model.CheckInDate.ToString("dd MMM yyyy") to @Model.CheckOutDate.ToString("dd MMM yyyy")
                            </div>

                            @if (Model.CheckInTime.HasValue && Model.CheckOutTime.HasValue)
                            {
                                <div class="small text-muted mb-2">
                                    <i class="bi bi-clock"></i> <strong>Timings:</strong> Check-in: @Model.CheckInTime.Value.ToString(@"hh\:mm") | Check-out: @Model.CheckOutTime.Value.ToString(@"hh\:mm")
                                </div>
                            }

                            <div class="small text-muted">
                                <strong>Guest:</strong> @Model.ClientName (@Model.ClientEmail)
                            </div>
                        </div>
                    </div>

                    <!-- Payment Breakup Card -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100 border d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Payment Summary</h6>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Total Reservation Fee</span>
                                    <span>₹@Model.Amount.ToString("N2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Convenience &amp; Gateway Fee</span>
                                    <span class="text-success fw-bold">FREE (Absorbed)</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Taxes &amp; GST</span>
                                    <span class="text-muted">Included</span>
                                </div>
                            </div>

                            <div class="border-top pt-3 mt-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="fw-bold mb-0">Total Payable</h5>
                                    <h3 class="fw-bold text-success mb-0">₹@Model.Amount.ToString("N2")</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Primary: Official Razorpay Payment Card -->
                <div class="card border-2 border-primary shadow-sm rounded-4 mb-4 overflow-hidden" style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);">
                    <div class="card-body p-4 text-center">
                        <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                            <span class="badge bg-primary px-3 py-1 rounded-pill">Recommended</span>
                            <span class="badge bg-dark px-3 py-1 rounded-pill"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Instant Confirmation</span>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">Pay Online with Razorpay</h4>
                        <p class="text-muted small mb-3">Accepts GooglePay, PhonePe, Paytm, BHIM UPI, Visa, MasterCard, RuPay, NetBanking &amp; Wallets.</p>
                        
                        <button type="button" id="btnRazorpayPay" class="btn btn-success btn-lg px-5 py-3 rounded-pill fw-bold shadow">
                            <i class="bi bi-shield-check me-2"></i> Pay ₹@Model.Amount.ToString("N2") with Razorpay
                        </button>
                    </div>
                </div>

                <!-- Hidden form submitted upon Razorpay modal success -->
                <form id="razorpaySuccessForm" asp-action="VerifyPayment" method="post" style="display:none;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingId" value="@Model.BookingID" />
                    <input type="hidden" name="razorpay_order_id" id="rzp_order_id" />
                    <input type="hidden" name="razorpay_payment_id" id="rzp_payment_id" />
                    <input type="hidden" name="razorpay_signature" id="rzp_signature" />
                </form>

                <!-- Sandbox / Alternative Direct Payment Options -->
                <div class="d-flex align-items-center my-4">
                    <hr class="flex-grow-1" />
                    <span class="px-3 text-muted small fw-semibold">OR PAY VIA SIMULATED SANDBOX CHANNELS</span>
                    <hr class="flex-grow-1" />
                </div>

                <div class="accordion" id="paymentOptionsAccordion">
                    <!-- Direct UPI -->
                    <div class="accordion-item border mb-3 rounded overflow-hidden">
                        <h2 class="accordion-header" id="headingUPI">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseUPI">
                                <i class="bi bi-qr-code text-primary fs-5 me-2"></i> Instant UPI (Direct Demo Pay)
                            </button>
                        </h2>
                        <div id="collapseUPI" class="accordion-collapse collapse" data-bs-parent="#paymentOptionsAccordion">
                            <div class="accordion-body">
                                <p class="text-muted small">Instant test payment simulator for sandbox environments.</p>
                                <form asp-action="ProcessPayment" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookingId" value="@Model.BookingID" />
                                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                                    <input type="hidden" name="paymentMethod" value="UPI" />
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Enter UPI VPA ID</label>
                                        <div class="input-group">
                                            <input type="text" class="form-control" placeholder="yourname@okhdfcbank" value="guest@okhdfc" required />
                                            <button type="submit" class="btn btn-warning fw-bold px-4">
                                                Pay ₹@Model.Amount.ToString("N0") via Demo UPI
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Direct Card -->
                    <div class="accordion-item border mb-3 rounded overflow-hidden">
                        <h2 class="accordion-header" id="headingCard">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCard">
                                <i class="bi bi-credit-card-2-front text-success fs-5 me-2"></i> Credit or Debit Card (Direct Demo Pay)
                            </button>
                        </h2>
                        <div id="collapseCard" class="accordion-collapse collapse" data-bs-parent="#paymentOptionsAccordion">
                            <div class="accordion-body">
                                <form asp-action="ProcessPayment" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookingId" value="@Model.BookingID" />
                                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                                    <input type="hidden" name="paymentMethod" value="Card" />
                                    <div class="row g-3">
                                        <div class="col-12">
                                            <label class="form-label small fw-semibold">Card Number</label>
                                            <input type="text" class="form-control" placeholder="4111 2222 3333 4444" value="4111 2222 3333 4444" required />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small fw-semibold">Expiry Date</label>
                                            <input type="text" class="form-control" placeholder="MM/YY" value="12/28" required />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small fw-semibold">CVV</label>
                                            <input type="password" class="form-control" placeholder="•••" maxlength="3" value="123" required />
                                        </div>
                                        <div class="col-12 mt-3">
                                            <button type="submit" class="btn btn-success fw-bold w-100 py-2">
                                                Pay ₹@Model.Amount.ToString("N0") via Demo Card
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Direct NetBanking -->
                    <div class="accordion-item border rounded overflow-hidden">
                        <h2 class="accordion-header" id="headingNetBanking">
                            <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNetBanking">
                                <i class="bi bi-bank text-info fs-5 me-2"></i> Net Banking (Direct Demo Pay)
                            </button>
                        </h2>
                        <div id="collapseNetBanking" class="accordion-collapse collapse" data-bs-parent="#paymentOptionsAccordion">
                            <div class="accordion-body">
                                <form asp-action="ProcessPayment" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookingId" value="@Model.BookingID" />
                                    <input type="hidden" name="orderId" value="@Model.OrderId" />
                                    <input type="hidden" name="paymentMethod" value="NetBanking" />
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">Select Bank</label>
                                        <select class="form-select">
                                            <option>HDFC Bank</option>
                                            <option>State Bank of India (SBI)</option>
                                            <option>ICICI Bank</option>
                                            <option>Axis Bank</option>
                                            <option>Kotak Mahindra Bank</option>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-primary fw-bold w-100 py-2">
                                        Proceed to Demo Bank &amp; Pay ₹@Model.Amount.ToString("N0")
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <form asp-action="CancelBooking" method="post" class="d-inline" onsubmit="return confirm('Do you want to cancel this booking reservation?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookingId" value="@Model.BookingID" />
                        <button type="submit" class="btn btn-link text-danger text-decoration-none small">
                            <i class="bi bi-x-circle"></i> Cancel Reservation &amp; Return
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Razorpay Checkout Integration Script -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var btnPay = document.getElementById("btnRazorpayPay");
        if (!btnPay) return;

        btnPay.addEventListener("click", function (e) {
            e.preventDefault();

            var razorpayKey = "@Model.KeyId";
            var isDemo = razorpayKey.indexOf("demo") !== -1;

            if (isDemo || typeof Razorpay === "undefined") {
                // If using local demo simulated keys, trigger simulated verification seamlessly
                var simPaymentId = "pay_sim_" + Math.random().toString(36).substring(2, 12);
                document.getElementById("rzp_order_id").value = "@Model.OrderId";
                document.getElementById("rzp_payment_id").value = simPaymentId;
                document.getElementById("rzp_signature").value = "sim_sig_" + Math.random().toString(36).substring(2, 12);
                document.getElementById("razorpaySuccessForm").submit();
                return;
            }

            var options = {
                "key": razorpayKey,
                "amount": Math.round(@Model.Amount * 100),
                "currency": "@Model.Currency",
                "name": "BookMyFun",
                "description": "Booking #@Model.BookingID - @Model.PropertyTitle",
                "order_id": "@Model.OrderId",
                "handler": function (response) {
                    document.getElementById("rzp_order_id").value = response.razorpay_order_id || "@Model.OrderId";
                    document.getElementById("rzp_payment_id").value = response.razorpay_payment_id;
                    document.getElementById("rzp_signature").value = response.razorpay_signature;
                    document.getElementById("razorpaySuccessForm").submit();
                },
                "prefill": {
                    "name": "@Model.ClientName",
                    "email": "@Model.ClientEmail",
                    "contact": "@(Model.ClientPhone ?? "")"
                },
                "theme": {
                    "color": "#059669"
                },
                "modal": {
                    "ondismiss": function() {
                        console.log("Razorpay checkout modal dismissed by user.");
                    }
                }
            };

            try {
                var rzp = new Razorpay(options);
                rzp.on('payment.failed', function (response) {
                    alert("Payment Failed: " + response.error.description);
                });
                rzp.open();
            } catch (err) {
                console.error("Razorpay open error:", err);
                // Fallback to simulated payment form
                document.getElementById("rzp_order_id").value = "@Model.OrderId";
                document.getElementById("rzp_payment_id").value = "pay_sim_" + Date.now();
                document.getElementById("rzp_signature").value = "sim_fallback";
                document.getElementById("razorpaySuccessForm").submit();
            }
        });
    });
</script>
