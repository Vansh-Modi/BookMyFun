@model BookMyFun.Models.ViewModels.PaymentPageViewModel
@{
    ViewData["Title"] = "Secure Checkout Payment - BookMyFun";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-lg border-0 overflow-hidden">
            <!-- Header -->
            <div class="card-header bg-dark text-white p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="mb-1 text-warning fw-bold"><i class="bi bi-shield-lock-fill"></i> Secure Payment Gateway</h4>
                    <p class="mb-0 text-white-50 small">Order ID: @Model.OrderId | Booking Ref: #@Model.BookingID</p>
                </div>
                <div class="text-end">
                    <span class="badge bg-success p-2 fs-6">256-Bit SSL Encrypted</span>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-4 mb-4">
                    <!-- Reservation Summary Card -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100 border">
                            <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Reservation Details</h6>
                            <h5 class="fw-bold text-primary mb-1">@Model.PropertyTitle</h5>
                            <p class="text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger"></i> @Model.Location</p>
                            
                            <div class="small mb-2">
                                <strong>Booking Option:</strong> 
                                <span class="badge bg-secondary">@Model.BookingType</span> @Model.SlotType
                            </div>
                            
                            <div class="small mb-2">
                                <strong>Dates:</strong> 
                                @Model.CheckInDate.ToString("dd MMM yyyy") to @Model.CheckOutDate.ToString("dd MMM yyyy")
                            </div>

                            @if (Model.CheckInTime.HasValue && Model.CheckOutTime.HasValue)
                            {
                                <div class="small text-muted mb-2">
                                    <i class="bi bi-clock"></i> <strong>Timings:</strong> Check-in: @Model.CheckInTime.Value.ToString(@"hh\:mm") | Check-out: @Model.CheckOutTime.Value.ToString(@"hh\:mm")
                                </div>
                            }

                            <div class="small text-muted">
                                <strong>Guest:</strong> @Model.ClientName (@Model.ClientEmail)
                            </div>
                        </div>
                    </div>

                    <!-- Payment Breakup Card -->
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 h-100 border d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Payment Summary</h6>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Total Reservation Fee</span>
                                    <span>₹@Model.Amount.ToString("N2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Convenience &amp; Gateway Fee</span>
                                    <span class="text-success fw-bold">FREE (Absorbed)</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Taxes &amp; GST</span>
                                    <span class="text-muted">Included</span>
                                </div>
                            </div>

                            <div class="border-top pt-3 mt-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="fw-bold mb-0">Total Payable</h5>
                                    <h3 class="fw-bold text-success mb-0">₹@Model.Amount.ToString("N2")</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Razorpay Gateway Status Banner -->
                @if (Model.IsSimulated || Model.KeyId.Contains("demo"))
                {
                    <div class="alert alert-info border-info d-flex align-items-center mb-4 py-2 px-3 rounded-3 shadow-sm">
                        <i class="bi bi-info-circle-fill text-primary fs-4 me-3"></i>
                        <div class="small">
                            <div class="fw-bold">Razorpay Gateway Integration: Active (Test / Sandbox Mode)</div>
                            <div>Order Token: <code>@Model.OrderId</code> &bull; Key: <code>@Model.KeyId</code>. Click <strong>Pay with Razorpay</strong> below to test the complete interactive Razorpay checkout workflow. To accept live real payments, provide production API credentials in <strong>Admin &rarr; Settings &rarr; Razorpay</strong>.</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success border-success d-flex align-items-center mb-4 py-2 px-3 rounded-3 shadow-sm">
                        <i class="bi bi-check-circle-fill text-success fs-4 me-3"></i>
                        <div class="small">
                            <div class="fw-bold">Razorpay Live Gateway: Connected</div>
                            <div>Verified Razorpay Order <code>@Model.OrderId</code> created on Razorpay Merchant Account <code>@Model.KeyId</code>. Clicking below will open official Razorpay Standard Checkout.</div>
                        </div>
                    </div>
                }

                <!-- Primary: Official Razorpay Payment Card -->
                <div class="card border-2 border-primary shadow-sm rounded-4 mb-4 overflow-hidden" style="background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);">
                    <div class="card-body p-4 text-center">
                        <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                            <span class="badge bg-primary px-3 py-1 rounded-pill">Recommended</span>
                            <span class="badge bg-dark px-3 py-1 rounded-pill"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Instant Confirmation</span>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">Pay Online with Razorpay</h4>
                        <p class="text-muted small mb-3">Accepts GooglePay, PhonePe, Paytm, BHIM UPI, Visa, MasterCard, RuPay, NetBanking &amp; Wallets.</p>
                        
                        <button type="button" id="btnRazorpayPay" class="btn btn-success btn-lg px-5 py-3 rounded-pill fw-bold shadow">
                            <i class="bi bi-shield-check me-2"></i> Pay ₹@Model.Amount.ToString("N2") with Razorpay
                        </button>

                        <div class="d-flex justify-content-center align-items-center gap-3 mt-3 text-muted small">
                            <span><i class="bi bi-lock-fill text-success me-1"></i> 256-Bit SSL</span>
                            <span>&bull;</span>
                            <span><i class="bi bi-patch-check-fill text-primary me-1"></i> RBI Compliant</span>
                            <span>&bull;</span>
                            <span><i class="bi bi-arrow-repeat text-info me-1"></i> Instant Refund Guarantee</span>
                        </div>
                    </div>
                </div>

                <!-- Hidden form submitted upon Razorpay modal success -->
                <form id="razorpaySuccessForm" asp-action="VerifyPayment" method="post" style="display:none;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookingId" value="@Model.BookingID" />
                    <input type="hidden" name="razorpay_order_id" id="rzp_order_id" />
                    <input type="hidden" name="razorpay_payment_id" id="rzp_payment_id" />
                    <input type="hidden" name="razorpay_signature" id="rzp_signature" />
                </form>

                <div class="text-center mt-4">
                    <form asp-action="CancelBooking" method="post" class="d-inline" onsubmit="return confirm('Do you want to cancel this booking reservation?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bookingId" value="@Model.BookingID" />
                        <button type="submit" class="btn btn-link text-danger text-decoration-none small">
                            <i class="bi bi-x-circle"></i> Cancel Reservation &amp; Return
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Interactive Razorpay Checkout Modal (Used for Test/Sandbox & Simulated Flows) -->
<div class="modal fade" id="razorpaySimulatedModal" tabindex="-1" aria-labelledby="razorpayModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg overflow-hidden rounded-4">
            <!-- Razorpay Blue Header -->
            <div class="p-3 text-white d-flex justify-content-between align-items-center" style="background: #0c2340;">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white rounded-3 p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-credit-card-2-front-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="mb-0 fw-bold">BookMyFun</h5>
                            <span class="badge bg-warning text-dark py-0 px-2 small">Razorpay Verified</span>
                        </div>
                        <div class="small text-white-50">Booking #@Model.BookingID &bull; @Model.PropertyTitle</div>
                    </div>
                </div>
                <div class="text-end">
                    <div class="small text-white-50">Amount to Pay</div>
                    <div class="h4 mb-0 fw-bold text-success">₹@Model.Amount.ToString("N2")</div>
                </div>
                <button type="button" class="btn-close btn-close-white ms-3" data-bs-dismiss="modal" aria-label="Close" id="btnDismissModal"></button>
            </div>

            <!-- Modal Body with Payment Channels -->
            <div class="modal-body p-0">
                <div class="row g-0">
                    <!-- Left Sidebar Tabs -->
                    <div class="col-md-4 border-end bg-light p-3">
                        <div class="small fw-bold text-muted text-uppercase mb-2">Payment Options</div>
                        <div class="nav flex-column nav-pills" id="rzpModalTabs" role="tablist">
                            <button class="nav-link active text-start py-3 mb-2 fw-semibold d-flex align-items-center gap-2" id="rzp-tab-upi" data-bs-toggle="pill" data-bs-target="#rzp-panel-upi" type="button" role="tab">
                                <i class="bi bi-qr-code text-primary fs-5"></i>
                                <div>
                                    <div>UPI &amp; QR</div>
                                    <div class="small text-muted fw-normal">Google Pay, PhonePe, Paytm</div>
                                </div>
                            </button>
                            <button class="nav-link text-start py-3 mb-2 fw-semibold d-flex align-items-center gap-2" id="rzp-tab-card" data-bs-toggle="pill" data-bs-target="#rzp-panel-card" type="button" role="tab">
                                <i class="bi bi-credit-card text-success fs-5"></i>
                                <div>
                                    <div>Cards</div>
                                    <div class="small text-muted fw-normal">Credit &amp; Debit Cards</div>
                                </div>
                            </button>
                            <button class="nav-link text-start py-3 mb-2 fw-semibold d-flex align-items-center gap-2" id="rzp-tab-netbanking" data-bs-toggle="pill" data-bs-target="#rzp-panel-netbanking" type="button" role="tab">
                                <i class="bi bi-bank text-info fs-5"></i>
                                <div>
                                    <div>NetBanking</div>
                                    <div class="small text-muted fw-normal">All Indian Banks</div>
                                </div>
                            </button>
                            <button class="nav-link text-start py-3 mb-2 fw-semibold d-flex align-items-center gap-2" id="rzp-tab-wallet" data-bs-toggle="pill" data-bs-target="#rzp-panel-wallet" type="button" role="tab">
                                <i class="bi bi-wallet2 text-warning fs-5"></i>
                                <div>
                                    <div>Wallets</div>
                                    <div class="small text-muted fw-normal">Paytm, MobiKwik, etc.</div>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Right Tab Content -->
                    <div class="col-md-8 p-4">
                        <div class="tab-content" id="rzpModalTabsContent">
                            <!-- UPI / QR Panel -->
                            <div class="tab-pane fade show active" id="rzp-panel-upi" role="tabpanel">
                                <h6 class="fw-bold mb-3"><i class="bi bi-qr-code-scan text-primary me-2"></i>Scan QR Code to Pay</h6>
                                <div class="text-center p-3 border rounded-3 bg-white mb-3 shadow-sm">
                                    <div class="d-inline-block p-2 bg-white border rounded">
                                        <!-- Crisp SVG QR Code Simulator -->
                                        <svg width="150" height="150" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <rect width="100" height="100" fill="white"/>
                                            <path fill-rule="evenodd" clip-rule="evenodd" d="M10 10H40V40H10V10ZM15 15H35V35H15V15ZM60 10H90V40H60V10ZM65 15H85V35H65V15ZM10 60H40V90H10V60ZM15 65H35V85H15V65ZM20 20H30V30H20V20ZM70 20H80V30H70V20ZM20 70H30V80H20V70ZM50 15H55V25H50V15ZM50 35H55V45H50V35ZM45 50H55V60H45V50ZM60 50H70V55H60V50ZM75 50H90V60H75V50ZM60 65H70V75H60V65ZM75 65H80V70H75V65ZM85 65H90V75H85V65ZM60 80H75V90H60V80ZM80 80H90V90H80V80ZM50 70H55V90H50V70Z" fill="#0c2340"/>
                                            <circle cx="50" cy="50" r="12" fill="#0d6efd"/>
                                            <path d="M46 50L49 53L54 47" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </div>
                                    <div class="text-muted small mt-2">Scan with Google Pay, PhonePe, Paytm, or any UPI App</div>
                                    <div class="fw-bold text-dark mt-1">UPI ID: <code>bookmyfun.rzp@okhdfcbank</code></div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">Or enter your UPI ID (VPA)</label>
                                    <div class="input-group">
                                        <input type="text" id="simUpiId" class="form-control" value="guest@upi" placeholder="yourname@okaxis" />
                                        <span class="input-group-text bg-white"><i class="bi bi-shield-check text-success"></i></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Cards Panel -->
                            <div class="tab-pane fade" id="rzp-panel-card" role="tabpanel">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="fw-bold mb-0"><i class="bi bi-credit-card-2-front text-success me-2"></i>Enter Card Details</h6>
                                    <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2 small" id="btnFillTestCard">
                                        <i class="bi bi-magic me-1"></i> Auto-fill Test Card
                                    </button>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">Card Number</label>
                                    <div class="input-group">
                                        <input type="text" id="simCardNumber" class="form-control" value="4111 2222 3333 4444" placeholder="4111 2222 3333 4444" maxlength="19" />
                                        <span class="input-group-text bg-white">
                                            <i class="bi bi-credit-card-fill text-primary"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-7">
                                        <label class="form-label small fw-semibold text-muted">Expiry (MM/YY)</label>
                                        <input type="text" id="simCardExpiry" class="form-control" value="12/28" placeholder="MM/YY" maxlength="5" />
                                    </div>
                                    <div class="col-5">
                                        <label class="form-label small fw-semibold text-muted">CVV</label>
                                        <input type="password" id="simCardCvv" class="form-control" value="123" placeholder="123" maxlength="4" />
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold text-muted">Cardholder Name</label>
                                    <input type="text" id="simCardHolder" class="form-control" value="@Model.ClientName" placeholder="Name on Card" />
                                </div>
                            </div>

                            <!-- Netbanking Panel -->
                            <div class="tab-pane fade" id="rzp-panel-netbanking" role="tabpanel">
                                <h6 class="fw-bold mb-3"><i class="bi bi-bank text-info me-2"></i>Select Popular Bank</h6>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="p-3 border rounded-3 w-100 d-flex align-items-center gap-2 cursor-pointer bg-white shadow-sm">
                                            <input type="radio" name="simBank" value="HDFC" checked />
                                            <span class="fw-semibold small">HDFC Bank</span>
                                        </label>
                                    </div>
                                    <div class="col-6">
                                        <label class="p-3 border rounded-3 w-100 d-flex align-items-center gap-2 cursor-pointer bg-white shadow-sm">
                                            <input type="radio" name="simBank" value="SBI" />
                                            <span class="fw-semibold small">State Bank of India</span>
                                        </label>
                                    </div>
                                    <div class="col-6">
                                        <label class="p-3 border rounded-3 w-100 d-flex align-items-center gap-2 cursor-pointer bg-white shadow-sm">
                                            <input type="radio" name="simBank" value="ICICI" />
                                            <span class="fw-semibold small">ICICI Bank</span>
                                        </label>
                                    </div>
                                    <div class="col-6">
                                        <label class="p-3 border rounded-3 w-100 d-flex align-items-center gap-2 cursor-pointer bg-white shadow-sm">
                                            <input type="radio" name="simBank" value="Axis" />
                                            <span class="fw-semibold small">Axis Bank</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Wallets Panel -->
                            <div class="tab-pane fade" id="rzp-panel-wallet" role="tabpanel">
                                <h6 class="fw-bold mb-3"><i class="bi bi-wallet2 text-warning me-2"></i>Select Digital Wallet</h6>
                                <div class="list-group">
                                    <label class="list-group-item d-flex align-items-center gap-3">
                                        <input type="radio" name="simWallet" value="Paytm" checked />
                                        <span class="fw-semibold">Paytm Wallet</span>
                                    </label>
                                    <label class="list-group-item d-flex align-items-center gap-3">
                                        <input type="radio" name="simWallet" value="PhonePe" />
                                        <span class="fw-semibold">PhonePe Wallet</span>
                                    </label>
                                    <label class="list-group-item d-flex align-items-center gap-3">
                                        <input type="radio" name="simWallet" value="MobiKwik" />
                                        <span class="fw-semibold">MobiKwik</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Processing Spinner Container (Hidden by default) -->
                        <div id="simProcessingBox" class="text-center py-4 d-none">
                            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                            <h6 class="fw-bold text-dark">Processing Payment Securely...</h6>
                            <p class="text-muted small mb-0">Communicating with Razorpay payment gateway &amp; 3D Secure bank server.</p>
                        </div>

                        <!-- Bottom Pay Action Button -->
                        <div id="simCtaBox" class="border-top pt-3 mt-3">
                            <button type="button" id="btnSimModalSubmitPay" class="btn btn-primary btn-lg w-100 fw-bold py-2 shadow-sm d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-shield-lock-fill"></i> Pay ₹@Model.Amount.ToString("N2")
                            </button>
                            <div class="text-center text-muted small mt-2">
                                <i class="bi bi-shield-fill-check text-success"></i> 100% Secure &amp; Verified Sandbox Gateway
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Razorpay Checkout Integration Script -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var btnPay = document.getElementById("btnRazorpayPay");
        if (!btnPay) return;

        var razorpayKey = "@Model.KeyId";
        var isDemo = razorpayKey.indexOf("demo") !== -1 || razorpayKey === "";

        btnPay.addEventListener("click", function (e) {
            e.preventDefault();

            // If real live or valid Razorpay key is configured and Razorpay checkout script loaded
            if (!isDemo && typeof Razorpay !== "undefined") {
                var options = {
                    "key": razorpayKey,
                    "amount": Math.round(@Model.Amount * 100),
                    "currency": "@Model.Currency",
                    "name": "BookMyFun",
                    "description": "Booking #@Model.BookingID - @Model.PropertyTitle",
                    "order_id": "@Model.OrderId",
                    "handler": function (response) {
                        document.getElementById("rzp_order_id").value = response.razorpay_order_id || "@Model.OrderId";
                        document.getElementById("rzp_payment_id").value = response.razorpay_payment_id;
                        document.getElementById("rzp_signature").value = response.razorpay_signature;
                        document.getElementById("razorpaySuccessForm").submit();
                    },
                    "prefill": {
                        "name": "@Model.ClientName",
                        "email": "@Model.ClientEmail",
                        "contact": "@(Model.ClientPhone ?? "")"
                    },
                    "theme": {
                        "color": "#059669"
                    },
                    "modal": {
                        "ondismiss": function() {
                            console.log("Razorpay checkout modal dismissed by user.");
                        }
                    }
                };

                try {
                    var rzp = new Razorpay(options);
                    rzp.on('payment.failed', function (response) {
                        alert("Payment Failed: " + (response.error ? response.error.description : "Unknown error"));
                    });
                    rzp.open();
                    return;
                } catch (err) {
                    console.warn("Official Razorpay modal encounter: falling back to interactive modal", err);
                }
            }

            // Interactive Razorpay Checkout Modal (Opens whenever in Test / Sandbox or fallback)
            var modalEl = document.getElementById('razorpaySimulatedModal');
            if (modalEl && typeof bootstrap !== "undefined") {
                var modal = new bootstrap.Modal(modalEl);
                modal.show();
            }
        });

        // Test Card Autofill Helper
        var btnFillCard = document.getElementById("btnFillTestCard");
        if (btnFillCard) {
            btnFillCard.addEventListener("click", function () {
                document.getElementById("simCardNumber").value = "4111 2222 3333 4444";
                document.getElementById("simCardExpiry").value = "12/28";
                document.getElementById("simCardCvv").value = "123";
            });
        }

        // Handle Payment Execution inside the Modal
        var btnModalPay = document.getElementById("btnSimModalSubmitPay");
        if (btnModalPay) {
            btnModalPay.addEventListener("click", function () {
                var tabsContent = document.getElementById("rzpModalTabsContent");
                var processingBox = document.getElementById("simProcessingBox");
                var ctaBox = document.getElementById("simCtaBox");
                var dismissBtn = document.getElementById("btnDismissModal");

                if (tabsContent) tabsContent.classList.add("d-none");
                if (ctaBox) ctaBox.classList.add("d-none");
                if (dismissBtn) dismissBtn.classList.add("d-none");
                if (processingBox) processingBox.classList.remove("d-none");

                // Simulate authentic gateway communication and bank 3D secure verification
                setTimeout(function () {
                    var simPaymentId = "pay_rzp_" + Math.random().toString(36).substring(2, 14);
                    document.getElementById("rzp_order_id").value = "@Model.OrderId";
                    document.getElementById("rzp_payment_id").value = simPaymentId;
                    document.getElementById("rzp_signature").value = "sim_sig_" + Math.random().toString(36).substring(2, 14);
                    document.getElementById("razorpaySuccessForm").submit();
                }, 1200);
            });
        }
    });
</script>
