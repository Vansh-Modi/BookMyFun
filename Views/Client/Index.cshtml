@model BookMyFun.Models.ViewModels.ClientDashboardViewModel
@{
    ViewData["Title"] = "My Reservations & Stays";
    var verification = ViewBag.Verification as BookMyFun.Models.Entities.ClientIdVerification;
    var todayInIst = ViewBag.TodayInIst != null ? (DateTime)ViewBag.TodayInIst : DateTime.Today;
    var refundMap = ViewBag.RefundMap as Dictionary<int, BookMyFun.Models.Entities.BookingRefund> ?? new Dictionary<int, BookMyFun.Models.Entities.BookingRefund>();
}

<style>
    /* Scoped Client Dashboard Styles (Section 8) */
    .client-hub-wrap {
        font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .client-booking-card {
        background: var(--bg-card, #ffffff);
        border: 1px solid var(--border-subtle, #e2e8f0) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .client-booking-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08) !important;
    }

    .booking-card-inner {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .booking-card-img-wrap {
        width: 100%;
        height: 180px;
        position: relative;
        overflow: hidden;
        background: #f1f5f9;
    }

    .booking-card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .client-booking-card:hover .booking-card-img {
        transform: scale(1.04);
    }

    .booking-status-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 20px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }

    .badge-status-confirmed {
        background: #10b981;
        color: #ffffff;
    }

    .badge-status-cancelled dash-badge-danger {
        background: #ef4444;
        color: #ffffff;
    }

    .badge-status-pending {
        background: #f59e0b;
        color: #ffffff;
    }

    .badge-status-completed {
        background: #0B4F6C;
        color: #ffffff;
    }

    .booking-card-content {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 0;
    }

    /* Tablet & Desktop Horizontal Card Layout (Section 8B) */
    @@media (min-width: 576px) {
        .booking-card-inner {
            flex-direction: row;
        }

        .booking-card-img-wrap {
            width: 140px;
            min-width: 140px;
            height: auto;
        }
    }

    [data-theme="dark"] .client-booking-card {
        background: #1e293b;
        border-color: #334155 !important;
    }

    [data-theme="dark"] .booking-dates-box {
        background: #0f172a !important;
        border-color: #334155 !important;
    }

    [data-theme="dark"] .client-booking-card:hover {
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4) !important;
    }
</style>

<div class="container py-4 client-hub-wrap">
    <!-- Hub Header Banner (Full width main layout) (Section 8A) -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 small">
                    <i class="bi bi-person-circle me-1"></i>Traveler Hub
                </span>
                @if (verification != null && verification.VerificationStatus == "Verified")
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 small">
                        <i class="bi bi-patch-check-fill me-1"></i>KYC Verified Guest
                    </span>
                }
            </div>
            <h1 class="h3 fw-bold text-dark mb-1">My Reservations &amp; Stays</h1>
            <p class="text-muted small mb-0">Welcome back, <strong>@Model.Client.FullName</strong> · View upcoming trips, download tax receipts, and leave host reviews.</p>
        </div>
        <div>
            <a asp-controller="Properties" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-xs">
                <i class="bi bi-compass me-1"></i> Book a New Stay
            </a>
        </div>
    </div>

    <!-- Empty State -->
    @if (!Model.Bookings.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 text-center py-5 px-3 mb-4">
            <div class="py-5">
                <i class="bi bi-calendar-x fs-1 text-muted opacity-50 mb-3 d-block"></i>
                <h4 class="fw-bold text-dark mb-2">No Reservations Found</h4>
                <p class="text-muted small mb-4" style="max-width: 420px; margin: 0 auto;">
                    You haven't booked any farm stays yet. Discover handcrafted countryside villas with private pools and scenic views.
                </p>
                <a asp-controller="Properties" asp-action="Index" class="btn btn-warning rounded-pill px-4 py-2 fw-bold shadow-sm">
                    <i class="bi bi-search me-1"></i> Explore Available Stays
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Responsive Card Grid: 1 col mobile, 2 cols tablet, 3 cols desktop (Section 8B) -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4 mb-4">
            @foreach (var b in Model.Bookings)
            {
                var isConfirmed = b.Status == "Confirmed";
                var isCancelled = b.Status == "Cancelled";
                var isPending = b.Status == "Pending";
                var isCheckInTodayOrPast = b.CheckInDate.Date <= todayInIst;
                var hasRefund = refundMap.ContainsKey(b.BookingID);

                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden client-booking-card">
                        <div class="booking-card-inner">
                            <!-- Thumbnail Image (Left on desktop/tablet, Top on mobile) -->
                            <div class="booking-card-img-wrap">
                                <img src="@(string.IsNullOrEmpty(b.PropertyImageUrl) ? "/images/placeholder.jpg" : b.PropertyImageUrl)"
                                     class="booking-card-img"
                                     alt="@b.PropertyTitle"
                                     onerror="this.src='/images/placeholder.jpg';" />
                                <span class="booking-status-badge @(isConfirmed ? "badge-status-confirmed" : isCancelled ? "badge-status-cancelled" : isPending ? "badge-status-pending" : "badge-status-completed")">
                                    @b.Status
                                </span>
                            </div>

                            <!-- Content Details -->
                            <div class="booking-card-content">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.72rem;">#@b.BookingID</span>
                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill small" style="font-size: 0.72rem;">@b.BookingType</span>
                                </div>

                                <h5 class="fw-bold mb-1 text-truncate" title="@b.PropertyTitle">
                                    <a asp-controller="Properties" asp-action="Details" asp-route-id="@b.PropertyID" class="text-decoration-none text-dark">
                                        @b.PropertyTitle
                                    </a>
                                </h5>
                                <p class="text-muted small text-truncate mb-2" style="font-size: 0.8rem;">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>@(string.IsNullOrEmpty(b.PropertyLocation) ? "Verified Farm Stay" : b.PropertyLocation)
                                </p>

                                <!-- Stay Dates & Slot -->
                                <div class="booking-dates-box p-2 rounded-3 bg-light border mb-3">
                                    <div class="d-flex align-items-center gap-1.5 small text-dark fw-semibold">
                                        <i class="bi bi-calendar3 text-primary"></i>
                                        <span>@b.CheckInDate.ToString("dd MMM yyyy") &ndash; @b.CheckOutDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(b.SlotType))
                                    {
                                        <div class="small text-muted mt-0.5" style="font-size: 0.73rem;">
                                            <i class="bi bi-clock me-1"></i>@b.SlotType
                                        </div>
                                    }
                                </div>

                                <div class="mt-auto">
                                    <div class="d-flex justify-content-between align-items-baseline mb-3">
                                        <span class="text-muted small">Total Paid:</span>
                                        <strong class="text-success fs-5 fw-bold">₹@b.TotalAmount.ToString("N0")</strong>
                                    </div>

                                    <!-- Actions Row (Sections 8C & 8D) -->
                                    <div class="d-flex flex-wrap gap-1.5 align-items-center">
                                        @if (isConfirmed)
                                        {
                                            <!-- Receipt button (Section 8D) -->
                                            <a asp-controller="Booking" asp-action="Receipt" asp-route-id="@b.BookingID" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1" style="font-size: 0.78rem;" title="Official Tax Receipt">
                                                <i class="bi bi-file-earmark-text me-1"></i>Receipt
                                            </a>

                                            <!-- Cancellation logic (Section 8C) -->
                                            @if (isCheckInTodayOrPast)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border px-2.5 py-1.5 rounded-pill small" style="font-size: 0.75rem;" title="Cancellation closed because check-in is today or past in Indian Standard Time">
                                                    <i class="bi bi-lock-fill me-1"></i>Cancellation closed
                                                </span>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" style="font-size: 0.78rem;" onclick="openCancelModal(@b.BookingID)">
                                                    <i class="bi bi-x-circle me-1"></i>Cancel
                                                </button>
                                            }

                                            <!-- Review Button -->
                                            <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-2 py-1" style="font-size: 0.78rem;" data-bs-toggle="modal" data-bs-target="#reviewModal_@b.BookingID">
                                                <i class="bi bi-star me-1"></i>Review
                                            </button>
                                        }
                                        else if (isCancelled)
                                        {
                                            <!-- Cancelled booking receipt rules (Section 8D) -->
                                            @if (hasRefund)
                                            {
                                                <a asp-controller="Booking" asp-action="Receipt" asp-route-id="@b.BookingID" target="_blank" class="btn btn-sm btn-outline-info rounded-pill px-2.5 py-1" style="font-size: 0.78rem;" title="Refund Receipt & Credit Voucher">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>Refund receipt
                                                </a>
                                            }
                                            @* Cancelled without a refund: NO receipt button rendered! (Section 8D) *@

                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 py-1" style="font-size: 0.78rem;" onclick="viewPaymentDetails(@b.BookingID)" title="View Payment & Refund Audit">
                                                <i class="bi bi-clock-history me-1"></i>Audit
                                            </button>
                                        }
                                        else if (isPending)
                                        {
                                            <a asp-controller="Booking" asp-action="Payment" asp-route-id="@b.BookingID" class="btn btn-sm btn-warning rounded-pill px-3 py-1 fw-bold" style="font-size: 0.78rem;">
                                                <i class="bi bi-credit-card me-1"></i>Pay Now
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" style="font-size: 0.78rem;" onclick="openCancelModal(@b.BookingID)">
                                                Cancel
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Review Modal for each booking -->
                        <div class="modal fade" id="reviewModal_@b.BookingID" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <form asp-action="AddReview" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="bookingId" value="@b.BookingID" />
                                        <input type="hidden" name="propertyId" value="@b.PropertyID" />
                                        <div class="modal-header border-0 pb-0">
                                            <h5 class="modal-title fw-bold">Review Your Stay</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body p-4">
                                            <p class="text-muted small mb-3">Share your feedback for <strong>@b.PropertyTitle</strong>.</p>
                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold">Rating (1 to 5 Stars)</label>
                                                <select name="rating" class="form-select">
                                                    <option value="5">⭐⭐⭐⭐⭐ 5 - Exceptional stay</option>
                                                    <option value="4">⭐⭐⭐⭐ 4 - Very Good</option>
                                                    <option value="3">⭐⭐⭐ 3 - Average</option>
                                                    <option value="2">⭐⭐ 2 - Needs improvement</option>
                                                    <option value="1">⭐ 1 - Poor experience</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold">Feedback Comments</label>
                                                <textarea name="comment" class="form-control" rows="3" placeholder="Tell other travelers what you enjoyed about the property, host, or amenities..."></textarea>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0 pt-0">
                                            <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                                            <button type="submit" class="btn btn-warning rounded-pill px-4 fw-bold">Submit Review</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Transparent Cancellation & Refund Modal -->
<div class="modal fade" id="cancellationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-light border-0 py-3">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="bi bi-shield-slash text-danger me-2"></i>Cancel Reservation &amp; Refund Quote
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="cancelModalLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="small text-muted mt-2">Computing real-time refund quote per host policy...</p>
                </div>

                <div id="cancelModalContent" style="display: none;">
                    <div class="alert alert-info border-0 rounded-3 mb-3 p-3">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-info-circle-fill fs-4 me-3 text-primary"></i>
                            <div>
                                <strong id="quotePolicyTier" class="d-block mb-1"></strong>
                                <span id="quotePolicyExplanation" class="small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="card border rounded-3 p-3 mb-3 bg-light">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Total Booking Paid</span>
                            <strong id="quoteGrossAmount">₹0.00</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-danger">
                            <span>Cancellation Policy Fee</span>
                            <span id="quoteCancellationFee">- ₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-danger">
                            <span>Payment Gateway Processing</span>
                            <span id="quoteGatewayFee">- ₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2 text-muted small">
                            <span>Expected Refund Timeline:</span>
                            <span id="quoteTimeline" class="fw-semibold text-dark">5 to 7 business days</span>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between fs-5 fw-bold">
                            <span>Net Estimated Refund:</span>
                            <span id="quoteNetRefund" class="text-success">₹0.00</span>
                        </div>
                    </div>

                    <form id="cancelBookingForm" asp-controller="Booking" asp-action="CancelBooking" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="cancelBookingIdInput" name="bookingId" value="" />

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Reason for Cancellation (Optional)</label>
                            <textarea name="reason" class="form-control" rows="2" placeholder="Tell us why you are cancelling..."></textarea>
                        </div>

                        <div class="d-flex gap-2 justify-content-end">
                            <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Keep Booking</button>
                            <button type="submit" class="btn btn-danger rounded-pill fw-bold px-4">
                                <i class="bi bi-x-circle me-1"></i>Confirm Cancellation
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Payment & Refund Transparency Modal -->
<div class="modal fade" id="paymentDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-shield-check text-warning me-2"></i>Payment &amp; Refund Transparency
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="paymentModalLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="small text-muted mt-2">Fetching gateway transaction logs...</p>
                </div>

                <div id="paymentModalContent" style="display: none;">
                    <div class="mb-3 pb-2 border-bottom">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h6 class="fw-bold mb-0 text-dark" id="pdBookingRef"></h6>
                            <span class="badge bg-secondary" id="pdBookingStatus"></span>
                        </div>
                        <small class="text-muted" id="pdBookingDates"></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-uppercase text-muted"><i class="bi bi-credit-card me-1 text-primary"></i>Gateway Transactions</label>
                        <div id="pdPaymentsList"></div>
                    </div>

                    <div id="pdRefundBox" class="card border-danger-subtle bg-danger-subtle bg-opacity-10 rounded-3 p-3 mt-3" style="display: none;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="text-danger small text-uppercase"><i class="bi bi-arrow-counterclockwise me-1"></i>Refund Audit Record</strong>
                            <span class="badge bg-danger" id="pdRefundStatus"></span>
                        </div>
                        <div class="small mb-2">
                            <span class="text-muted">Gateway Refund ID:</span>
                            <code class="text-dark fw-bold" id="pdRefundId"></code>
                        </div>
                        <div class="bg-white p-2 rounded border small mb-2">
                            <div class="d-flex justify-content-between text-muted mb-1">
                                <span>Gross Booking Total:</span>
                                <span id="pdGrossAmount"></span>
                            </div>
                            <div class="d-flex justify-content-between text-danger mb-1">
                                <span>Cancellation Policy Fee:</span>
                                <span id="pdCancelFee"></span>
                            </div>
                            <div class="d-flex justify-content-between text-danger mb-1">
                                <span>Gateway Processing Fee:</span>
                                <span id="pdGatewayFee"></span>
                            </div>
                            <div class="d-flex justify-content-between fw-bold text-success border-top pt-1 mt-1">
                                <span>Net Refund Credited:</span>
                                <span id="pdNetRefund" class="fs-6"></span>
                            </div>
                        </div>
                        <div class="small text-muted">
                            <div><strong>Reason:</strong> <span id="pdRefundReason"></span></div>
                            <div><strong>Processed:</strong> <span id="pdRefundDate"></span></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-2">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function openCancelModal(bookingId) {
        document.getElementById('cancelBookingIdInput').value = bookingId;
        document.getElementById('cancelModalLoading').style.display = 'block';
        document.getElementById('cancelModalContent').style.display = 'none';

        const modal = new bootstrap.Modal(document.getElementById('cancellationModal'));
        modal.show();

        try {
            const resp = await fetch(`/Booking/GetCancellationQuote?bookingId=${bookingId}`);
            const data = await resp.json();

            if (data.success && data.quote) {
                const q = data.quote;
                document.getElementById('quotePolicyTier').innerText = q.policyTier === 'FullRefund' ? 'Eligible for Full Refund' :
                                                                       q.policyTier === 'PartialRefund' ? 'Eligible for Partial Refund' : 'Non-Refundable Window';
                document.getElementById('quotePolicyExplanation').innerText = q.policyExplanation;
                document.getElementById('quoteGrossAmount').innerText = '₹' + (q.amountPaid || q.totalAmount).toLocaleString('en-IN', { minimumFractionDigits: 2 });
                document.getElementById('quoteCancellationFee').innerText = '- ₹' + q.cancellationFeeDeducted.toLocaleString('en-IN', { minimumFractionDigits: 2 });
                document.getElementById('quoteGatewayFee').innerText = '- ₹' + q.gatewayFeeDeducted.toLocaleString('en-IN', { minimumFractionDigits: 2 });
                if (document.getElementById('quoteTimeline')) {
                    document.getElementById('quoteTimeline').innerText = q.refundTimeline || '5 to 7 business days';
                }
                document.getElementById('quoteNetRefund').innerText = '₹' + q.netRefundAmount.toLocaleString('en-IN', { minimumFractionDigits: 2 });

                if (q.netRefundAmount <= 0) {
                    document.getElementById('quoteNetRefund').className = 'text-danger fw-bold';
                } else {
                    document.getElementById('quoteNetRefund').className = 'text-success fw-bold';
                }

                document.getElementById('cancelModalLoading').style.display = 'none';
                document.getElementById('cancelModalContent').style.display = 'block';
            } else {
                alert('Cancellation is closed: ' + (data.message || 'Cannot cancel this reservation.'));
                modal.hide();
            }
        } catch (err) {
            alert('Cancellation is closed or failed to connect to refund engine.');
            modal.hide();
        }
    }

    async function viewPaymentDetails(bookingId) {
        const modal = new bootstrap.Modal(document.getElementById('paymentDetailsModal'));
        const loading = document.getElementById('paymentModalLoading');
        const content = document.getElementById('paymentModalContent');

        loading.style.display = 'block';
        content.style.display = 'none';
        modal.show();

        try {
            const resp = await fetch(`/Booking/GetPaymentAndRefundDetails?bookingId=${bookingId}`);
            if (!resp.ok) throw new Error('Failed to load transaction details.');

            const data = await resp.json();
            if (!data.success) throw new Error(data.message || 'Unable to retrieve data');

            document.getElementById('pdBookingRef').textContent = `#${data.booking.bookingID} · ${data.booking.propertyTitle}`;
            document.getElementById('pdBookingDates').textContent = `${data.booking.checkIn} — ${data.booking.checkOut}`;
            document.getElementById('pdBookingStatus').textContent = data.booking.status;

            const payList = document.getElementById('pdPaymentsList');
            payList.innerHTML = '';
            if (data.payments && data.payments.length > 0) {
                data.payments.forEach(p => {
                    const row = document.createElement('div');
                    row.className = 'd-flex justify-content-between align-items-center p-2 mb-1 bg-white border rounded';
                    row.innerHTML = `
                        <div>
                            <span class="badge bg-success me-1">${p.paymentStatus}</span>
                            <code class="small text-dark">${p.gatewayTransactionID || 'GATEWAY_SIMULATED'}</code>
                            <div class="small text-muted">${p.paymentDate}</div>
                        </div>
                        <strong class="text-success fs-6">₹${parseFloat(p.amount).toLocaleString('en-IN', {minimumFractionDigits: 2})}</strong>
                    `;
                    payList.appendChild(row);
                });
            } else {
                payList.innerHTML = `<div class="small text-muted p-2 bg-light rounded">No payment transactions recorded yet.</div>`;
            }

            const refundBox = document.getElementById('pdRefundBox');
            if (data.refund) {
                refundBox.style.display = 'block';
                document.getElementById('pdRefundStatus').textContent = data.refund.status;
                document.getElementById('pdRefundId').textContent = data.refund.gatewayRefundID || 'PENDING_GATEWAY';
                document.getElementById('pdGrossAmount').textContent = '₹' + parseFloat(data.refund.grossBookingAmount).toLocaleString('en-IN', {minimumFractionDigits: 2});
                document.getElementById('pdCancelFee').textContent = '- ₹' + parseFloat(data.refund.cancellationFeeDeducted).toLocaleString('en-IN', {minimumFractionDigits: 2});
                document.getElementById('pdGatewayFee').textContent = '- ₹' + parseFloat(data.refund.gatewayFeeDeducted).toLocaleString('en-IN', {minimumFractionDigits: 2});
                document.getElementById('pdNetRefund').textContent = '₹' + parseFloat(data.refund.netRefundAmount).toLocaleString('en-IN', {minimumFractionDigits: 2});
                document.getElementById('pdRefundReason').textContent = data.refund.refundReason || 'User cancellation';
                document.getElementById('pdRefundDate').textContent = data.refund.processedAt || data.refund.createdAt;
            } else {
                refundBox.style.display = 'none';
            }

            loading.style.display = 'none';
            content.style.display = 'block';
        } catch (err) {
            loading.innerHTML = `<div class="text-danger small py-3"><i class="bi bi-exclamation-circle me-1"></i>${err.message || 'Error loading transaction transparency details.'}</div>`;
        }
    }
</script>
}
