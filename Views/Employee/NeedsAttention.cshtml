@model BookMyFun.Models.ViewModels.StaffQueueViewModel
@{
    ViewData["Title"] = "Needs Attention - Staff Operational Queue";
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Employee";
}

<div class="dash-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <p class="dash-eyebrow">Operations · Unified Task Queue</p>
            <h1 class="dash-title">Needs Attention</h1>
            <p class="dash-subtitle">Centralized operational queue aggregating all pending reviews across the marketplace, sorted oldest first.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">
                <i class="bi bi-inbox-fill me-1"></i> @Model.TotalPendingCount Total Pending
            </span>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-xs" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-xs" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters Bar -->
<div class="mb-4">
    <ul class="nav nav-pills gap-2 bg-light p-2 rounded-4 border flex-wrap">
        <li class="nav-item">
            <a class="nav-link rounded-pill px-3 py-2 fw-semibold @(Model.SelectedFilter == "All" ? "active bg-dark text-white" : "text-dark")"
               asp-controller="@currentCtrl" asp-action="NeedsAttention" asp-route-filter="All" asp-route-page="1">
                All Tasks
                <span class="badge rounded-pill ms-1 @(Model.SelectedFilter == "All" ? "bg-light text-dark" : "bg-secondary text-white")">@Model.TotalPendingCount</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-3 py-2 fw-semibold @(Model.SelectedFilter == "EventManager" ? "active bg-primary text-white" : "text-dark")"
               asp-controller="@currentCtrl" asp-action="NeedsAttention" asp-route-filter="EventManager" asp-route-page="1">
                <i class="bi bi-patch-check me-1"></i> Event Managers
                <span class="badge rounded-pill ms-1 @(Model.SelectedFilter == "EventManager" ? "bg-white text-primary" : "bg-secondary text-white")">@Model.CountsByType.GetValueOrDefault("EventManager", 0)</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-3 py-2 fw-semibold @(Model.SelectedFilter == "Portfolio" ? "active bg-info text-dark" : "text-dark")"
               asp-controller="@currentCtrl" asp-action="NeedsAttention" asp-route-filter="Portfolio" asp-route-page="1">
                <i class="bi bi-images me-1"></i> Portfolios
                <span class="badge rounded-pill ms-1 @(Model.SelectedFilter == "Portfolio" ? "bg-dark text-white" : "bg-secondary text-white")">@Model.CountsByType.GetValueOrDefault("Portfolio", 0)</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-3 py-2 fw-semibold @(Model.SelectedFilter == "Property" ? "active bg-warning text-dark" : "text-dark")"
               asp-controller="@currentCtrl" asp-action="NeedsAttention" asp-route-filter="Property" asp-route-page="1">
                <i class="bi bi-building me-1"></i> Properties
                <span class="badge rounded-pill ms-1 @(Model.SelectedFilter == "Property" ? "bg-dark text-white" : "bg-secondary text-white")">@Model.CountsByType.GetValueOrDefault("Property", 0)</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-3 py-2 fw-semibold @(Model.SelectedFilter == "ClientId" ? "active bg-secondary text-white" : "text-dark")"
               asp-controller="@currentCtrl" asp-action="NeedsAttention" asp-route-filter="ClientId" asp-route-page="1">
                <i class="bi bi-person-vcard me-1"></i> Guest KYC
                <span class="badge rounded-pill ms-1 @(Model.SelectedFilter == "ClientId" ? "bg-light text-dark" : "bg-secondary text-white")">@Model.CountsByType.GetValueOrDefault("ClientId", 0)</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-3 py-2 fw-semibold @(Model.SelectedFilter == "PartnerLead" ? "active bg-success text-white" : "text-dark")"
               asp-controller="@currentCtrl" asp-action="NeedsAttention" asp-route-filter="PartnerLead" asp-route-page="1">
                <i class="bi bi-people me-1"></i> Partner Leads
                <span class="badge rounded-pill ms-1 @(Model.SelectedFilter == "PartnerLead" ? "bg-white text-success" : "bg-secondary text-white")">@Model.CountsByType.GetValueOrDefault("PartnerLead", 0)</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-3 py-2 fw-semibold @(Model.SelectedFilter == "Refund" ? "active bg-danger text-white" : "text-dark")"
               asp-controller="@currentCtrl" asp-action="NeedsAttention" asp-route-filter="Refund" asp-route-page="1">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Refunds
                <span class="badge rounded-pill ms-1 @(Model.SelectedFilter == "Refund" ? "bg-white text-danger" : "bg-secondary text-white")">@Model.CountsByType.GetValueOrDefault("Refund", 0)</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-3 py-2 fw-semibold @(Model.SelectedFilter == "DamageClaim" ? "active bg-dark text-white" : "text-dark")"
               asp-controller="@currentCtrl" asp-action="NeedsAttention" asp-route-filter="DamageClaim" asp-route-page="1">
                <i class="bi bi-shield-shaded me-1"></i> Damage Claims
                <span class="badge rounded-pill ms-1 @(Model.SelectedFilter == "DamageClaim" ? "bg-light text-dark" : "bg-secondary text-white")">@Model.CountsByType.GetValueOrDefault("DamageClaim", 0)</span>
            </a>
        </li>
    </ul>
</div>

<!-- Queue Items Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0 fw-bold">
            <i class="bi bi-list-task me-2 text-primary"></i>
            Pending Items (@Model.TotalItems)
        </h5>
        <small class="text-muted">Ordered by waiting time (oldest first)</small>
    </div>
    <div class="card-body p-0">
        @if (Model.Items == null || !Model.Items.Any())
        {
            <div class="p-5 text-center">
                <i class="bi bi-check2-circle text-success display-4 mb-3 d-block"></i>
                <h5 class="fw-bold">All Caught Up!</h5>
                <p class="text-muted mb-0">There are no pending tasks requiring attention in this category.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 180px;">Type</th>
                            <th>Subject / Entity</th>
                            <th>Details &amp; Context</th>
                            <th style="width: 180px;">Submitted</th>
                            <th style="width: 130px;" class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var waitSpan = DateTime.UtcNow - item.SubmittedAt;
                            string waitText = waitSpan.TotalDays >= 1 ? $"{(int)waitSpan.TotalDays}d ago" :
                                              waitSpan.TotalHours >= 1 ? $"{(int)waitSpan.TotalHours}h ago" :
                                              $"{Math.Max(1, (int)waitSpan.TotalMinutes)}m ago";
                            <tr>
                                <td>
                                    <span class="badge rounded-pill @item.BadgeClass px-2 py-1">
                                        @item.TaskTypeLabel
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    <small class="text-muted">Entity ID: #@item.EntityID</small>
                                </td>
                                <td>
                                    <div class="text-secondary small">@item.Subtitle</div>
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark">@item.SubmittedAt.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">@item.SubmittedAt.ToString("HH:mm") · <span class="badge bg-light text-dark border">@waitText</span></small>
                                </td>
                                <td class="text-end">
                                    <a href="@item.ActionUrl" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-box-arrow-up-right me-1"></i> Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Pagination Controls (25 per page) -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3 px-4 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="small text-muted">
                Showing page <strong>@Model.CurrentPage</strong> of <strong>@Model.TotalPages</strong> (@Model.TotalItems total items)
            </div>
            <nav aria-label="Staff queue pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-controller="@currentCtrl" asp-action="NeedsAttention"
                           asp-route-filter="@Model.SelectedFilter" asp-route-page="@(Model.CurrentPage - 1)">
                            <i class="bi bi-chevron-left"></i> Previous
                        </a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-controller="@currentCtrl" asp-action="NeedsAttention"
                               asp-route-filter="@Model.SelectedFilter" asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-controller="@currentCtrl" asp-action="NeedsAttention"
                           asp-route-filter="@Model.SelectedFilter" asp-route-page="@(Model.CurrentPage + 1)">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
