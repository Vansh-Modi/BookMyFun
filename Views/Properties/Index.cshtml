@model IEnumerable<BookMyFun.Models.Entities.Property>
@{
    ViewData["Title"] = "Explore Farmhouses, Villas & Resorts";
    var types = ViewBag.PropertyTypes as List<BookMyFun.Models.Entities.PropertyType> ?? new();
    var occasions = ViewBag.Occasions as List<BookMyFun.Models.Entities.Occasion> ?? new();
}

<div class="card shadow-sm p-4 mb-5 border-0">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Location / Keyword</label>
            <input type="text" name="location" value="@ViewBag.SelectedLocation" class="form-control" placeholder="City, landmark, or region..." />
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-building text-primary me-1"></i>Property Type</label>
            <select name="typeId" class="form-select">
                <option value="">All Types</option>
                @foreach (var t in types)
                {
                    <option value="@t.PropertyTypeID" selected="@(ViewBag.SelectedTypeId == t.PropertyTypeID)">@t.TypeName</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-balloon-heart-fill text-warning me-1"></i>Occasion</label>
            <select name="occasionId" class="form-select">
                <option value="">Any Occasion</option>
                @foreach (var o in occasions)
                {
                    <option value="@o.OccasionID" selected="@(ViewBag.SelectedOccasionId == o.OccasionID)">@o.OccasionName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-people-fill text-primary me-1"></i>Min Guests</label>
            <input type="number" name="guests" value="@ViewBag.SelectedGuests" class="form-control" placeholder="1+" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-warning w-100 fw-bold py-2"><i class="bi bi-search me-1"></i> Search</button>
        </div>
    </form>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <i class="bi bi-house-x fs-1 d-block mb-2 text-muted opacity-50"></i>
            <h4 class="text-muted">No properties found matching your criteria.</h4>
            <a asp-action="Index" class="btn btn-outline-secondary mt-3">Clear Filters</a>
        </div>
    }
    @foreach (var p in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 property-card overflow-hidden">
                <div class="position-relative">
                    <img src="@p.PrimaryImageUrl" class="card-img-top" style="height: 230px; object-fit: cover;" alt="@p.Title" onerror="this.src='/images/placeholder.jpg';" />
                    <span class="badge bg-dark bg-opacity-75 text-white position-absolute top-0 start-0 m-3 px-2 py-1">
                        @p.PropertyTypeName
                    </span>
                </div>
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-1">@p.Title</h5>
                    <p class="text-muted small mb-3"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @p.Location</p>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="small text-muted"><i class="bi bi-people me-1"></i> Up to @p.MaxGuests Guests</span>
                        <span class="fw-bold fs-5 text-primary">₹@p.PricePerNight.ToString("N0") <small class="text-muted fs-6">/ night</small></span>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="Details" asp-route-id="@p.PropertyID" class="btn btn-outline-secondary btn-sm">View Details</a>
                        <a asp-controller="Booking" asp-action="Checkout" asp-route-propertyId="@p.PropertyID" class="btn btn-warning btn-sm fw-bold">
                            Book Flexible Slot
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
