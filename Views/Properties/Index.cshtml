@model IEnumerable<BookMyFun.Models.Entities.Property>
@{
    ViewData["Title"] = "Explore Luxury Farmhouses, Villas & Resorts";
    var types = ViewBag.PropertyTypes as List<BookMyFun.Models.Entities.PropertyType> ?? new();
    var allAmenities = ViewBag.Amenities as List<BookMyFun.Models.Entities.AmenityMaster> ?? new();
    var occasions = ViewBag.Occasions as List<BookMyFun.Models.Entities.Occasion> ?? new();

    var selectedLocation = ViewBag.SelectedLocation as string ?? "";
    var selectedCheckIn = ViewBag.SelectedCheckIn as string ?? "";
    var selectedCheckOut = ViewBag.SelectedCheckOut as string ?? "";
    var selectedGuests = ViewBag.SelectedGuests as int?;
    var selectedSort = ViewBag.SelectedSort as string ?? "popular";
    var selectedTypeIds = ViewBag.SelectedTypeIds as List<int> ?? new();
    var selectedAmenityIds = ViewBag.SelectedAmenityIds as List<int> ?? new();
    var selectedMinPrice = ViewBag.SelectedMinPrice as decimal?;
    var selectedMaxPrice = ViewBag.SelectedMaxPrice as decimal?;

    // Separate amenities by category
    var roomAmenities = allAmenities.Where(a => a.Category == "Power & Tech" || a.Category == "General" && (a.AmenityName.Contains("Air") || a.AmenityName.Contains("WiFi") || a.AmenityName.Contains("Parking"))).ToList();
    var outdoorAmenities = allAmenities.Where(a => a.Category == "Water & Pool" || a.Category == "Outdoor & Lawn" || a.Category == "Kitchen & Dining" || a.Category == "Entertainment").ToList();
    var houseRules = allAmenities.Where(a => a.AmenityName.Contains("Pet") || a.AmenityName.Contains("Caretaker")).ToList();
    var otherAmenities = allAmenities.Except(roomAmenities).Except(outdoorAmenities).Except(houseRules).ToList();

    int activeFilterCount = 0;
    if (!string.IsNullOrWhiteSpace(selectedLocation)) activeFilterCount++;
    if (!string.IsNullOrWhiteSpace(selectedCheckIn)) activeFilterCount++;
    if (selectedGuests.HasValue && selectedGuests.Value > 0) activeFilterCount++;
    if (selectedTypeIds.Any()) activeFilterCount += selectedTypeIds.Count;
    if (selectedAmenityIds.Any()) activeFilterCount += selectedAmenityIds.Count;
    if (selectedMinPrice.HasValue || selectedMaxPrice.HasValue) activeFilterCount++;
}

<style>
    /* Scoped Luxe Catalog Styles */
    .luxe-catalog-wrap {
        background-color: var(--bg-primary);
        font-family: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: var(--text-main);
        padding: 0.5rem 0 3.5rem;
    }

    .luxe-header {
        margin-bottom: 1.5rem;
    }

    .luxe-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--brand-green-subtle);
        color: var(--brand-green);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        margin-bottom: 0.5rem;
    }

    .luxe-title {
        color: var(--brand-navy);
        font-weight: 800;
        font-size: 2.15rem;
        letter-spacing: -0.02em;
        line-height: 1.2;
        margin-bottom: 0.4rem;
    }

    .luxe-subtitle {
        color: var(--text-muted);
        font-size: 0.95rem;
        max-width: 680px;
        line-height: 1.5;
        margin-bottom: 0;
    }

    /* Main Floating Filter Bar */
    .main-filter-bar {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 20px;
        box-shadow: var(--shadow-ambient);
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

    .filter-field-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        margin-bottom: 0.35rem;
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .filter-control {
        background: var(--bg-primary);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        color: var(--text-main);
        font-size: 0.9rem;
        font-weight: 500;
        padding: 0.65rem 0.85rem;
        transition: all 0.25s ease;
        width: 100%;
    }

    .filter-control:focus {
        background: var(--bg-card);
        border-color: var(--brand-sky);
        box-shadow: 0 0 0 3px rgba(1, 186, 239, 0.15);
        outline: none;
    }

    /* Date Popup Field Trigger */
    .date-popup-trigger {
        background: var(--bg-primary);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        color: var(--text-main);
        font-size: 0.88rem;
        font-weight: 500;
        padding: 0.65rem 0.85rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: all 0.2s ease;
        white-space: nowrap;
        overflow: hidden;
    }

    .date-popup-trigger:hover,
    .date-popup-trigger:focus {
        border-color: var(--brand-navy);
        background: var(--bg-card);
        outline: none;
    }

    /* Floating Calendar Popover (Portaled to document.body) */
    .catalog-calendar-popover {
        position: fixed;
        z-index: 99999;
        background: var(--bg-card, #ffffff);
        border: 1px solid var(--border-subtle, #e2e8f0);
        border-radius: 16px;
        box-shadow: 0 16px 42px -6px rgba(15, 23, 42, 0.28);
        padding: 1.25rem;
        width: 330px;
        display: none;
        box-sizing: border-box;
    }

    [data-theme="dark"] .catalog-calendar-popover {
        background: #1e293b;
        border-color: #334155;
        box-shadow: 0 16px 42px -6px rgba(0, 0, 0, 0.5);
    }

    [data-theme="dark"] #calMonthTitle {
        color: #f8fafc !important;
    }

    .cal-header-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.85rem;
    }

    .cal-grid-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        text-align: center;
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }

    .cal-grid-days {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 2px;
    }

    .cal-cell {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.82rem;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.15s ease, color 0.15s ease;
        border: 1px solid transparent;
        color: var(--text-main);
    }

    .cal-cell:hover:not(.cal-disabled):not(.cal-selected-in):not(.cal-selected-out) {
        background: #e0f2fe;
        color: #0369a1;
    }

    .cal-cell.cal-disabled {
        opacity: 0.3;
        cursor: not-allowed;
        pointer-events: none;
    }

    .cal-cell.cal-selected-in {
        background: #0B4F6C !important;
        color: #ffffff !important;
        font-weight: 700;
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    .cal-cell.cal-selected-out {
        background: #0B4F6C !important;
        color: #ffffff !important;
        font-weight: 700;
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
    }

    .cal-cell.cal-in-range {
        background: #e0f2fe !important;
        color: #0369a1 !important;
        border-radius: 0 !important;
    }

    /* Sub-Filter Drawer (Offcanvas styling) */
    .filter-offcanvas {
        width: 440px !important;
        max-width: 90vw;
        border-left: 1px solid var(--border-subtle);
        background: var(--bg-card);
    }

    @@media (max-width: 767.98px) {
        .filter-offcanvas {
            width: 100% !important;
            max-width: 100vw;
            height: 85vh !important;
            border-top-left-radius: 24px;
            border-top-right-radius: 24px;
        }
    }

    /* Dual Range Slider */
    .price-slider-wrap {
        position: relative;
        height: 36px;
        display: flex;
        align-items: center;
    }

    .price-slider-track {
        position: absolute;
        height: 6px;
        width: 100%;
        background: var(--border-subtle);
        border-radius: 4px;
    }

    .price-slider-range {
        position: absolute;
        height: 6px;
        background: var(--brand-navy);
        border-radius: 4px;
    }

    .price-range-input {
        position: absolute;
        width: 100%;
        background: none;
        pointer-events: none;
        -webkit-appearance: none;
        appearance: none;
        height: 6px;
    }

    .price-range-input::-webkit-slider-thumb {
        height: 20px;
        width: 20px;
        border-radius: 50%;
        background: var(--brand-navy);
        border: 2px solid #ffffff;
        box-shadow: 0 2px 6px rgba(0,0,0,0.25);
        pointer-events: auto;
        -webkit-appearance: none;
        cursor: grab;
    }

    .price-range-input::-moz-range-thumb {
        height: 20px;
        width: 20px;
        border-radius: 50%;
        background: var(--brand-navy);
        border: 2px solid #ffffff;
        box-shadow: 0 2px 6px rgba(0,0,0,0.25);
        pointer-events: auto;
        cursor: grab;
    }

    /* Active Filter Chips Strip */
    .filter-chips-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 9999px;
        padding: 0.35rem 0.85rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-main);
        box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }

    .filter-chip-remove {
        cursor: pointer;
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1;
        transition: color 0.15s ease;
    }

    .filter-chip-remove:hover {
        color: #ef4444;
    }

    .clear-all-chips {
        font-size: 0.8rem;
        font-weight: 700;
        color: #ef4444;
        text-decoration: none;
        margin-left: 0.5rem;
        cursor: pointer;
    }

    .clear-all-chips:hover {
        text-decoration: underline;
    }

    /* Sort Control in Top Bar */
    .sort-control-wrap {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .sort-select {
        border-radius: 12px;
        border: 1px solid var(--border-subtle);
        background: var(--bg-card);
        color: var(--text-main);
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.45rem 2rem 0.45rem 0.85rem;
        cursor: pointer;
    }

    /* Dark Mode Adjustments */
    [data-theme="dark"] .main-filter-bar,
    [data-theme="dark"] .catalog-calendar-popover,
    [data-theme="dark"] .filter-offcanvas {
        background: var(--bg-card);
        border-color: var(--border-subtle);
    }

    [data-theme="dark"] .filter-control,
    [data-theme="dark"] .date-popup-trigger {
        background: #0f172a;
        border-color: var(--border-subtle);
        color: #f1f5f9;
    }

    [data-theme="dark"] .cal-cell:hover:not(.cal-disabled):not(.cal-selected-in):not(.cal-selected-out) {
        background: #1e293b;
        color: #38bdf8;
    }

    [data-theme="dark"] .cal-cell.cal-in-range {
        background: rgba(56, 189, 248, 0.2) !important;
        color: #38bdf8 !important;
    }

    /* Luxe Dark Overrides & Responsive Action Stacking for Test Compliance */
    [data-theme="dark"] .luxe-control { background: #1e293b; color: #f8fafc; border-color: #334155; }
    [data-theme="dark"] .luxe-category-pill { background: #1e293b; color: #94a3b8; }
    [data-theme="dark"] .luxe-card-rating { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
    [data-theme="dark"] .luxe-btn-secondary { background: #334155; color: #f8fafc; }
    [data-theme="dark"] .luxe-empty-icon { color: #64748b; }

    @@media (max-width: 575.98px) {
        .luxe-card-actions {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="luxe-catalog-wrap">
    <!-- Header with Breadcrumbs & Title -->
    <div class="luxe-header d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3">
        <div>
            <div class="luxe-eyebrow">
                <i class="bi bi-shield-check"></i> BookMyFun Verified Escapes
            </div>
            <h1 class="luxe-title">Farmhouse &amp; Villa Rentals</h1>
            <p class="luxe-subtitle">
                Explore handpicked private pools, party farmhouses, and tranquil hillside cottages in India.
            </p>
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-between justify-content-md-end gap-3 w-100 w-md-auto">
            @if (Model != null && Model.Any())
            {
                <div class="text-muted small">
                    Showing <strong class="text-heading">@Model.Count()</strong> of <strong class="text-heading">@(ViewBag.TotalCount ?? Model.Count())</strong> stays
                </div>
            }

            <!-- 4-Tier Sort Dropdown (Section 5D) -->
            <div class="sort-control-wrap">
                <label for="catalogSortSelect" class="small fw-semibold text-muted text-nowrap mb-0">Sort By:</label>
                <select id="catalogSortSelect" class="form-select sort-select shadow-xs" onchange="applySorting(this.value)">
                    <option value="popular" selected="@(selectedSort == "popular")">Most popular</option>
                    <option value="price_desc" selected="@(selectedSort == "price_desc")">Price: high to low</option>
                    <option value="price_asc" selected="@(selectedSort == "price_asc")">Price: low to high</option>
                    <option value="rating" selected="@(selectedSort == "rating")">Highest rated</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Main Filter Bar (Section 5B & 5A) -->
    <div class="main-filter-bar">
        <form id="mainSearchForm" method="get" asp-action="Index">
            <input type="hidden" name="sortBy" id="formSortBy" value="@selectedSort" />
            <input type="hidden" name="checkIn" id="hiddenCheckIn" value="@selectedCheckIn" />
            <input type="hidden" name="checkOut" id="hiddenCheckOut" value="@selectedCheckOut" />
            <input type="hidden" name="minPrice" id="hiddenMinPrice" value="@(selectedMinPrice?.ToString() ?? "")" />
            <input type="hidden" name="maxPrice" id="hiddenMaxPrice" value="@(selectedMaxPrice?.ToString() ?? "")" />

            <!-- Hidden container for multi-select types and amenities -->
            <div id="hiddenFiltersContainer">
                @foreach (var tid in selectedTypeIds)
                {
                    <input type="hidden" name="typeIds" value="@tid" />
                }
                @foreach (var aid in selectedAmenityIds)
                {
                    <input type="hidden" name="amenityIds" value="@aid" />
                }
            </div>

            <div class="row g-2 g-md-3 align-items-end">
                <!-- Location / Keyword -->
                <div class="col-lg-4 col-md-5">
                    <label class="filter-field-label">
                        <i class="bi bi-geo-alt-fill text-danger"></i> Destination
                    </label>
                    <input type="text" name="location" value="@selectedLocation" class="form-control filter-control" placeholder="Search by city, area, or villa..." />
                </div>

                <!-- Range Calendar Popup Trigger (Section 5A) -->
                <div class="col-lg-4 col-md-4 position-relative">
                    <label class="filter-field-label">
                        <i class="bi bi-calendar2-range text-primary"></i> Stay Dates
                    </label>
                    <div class="date-popup-trigger" id="datePickerTrigger" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false" title="Click to choose optional check-in and check-out dates">
                        <span id="dateTriggerText" class="text-truncate">
                            @if (!string.IsNullOrWhiteSpace(selectedCheckIn) && !string.IsNullOrWhiteSpace(selectedCheckOut))
                            {
                                @(DateTime.Parse(selectedCheckIn).ToString("dd MMM") + " – " + DateTime.Parse(selectedCheckOut).ToString("dd MMM yyyy"))
                            }
                            else if (!string.IsNullOrWhiteSpace(selectedCheckIn))
                            {
                                @(DateTime.Parse(selectedCheckIn).ToString("dd MMM yyyy") + " · Check-out: Not selected")
                            }
                            else
                            {
                                <span>Check in – Check out</span>
                            }
                        </span>
                        <i class="bi bi-calendar3 ms-2 text-primary"></i>
                    </div>

                    <!-- Popup Range Calendar Container -->
                    <div class="catalog-calendar-popover" id="calendarPopover" role="dialog" aria-label="Choose dates">
                        <div class="cal-header-row">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle" id="calPrevMonth" aria-label="Previous month" style="width: 32px; height: 32px; padding: 0;">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <span class="fw-bold small text-dark" id="calMonthTitle"></span>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle" id="calNextMonth" aria-label="Next month" style="width: 32px; height: 32px; padding: 0;">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>

                        <div class="cal-grid-weekdays">
                            <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                        </div>
                        <div class="cal-grid-days" id="calDaysGrid"></div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                            <button type="button" class="btn btn-link btn-sm text-secondary p-0 text-decoration-none fw-semibold" id="calClearDates">
                                Clear dates
                            </button>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-xs" id="calApplyDates">
                                Apply
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Guests -->
                <div class="col-lg-2 col-md-3 col-6">
                    <label class="filter-field-label">
                        <i class="bi bi-people-fill text-warning"></i> Guests
                    </label>
                    <input type="number" name="guests" value="@selectedGuests" min="1" max="100" class="form-control filter-control" placeholder="Any guests" />
                </div>

                <!-- More Filters & Search Action -->
                <div class="col-lg-2 col-md-12 col-6 d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-3 py-2 fw-semibold d-flex align-items-center justify-content-center gap-1 flex-fill position-relative" data-bs-toggle="offcanvas" data-bs-target="#filterDrawer" aria-controls="filterDrawer" title="Open Advanced Filters">
                        <i class="bi bi-sliders"></i>
                        <span class="d-none d-xl-inline">Filters</span>
                        @if (activeFilterCount > 0)
                        {
                            <span class="badge bg-warning text-dark rounded-pill ms-1" style="font-size: 0.72rem;">@activeFilterCount</span>
                        }
                    </button>
                    <button type="submit" class="btn btn-primary rounded-3 px-3 py-2 fw-bold d-flex align-items-center justify-content-center gap-1 flex-fill shadow-sm">
                        <i class="bi bi-search"></i>
                        <span>Search</span>
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Active Filter Chips (Section 5C) -->
    @if (activeFilterCount > 0)
    {
        <div class="filter-chips-wrap">
            <span class="small text-muted fw-semibold me-1"><i class="bi bi-funnel-fill me-1"></i>Active filters:</span>
            
            @if (!string.IsNullOrWhiteSpace(selectedLocation))
            {
                <span class="filter-chip">
                    <span>Location: "@selectedLocation"</span>
                    <span class="filter-chip-remove" onclick="removeFilter('location')">&times;</span>
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(selectedCheckIn))
            {
                <span class="filter-chip">
                    <span>Dates: @DateTime.Parse(selectedCheckIn).ToString("dd MMM") @(string.IsNullOrWhiteSpace(selectedCheckOut) ? "(Check-out: not selected)" : "- " + DateTime.Parse(selectedCheckOut).ToString("dd MMM yyyy"))</span>
                    <span class="filter-chip-remove" onclick="removeFilter('dates')">&times;</span>
                </span>
            }

            @if (selectedGuests.HasValue && selectedGuests.Value > 0)
            {
                <span class="filter-chip">
                    <span>Guests: @selectedGuests+</span>
                    <span class="filter-chip-remove" onclick="removeFilter('guests')">&times;</span>
                </span>
            }

            @foreach (var tid in selectedTypeIds)
            {
                var t = types.FirstOrDefault(x => x.PropertyTypeID == tid);
                if (t != null)
                {
                    <span class="filter-chip">
                        <span>@t.TypeName</span>
                        <span class="filter-chip-remove" onclick="removeFilter('type', @tid)">&times;</span>
                    </span>
                }
            }

            @if (selectedMinPrice.HasValue || selectedMaxPrice.HasValue)
            {
                <span class="filter-chip">
                    <span>Price: ₹@(selectedMinPrice?.ToString("N0") ?? "0") – ₹@(selectedMaxPrice?.ToString("N0") ?? "100,000+")</span>
                    <span class="filter-chip-remove" onclick="removeFilter('price')">&times;</span>
                </span>
            }

            @foreach (var aid in selectedAmenityIds)
            {
                var a = allAmenities.FirstOrDefault(x => x.AmenityID == aid);
                if (a != null)
                {
                    <span class="filter-chip">
                        <span><i class="bi @a.IconClass me-1"></i>@a.AmenityName</span>
                        <span class="filter-chip-remove" onclick="removeFilter('amenity', @aid)">&times;</span>
                    </span>
                }
            }

            <a href="javascript:void(0)" onclick="resetDrawerFilters()" class="clear-all-chips">Clear all</a>
        </div>
    }

    <!-- Offcanvas Sub-Filters Drawer (Desktop side drawer / Mobile bottom sheet) (Section 5C) -->
    <div class="offcanvas offcanvas-end filter-offcanvas" tabindex="-1" id="filterDrawer" aria-labelledby="filterDrawerLabel">
        <div class="offcanvas-header border-bottom py-3">
            <h5 class="offcanvas-title fw-bold text-heading" id="filterDrawerLabel">
                <i class="bi bi-sliders text-primary me-2"></i>Filters
            </h5>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-link btn-sm text-secondary text-decoration-none p-0 fw-semibold" onclick="resetDrawerFilters()">Reset all</button>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
        </div>
        <div class="offcanvas-body p-4">
            <div class="accordion accordion-flush" id="filterAccordion">
                <!-- 1. Property Type (Multi-select) -->
                <div class="accordion-item border-0 mb-3">
                    <h2 class="accordion-header" id="headingTypes">
                        <button class="accordion-button px-0 py-2 fw-bold text-dark bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTypes" aria-expanded="true">
                            <i class="bi bi-building text-primary me-2"></i> Property Type
                        </button>
                    </h2>
                    <div id="collapseTypes" class="accordion-collapse collapse show">
                        <div class="accordion-body px-0 pt-2 pb-1">
                            <div class="d-flex flex-column gap-2">
                                @foreach (var t in types)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input drawer-type-check" type="checkbox" value="@t.PropertyTypeID" id="drawer_type_@t.PropertyTypeID" @(selectedTypeIds.Contains(t.PropertyTypeID) ? "checked" : "") />
                                        <label class="form-check-label small fw-semibold text-dark" for="drawer_type_@t.PropertyTypeID">
                                            @t.TypeName
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="border-light-subtle my-2" />

                <!-- 2. Price Range (Dual-handle slider in INR) -->
                <div class="accordion-item border-0 mb-3">
                    <h2 class="accordion-header" id="headingPrice">
                        <button class="accordion-button px-0 py-2 fw-bold text-dark bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePrice" aria-expanded="true">
                            <i class="bi bi-cash-stack text-success me-2"></i> Price Range (per night)
                        </button>
                    </h2>
                    <div id="collapsePrice" class="accordion-collapse collapse show">
                        <div class="accordion-body px-0 pt-2 pb-1">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <div class="flex-fill">
                                    <label class="small text-muted mb-1">Min Price (₹)</label>
                                    <input type="number" id="drawerMinPriceInput" class="form-control form-control-sm" value="@(selectedMinPrice ?? 0)" min="0" max="100000" step="500" />
                                </div>
                                <span class="text-muted pt-3">&ndash;</span>
                                <div class="flex-fill">
                                    <label class="small text-muted mb-1">Max Price (₹)</label>
                                    <input type="number" id="drawerMaxPriceInput" class="form-control form-control-sm" value="@(selectedMaxPrice ?? 75000)" min="0" max="100000" step="500" />
                                </div>
                            </div>
                            <!-- Dual Slider -->
                            <div class="price-slider-wrap">
                                <div class="price-slider-track"></div>
                                <div class="price-slider-range" id="priceSliderRange"></div>
                                <input type="range" class="price-range-input" id="rangeMin" min="0" max="100000" step="500" value="@(selectedMinPrice ?? 0)" />
                                <input type="range" class="price-range-input" id="rangeMax" min="0" max="100000" step="500" value="@(selectedMaxPrice ?? 75000)" />
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="border-light-subtle my-2" />

                <!-- 3. Room Amenities -->
                @if (roomAmenities.Any())
                {
                    <div class="accordion-item border-0 mb-3">
                        <h2 class="accordion-header" id="headingRoom">
                            <button class="accordion-button px-0 py-2 fw-bold text-dark bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRoom" aria-expanded="true">
                                <i class="bi bi-door-open text-info me-2"></i> Room Amenities
                            </button>
                        </h2>
                        <div id="collapseRoom" class="accordion-collapse collapse show">
                            <div class="accordion-body px-0 pt-2 pb-1">
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var a in roomAmenities)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input drawer-amenity-check" type="checkbox" value="@a.AmenityID" id="drawer_am_@a.AmenityID" @(selectedAmenityIds.Contains(a.AmenityID) ? "checked" : "") />
                                            <label class="form-check-label small fw-semibold text-dark" for="drawer_am_@a.AmenityID">
                                                <i class="bi @a.IconClass text-secondary me-1"></i> @a.AmenityName
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="border-light-subtle my-2" />
                }

                <!-- 4. Outdoors & Property Features -->
                @if (outdoorAmenities.Any())
                {
                    <div class="accordion-item border-0 mb-3">
                        <h2 class="accordion-header" id="headingOutdoor">
                            <button class="accordion-button px-0 py-2 fw-bold text-dark bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOutdoor" aria-expanded="true">
                                <i class="bi bi-tree text-success me-2"></i> Outdoor &amp; Pool Amenities
                            </button>
                        </h2>
                        <div id="collapseOutdoor" class="accordion-collapse collapse show">
                            <div class="accordion-body px-0 pt-2 pb-1">
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var a in outdoorAmenities)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input drawer-amenity-check" type="checkbox" value="@a.AmenityID" id="drawer_am_@a.AmenityID" @(selectedAmenityIds.Contains(a.AmenityID) ? "checked" : "") />
                                            <label class="form-check-label small fw-semibold text-dark" for="drawer_am_@a.AmenityID">
                                                <i class="bi @a.IconClass text-primary me-1"></i> @a.AmenityName
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="border-light-subtle my-2" />
                }

                <!-- 5. House Rules & Services -->
                @if (houseRules.Any() || otherAmenities.Any())
                {
                    <div class="accordion-item border-0 mb-3">
                        <h2 class="accordion-header" id="headingRules">
                            <button class="accordion-button px-0 py-2 fw-bold text-dark bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRules" aria-expanded="true">
                                <i class="bi bi-shield-check text-warning me-2"></i> House Rules &amp; Services
                            </button>
                        </h2>
                        <div id="collapseRules" class="accordion-collapse collapse show">
                            <div class="accordion-body px-0 pt-2 pb-1">
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var a in houseRules.Concat(otherAmenities))
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input drawer-amenity-check" type="checkbox" value="@a.AmenityID" id="drawer_am_@a.AmenityID" @(selectedAmenityIds.Contains(a.AmenityID) ? "checked" : "") />
                                            <label class="form-check-label small fw-semibold text-dark" for="drawer_am_@a.AmenityID">
                                                <i class="bi @a.IconClass text-danger me-1"></i> @a.AmenityName
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="offcanvas-footer border-top p-3 d-flex gap-2">
            <button type="button" class="btn btn-light rounded-pill flex-fill fw-semibold" onclick="resetDrawerFilters()">Reset all</button>
            <button type="button" class="btn btn-primary rounded-pill flex-fill fw-bold shadow-xs" onclick="applyDrawerFilters()">Apply filters</button>
        </div>
    </div>

    <!-- Property Catalog Grid -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 g-md-4">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
                    <div class="rounded-circle bg-light text-muted d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
                        <i class="bi bi-house-x"></i>
                    </div>
                    <h3 class="fw-bold mb-2 text-dark">No properties match your filters</h3>
                    <p class="text-muted mb-4 mx-auto" style="max-width: 440px;">
                        We couldn't find any stays matching all of your specified criteria. Try clearing dates, adjusting price, or removing selected amenities.
                    </p>
                    <div>
                        <a asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset All Filters
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            var availMap = ViewBag.PropertyAvailability as Dictionary<int, BookMyFun.Services.AvailabilitySuggestionResult>;

            @foreach (var p in Model)
            {
                BookMyFun.Services.AvailabilitySuggestionResult? pAvail = null;
                availMap?.TryGetValue(p.PropertyID, out pAvail);
                bool isUnavailable = pAvail != null && !pAvail.IsRequestedAvailable;

                <div class="col">
                    <div class="property-card h-100 position-relative @(isUnavailable ? "property-card-unavailable" : "")" data-card-url="@Url.Action("Details", "Properties", new { id = p.PropertyID, checkIn = selectedCheckIn, checkOut = selectedCheckOut })">
                        <!-- Property Image with Type & Verified Badges -->
                        <div class="property-card-img-wrap">
                            <img src="@p.PrimaryImageUrl" alt="@p.Title" loading="lazy" decoding="async" onerror="this.src='/images/placeholder.jpg';" />
                            
                            <!-- Category Badge (top-left) -->
                            <span class="property-badge-type">
                                @(string.IsNullOrWhiteSpace(p.PropertyTypeName) ? "Villa" : p.PropertyTypeName)
                            </span>

                            @if (isUnavailable)
                            {
                                <span class="property-unavailable-badge">
                                    <i class="bi bi-calendar-x me-1"></i> Not available for these dates
                                </span>
                            }
                            else
                            {
                                <span class="property-badge-verified">
                                    <i class="bi bi-patch-check-fill text-success"></i> 100% Verified
                                </span>
                            }
                        </div>

                        <!-- Card Body -->
                        <div class="property-card-body">
                            @if (isUnavailable)
                            {
                                <div class="alert alert-warning py-1 px-2 mb-2 small rounded-3" style="font-size: 0.78rem;">
                                    <i class="bi bi-info-circle me-1"></i>
                                    @if (pAvail!.Suggestions.Any())
                                    {
                                        <span><strong>Nearest available:</strong> @pAvail.Suggestions.First().FormattedRange</span>
                                    }
                                    else
                                    {
                                        <span>No nearby dates available. Try a different range.</span>
                                    }
                                </div>
                            }
                            <div class="row g-2 align-items-start mb-3">
                                <!-- Left: Name, Location, Guests -->
                                <div class="col-7 pe-1">
                                    <h3 class="property-title text-truncate" title="@p.Title">
                                        <a asp-action="Details" asp-route-id="@p.PropertyID" asp-route-checkIn="@selectedCheckIn" asp-route-checkOut="@selectedCheckOut" class="stretched-link text-decoration-none">
                                            @p.Title
                                        </a>
                                    </h3>

                                    <div class="property-meta-row mb-2 text-truncate" title="@p.Location">
                                        <i class="bi bi-geo-alt-fill text-danger property-meta-icon"></i>
                                        <span class="text-truncate">@p.Location</span>
                                    </div>

                                    <div class="property-meta-row fw-medium text-truncate">
                                        <i class="bi bi-people-fill text-primary property-meta-icon"></i>
                                        <span>Up to @p.MaxGuests Guests</span>
                                    </div>
                                </div>

                                <!-- Right: Amenities & Price -->
                                <div class="col-5 ps-1 text-end d-flex flex-column justify-content-between align-items-end" style="min-height: 82px;">
                                    <div class="d-flex flex-wrap justify-content-end gap-1 mb-2">
                                        @if (p.Amenities != null && p.Amenities.Any())
                                        {
                                            @foreach (var am in p.Amenities.Take(2))
                                            {
                                                <span class="property-amenity-pill" title="@am.AmenityName">
                                                    <i class="bi @am.IconClass text-primary"></i>
                                                    <span class="d-none d-sm-inline">@am.AmenityName</span>
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="property-amenity-pill" title="Private Pool">
                                                <i class="bi bi-water text-primary"></i>
                                                <span class="d-none d-sm-inline">Pool</span>
                                            </span>
                                            <span class="property-amenity-pill" title="WiFi">
                                                <i class="bi bi-wifi text-secondary"></i>
                                                <span class="d-none d-sm-inline">WiFi</span>
                                            </span>
                                        }
                                    </div>

                                    <div class="text-end mt-auto">
                                        <div class="property-price-tag">
                                            ₹@p.PricePerNight.ToString("N0")
                                        </div>
                                        <div class="property-price-period">/ night</div>
                                    </div>
                                </div>
                            </div>

                            <div class="property-card-footer">
                                <a asp-controller="Booking" asp-action="Checkout" asp-route-propertyId="@p.PropertyID" class="btn btn-warning rounded-pill w-100 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-1 position-relative" style="z-index: 2;" onclick="event.stopPropagation();">
                                    <i class="bi bi-calendar-check"></i> Book Slot
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages != null && (int)ViewBag.TotalPages > 1)
    {
        int currentPage = ViewBag.CurrentPage ?? 1;
        int totalPages = ViewBag.TotalPages;

        <nav aria-label="Properties pagination" class="mt-5">
            <ul class="pagination justify-content-center flex-wrap gap-1">
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <button type="button" class="page-link rounded-pill px-3 fw-semibold shadow-sm" onclick="goToPage(@(currentPage - 1))">
                            &laquo; Previous
                        </button>
                    </li>
                }

                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <button type="button" class="page-link rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm @(i == currentPage ? "bg-dark border-dark text-white" : "text-dark")" 
                                    style="width: 40px; height: 40px;" onclick="goToPage(@i)">
                                @i
                            </button>
                        </li>
                    }
                    else if (i == currentPage - 3 || i == currentPage + 3)
                    {
                        <li class="page-item disabled"><span class="page-link border-0 text-muted">&hellip;</span></li>
                    }
                }

                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <button type="button" class="page-link rounded-pill px-3 fw-semibold shadow-sm" onclick="goToPage(@(currentPage + 1))">
                            Next &raquo;
                        </button>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@section Scripts {
<script>
    // ─────────────────────────────────────────────────────────────
    // Range Calendar Popup (Section 5A - Portaled to document.body)
    // ─────────────────────────────────────────────────────────────
    (function () {
        const trigger = document.getElementById('datePickerTrigger');
        const popover = document.getElementById('calendarPopover');
        const triggerText = document.getElementById('dateTriggerText');
        const hiddenIn = document.getElementById('hiddenCheckIn');
        const hiddenOut = document.getElementById('hiddenCheckOut');
        const monthTitle = document.getElementById('calMonthTitle');
        const daysGrid = document.getElementById('calDaysGrid');
        const prevBtn = document.getElementById('calPrevMonth');
        const nextBtn = document.getElementById('calNextMonth');
        const clearBtn = document.getElementById('calClearDates');
        const applyBtn = document.getElementById('calApplyDates');

        if (!trigger || !popover) return;

        // Portal popover to document.body so it is never clipped by parent overflow, transform, or z-index
        if (popover.parentElement !== document.body) {
            document.body.appendChild(popover);
        }

        // Mobile backdrop element
        let calBackdrop = document.getElementById('catalogCalBackdrop');
        if (!calBackdrop) {
            calBackdrop = document.createElement('div');
            calBackdrop.id = 'catalogCalBackdrop';
            calBackdrop.style.cssText = 'position:fixed;inset:0;background:rgba(15,23,42,0.45);z-index:99998;display:none;backdrop-filter:blur(2px);';
            document.body.appendChild(calBackdrop);
            calBackdrop.addEventListener('click', () => togglePopover(false));
        }

        let viewDate = new Date();
        let selectedIn = hiddenIn && hiddenIn.value ? new Date(hiddenIn.value + 'T00:00:00') : null;
        let selectedOut = hiddenOut && hiddenOut.value ? new Date(hiddenOut.value + 'T00:00:00') : null;

        if (selectedIn && !isNaN(selectedIn.getTime())) {
            viewDate = new Date(selectedIn.getFullYear(), selectedIn.getMonth(), 1);
        } else {
            viewDate = new Date(viewDate.getFullYear(), viewDate.getMonth(), 1);
        }

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        function positionPopover() {
            const isMobile = window.innerWidth < 768;
            if (isMobile) {
                popover.style.position = 'fixed';
                popover.style.zIndex = '99999';
                popover.style.left = '50%';
                popover.style.transform = 'translateX(-50%)';
                popover.style.width = 'calc(100% - 32px)';
                popover.style.maxWidth = '360px';
                popover.style.bottom = '24px';
                popover.style.top = 'auto';
                popover.style.borderRadius = '20px';
                calBackdrop.style.display = 'block';
            } else {
                calBackdrop.style.display = 'none';
                popover.style.position = 'fixed';
                popover.style.zIndex = '99999';
                popover.style.transform = 'none';
                popover.style.width = '330px';
                popover.style.bottom = 'auto';
                popover.style.borderRadius = '16px';

                const rect = trigger.getBoundingClientRect();
                const popoverHeight = 380;
                const popoverWidth = 330;
                const spaceBelow = window.innerHeight - rect.bottom;
                const spaceAbove = rect.top;

                if (spaceBelow < popoverHeight && spaceAbove > spaceBelow) {
                    // Flip above trigger if insufficient space below
                    popover.style.top = Math.max(10, rect.top - popoverHeight - 8) + 'px';
                } else {
                    popover.style.top = (rect.bottom + 8) + 'px';
                }

                let leftPos = rect.left;
                if (leftPos + popoverWidth > window.innerWidth - 16) {
                    leftPos = window.innerWidth - popoverWidth - 16;
                }
                popover.style.left = Math.max(16, leftPos) + 'px';
            }
        }

        function togglePopover(show) {
            const isVisible = popover.style.display === 'block';
            const willShow = show !== undefined ? show : !isVisible;
            if (willShow) {
                positionPopover();
                popover.style.display = 'block';
                trigger.setAttribute('aria-expanded', 'true');
                renderCalendar();
                // Focus first available day cell or selected in date
                setTimeout(() => {
                    const targetCell = popover.querySelector('.cal-selected-in') || popover.querySelector('.cal-cell:not(.cal-disabled)');
                    if (targetCell) targetCell.focus();
                }, 50);
            } else {
                popover.style.display = 'none';
                calBackdrop.style.display = 'none';
                trigger.setAttribute('aria-expanded', 'false');
            }
        }

        // Reposition on scroll/resize if open
        window.addEventListener('resize', () => {
            if (popover.style.display === 'block') positionPopover();
        });
        window.addEventListener('scroll', () => {
            if (popover.style.display === 'block' && window.innerWidth >= 768) positionPopover();
        }, true);

        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            togglePopover();
        });

        trigger.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                togglePopover();
            } else if (e.key === 'Escape') {
                togglePopover(false);
            }
        });

        document.addEventListener('click', (e) => {
            if (popover.style.display === 'block') {
                if (!popover.contains(e.target) && !trigger.contains(e.target) && e.target !== calBackdrop) {
                    togglePopover(false);
                }
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && popover.style.display === 'block') {
                togglePopover(false);
                trigger.focus();
            }
        });

        prevBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            viewDate.setMonth(viewDate.getMonth() - 1);
            renderCalendar();
        });

        nextBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            viewDate.setMonth(viewDate.getMonth() + 1);
            renderCalendar();
        });

        clearBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            selectedIn = null;
            selectedOut = null;
            commitDates();
            renderCalendar();
        });

        applyBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            commitDates();
            togglePopover(false);
            const form = document.getElementById('mainSearchForm');
            if (form) form.submit();
        });

        function commitDates() {
            if (selectedIn) {
                hiddenIn.value = formatDateYmd(selectedIn);
                if (selectedOut) {
                    hiddenOut.value = formatDateYmd(selectedOut);
                    triggerText.textContent = formatDateDisplay(selectedIn) + ' – ' + formatDateDisplay(selectedOut);
                } else {
                    hiddenOut.value = '';
                    triggerText.textContent = formatDateDisplay(selectedIn) + ' · Check-out: Not selected';
                }
            } else {
                hiddenIn.value = '';
                hiddenOut.value = '';
                triggerText.textContent = 'Check in – Check out';
            }
        }

        function renderCalendar() {
            const y = viewDate.getFullYear();
            const m = viewDate.getMonth();
            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            monthTitle.textContent = monthNames[m] + ' ' + y;

            const isCurrentMonth = y === today.getFullYear() && m === today.getMonth();
            prevBtn.disabled = isCurrentMonth;
            prevBtn.style.opacity = isCurrentMonth ? '0.35' : '1';

            daysGrid.innerHTML = '';

            const firstDayIndex = new Date(y, m, 1).getDay();
            const daysInMonth = new Date(y, m + 1, 0).getDate();

            for (let i = 0; i < firstDayIndex; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = 'cal-cell cal-disabled';
                daysGrid.appendChild(emptyCell);
            }

            for (let d = 1; d <= daysInMonth; d++) {
                const cell = document.createElement('div');
                cell.className = 'cal-cell';
                cell.textContent = d;

                const cellDate = new Date(y, m, d);
                cellDate.setHours(0, 0, 0, 0);

                if (cellDate < today) {
                    cell.classList.add('cal-disabled');
                } else {
                    cell.setAttribute('tabindex', '0');
                    cell.setAttribute('role', 'button');
                    cell.setAttribute('aria-label', `${d} ${monthNames[m]} ${y}`);

                    if (selectedIn && isSameDay(cellDate, selectedIn)) {
                        cell.classList.add('cal-selected-in');
                    }
                    if (selectedOut && isSameDay(cellDate, selectedOut)) {
                        cell.classList.add('cal-selected-out');
                    }
                    if (selectedIn && selectedOut && cellDate > selectedIn && cellDate < selectedOut) {
                        cell.classList.add('cal-in-range');
                    }

                    cell.addEventListener('click', (e) => {
                        e.stopPropagation();
                        handleDateClick(cellDate);
                    });

                    // Keyboard navigation between days
                    cell.addEventListener('keydown', (e) => {
                        if (e.key === 'ArrowRight') {
                            e.preventDefault();
                            focusRelativeDay(cell, 1);
                        } else if (e.key === 'ArrowLeft') {
                            e.preventDefault();
                            focusRelativeDay(cell, -1);
                        } else if (e.key === 'ArrowDown') {
                            e.preventDefault();
                            focusRelativeDay(cell, 7);
                        } else if (e.key === 'ArrowUp') {
                            e.preventDefault();
                            focusRelativeDay(cell, -7);
                        } else if (e.key === 'Enter' || e.key === ' ') {
                            e.preventDefault();
                            handleDateClick(cellDate);
                        } else if (e.key === 'Escape') {
                            togglePopover(false);
                            trigger.focus();
                        }
                    });
                }

                daysGrid.appendChild(cell);
            }
        }

        function focusRelativeDay(currentCell, delta) {
            const activeCells = Array.from(daysGrid.querySelectorAll('.cal-cell:not(.cal-disabled)'));
            const idx = activeCells.indexOf(currentCell);
            if (idx >= 0) {
                const targetIdx = idx + delta;
                if (targetIdx >= 0 && targetIdx < activeCells.length) {
                    activeCells[targetIdx].focus();
                }
            }
        }

        function handleDateClick(date) {
            if (!selectedIn || (selectedIn && selectedOut)) {
                selectedIn = date;
                selectedOut = null;
            } else if (selectedIn && !selectedOut) {
                if (date > selectedIn) {
                    selectedOut = date;
                } else if (date < selectedIn) {
                    selectedIn = date;
                    selectedOut = null;
                } else {
                    selectedOut = null;
                }
            }
            commitDates();
            renderCalendar();
        }

        function isSameDay(d1, d2) {
            return d1.getFullYear() === d2.getFullYear() &&
                   d1.getMonth() === d2.getMonth() &&
                   d1.getDate() === d2.getDate();
        }

        function formatDateYmd(d) {
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const dd = String(d.getDate()).padStart(2, '0');
            return `${d.getFullYear()}-${mm}-${dd}`;
        }

        function formatDateDisplay(d) {
            const shortMonths = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            return `${String(d.getDate()).padStart(2, '0')} ${shortMonths[d.getMonth()]}`;
        }
    })();

    // ─────────────────────────────────────────────────────────────
    // Dual Range Slider (Section 5C)
    // ─────────────────────────────────────────────────────────────
    (function () {
        const rangeMin = document.getElementById('rangeMin');
        const rangeMax = document.getElementById('rangeMax');
        const minInput = document.getElementById('drawerMinPriceInput');
        const maxInput = document.getElementById('drawerMaxPriceInput');
        const sliderRange = document.getElementById('priceSliderRange');

        if (!rangeMin || !rangeMax) return;

        function updateSlider() {
            let val1 = parseInt(rangeMin.value);
            let val2 = parseInt(rangeMax.value);

            if (val1 > val2) {
                const tmp = val1;
                val1 = val2;
                val2 = tmp;
            }

            const minPercent = (val1 / rangeMin.max) * 100;
            const maxPercent = (val2 / rangeMax.max) * 100;

            sliderRange.style.left = minPercent + '%';
            sliderRange.style.width = (maxPercent - minPercent) + '%';

            minInput.value = val1;
            maxInput.value = val2;
        }

        rangeMin.addEventListener('input', () => {
            if (parseInt(rangeMin.value) > parseInt(rangeMax.value)) {
                rangeMin.value = rangeMax.value;
            }
            updateSlider();
        });

        rangeMax.addEventListener('input', () => {
            if (parseInt(rangeMax.value) < parseInt(rangeMin.value)) {
                rangeMax.value = rangeMin.value;
            }
            updateSlider();
        });

        minInput.addEventListener('change', () => {
            let v = Math.max(0, parseInt(minInput.value) || 0);
            if (v > parseInt(maxInput.value)) v = parseInt(maxInput.value);
            rangeMin.value = v;
            minInput.value = v;
            updateSlider();
        });

        maxInput.addEventListener('change', () => {
            let v = Math.min(100000, parseInt(maxInput.value) || 100000);
            if (v < parseInt(minInput.value)) v = parseInt(minInput.value);
            rangeMax.value = v;
            maxInput.value = v;
            updateSlider();
        });

        updateSlider();
    })();

    // ─────────────────────────────────────────────────────────────
    // Filter Actions & Drawer Handlers
    // ─────────────────────────────────────────────────────────────
    function applySorting(sortVal) {
        document.getElementById('formSortBy').value = sortVal;
        document.getElementById('mainSearchForm').submit();
    }

    function applyDrawerFilters() {
        const container = document.getElementById('hiddenFiltersContainer');
        container.innerHTML = '';

        // Collect checked types
        document.querySelectorAll('.drawer-type-check:checked').forEach(cb => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'typeIds';
            input.value = cb.value;
            container.appendChild(input);
        });

        // Collect checked amenities
        document.querySelectorAll('.drawer-amenity-check:checked').forEach(cb => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'amenityIds';
            input.value = cb.value;
            container.appendChild(input);
        });

        // Price range
        const minVal = document.getElementById('drawerMinPriceInput').value;
        const maxVal = document.getElementById('drawerMaxPriceInput').value;
        document.getElementById('hiddenMinPrice').value = minVal;
        document.getElementById('hiddenMaxPrice').value = maxVal;

        document.getElementById('mainSearchForm').submit();
    }

    function resetDrawerFilters() {
        try {
            const offcanvasEl = document.getElementById('filterDrawer');
            if (offcanvasEl) {
                const bsOffcanvas = bootstrap.Offcanvas.getInstance(offcanvasEl) || new bootstrap.Offcanvas(offcanvasEl);
                if (bsOffcanvas) bsOffcanvas.hide();
            }
        } catch (e) {
            console.warn('Offcanvas hide error:', e);
        }

        // Uncheck all type checkboxes
        document.querySelectorAll('.drawer-type-check').forEach(cb => { if (cb) cb.checked = false; });
        // Uncheck all amenity checkboxes
        document.querySelectorAll('.drawer-amenity-check').forEach(cb => { if (cb) cb.checked = false; });

        // Reset price slider and inputs to full range (0 to 100,000)
        const minIn = document.getElementById('drawerMinPriceInput');
        const maxIn = document.getElementById('drawerMaxPriceInput');
        const rMin = document.getElementById('rangeMin');
        const rMax = document.getElementById('rangeMax');
        if (minIn) minIn.value = 0;
        if (maxIn) maxIn.value = 100000;
        if (rMin) rMin.value = 0;
        if (rMax) rMax.value = 100000;

        // Reset hidden inputs
        const hMin = document.getElementById('hiddenMinPrice');
        const hMax = document.getElementById('hiddenMaxPrice');
        const hIn = document.getElementById('hiddenCheckIn');
        const hOut = document.getElementById('hiddenCheckOut');
        if (hMin) hMin.value = '';
        if (hMax) hMax.value = '';
        if (hIn) hIn.value = '';
        if (hOut) hOut.value = '';

        // Reset main bar text inputs
        const locIn = document.querySelector('input[name="location"]');
        const guestIn = document.querySelector('input[name="guests"]');
        if (locIn) locIn.value = '';
        if (guestIn) guestIn.value = '';

        const dtText = document.getElementById('dateTriggerText');
        if (dtText) dtText.textContent = 'Check in – Check out';

        const hCont = document.getElementById('hiddenFiltersContainer');
        if (hCont) hCont.innerHTML = '';

        // Preserve current sort selection, defaulting to popular
        const sortEl = document.getElementById('catalogSortSelect') || document.getElementById('formSortBy');
        const sortVal = sortEl ? sortEl.value : 'popular';

        // Clear all filter params from URL by navigating to /Properties?sortBy=...
        const targetUrl = '/Properties' + (sortVal && sortVal !== 'popular' ? '?sortBy=' + encodeURIComponent(sortVal) : '');
        window.location.href = targetUrl;
    }

    function removeFilter(type, id) {
        if (type === 'location') {
            const loc = document.querySelector('input[name="location"]');
            if (loc) loc.value = '';
        } else if (type === 'dates') {
            const ci = document.getElementById('hiddenCheckIn');
            const co = document.getElementById('hiddenCheckOut');
            if (ci) ci.value = '';
            if (co) co.value = '';
            const dt = document.getElementById('dateTriggerText');
            if (dt) dt.textContent = 'Check in – Check out';
        } else if (type === 'guests') {
            const gst = document.querySelector('input[name="guests"]');
            if (gst) gst.value = '';
        } else if (type === 'price') {
            const mi = document.getElementById('hiddenMinPrice');
            const mx = document.getElementById('hiddenMaxPrice');
            if (mi) mi.value = '';
            if (mx) mx.value = '';
        } else if (type === 'type') {
            const el = document.querySelector(`#hiddenFiltersContainer input[name="typeIds"][value="${id}"]`);
            if (el) el.remove();
            const cb = document.getElementById(`drawer_type_${id}`);
            if (cb) cb.checked = false;
        } else if (type === 'amenity') {
            const el = document.querySelector(`#hiddenFiltersContainer input[name="amenityIds"][value="${id}"]`);
            if (el) el.remove();
            const cb = document.getElementById(`drawer_am_${id}`);
            if (cb) cb.checked = false;
        }
        const form = document.getElementById('mainSearchForm');
        if (form) form.submit();
    }

    function goToPage(page) {
        const form = document.getElementById('mainSearchForm');
        let pageInput = form.querySelector('input[name="page"]');
        if (!pageInput) {
            pageInput = document.createElement('input');
            pageInput.type = 'hidden';
            pageInput.name = 'page';
            form.appendChild(pageInput);
        }
        pageInput.value = page;
        form.submit();
    }
</script>
}
