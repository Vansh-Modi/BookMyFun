@model BookMyFun.Models.Entities.Property
@{
    ViewData["Title"] = Model.Title + " - Property Details";
    var reviews = ViewBag.Reviews as List<BookMyFun.Models.Entities.CustomerReview> ?? new();
    double avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : 5.0;

    var photoUrls = Model.MediaList?.Where(m => m.MediaType == "photo").Select(m => m.StorageUrl).ToList() ?? new List<string>();
    if (!photoUrls.Any() && Model.ImageUrls != null && Model.ImageUrls.Any())
    {
        photoUrls.AddRange(Model.ImageUrls);
    }
    if (!string.IsNullOrWhiteSpace(Model.PrimaryImageUrl))
    {
        if (photoUrls.Contains(Model.PrimaryImageUrl))
        {
            photoUrls.Remove(Model.PrimaryImageUrl);
        }
        photoUrls.Insert(0, Model.PrimaryImageUrl);
    }
    if (!photoUrls.Any())
    {
        photoUrls.Add("/images/property-placeholder.jpg");
    }
    var videos = Model.MediaList?.Where(m => m.MediaType == "video").ToList() ?? new();

    var avail = ViewBag.AvailabilityResult as BookMyFun.Services.AvailabilitySuggestionResult;
    bool isUnavailable = avail != null && !avail.IsRequestedAvailable;
    string selectedIn = ViewBag.SelectedCheckIn as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    string selectedOut = ViewBag.SelectedCheckOut as string ?? DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
}

<style>
    .property-detail-unavailable {
        border: 2px solid #ef4444 !important;
        opacity: 0.88;
    }
    .property-detail-unavailable .card-body {
        background: linear-gradient(180deg, rgba(254, 242, 242, 0.5) 0%, #ffffff 100%);
    }
    .suggestion-chip-btn {
        transition: all 0.2s ease;
        font-weight: 600;
        cursor: pointer;
    }
    .suggestion-chip-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(11, 79, 108, 0.15);
    }
</style>

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Properties" asp-action="Index">Stays</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Flipkart-Style Interactive Gallery -->
            <div class="flipkart-gallery shadow-sm" id="propertyGallery" tabindex="0" aria-label="Property Image Gallery">
                <!-- Large Active Image -->
                <div class="gallery-main-stage" id="galleryStage">
                    <img id="galleryMainImg" 
                         src="@photoUrls[0]" 
                         alt="@Model.Title" 
                         width="800" 
                         height="480" 
                         class="gallery-main-img" 
                         onerror="this.src='/images/property-placeholder.jpg';" />

                    @if (photoUrls.Count > 1)
                    {
                        <button type="button" class="gallery-nav-btn prev" id="galleryPrevBtn" aria-label="Previous photo">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button type="button" class="gallery-nav-btn next" id="galleryNextBtn" aria-label="Next photo">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                        <div class="gallery-counter" id="galleryCounter">1 / @photoUrls.Count</div>
                    }
                </div>

                <!-- Horizontal Scrollable Row of Thumbnails Below Active Image -->
                @if (photoUrls.Count > 1 || videos.Any())
                {
                    <div class="gallery-thumbnails-wrap">
                        <div class="gallery-thumbnails" id="galleryThumbnails">
                            @for (int i = 0; i < photoUrls.Count; i++)
                            {
                                var pUrl = photoUrls[i];
                                <button type="button" 
                                        class="gallery-thumb-item @(i == 0 ? "active" : "")" 
                                        data-index="@i" 
                                        data-src="@pUrl" 
                                        aria-label="View photo @(i + 1) of @photoUrls.Count">
                                    <img src="@pUrl" 
                                         alt="Thumbnail @(i + 1)" 
                                         width="96" 
                                         height="64" 
                                         loading="lazy" 
                                         class="gallery-thumb-img" 
                                         onerror="this.src='/images/property-placeholder.jpg';" />
                                </button>
                            }
                            @foreach (var vid in videos)
                            {
                                <a href="@vid.StorageUrl" target="_blank" rel="noopener noreferrer" class="rounded-3 border bg-dark text-white d-flex flex-column align-items-center justify-content-center text-decoration-none flex-shrink-0" style="width: 96px; height: 64px;">
                                    <i class="bi bi-play-circle-fill text-danger fs-5"></i>
                                    <span style="font-size: 10px;">Video Tour</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Property Details Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                        <div>
                            <span class="badge bg-secondary rounded-pill mb-2">@Model.PropertyTypeName</span>
                            <h2 class="fw-bold mb-1 text-dark">@Model.Title</h2>
                            <p class="text-muted mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Location</p>
                        </div>
                        @if (reviews.Any())
                        {
                            <div class="text-end">
                                <div class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill shadow-sm">
                                    ⭐ @avgRating.ToString("0.0") (@reviews.Count reviews)
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Highlight Badges -->
                    <div class="row g-3 py-3 border-top border-bottom my-3 text-center">
                        <div class="col-4">
                            <i class="bi bi-people-fill fs-4 text-primary d-block mb-1"></i>
                            <span class="text-muted small">Max Capacity</span>
                            <div class="fw-bold">@Model.MaxGuests Guests</div>
                        </div>
                        <div class="col-4">
                            <i class="bi bi-house-door-fill fs-4 text-success d-block mb-1"></i>
                            <span class="text-muted small">Property Type</span>
                            <div class="fw-bold">@Model.PropertyTypeName</div>
                        </div>
                        <div class="col-4">
                            <i class="bi bi-shield-check fs-4 text-warning d-block mb-1"></i>
                            <span class="text-muted small">Host Verification</span>
                            <div class="fw-bold text-success">Verified Partner</div>
                        </div>
                    </div>

                    <!-- Description -->
                    <h5 class="fw-bold mt-4 mb-2 text-dark">About this Property</h5>
                    <p class="text-secondary leading-relaxed mb-4">
                        @(Model.Description ?? "Experience a luxurious and tranquil escape. Perfect for family reunions, weekend getaways, pool parties, or celebrations with unmatched privacy.")
                    </p>

                    <!-- Amenities Taxonomy -->
                    <h5 class="fw-bold mt-4 mb-3 text-dark"><i class="bi bi-grid-fill text-success me-2"></i>Features & Amenities</h5>
                    @if (Model.Amenities != null && Model.Amenities.Any())
                    {
                        <div class="row row-cols-2 row-cols-md-3 g-3 mb-4">
                            @foreach (var am in Model.Amenities)
                            {
                                <div class="col">
                                    <div class="p-2 border rounded-3 bg-light d-flex align-items-center gap-2">
                                        <i class="bi @am.IconClass text-success fs-5"></i>
                                        <span class="small fw-medium text-dark">@am.AmenityName</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="row g-2 mb-4">
                            <div class="col-md-4 col-6"><i class="bi bi-water text-primary me-2"></i> Swimming Pool</div>
                            <div class="col-md-4 col-6"><i class="bi bi-wifi text-primary me-2"></i> High-Speed WiFi</div>
                            <div class="col-md-4 col-6"><i class="bi bi-snow text-primary me-2"></i> Air Conditioning</div>
                            <div class="col-md-4 col-6"><i class="bi bi-p-square text-primary me-2"></i> Free Onsite Parking</div>
                            <div class="col-md-4 col-6"><i class="bi bi-music-note-beamed text-primary me-2"></i> Lawn & Audio System</div>
                            <div class="col-md-4 col-6"><i class="bi bi-cup-hot text-primary me-2"></i> Caretaker / Kitchen</div>
                        </div>
                    }

                    <!-- Location & Google Maps -->
                    <h5 class="fw-bold mt-4 mb-3 text-dark"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Location & Driving Directions</h5>
                    <div class="card border rounded-4 p-3 bg-light mb-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <h6 class="fw-bold mb-1">@(string.IsNullOrEmpty(Model.FormattedAddress) ? Model.Location : Model.FormattedAddress)</h6>
                                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                                {
                                    <span class="text-muted small font-monospace">GPS: @Model.Latitude.Value.ToString("0.0000"), @Model.Longitude.Value.ToString("0.0000")</span>
                                }
                            </div>
                            @{
                                var hasDirectMapUrl = !string.IsNullOrWhiteSpace(Model.MapUrl);
                                var mapHref = hasDirectMapUrl 
                                    ? Model.MapUrl 
                                    : (Model.Latitude.HasValue && Model.Longitude.HasValue 
                                        ? $"https://www.google.com/maps/search/?api=1&query={Model.Latitude.Value},{Model.Longitude.Value}" 
                                        : $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(Model.Location)}");
                            }
                            <a href="@mapHref" target="_blank" class="btn btn-outline-success rounded-pill px-3">
                                <i class="bi bi-compass me-1"></i> @(hasDirectMapUrl ? "Open Verified Location Link" : "Open in Google Maps")
                            </a>
                        </div>
                    </div>

                    <!-- Transparent Cancellation Policy -->
                    <h5 class="fw-bold mt-4 mb-3 text-dark"><i class="bi bi-shield-check text-primary me-2"></i>Transparent Cancellation & Refund Policy</h5>
                    <div class="card border rounded-4 p-3 bg-light mb-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="p-2 border rounded-3 bg-white h-100">
                                    <div class="fw-bold text-success mb-1"><i class="bi bi-check-circle-fill me-1"></i>Free Cancellation</div>
                                    <small class="text-muted d-block">Up to <strong>@Model.FreeCancellationWindowHours hours</strong> prior to check-in. Full refund minus 2% payment gateway fee.</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-2 border rounded-3 bg-white h-100">
                                    <div class="fw-bold text-warning text-dark mb-1"><i class="bi bi-clock-history me-1"></i>Partial Refund</div>
                                    <small class="text-muted d-block">Between <strong>@Model.FreeCancellationWindowHours h and @Model.CancellationCutoffHours h</strong> prior. Cancellation fee of @(Model.CancellationFeeType == "percentage" ? $"{Model.CancellationFeeValue:N0}%" : $"₹{Model.CancellationFeeValue:N0}") applies.</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-2 border rounded-3 bg-white h-100">
                                    <div class="fw-bold text-danger mb-1"><i class="bi bi-x-circle-fill me-1"></i>Strict Non-Refundable</div>
                                    <small class="text-muted d-block">Within <strong>@Model.CancellationCutoffHours hours</strong> of check-in or post-check-in, cancellations are strictly non-refundable.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (reviews.Any())
                    {
                        <!-- Reviews Section -->
                        <hr class="my-4" />
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="fw-bold mb-0 text-dark">Guest Reviews (@reviews.Count)</h4>
                            <span class="text-warning fs-5">⭐ @avgRating.ToString("0.0") / 5.0</span>
                        </div>

                        <div class="list-group list-group-flush">
                            @foreach (var r in reviews)
                            {
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <strong class="text-dark">@r.ClientName</strong>
                                        <span class="text-warning">@string.Concat(Enumerable.Repeat("⭐", r.Rating))</span>
                                    </div>
                                    <small class="text-muted d-block mb-1">Verified Guest Stay</small>
                                    <p class="mb-0 text-secondary">@r.Comment</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sticky Booking Widget -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 sticky-top @(isUnavailable ? "property-detail-unavailable" : "")" id="bookingWidgetCard" style="top: 5rem;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-muted small">Starting from</span>
                            <h3 class="fw-bold text-success mb-0">₹@Model.PricePerNight.ToString("N0") <small class="text-muted fs-6">/ night</small></h3>
                        </div>
                        <div id="availabilityBadgeContainer">
                            @if (isUnavailable)
                            {
                                <span class="badge bg-danger p-2 px-3 rounded-pill" id="availBadge">
                                    <i class="bi bi-calendar-x me-1"></i> Not available for these dates
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success p-2 px-3 rounded-pill" id="availBadge">
                                    <i class="bi bi-check-circle me-1"></i> Available
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Stay Dates Selector -->
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <label class="form-label fw-bold small text-muted text-uppercase mb-2">
                            <i class="bi bi-calendar-range text-primary me-1"></i> Your Stay Dates
                        </label>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="small text-muted mb-1" for="widgetCheckIn">Check-In</label>
                                <input type="date" id="widgetCheckIn" class="form-control form-control-sm" value="@selectedIn" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="col-6">
                                <label class="small text-muted mb-1" for="widgetCheckOut">Check-Out</label>
                                <input type="date" id="widgetCheckOut" class="form-control form-control-sm" value="@selectedOut" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                    </div>

                    <!-- Nearest Available Date Suggestions (Visible when unavailable) -->
                    <div id="suggestionsSection" class="@(isUnavailable ? "" : "d-none") mb-3">
                        <div class="alert alert-warning border-0 p-3 rounded-3 mb-0" id="suggestionAlert">
                            <div class="fw-bold text-dark small mb-1" id="suggestionTitle">
                                @if (avail != null && avail.Suggestions.Any())
                                {
                                    <i class="bi bi-calendar-event text-warning me-1"></i>
                                    <span>Nearest available dates: @avail.Suggestions.First().FormattedRange (@avail.Nights @(avail.Nights == 1 ? "night" : "nights"))</span>
                                }
                                else if (isUnavailable)
                                {
                                    <span>No nearby dates available. Try a different range.</span>
                                }
                            </div>
                            <div class="small text-muted mb-2" id="suggestionSubtext" style="@(avail?.Suggestions.Any() == true ? "" : "display:none;")">Tap a suggestion to fill these dates:</div>
                            <div class="d-flex flex-wrap gap-2" id="suggestionChipsContainer">
                                @if (avail != null && avail.Suggestions.Any())
                                {
                                    @foreach (var s in avail.Suggestions)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill suggestion-chip-btn"
                                                data-in="@s.CheckInDate.ToString("yyyy-MM-dd")"
                                                data-out="@s.CheckOutDate.ToString("yyyy-MM-dd")">
                                            <i class="bi bi-calendar-check me-1"></i>@s.FormattedRange
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    @if (Model.SecurityDepositAmount > 0)
                    {
                        <div class="p-2 bg-light border rounded-3 mb-3 small d-flex align-items-center justify-content-between">
                            <span class="text-secondary"><i class="bi bi-shield-lock text-success me-1"></i>Security Deposit Hold</span>
                            <strong class="text-dark">₹@Model.SecurityDepositAmount.ToString("N0")</strong>
                        </div>
                    }

                    <div class="alert alert-light border small text-muted mb-3">
                        <i class="bi bi-info-circle text-primary me-1"></i> Flexible booking options available: <strong>Full Day, Half Day</strong> (Morning / Evening slot), or <strong>Hourly</strong> bookings!
                    </div>

                    <div class="d-grid gap-2">
                        <a id="checkoutBtn" asp-controller="Booking" asp-action="Checkout" asp-route-propertyId="@Model.PropertyID" class="btn btn-warning btn-lg fw-bold py-3 shadow-sm rounded-pill">
                            <i class="bi bi-calendar-check me-1"></i> Book Flexible Stay Now
                        </a>
                    </div>

                    <div class="text-center mt-3">
                        <small class="text-muted"><i class="bi bi-shield-check text-success me-1"></i> PCI-DSS compliant secure checkout</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Sticky Booking Bar (Visible on mobile/tablet screens < 992px) -->
    <div class="mobile-booking-bottom-bar d-lg-none">
        <div class="container d-flex align-items-center justify-content-between gap-3 px-1">
            <div>
                <div class="small text-muted" style="font-size: 0.72rem; line-height: 1.1;">Starting from</div>
                <div class="fw-bold text-success" style="font-size: 1.25rem;">
                    ₹@Model.PricePerNight.ToString("N0") <span class="text-muted fw-normal" style="font-size: 0.8rem;">/ night</span>
                </div>
            </div>
            <a id="mobileCheckoutBtn" asp-controller="Booking" asp-action="Checkout" asp-route-propertyId="@Model.PropertyID" class="btn btn-warning fw-bold px-4 py-2 rounded-pill shadow-sm flex-shrink-0">
                <i class="bi bi-calendar-check me-1"></i> Book Stay Now
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const gallery = document.getElementById('propertyGallery');
        const mainImg = document.getElementById('galleryMainImg');
        const prevBtn = document.getElementById('galleryPrevBtn');
        const nextBtn = document.getElementById('galleryNextBtn');
        const counter = document.getElementById('galleryCounter');
        const thumbBtns = document.querySelectorAll('.gallery-thumb-item');

        if (!gallery || !mainImg || thumbBtns.length <= 1) return;

        let currentIndex = 0;
        const total = thumbBtns.length;

        function goToImage(index) {
            if (index < 0) index = total - 1;
            if (index >= total) index = 0;
            currentIndex = index;

            const targetBtn = thumbBtns[currentIndex];
            if (!targetBtn) return;
            const newSrc = targetBtn.getAttribute('data-src');

            mainImg.style.opacity = '0.35';
            setTimeout(() => {
                mainImg.src = newSrc;
                mainImg.style.opacity = '1';
            }, 70);

            thumbBtns.forEach((btn, idx) => {
                if (idx === currentIndex) {
                    btn.classList.add('active');
                    btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
                } else {
                    btn.classList.remove('active');
                }
            });

            if (counter) {
                counter.textContent = `${currentIndex + 1} / ${total}`;
            }
        }

        // Clicking or Hovering a thumbnail changes the big image (Flipkart style)
        thumbBtns.forEach((btn, idx) => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                goToImage(idx);
            });
            btn.addEventListener('mouseenter', () => {
                goToImage(idx);
            });
        });

        // Left & Right Arrow Navigation
        if (prevBtn) {
            prevBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                goToImage(currentIndex - 1);
            });
        }
        if (nextBtn) {
            nextBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                goToImage(currentIndex + 1);
            });
        }

        // Keyboard Navigation (ArrowLeft / ArrowRight)
        gallery.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') {
                e.preventDefault();
                goToImage(currentIndex - 1);
            } else if (e.key === 'ArrowRight') {
                e.preventDefault();
                goToImage(currentIndex + 1);
            }
        });

        let isHovered = false;
        gallery.addEventListener('mouseenter', () => isHovered = true);
        gallery.addEventListener('mouseleave', () => isHovered = false);

        window.addEventListener('keydown', (e) => {
            if (!isHovered) return;
            if (e.key === 'ArrowLeft') {
                e.preventDefault();
                goToImage(currentIndex - 1);
            } else if (e.key === 'ArrowRight') {
                e.preventDefault();
                goToImage(currentIndex + 1);
            }
        });

        // Touch Swipe on Mobile
        const stage = document.getElementById('galleryStage') || gallery;
        let touchStartX = 0;
        let touchStartY = 0;

        stage.addEventListener('touchstart', (e) => {
            if (e.touches.length === 1) {
                touchStartX = e.touches[0].clientX;
                touchStartY = e.touches[0].clientY;
            }
        }, { passive: true });

        stage.addEventListener('touchend', (e) => {
            if (e.changedTouches.length === 1) {
                const touchEndX = e.changedTouches[0].clientX;
                const touchEndY = e.changedTouches[0].clientY;
                const deltaX = touchEndX - touchStartX;
                const deltaY = touchEndY - touchStartY;

                // Trigger if horizontal swipe > 40px and dominant over vertical scroll
                if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
                    if (deltaX < 0) {
                        goToImage(currentIndex + 1); // Swiped Left -> Next
                    } else {
                        goToImage(currentIndex - 1); // Swiped Right -> Prev
                    }
                }
            }
        }, { passive: true });
    })();

    // Property Date Availability & Nearest Suggestions Engine (Item 7)
    (function () {
        const propId = @Model.PropertyID;
        const checkInInput = document.getElementById('widgetCheckIn');
        const checkOutInput = document.getElementById('widgetCheckOut');
        const widgetCard = document.getElementById('bookingWidgetCard');
        const badgeContainer = document.getElementById('availabilityBadgeContainer');
        const suggestionsSection = document.getElementById('suggestionsSection');
        const suggestionTitle = document.getElementById('suggestionTitle');
        const suggestionSubtext = document.getElementById('suggestionSubtext');
        const suggestionChipsContainer = document.getElementById('suggestionChipsContainer');
        const checkoutBtn = document.getElementById('checkoutBtn');
        const mobileCheckoutBtn = document.getElementById('mobileCheckoutBtn');

        if (!checkInInput || !checkOutInput) return;

        function updateCheckoutLinks(inVal, outVal) {
            const baseUri = '/Booking/Checkout?propertyId=' + propId + '&checkIn=' + encodeURIComponent(inVal) + '&checkOut=' + encodeURIComponent(outVal);
            if (checkoutBtn) checkoutBtn.href = baseUri;
            if (mobileCheckoutBtn) mobileCheckoutBtn.href = baseUri;
        }

        function bindSuggestionChips() {
            const chips = document.querySelectorAll('.suggestion-chip-btn');
            chips.forEach(btn => {
                btn.onclick = function () {
                    const inDate = this.getAttribute('data-in');
                    const outDate = this.getAttribute('data-out');
                    if (inDate && outDate) {
                        checkInInput.value = inDate;
                        checkOutInput.value = outDate;
                        updateCheckoutLinks(inDate, outDate);
                        fetchAvailability(inDate, outDate);
                    }
                };
            });
        }

        async function fetchAvailability(inDate, outDate) {
            if (!inDate || !outDate || outDate <= inDate) return;

            updateCheckoutLinks(inDate, outDate);

            try {
                const res = await fetch('/api/properties/' + propId + '/availability/suggestions?checkIn=' + encodeURIComponent(inDate) + '&checkOut=' + encodeURIComponent(outDate));
                if (!res.ok) return;

                const data = await res.json();
                if (data.isRequestedAvailable) {
                    if (widgetCard) widgetCard.classList.remove('property-detail-unavailable');
                    if (badgeContainer) {
                        badgeContainer.innerHTML = '<span class="badge bg-success p-2 px-3 rounded-pill" id="availBadge"><i class="bi bi-check-circle me-1"></i> Available</span>';
                    }
                    if (suggestionsSection) suggestionsSection.classList.add('d-none');
                } else {
                    if (widgetCard) widgetCard.classList.add('property-detail-unavailable');
                    if (badgeContainer) {
                        badgeContainer.innerHTML = '<span class="badge bg-danger p-2 px-3 rounded-pill" id="availBadge"><i class="bi bi-calendar-x me-1"></i> Not available for these dates</span>';
                    }
                    if (suggestionsSection) {
                        suggestionsSection.classList.remove('d-none');
                        if (data.suggestions && data.suggestions.length > 0) {
                            suggestionTitle.innerHTML = '<i class="bi bi-calendar-event text-warning me-1"></i> Nearest available dates: ' + data.suggestions[0].formattedRange + ' (' + data.nights + (data.nights === 1 ? ' night)' : ' nights)');
                            if (suggestionSubtext) suggestionSubtext.style.display = 'block';

                            let chipsHtml = '';
                            data.suggestions.forEach(s => {
                                const inStr = s.checkInDate ? s.checkInDate.substring(0, 10) : '';
                                const outStr = s.checkOutDate ? s.checkOutDate.substring(0, 10) : '';
                                chipsHtml += '<button type="button" class="btn btn-sm btn-outline-primary rounded-pill suggestion-chip-btn" data-in="' + inStr + '" data-out="' + outStr + '"><i class="bi bi-calendar-check me-1"></i>' + s.formattedRange + '</button>';
                            });
                            suggestionChipsContainer.innerHTML = chipsHtml;
                            bindSuggestionChips();
                        } else {
                            suggestionTitle.innerHTML = 'No nearby dates available. Try a different range.';
                            if (suggestionSubtext) suggestionSubtext.style.display = 'none';
                            suggestionChipsContainer.innerHTML = '';
                        }
                    }
                }
            } catch (e) {
                console.warn('Availability check failed:', e);
            }
        }

        checkInInput.addEventListener('change', () => {
            if (checkOutInput.value <= checkInInput.value) {
                const nextDay = new Date(checkInInput.value);
                nextDay.setDate(nextDay.getDate() + 1);
                checkOutInput.value = nextDay.toISOString().split('T')[0];
            }
            fetchAvailability(checkInInput.value, checkOutInput.value);
        });

        checkOutInput.addEventListener('change', () => {
            fetchAvailability(checkInInput.value, checkOutInput.value);
        });

        bindSuggestionChips();
        updateCheckoutLinks(checkInInput.value, checkOutInput.value);
    })();
</script>
}
