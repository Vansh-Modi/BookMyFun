@model BookMyFun.Models.Entities.Property
@{
    ViewData["Title"] = Model.Title + " - Property Details";
    var reviews = ViewBag.Reviews as List<BookMyFun.Models.Entities.CustomerReview> ?? new();
    double? avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : null;

    // Single source of truth: PropertyMedia (MediaType: "image" or "video", or "photo" from legacy data). Ordered by SortOrder, then MediaID.
    var rawMedia = (Model.MediaList ?? new List<BookMyFun.Models.Entities.PropertyMedia>())
        .Where(m => !string.IsNullOrWhiteSpace(m.StorageUrl) &&
                    !m.StorageUrl.Contains("test.jpg") &&
                    !m.StorageUrl.Contains("placeholder"))
        .OrderBy(m => m.SortOrder)
        .ThenBy(m => m.MediaID)
        .ToList();

    var gallerySlides = rawMedia.Select(m => new {
        MediaID = m.MediaID,
        MediaType = m.MediaType.Equals("video", StringComparison.OrdinalIgnoreCase) ? "video" : "image",
        StorageUrl = m.StorageUrl,
        IsPrimary = m.IsPrimary,
        SortOrder = m.SortOrder
    }).ToList();

    if (!gallerySlides.Any() && !string.IsNullOrWhiteSpace(Model.PrimaryImageUrl) &&
        !Model.PrimaryImageUrl.Contains("test.jpg") && !Model.PrimaryImageUrl.Contains("placeholder"))
    {
        gallerySlides.Add(new {
            MediaID = 0,
            MediaType = "image",
            StorageUrl = Model.PrimaryImageUrl,
            IsPrimary = true,
            SortOrder = 0
        });
    }

    if (!gallerySlides.Any())
    {
        gallerySlides.Add(new {
            MediaID = 0,
            MediaType = "image",
            StorageUrl = "/images/property-placeholder.jpg",
            IsPrimary = true,
            SortOrder = 0
        });
    }

    var avail = ViewBag.AvailabilityResult as BookMyFun.Services.AvailabilitySuggestionResult;
    bool isUnavailable = avail != null && !avail.IsRequestedAvailable;
        string selectedIn = ViewBag.SelectedCheckIn as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    string selectedOut = ViewBag.SelectedCheckOut as string ?? DateTime.Today.AddDays(1).ToString("yyyy-MM-dd");
    DateTime? selectedInDate = DateTime.TryParse(selectedIn, out var parsedIn) ? parsedIn : DateTime.Today;
    DateTime? selectedOutDate = DateTime.TryParse(selectedOut, out var parsedOut) ? parsedOut : DateTime.Today.AddDays(1);
    int nights = selectedInDate.HasValue && selectedOutDate.HasValue && selectedOutDate.Value > selectedInDate.Value ? (selectedOutDate.Value - selectedInDate.Value).Days : 1;
}

<style>
    .property-detail-unavailable {
        border: 2px solid #ef4444 !important;
        opacity: 0.88;
    }
    .property-detail-unavailable .card-body {
        background: linear-gradient(180deg, rgba(254, 242, 242, 0.5) 0%, #ffffff 100%);
    }
    .suggestion-chip-btn {
        transition: all 0.2s ease;
        font-weight: 600;
        cursor: pointer;
    }
    .suggestion-chip-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(11, 79, 108, 0.15);
    }
</style>

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Properties" asp-action="Index">Stays</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Flipkart-Style Interactive Gallery -->
            <div class="flipkart-gallery shadow-sm" id="propertyGallery" tabindex="0" aria-label="Property Image and Video Gallery">
                <!-- Large Active Slide Stage (Fixed Aspect 16:9 Frame) -->
                <div class="gallery-main-stage" id="galleryStage">
                    <div id="gallerySlideContainer" class="w-100 h-100 position-relative">
                        @for (int i = 0; i < gallerySlides.Count; i++)
                        {
                            var s = gallerySlides[i];
                            var isFirst = i == 0;
                            var isPreloadable = i <= 1; // Lazy-load every slide except current and next
                            if (s.MediaType == "video")
                            {
                                <video id="slide-media-@i"
                                       class="gallery-slide-item gallery-main-video"
                                       data-index="@i"
                                       data-media-id="@s.MediaID"
                                       data-type="video"
                                       preload="metadata"
                                       controls
                                       playsinline
                                       style="@(isFirst ? "display:block;" : "display:none;")"
                                       src="@(isPreloadable ? s.StorageUrl : "")"
                                       data-src="@s.StorageUrl">
                                    Your browser does not support HTML5 video.
                                </video>
                            }
                            else
                            {
                                <img id="slide-media-@i"
                                     class="gallery-slide-item gallery-main-img"
                                     data-index="@i"
                                     data-media-id="@s.MediaID"
                                     data-type="image"
                                     src="@(isPreloadable ? s.StorageUrl : "")"
                                     data-src="@s.StorageUrl"
                                     alt="@Model.Title - Slide @(i + 1)"
                                     loading="@(isFirst ? "eager" : "lazy")"
                                     style="@(isFirst ? "display:block;" : "display:none;")" />
                            }
                        }
                    </div>

                    @if (gallerySlides.Count > 1)
                    {
                        <button type="button" class="gallery-nav-btn prev" id="galleryPrevBtn" aria-label="Previous slide">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button type="button" class="gallery-nav-btn next" id="galleryNextBtn" aria-label="Next slide">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                        <div class="gallery-counter" id="galleryCounter">1 / @gallerySlides.Count</div>
                    }
                </div>

                <!-- Horizontal Scrollable Row of Thumbnails Below Active Stage -->
                @if (gallerySlides.Count > 1)
                {
                    <div class="gallery-thumbnails-wrap">
                        <div class="gallery-thumbnails" id="galleryThumbnails">
                            @for (int i = 0; i < gallerySlides.Count; i++)
                            {
                                var s = gallerySlides[i];
                                <button type="button"
                                        class="gallery-thumb-item position-relative @(i == 0 ? "active" : "")"
                                        id="thumb-btn-@i"
                                        data-index="@i"
                                        data-media-id="@s.MediaID"
                                        aria-label="View slide @(i + 1) of @gallerySlides.Count">
                                    @if (s.MediaType == "video")
                                    {
                                        <span class="gallery-video-badge" aria-hidden="true">
                                            <i class="bi bi-play-fill"></i>
                                        </span>
                                        <video src="@s.StorageUrl" preload="metadata" muted class="gallery-thumb-img"></video>
                                    }
                                    else
                                    {
                                        <img src="@s.StorageUrl"
                                             alt="Thumbnail @(i + 1)"
                                             width="96"
                                             height="64"
                                             loading="lazy"
                                             class="gallery-thumb-img" />
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Property Details Card -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-body p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                        <div>
                            <span class="badge bg-secondary rounded-pill mb-2">@Model.PropertyTypeName</span>
                            <h2 class="fw-bold mb-1 text-dark">@Model.Title</h2>
                            <p class="text-muted mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Location</p>
                        </div>
                        @if (reviews.Any() && avgRating.HasValue)
                        {
                            <div class="text-end">
                                <div class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill shadow-sm">
                                    ⭐ @avgRating.Value.ToString("0.0") (@reviews.Count reviews)
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Highlight Badges -->
                    <div class="row g-3 py-3 border-top border-bottom my-3 text-center">
                        <div class="col-4">
                            <i class="bi bi-people-fill fs-4 text-primary d-block mb-1"></i>
                            <span class="text-muted small">Max Capacity</span>
                            <div class="fw-bold">@Model.MaxGuests Guests</div>
                        </div>
                        <div class="col-4">
                            <i class="bi bi-house-door-fill fs-4 text-success d-block mb-1"></i>
                            <span class="text-muted small">Property Type</span>
                            <div class="fw-bold">@Model.PropertyTypeName</div>
                        </div>
                        <div class="col-4">
                            <i class="bi bi-shield-check fs-4 text-warning d-block mb-1"></i>
                            <span class="text-muted small">Host Verification</span>
                            <div class="fw-bold text-success">Verified Partner</div>
                        </div>
                    </div>

                    <!-- Description -->
                    <h5 class="fw-bold mt-4 mb-2 text-dark">About this Property</h5>
                    <p class="text-secondary leading-relaxed mb-4">
                        @(Model.Description ?? "Experience a luxurious and tranquil escape. Perfect for family reunions, weekend getaways, pool parties, or celebrations with unmatched privacy.")
                    </p>

                    <!-- Amenities Taxonomy -->
                    <h5 class="fw-bold mt-4 mb-3 text-dark"><i class="bi bi-grid-fill text-success me-2"></i>Features & Amenities</h5>
                    @if (Model.Amenities != null && Model.Amenities.Any())
                    {
                        <div class="row row-cols-2 row-cols-md-3 g-3 mb-4">
                            @foreach (var am in Model.Amenities)
                            {
                                <div class="col">
                                    <div class="p-2 border rounded-3 bg-light d-flex align-items-center gap-2">
                                        <i class="bi @am.IconClass text-success fs-5"></i>
                                        <span class="small fw-medium text-dark">@am.AmenityName</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="row g-2 mb-4">
                            <div class="col-md-4 col-6"><i class="bi bi-water text-primary me-2"></i> Swimming Pool</div>
                            <div class="col-md-4 col-6"><i class="bi bi-wifi text-primary me-2"></i> High-Speed WiFi</div>
                            <div class="col-md-4 col-6"><i class="bi bi-snow text-primary me-2"></i> Air Conditioning</div>
                            <div class="col-md-4 col-6"><i class="bi bi-p-square text-primary me-2"></i> Free Onsite Parking</div>
                            <div class="col-md-4 col-6"><i class="bi bi-music-note-beamed text-primary me-2"></i> Lawn & Audio System</div>
                            <div class="col-md-4 col-6"><i class="bi bi-cup-hot text-primary me-2"></i> Caretaker / Kitchen</div>
                        </div>
                    }

                    <!-- Location & Google Maps -->
                    <h5 class="fw-bold mt-4 mb-3 text-dark"><i class="bi bi-geo-alt-fill text-danger me-2"></i>Location & Driving Directions</h5>
                    <div class="card border rounded-4 p-3 bg-light mb-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <h6 class="fw-bold mb-1">@(string.IsNullOrEmpty(Model.FormattedAddress) ? Model.Location : Model.FormattedAddress)</h6>
                                @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                                {
                                    <span class="text-muted small font-monospace">GPS: @Model.Latitude.Value.ToString("0.0000"), @Model.Longitude.Value.ToString("0.0000")</span>
                                }
                            </div>
                            @{
                                var hasDirectMapUrl = !string.IsNullOrWhiteSpace(Model.MapUrl);
                                var mapHref = hasDirectMapUrl 
                                    ? Model.MapUrl 
                                    : (Model.Latitude.HasValue && Model.Longitude.HasValue 
                                        ? $"https://www.google.com/maps/search/?api=1&query={Model.Latitude.Value},{Model.Longitude.Value}" 
                                        : $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(Model.Location)}");
                            }
                            <a href="@mapHref" target="_blank" class="btn btn-outline-success rounded-pill px-3">
                                <i class="bi bi-compass me-1"></i> @(hasDirectMapUrl ? "Open Verified Location Link" : "Open in Google Maps")
                            </a>
                        </div>
                    </div>

                    <!-- Transparent Cancellation Policy -->
                    <h5 class="fw-bold mt-4 mb-3 text-dark"><i class="bi bi-shield-check text-primary me-2"></i>Transparent Cancellation & Refund Policy</h5>
                    <div class="card border rounded-4 p-3 bg-light mb-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="p-2 border rounded-3 bg-white h-100">
                                    <div class="fw-bold text-success mb-1"><i class="bi bi-check-circle-fill me-1"></i>Free Cancellation</div>
                                    <small class="text-muted d-block">Up to <strong>@Model.FreeCancellationWindowHours hours</strong> prior to check-in. Full refund minus 2% payment gateway fee.</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-2 border rounded-3 bg-white h-100">
                                    <div class="fw-bold text-warning text-dark mb-1"><i class="bi bi-clock-history me-1"></i>Partial Refund</div>
                                    <small class="text-muted d-block">Between <strong>@Model.FreeCancellationWindowHours h and @Model.CancellationCutoffHours h</strong> prior. Cancellation fee of @(Model.CancellationFeeType == "percentage" ? $"{Model.CancellationFeeValue:N0}%" : $"₹{Model.CancellationFeeValue:N0}") applies.</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-2 border rounded-3 bg-white h-100">
                                    <div class="fw-bold text-danger mb-1"><i class="bi bi-x-circle-fill me-1"></i>Strict Non-Refundable</div>
                                    <small class="text-muted d-block">Within <strong>@Model.CancellationCutoffHours hours</strong> of check-in or post-check-in, cancellations are strictly non-refundable.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (reviews.Any() && avgRating.HasValue)
                    {
                        <!-- Reviews Section -->
                        <hr class="my-4" />
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="fw-bold mb-0 text-dark">Guest Reviews (@reviews.Count)</h4>
                            <span class="text-warning fs-5">⭐ @avgRating.Value.ToString("0.0") / 5.0</span>
                        </div>

                        <div class="list-group list-group-flush">
                            @foreach (var r in reviews)
                            {
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <strong class="text-dark">@r.ClientName</strong>
                                        <span class="text-warning">@string.Concat(Enumerable.Repeat("⭐", r.Rating))</span>
                                    </div>
                                    <small class="text-muted d-block mb-1">Verified Guest Stay</small>
                                    <p class="mb-0 text-secondary">@r.Comment</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sticky Booking Widget -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 sticky-top @(isUnavailable ? "property-detail-unavailable" : "")" id="bookingWidgetCard" style="top: calc(var(--header-height, 70px) + 1.25rem); z-index: 90;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <span class="text-muted small">Starting from</span>
                            <h3 class="fw-bold text-success mb-0">₹@Model.PricePerNight.ToString("N0") <small class="text-muted fs-6">/ night</small></h3>
                        </div>
                        <div id="availabilityBadgeContainer">
                            @if (isUnavailable)
                            {
                                <span class="badge bg-danger p-2 px-3 rounded-pill" id="availBadge">
                                    <i class="bi bi-calendar-x me-1"></i> Not available for these dates
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success p-2 px-3 rounded-pill" id="availBadge">
                                    <i class="bi bi-check-circle me-1"></i> Available
                                </span>
                            }
                        </div>
                    </div>

                    <!-- Stay Dates Unified Range Selector (Section 6C) -->
                    <div class="mb-3 position-relative">
                        <label class="form-label fw-bold small text-muted text-uppercase mb-2 d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-calendar-range text-primary me-1"></i> Your Stay Dates</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small" id="nightsCountBadge">
                                @(nights > 0 ? $"{nights} {(nights == 1 ? "night" : "nights")}" : "Select dates")
                            </span>
                        </label>
                        <div class="p-2.5 px-3 bg-light border rounded-3 d-flex align-items-center justify-content-between cursor-pointer" id="detailsDateRangeTrigger" tabindex="0" role="button" aria-haspopup="dialog" aria-expanded="false" title="Click to choose stay dates">
                            <div class="d-flex align-items-center gap-2 overflow-hidden">
                                <i class="bi bi-calendar3 text-primary"></i>
                                <span class="fw-semibold text-dark small text-truncate" id="detailsDateRangeText">
                                    @if (selectedInDate.HasValue && selectedOutDate.HasValue)
                                    {
                                        @($"{selectedInDate.Value:dd MMM} – {selectedOutDate.Value:dd MMM yyyy}")
                                    }
                                    else
                                    {
                                        <span>Choose Check-in &amp; Check-out</span>
                                    }
                                </span>
                            </div>
                            <i class="bi bi-chevron-down text-muted small ms-2"></i>
                        </div>
                        <input type="hidden" id="widgetCheckIn" value="@selectedIn" />
                        <input type="hidden" id="widgetCheckOut" value="@selectedOut" />

                        <!-- Compact Popup Range Calendar -->
                        <div class="catalog-calendar-popover" id="detailsCalendarPopover" style="width: 100%; max-width: 330px; display: none;" role="dialog">
                            <div class="cal-header-row">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle" id="detailsCalPrev" style="width: 30px; height: 30px; padding: 0;">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <span class="fw-bold small text-dark" id="detailsCalMonthTitle"></span>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle" id="detailsCalNext" style="width: 30px; height: 30px; padding: 0;">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </div>
                            <div class="cal-grid-weekdays">
                                <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                            </div>
                            <div class="cal-grid-days" id="detailsCalDaysGrid"></div>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <button type="button" class="btn btn-link btn-sm text-secondary p-0 text-decoration-none fw-semibold" id="detailsCalClear">Clear</button>
                                <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-xs" id="detailsCalApply">Apply</button>
                            </div>
                        </div>
                    </div>

                    <!-- Live Price Breakdown (No Security Deposit) -->
                    <div class="p-3 bg-light rounded-3 border mb-3" id="livePriceBreakdown">
                        <div class="d-flex justify-content-between mb-1 small">
                            <span class="text-muted">₹@Model.PricePerNight.ToString("N0") × <span id="calcNightsLabel">@(Math.Max(1, nights))</span> nights</span>
                            <strong class="text-dark" id="calcStaySubtotal">₹@((Model.PricePerNight * Math.Max(1, nights)).ToString("N0"))</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1 small text-muted">
                            <span>Total payable</span>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="fw-bold text-dark small">Total (INR)</span>
                            <h4 class="fw-bold text-success mb-0" id="calcTotalAmount">₹@((Model.PricePerNight * Math.Max(1, nights)).ToString("N0"))</h4>
                        </div>
                    </div>

                    <!-- Nearest Available Date Suggestions (Visible when unavailable) -->
                    <div id="suggestionsSection" class="@(isUnavailable ? "" : "d-none") mb-3">
                        <div class="alert alert-warning border-0 p-3 rounded-3 mb-0" id="suggestionAlert">
                            <div class="fw-bold text-dark small mb-1" id="suggestionTitle">
                                @if (avail != null && avail.Suggestions.Any())
                                {
                                    <i class="bi bi-calendar-event text-warning me-1"></i>
                                    <span>Nearest available dates: @avail.Suggestions.First().FormattedRange (@avail.Nights @(avail.Nights == 1 ? "night" : "nights"))</span>
                                }
                                else if (isUnavailable)
                                {
                                    <span>No nearby dates available. Try a different range.</span>
                                }
                            </div>
                            <div class="small text-muted mb-2" id="suggestionSubtext" style="@(avail?.Suggestions.Any() == true ? "" : "display:none;")">Tap a suggestion to fill these dates:</div>
                            <div class="d-flex flex-wrap gap-2" id="suggestionChipsContainer">
                                @if (avail != null && avail.Suggestions.Any())
                                {
                                    @foreach (var s in avail.Suggestions)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill suggestion-chip-btn"
                                                data-in="@s.CheckInDate.ToString("yyyy-MM-dd")"
                                                data-out="@s.CheckOutDate.ToString("yyyy-MM-dd")">
                                            <i class="bi bi-calendar-check me-1"></i>@s.FormattedRange
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>



                    <div class="alert alert-light border small text-muted mb-3">
                        <i class="bi bi-info-circle text-primary me-1"></i> Flexible booking options available: <strong>Full Day, Half Day</strong> (Morning / Evening slot), or <strong>Hourly</strong> bookings!
                    </div>

                    <div class="d-grid gap-2">
                        <a id="checkoutBtn" asp-controller="Booking" asp-action="Checkout" asp-route-propertyId="@Model.PropertyID" class="btn btn-warning btn-lg fw-bold py-3 shadow-sm rounded-pill">
                            <i class="bi bi-calendar-check me-1"></i> Book Flexible Stay Now
                        </a>
                    </div>

                    <div class="text-center mt-3">
                        <small class="text-muted"><i class="bi bi-shield-check text-success me-1"></i> PCI-DSS compliant secure checkout</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Sticky Booking Bar (Visible on mobile/tablet screens < 992px) -->
    <div class="mobile-booking-bottom-bar d-lg-none">
        <div class="container d-flex align-items-center justify-content-between gap-3 px-1">
            <div>
                <div class="small text-muted" style="font-size: 0.72rem; line-height: 1.1;">Starting from</div>
                <div class="fw-bold text-success" style="font-size: 1.25rem;">
                    ₹@Model.PricePerNight.ToString("N0") <span class="text-muted fw-normal" style="font-size: 0.8rem;">/ night</span>
                </div>
            </div>
            <a id="mobileCheckoutBtn" asp-controller="Booking" asp-action="Checkout" asp-route-propertyId="@Model.PropertyID" class="btn btn-warning fw-bold px-4 py-2 rounded-pill shadow-sm flex-shrink-0">
                <i class="bi bi-calendar-check me-1"></i> Book Stay Now
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script type="application/json" id="propertyDetailsConfig">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
    propertyId = Model.PropertyID,
    pricePerNight = Model.PricePerNight,
    slideCount = gallerySlides.Count
}))
</script>

<script>
    // ─────────────────────────────────────────────────────────────
    // Unified Flipkart-Style Gallery Script (Images + Videos)
    // ─────────────────────────────────────────────────────────────
    (function () {
        const gallery = document.getElementById('propertyGallery');
        const prevBtn = document.getElementById('galleryPrevBtn');
        const nextBtn = document.getElementById('galleryNextBtn');
        const counter = document.getElementById('galleryCounter');
        const slideItems = Array.from(document.querySelectorAll('.gallery-slide-item'));
        const thumbBtns = Array.from(document.querySelectorAll('.gallery-thumb-item'));

        if (!gallery || slideItems.length === 0) return;

        let activeSlides = slideItems.filter(s => !s.dataset.broken);
        let currentIndex = 0;

        function handleGalleryMedia404(mediaIdOrEvent, element) {
            let mediaId = mediaIdOrEvent;
            if (mediaIdOrEvent && mediaIdOrEvent.target) {
                element = mediaIdOrEvent.target;
                mediaId = element.getAttribute('data-media-id') || element.dataset?.mediaId;
            } else if (!element && this && this.nodeType) {
                element = this;
                mediaId = mediaId || element.getAttribute('data-media-id') || element.dataset?.mediaId;
            }

            if (!element) return;
            // The handler must not throw when a slide is already hidden
            if (element.dataset.broken === 'true' || element.style.display === 'none') {
                element.dataset.broken = 'true';
                return;
            }
            element.dataset.broken = 'true';
            element.style.display = 'none';

            // Record failed media ID
            window.failedGalleryMediaIds = window.failedGalleryMediaIds || [];
            if (mediaId && !window.failedGalleryMediaIds.includes(mediaId)) {
                window.failedGalleryMediaIds.push(mediaId);
            }

            try {
                fetch('/api/health/report-media-404', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mediaId: mediaId, url: element.dataset.src || element.src })
                }).catch(() => {});
            } catch (_) {}

            const origIdx = element.getAttribute('data-index');
            const thumbBtn = document.getElementById('thumb-btn-' + origIdx);
            if (thumbBtn) thumbBtn.style.display = 'none';

            const currentActiveSlide = activeSlides[currentIndex];
            activeSlides = slideItems.filter(s => !s.dataset.broken && s.style.display !== 'none');

            if (activeSlides.length === 0) {
                if (counter) counter.textContent = '0 / 0';
                return;
            }

            // Move gallery to the next valid slide
            if (element === currentActiveSlide) {
                if (currentIndex >= activeSlides.length) {
                    currentIndex = 0;
                }
                goToSlide(currentIndex);
            } else {
                const newIdx = activeSlides.indexOf(currentActiveSlide);
                if (newIdx !== -1) {
                    currentIndex = newIdx;
                    goToSlide(currentIndex);
                } else {
                    if (currentIndex >= activeSlides.length) {
                        currentIndex = 0;
                    }
                    goToSlide(currentIndex);
                }
            }
        }
        window.handleGalleryMedia404 = handleGalleryMedia404;

        function pauseVideoIfAny(slideEl) {
            if (!slideEl) return;
            if (slideEl.tagName === 'VIDEO') {
                try {
                    slideEl.pause();
                } catch (err) {}
            }
        }

        function ensureLoaded(slideEl) {
            if (!slideEl) return;
            if (!slideEl.src && slideEl.dataset.src) {
                slideEl.src = slideEl.dataset.src;
                if (slideEl.tagName === 'VIDEO') {
                    slideEl.load();
                }
            }
        }

        function updateCounter() {
            if (counter) {
                counter.textContent = (currentIndex + 1) + ' / ' + activeSlides.length;
            }
        }

        function goToSlide(index) {
            if (activeSlides.length === 0) return;
            if (index < 0) index = activeSlides.length - 1;
            if (index >= activeSlides.length) index = 0;

            const oldSlide = activeSlides[currentIndex];
            pauseVideoIfAny(oldSlide);

            currentIndex = index;
            const currentSlide = activeSlides[currentIndex];
            ensureLoaded(currentSlide);

            const nextSlideIndex = (currentIndex + 1) % activeSlides.length;
            ensureLoaded(activeSlides[nextSlideIndex]);

            activeSlides.forEach((slide, idx) => {
                if (idx === currentIndex) {
                    slide.style.display = 'block';
                    slide.style.opacity = '1';
                } else {
                    slide.style.display = 'none';
                    pauseVideoIfAny(slide);
                }
            });

            const currentSlideOrigIndex = currentSlide.getAttribute('data-index');
            thumbBtns.forEach(btn => {
                if (btn.getAttribute('data-index') === currentSlideOrigIndex) {
                    btn.classList.add('active');
                    btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
                } else {
                    btn.classList.remove('active');
                }
            });

            updateCounter();
        }

        slideItems.forEach(slide => {
            slide.addEventListener('error', handleGalleryMedia404, true);
            if (slide.tagName === 'IMG' && slide.complete && slide.naturalWidth === 0 && slide.src) {
                handleGalleryMedia404(slide.getAttribute('data-media-id'), slide);
            }
        });

        document.querySelectorAll('.gallery-thumb-img').forEach(thumb => {
            thumb.addEventListener('error', function () {
                this.src = '/images/property-placeholder.jpg';
            });
        });

        thumbBtns.forEach(btn => {
            const btnIndex = parseInt(btn.getAttribute('data-index'), 10);
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const activeIdx = activeSlides.findIndex(s => parseInt(s.getAttribute('data-index'), 10) === btnIndex);
                if (activeIdx !== -1) goToSlide(activeIdx);
            });
            btn.addEventListener('mouseenter', () => {
                const activeIdx = activeSlides.findIndex(s => parseInt(s.getAttribute('data-index'), 10) === btnIndex);
                if (activeIdx !== -1) goToSlide(activeIdx);
            });
        });

        if (prevBtn) {
            prevBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                goToSlide(currentIndex - 1);
            });
        }
        if (nextBtn) {
            nextBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                goToSlide(currentIndex + 1);
            });
        }

        gallery.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') {
                e.preventDefault();
                goToSlide(currentIndex - 1);
            } else if (e.key === 'ArrowRight') {
                e.preventDefault();
                goToSlide(currentIndex + 1);
            }
        });

        const stage = document.getElementById('galleryStage') || gallery;
        let touchStartX = 0;
        let touchStartY = 0;

        stage.addEventListener('touchstart', (e) => {
            if (e.touches.length === 1) {
                touchStartX = e.touches[0].clientX;
                touchStartY = e.touches[0].clientY;
            }
        }, { passive: true });

        stage.addEventListener('touchend', (e) => {
            if (e.changedTouches.length === 1) {
                const deltaX = e.changedTouches[0].clientX - touchStartX;
                const deltaY = e.changedTouches[0].clientY - touchStartY;
                if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
                    if (deltaX < 0) {
                        goToSlide(currentIndex + 1);
                    } else {
                        goToSlide(currentIndex - 1);
                    }
                }
            }
        }, { passive: true });

        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (!entry.isIntersecting) {
                        const vid = entry.target.querySelector('video');
                        if (vid) pauseVideoIfAny(vid);
                    }
                });
            }, { threshold: 0.1 });
            observer.observe(stage);
        }



        window.handleGalleryThumb404 = function (mediaId, imgElement) {
            if (imgElement) imgElement.src = '/images/property-placeholder.jpg';
        };
    })();

    // ─────────────────────────────────────────────────────────────
    // Property Date Availability & Nearest Suggestions Engine
    // ─────────────────────────────────────────────────────────────
    (function () {
        const configEl = document.getElementById('propertyDetailsConfig');
        const pageConfig = configEl ? JSON.parse(configEl.textContent) : { propertyId: 0, pricePerNight: 0 };
        const propId = pageConfig.propertyId;

        const checkInInput = document.getElementById('widgetCheckIn');
        const checkOutInput = document.getElementById('widgetCheckOut');
        const widgetCard = document.getElementById('bookingWidgetCard');
        const badgeContainer = document.getElementById('availabilityBadgeContainer');
        const suggestionsSection = document.getElementById('suggestionsSection');
        const suggestionTitle = document.getElementById('suggestionTitle');
        const suggestionSubtext = document.getElementById('suggestionSubtext');
        const suggestionChipsContainer = document.getElementById('suggestionChipsContainer');
        const checkoutBtn = document.getElementById('checkoutBtn');
        const mobileCheckoutBtn = document.getElementById('mobileCheckoutBtn');

        if (!checkInInput || !checkOutInput) return;

        function updateCheckoutLinks(inVal, outVal) {
            const baseUri = '/Booking/Checkout?propertyId=' + propId + '&checkIn=' + encodeURIComponent(inVal) + '&checkOut=' + encodeURIComponent(outVal);
            if (checkoutBtn) checkoutBtn.href = baseUri;
            if (mobileCheckoutBtn) mobileCheckoutBtn.href = baseUri;
        }

        function bindSuggestionChips() {
            const chips = document.querySelectorAll('.suggestion-chip-btn');
            chips.forEach(btn => {
                btn.onclick = function () {
                    const inDate = this.getAttribute('data-in');
                    const outDate = this.getAttribute('data-out');
                    if (inDate && outDate) {
                        checkInInput.value = inDate;
                        checkOutInput.value = outDate;
                        updateCheckoutLinks(inDate, outDate);
                        fetchAvailability(inDate, outDate);
                    }
                };
            });
        }

        async function fetchAvailability(inDate, outDate) {
            if (!inDate || !outDate || outDate <= inDate) return;

            updateCheckoutLinks(inDate, outDate);

            try {
                const res = await fetch('/api/properties/' + propId + '/availability/suggestions?checkIn=' + encodeURIComponent(inDate) + '&checkOut=' + encodeURIComponent(outDate));
                if (!res.ok) return;

                const data = await res.json();
                if (data.isRequestedAvailable) {
                    if (widgetCard) widgetCard.classList.remove('property-detail-unavailable');
                    if (badgeContainer) {
                        badgeContainer.innerHTML = '<span class="badge bg-success p-2 px-3 rounded-pill" id="availBadge"><i class="bi bi-check-circle me-1"></i> Available</span>';
                    }
                    if (suggestionsSection) suggestionsSection.classList.add('d-none');
                } else {
                    if (widgetCard) widgetCard.classList.add('property-detail-unavailable');
                    if (badgeContainer) {
                        badgeContainer.innerHTML = '<span class="badge bg-danger p-2 px-3 rounded-pill" id="availBadge"><i class="bi bi-calendar-x me-1"></i> Not available for these dates</span>';
                    }
                    if (suggestionsSection) {
                        suggestionsSection.classList.remove('d-none');
                        if (data.suggestions && data.suggestions.length > 0) {
                            suggestionTitle.innerHTML = '<i class="bi bi-calendar-event text-warning me-1"></i> Nearest available dates: ' + data.suggestions[0].formattedRange + ' (' + data.nights + (data.nights === 1 ? ' night)' : ' nights)');
                            if (suggestionSubtext) suggestionSubtext.style.display = 'block';

                            let chipsHtml = '';
                            data.suggestions.forEach(s => {
                                const inStr = s.checkInDate ? s.checkInDate.substring(0, 10) : '';
                                const outStr = s.checkOutDate ? s.checkOutDate.substring(0, 10) : '';
                                chipsHtml += '<button type="button" class="btn btn-sm btn-outline-primary rounded-pill suggestion-chip-btn" data-in="' + inStr + '" data-out="' + outStr + '"><i class="bi bi-calendar-check me-1"></i>' + s.formattedRange + '</button>';
                            });
                            suggestionChipsContainer.innerHTML = chipsHtml;
                            bindSuggestionChips();
                        } else {
                            suggestionTitle.innerHTML = 'No nearby dates available. Try a different range.';
                            if (suggestionSubtext) suggestionSubtext.style.display = 'none';
                            suggestionChipsContainer.innerHTML = '';
                        }
                    }
                }
            } catch (e) {
                console.warn('Availability check failed:', e);
            }
        }

        window.fetchDetailsAvailability = fetchAvailability;

        checkInInput.addEventListener('change', () => {
            if (checkOutInput.value <= checkInInput.value) {
                const nextDay = new Date(checkInInput.value);
                nextDay.setDate(nextDay.getDate() + 1);
                checkOutInput.value = nextDay.toISOString().split('T')[0];
            }
            fetchAvailability(checkInInput.value, checkOutInput.value);
        });

        checkOutInput.addEventListener('change', () => {
            fetchAvailability(checkInInput.value, checkOutInput.value);
        });

        bindSuggestionChips();
        updateCheckoutLinks(checkInInput.value, checkOutInput.value);
    })();

    // ─────────────────────────────────────────────────────────────
    // Unified Date Range Picker Script for Details Page
    // ─────────────────────────────────────────────────────────────
    (function () {
        const configEl = document.getElementById('propertyDetailsConfig');
        const pageConfig = configEl ? JSON.parse(configEl.textContent) : { propertyId: 0, pricePerNight: 0 };
        const pricePerNight = pageConfig.pricePerNight;

        const trigger = document.getElementById('detailsDateRangeTrigger');
        const popover = document.getElementById('detailsCalendarPopover');
        const textSpan = document.getElementById('detailsDateRangeText');
        const hiddenIn = document.getElementById('widgetCheckIn');
        const hiddenOut = document.getElementById('widgetCheckOut');
        const monthTitle = document.getElementById('detailsCalMonthTitle');
        const daysGrid = document.getElementById('detailsCalDaysGrid');
        const prevBtn = document.getElementById('detailsCalPrev');
        const nextBtn = document.getElementById('detailsCalNext');
        const clearBtn = document.getElementById('detailsCalClear');
        const applyBtn = document.getElementById('detailsCalApply');
        const nightsBadge = document.getElementById('nightsCountBadge');
        const calcNightsLabel = document.getElementById('calcNightsLabel');
        const calcStaySubtotal = document.getElementById('calcStaySubtotal');
        const calcTotalAmount = document.getElementById('calcTotalAmount');

        if (!trigger || !popover) return;

        let viewDate = new Date();
        let selIn = hiddenIn.value ? new Date(hiddenIn.value + 'T00:00:00') : null;
        let selOut = hiddenOut.value ? new Date(hiddenOut.value + 'T00:00:00') : null;

        if (selIn && !isNaN(selIn.getTime())) {
            viewDate = new Date(selIn.getFullYear(), selIn.getMonth(), 1);
        } else {
            viewDate = new Date(viewDate.getFullYear(), viewDate.getMonth(), 1);
        }

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        function togglePopover(show) {
            const isVis = popover.style.display === 'block';
            const willShow = show !== undefined ? show : !isVis;
            popover.style.display = willShow ? 'block' : 'none';
            trigger.setAttribute('aria-expanded', willShow ? 'true' : 'false');
            if (willShow) renderDetailsCalendar();
        }

        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            togglePopover();
        });

        document.addEventListener('click', (e) => {
            if (!popover.contains(e.target) && !trigger.contains(e.target)) {
                togglePopover(false);
            }
        });

        prevBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            viewDate.setMonth(viewDate.getMonth() - 1);
            renderDetailsCalendar();
        });

        nextBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            viewDate.setMonth(viewDate.getMonth() + 1);
            renderDetailsCalendar();
        });

        clearBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            selIn = null;
            selOut = null;
            renderDetailsCalendar();
        });

        applyBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            commitDetailsDates();
            togglePopover(false);
        });

        function commitDetailsDates() {
            if (selIn && selOut) {
                const inStr = formatDateYmd(selIn);
                const outStr = formatDateYmd(selOut);
                hiddenIn.value = inStr;
                hiddenOut.value = outStr;
                textSpan.textContent = formatDateDisplay(selIn) + ' – ' + formatDateDisplay(selOut);

                const diffDays = Math.max(1, Math.round((selOut - selIn) / (1000 * 60 * 60 * 24)));
                if (nightsBadge) nightsBadge.textContent = diffDays + (diffDays === 1 ? ' night' : ' nights');
                if (calcNightsLabel) calcNightsLabel.textContent = diffDays;
                const total = pricePerNight * diffDays;
                if (calcStaySubtotal) calcStaySubtotal.textContent = '₹' + total.toLocaleString('en-IN');
                if (calcTotalAmount) calcTotalAmount.textContent = '₹' + total.toLocaleString('en-IN');

                if (window.fetchDetailsAvailability) {
                    window.fetchDetailsAvailability(inStr, outStr);
                }
            } else if (selIn) {
                hiddenIn.value = formatDateYmd(selIn);
                hiddenOut.value = '';
                textSpan.textContent = formatDateDisplay(selIn) + ' · Check-out not selected';
            }
        }

        function renderDetailsCalendar() {
            const y = viewDate.getFullYear();
            const m = viewDate.getMonth();
            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            monthTitle.textContent = monthNames[m] + ' ' + y;

            const isCurrentMonth = y === today.getFullYear() && m === today.getMonth();
            prevBtn.disabled = isCurrentMonth;
            prevBtn.style.opacity = isCurrentMonth ? '0.35' : '1';

            daysGrid.innerHTML = '';

            const firstDayIndex = new Date(y, m, 1).getDay();
            const daysInMonth = new Date(y, m + 1, 0).getDate();

            for (let i = 0; i < firstDayIndex; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = 'cal-cell cal-disabled';
                daysGrid.appendChild(emptyCell);
            }

            for (let d = 1; d <= daysInMonth; d++) {
                const cell = document.createElement('div');
                cell.className = 'cal-cell';
                cell.textContent = d;

                const cellDate = new Date(y, m, d);
                cellDate.setHours(0, 0, 0, 0);

                if (cellDate < today) {
                    cell.classList.add('cal-disabled');
                } else {
                    if (selIn && isSameDay(cellDate, selIn)) {
                        cell.classList.add('cal-selected-in');
                    }
                    if (selOut && isSameDay(cellDate, selOut)) {
                        cell.classList.add('cal-selected-out');
                    }
                    if (selIn && selOut && cellDate > selIn && cellDate < selOut) {
                        cell.classList.add('cal-in-range');
                    }

                    cell.addEventListener('click', (e) => {
                        e.stopPropagation();
                        if (!selIn || (selIn && selOut)) {
                            selIn = cellDate;
                            selOut = null;
                        } else if (selIn && !selOut) {
                            if (cellDate > selIn) {
                                selOut = cellDate;
                            } else {
                                selIn = cellDate;
                                selOut = null;
                            }
                        }
                        renderDetailsCalendar();
                    });
                }

                daysGrid.appendChild(cell);
            }
        }

        function isSameDay(d1, d2) {
            return d1.getFullYear() === d2.getFullYear() &&
                   d1.getMonth() === d2.getMonth() &&
                   d1.getDate() === d2.getDate();
        }

        function formatDateYmd(d) {
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const dd = String(d.getDate()).padStart(2, '0');
            return d.getFullYear() + '-' + mm + '-' + dd;
        }

        function formatDateDisplay(d) {
            const shortMonths = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            return String(d.getDate()).padStart(2, '0') + ' ' + shortMonths[d.getMonth()];
        }

        // B7: Analytics property_view (consent-gated, property ID only, no PII)
        if (typeof window.trackAnalyticsEvent === 'function') {
            window.trackAnalyticsEvent('property_view', { property_id: @Model.PropertyID });
        }
    })();
</script>
}