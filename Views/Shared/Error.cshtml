@model BookMyFun.Models.ErrorViewModel
@{
    ViewData["Title"] = Model.IsNotFound ? "Page Not Found (404)" :
                        Model.IsAccessDenied ? "Access Restricted (403)" :
                        "Something Went Wrong (500)";
    Layout = "_Layout";
}

<div class="container py-5 my-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 text-center">

            @if (Model.IsNotFound)
            {
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle p-4 shadow-sm" style="width: 100px; height: 100px;">
                        <i class="fa-solid fa-map-location-dot fa-3x text-primary"></i>
                    </div>
                </div>
                <h1 class="h2 fw-bold text-dark mb-2">Page Not Found</h1>
                <p class="text-muted mb-4 lead fs-6">
                    @(Model.Message ?? "The page or destination you are looking for might have been moved, renamed, or is temporarily unavailable.")
                </p>

                <!-- Search Box for Properties -->
                <form asp-controller="Properties" asp-action="Index" method="get" class="mb-4">
                    <div class="input-group input-group-lg shadow-sm">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search farmhouses, villas, or locations..." aria-label="Search properties" />
                        <button class="btn btn-primary px-4" type="submit">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                        </button>
                    </div>
                </form>

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-controller="Properties" asp-action="Index" class="btn btn-outline-primary px-4 py-2">
                        <i class="fa-solid fa-compass me-1"></i> Explore Properties
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                        <i class="fa-solid fa-house me-1"></i> Go to Homepage
                    </a>
                </div>
            }
            else if (Model.IsAccessDenied)
            {
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle p-4 shadow-sm" style="width: 100px; height: 100px;">
                        <i class="fa-solid fa-shield-halved fa-3x text-warning"></i>
                    </div>
                </div>
                <h1 class="h2 fw-bold text-dark mb-2">Access Restricted</h1>
                <p class="text-muted mb-4 lead fs-6">
                    @(Model.Message ?? "You do not have permission to view or manage this resource. If you believe this is in error, please verify that you are signed in with the correct account.")
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Client";
                        var (dashCtrl, dashAct) = BookMyFun.Services.Navigation.NavigationMenuDefinition.GetDashboardRouteForRole(userRole);
                        var dashTitle = BookMyFun.Services.Navigation.NavigationMenuDefinition.GetDashboardNameForRole(userRole);
                        <a asp-controller="@dashCtrl" asp-action="@dashAct" class="btn btn-warning px-4 py-2 fw-semibold text-dark shadow-sm">
                            <i class="bi bi-speedometer2 me-1"></i> Go to @dashTitle
                        </a>
                    }
                    <button type="button" class="btn btn-outline-secondary px-4 py-2" onclick="if(history.length > 1){ history.back(); } else { window.location.href='/'; }">
                        <i class="fa-solid fa-arrow-left me-1"></i> Go Back
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                        <i class="fa-solid fa-house me-1"></i> Go to Homepage
                    </a>
                </div>
            }
            else
            {
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle p-4 shadow-sm" style="width: 100px; height: 100px;">
                        <i class="fa-solid fa-triangle-exclamation fa-3x text-danger"></i>
                    </div>
                </div>
                <h1 class="h2 fw-bold text-dark mb-2">Something Went Wrong</h1>
                <p class="text-muted mb-3 lead fs-6">
                    @(Model.Message ?? "We apologize for the inconvenience. An unexpected system error occurred on our end. Our technical team has been notified.")
                </p>

                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-light border py-2 px-3 d-inline-block mb-4">
                        <small class="text-muted text-uppercase fw-semibold d-block mb-1">Reference / Correlation ID</small>
                        <code class="text-dark fw-bold user-select-all">@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
                    <button type="button" class="btn btn-outline-secondary px-4 py-2" onclick="if(history.length > 1){ history.back(); } else { window.location.href='/'; }">
                        <i class="fa-solid fa-arrow-left me-1"></i> Go Back
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                        <i class="fa-solid fa-house me-1"></i> Go to Homepage
                    </a>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <small class="text-muted">
                        Need immediate assistance? Contact our team at
                        <a asp-controller="Home" asp-action="Contact" class="text-primary fw-medium text-decoration-none">Support &amp; Inquiries</a>.
                    </small>
                </div>
            }

        </div>
    </div>
</div>
