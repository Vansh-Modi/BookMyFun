@inject BookMyFun.Services.ISiteSettingsService SettingsService
@{
    Layout = "_Layout";
    ViewData["IsDashboard"] = true;
    var site = await SettingsService.GetSettingsAsync();
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Client";
    var userName = User.Identity?.Name ?? "User";
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "U" : userName.Substring(0, 1).ToUpper();

    var roleBadge = role switch
    {
        "Admin" => "bg-warning text-dark",
        "Employee" => "bg-info text-dark",
        "Owner" => "bg-primary text-white",
        "EventManager" => "bg-warning text-dark",
        _ => "bg-success text-white"
    };

    var roleTitle = role switch
    {
        "Admin" => "Platform Admin",
        "Employee" => "Operations Staff",
        "Owner" => "Farm Host",
        "EventManager" => "Event Partner",
        _ => "Traveler / Guest"
    };
}

<div class="dashboard-root">
    <!-- Desktop & Tablet Sidebar (Rail on tablet, Full on desktop) -->
    <aside class="dashboard-sidebar-container d-none d-md-flex" id="desktopDashboardSidebar">
        <div class="dashboard-sidebar-header">
            <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center text-decoration-none text-dark gap-2">
                @if (!string.IsNullOrEmpty(site.LogoUrl))
                {
                    <img src="@Url.Content(site.LogoUrl)" alt="@site.SiteName" style="height: 32px; object-fit: contain;" />
                }
                else
                {
                    <i class="bi @site.SiteIcon fs-4 text-warning"></i>
                }
                <span class="fw-bold fs-6 sidebar-brand-text">@site.SiteName</span>
            </a>
        </div>
        <div class="dashboard-sidebar-content">
            <partial name="_DashboardSidebarNav" />
        </div>
        <div class="p-3 border-top border-subtle small text-muted d-flex align-items-center justify-content-between sidebar-brand-text">
            <span class="badge @roleBadge px-2 py-1 rounded-pill">@role</span>
            <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none hover-primary" title="Go to public website">
                <i class="bi bi-box-arrow-up-right me-1"></i>Site
            </a>
        </div>
    </aside>

    <!-- Mobile Offcanvas Slide-in Drawer -->
    <div class="offcanvas offcanvas-start d-md-none bg-card" tabindex="-1" id="mobileDashboardDrawer" aria-labelledby="mobileDrawerLabel">
        <div class="offcanvas-header border-bottom">
            <h5 class="offcanvas-title d-flex align-items-center gap-2" id="mobileDrawerLabel">
                <i class="bi @site.SiteIcon text-warning fs-4"></i>
                <span class="fw-bold">@site.SiteName</span>
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-2">
            <partial name="_DashboardSidebarNav" />
        </div>
        <div class="p-3 border-top d-flex align-items-center justify-content-between bg-body">
            <div>
                <div class="fw-semibold text-dark small">@userName</div>
                <span class="badge @roleBadge" style="font-size: 0.7rem;">@roleTitle</span>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                    <i class="bi bi-box-arrow-right me-1"></i>Log out
                </button>
            </form>
        </div>
    </div>

    <!-- Main Dashboard Column -->
    <div class="dashboard-main">
        <!-- Top Bar -->
        <header class="dashboard-topbar">
            <div class="d-flex align-items-center gap-3">
                <!-- Mobile Hamburger Drawer Toggle -->
                <button class="btn btn-outline-secondary d-md-none rounded-3 py-1 px-2 border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileDashboardDrawer" aria-controls="mobileDashboardDrawer" aria-label="Open sidebar menu">
                    <i class="bi bi-list fs-4"></i>
                </button>

                <!-- Breadcrumb / Portal Label -->
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @roleBadge px-2.5 py-1.5 rounded-pill d-none d-sm-inline-block">@roleTitle</span>
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted small d-none d-lg-inline-block">
                        <i class="bi bi-house me-1"></i>Home
                    </a>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <!-- Notifications Bell with Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-light border-0 rounded-circle position-relative" type="button" id="notifBellDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications" aria-label="Notifications" style="width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;">
                        <i class="bi bi-bell-fill text-muted fs-5"></i>
                        <span class="position-absolute top-0 start-100 translate-middle p-1.5 bg-danger border border-light rounded-circle" style="transform: translate(-12px, 8px) !important;">
                            <span class="visually-hidden">New notifications</span>
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 p-0 mt-2" aria-labelledby="notifBellDropdown" style="width: 320px; max-width: 90vw;">
                        <li class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light rounded-top-4">
                            <span class="fw-bold small text-dark"><i class="bi bi-bell me-1 text-primary"></i> Notifications</span>
                            <span class="badge bg-primary rounded-pill small">Active</span>
                        </li>
                        <li class="p-3 border-bottom">
                            <div class="d-flex gap-2">
                                <div class="p-2 bg-success-subtle text-success rounded-circle"><i class="bi bi-check-circle"></i></div>
                                <div>
                                    <div class="fw-semibold small text-dark">Portal operational</div>
                                    <p class="text-muted small mb-0">System healthy. Automated notifications active.</p>
                                </div>
                            </div>
                        </li>
                        <li class="p-2 text-center bg-light rounded-bottom-4">
                            <a asp-controller="Home" asp-action="Index" class="text-decoration-none small fw-semibold text-primary">View Marketplace</a>
                        </li>
                    </ul>
                </div>

                <!-- Dark / Light Theme Toggle -->
                <button type="button" class="theme-switch-btn btn btn-light border-0 rounded-circle" title="Toggle dark / light mode" aria-label="Toggle dark/light mode" style="width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;">
                    <i class="bi bi-moon-stars-fill theme-icon text-muted"></i>
                </button>

                <!-- User Profile Menu -->
                <div class="dropdown ms-1">
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle gap-2 p-1 rounded-pill border" id="userProfileDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 34px; height: 34px; font-size: 0.85rem;">
                            @userInitial
                        </div>
                        <span class="small fw-semibold text-dark d-none d-sm-inline-block me-1">@userName</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 py-2 mt-2" aria-labelledby="userProfileDropdown" style="min-width: 220px;">
                        <li class="px-3 py-2 border-bottom">
                            <div class="fw-bold text-dark text-truncate">@userName</div>
                            <span class="badge @roleBadge small mt-1">@roleTitle</span>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                <i class="bi bi-person text-secondary me-2"></i>My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" asp-controller="Home" asp-action="Contact">
                                <i class="bi bi-headset text-warning me-2"></i>Help &amp; Support
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 py-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item text-danger rounded-2 d-flex align-items-center py-1.5 fw-semibold">
                                    <i class="bi bi-box-arrow-right me-2"></i>Log Out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Main Content View -->
        <main class="dashboard-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}
