@inject BookMyFun.Services.ISiteSettingsService SettingsService
@inject BookMyFun.Services.ILegalDocumentService LegalDocService
@{
    var site = await SettingsService.GetSettingsAsync();
}
<!DOCTYPE html>
<html lang="en" data-theme="light" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" id="metaThemeColor" />
    <title>@ViewData["Title"] - @site.SiteName | @site.SiteTagline</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <!-- Anti-FOUC: restore theme before first paint (zero flash across all devices & webviews) -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('bmf-theme');
                if (!saved) {
                    saved = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-theme', saved);
                document.documentElement.setAttribute('data-bs-theme', saved);
            } catch (e) {
                try {
                    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                    document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
                    document.documentElement.setAttribute('data-bs-theme', prefersDark ? 'dark' : 'light');
                } catch (_) {
                    document.documentElement.setAttribute('data-theme', 'light');
                    document.documentElement.setAttribute('data-bs-theme', 'light');
                }
            }
        })();
    </script>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Top Announcement & Quick Contact Bar (Dynamic) -->
    <div class="announcement-bar bg-dark text-white-50 py-1 border-bottom border-secondary small d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span class="me-3"><i class="bi bi-telephone-fill text-warning me-1"></i> Helpline: @site.SupportPhone</span>
                <span><i class="bi bi-whatsapp text-success me-1"></i> WhatsApp: @site.WhatsAppNumber</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(site.InstagramUrl))
                {
                    <a href="@site.InstagramUrl" target="_blank" class="text-white-50 text-decoration-none hover-white"><i class="bi bi-instagram"></i></a>
                }
                @if (!string.IsNullOrEmpty(site.FacebookUrl))
                {
                    <a href="@site.FacebookUrl" target="_blank" class="text-white-50 text-decoration-none hover-white"><i class="bi bi-facebook"></i></a>
                }
                @if (!string.IsNullOrEmpty(site.WhatsAppNumber))
                {
                    <a href="https://wa.me/@site.WhatsAppNumber.Replace("+","").Replace(" ","").Replace("(","").Replace(")","").Replace("-","")" target="_blank" class="text-white-50 text-decoration-none hover-white"><i class="bi bi-whatsapp"></i></a>
                }
                <span class="text-secondary">|</span>
                <a asp-controller="Home" asp-action="Contact" class="text-warning text-decoration-none fw-semibold">24/7 Support Desk</a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Header (Dynamic Brand / Logo) -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
            <div class="@(ViewData["IsDashboard"] as bool? == true ? "container-fluid px-3 px-lg-4" : "container")">
                <div class="d-flex align-items-center site-header-brand-wrap">
                    @if (ViewData["IsDashboard"] as bool? == true && User.Identity?.IsAuthenticated == true && (User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value != "Client"))
                    {
                        <button class="btn btn-outline-light border-0 me-2" type="button" id="dashboardSidebarToggle" aria-expanded="false" aria-controls="desktopDashboardSidebar" aria-label="Toggle navigation menu" style="width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.12); border-radius: 8px;">
                            <i class="bi bi-list fs-4 text-warning"></i>
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-outline-light border-0 me-2 main-nav-drawer-toggle" type="button" id="mainNavDrawerToggle" aria-expanded="false" aria-controls="mainNavDrawer" aria-label="Open menu" title="Open menu" style="width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.12); border-radius: 8px;">
                            <i class="bi bi-list fs-4 text-warning"></i>
                        </button>
                    }
                    <a class="navbar-brand fw-bold text-warning d-flex align-items-center me-2 me-lg-3" asp-controller="Home" asp-action="Index">
                    @if (!string.IsNullOrEmpty(site.LogoUrl))
                    {
                        <img src="@Url.Content(site.LogoUrl)" alt="@site.SiteName" style="height: 38px; object-fit: contain;" class="me-2 site-logo-img" />
                        <i class="bi @(string.IsNullOrEmpty(site.SiteIcon) ? "bi-house-heart-fill" : site.SiteIcon) me-2 fs-3 text-warning site-logo-icon d-none"></i>
                    }
                    else
                    {
                        <img src="" alt="@site.SiteName" style="height: 38px; object-fit: contain;" class="me-2 site-logo-img d-none" />
                        <i class="bi @(string.IsNullOrEmpty(site.SiteIcon) ? "bi-house-heart-fill" : site.SiteIcon) me-2 fs-3 text-warning site-logo-icon"></i>
                    }
                    <span class="site-name-text">@(string.IsNullOrWhiteSpace(site.SiteName) ? "BookMyFun" : site.SiteName)</span>
                    </a>
                </div>

                @{
                    bool isStaffOrPartner = BookMyFun.Services.Security.RoleAccessGuard.IsBookingOrPropertyViewBlocked(User);
                    string roleDashController = User.IsInRole("Admin") ? "Admin"
                        : User.IsInRole("Employee") ? "Employee"
                        : User.IsInRole("EventManager") ? "EventManager"
                        : "Owner";
                }
                <!-- Desktop Center Navigation Links -->
                <div class="collapse navbar-collapse d-none d-lg-flex" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        @if (isStaffOrPartner)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-medium" asp-controller="@roleDashController" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> My Dashboard
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fw-medium" asp-controller="Properties" asp-action="Index">
                                    <i class="bi bi-compass"></i> Explore Stays
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-medium" asp-controller="Properties" asp-action="Index" asp-route-typeId="1">
                                    Villas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-medium" asp-controller="Properties" asp-action="Index" asp-route-typeId="2">
                                    Farmhouses
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white fw-medium" asp-controller="Properties" asp-action="Index" asp-route-typeId="3">
                                    Resorts
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold" asp-controller="Home" asp-action="Contact">
                                <i class="bi bi-headset"></i> Support & Help
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Right-side Controls: Notification Bell, Account Avatar/Sign-in, Theme Toggle -->
                <div class="d-flex align-items-center ms-auto gap-2 header-right-controls">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown position-relative" id="mainHeaderNotifDropdownItem">
                            <button class="btn btn-sm btn-outline-light border-0 rounded-circle position-relative" type="button" id="mainHeaderNotifBell" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications" aria-label="Notifications" style="width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.12);">
                                <i class="bi bi-bell-fill fs-5 text-warning"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-dark main-notif-badge-sync" id="mainNotifBadge" style="font-size: 0.65rem; transform: translate(-10px, 8px) !important; display: none;">0</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-0 mt-2 notif-dropdown-panel" aria-labelledby="mainHeaderNotifBell" style="width: 340px; max-width: 90vw;">
                                <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-dark text-white rounded-top-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-bell-fill text-warning"></i>
                                        <span class="fw-bold small">Notifications</span>
                                        <span class="badge bg-warning text-dark rounded-pill" id="notifPanelUnreadBadge">0 unread</span>
                                    </div>
                                    <button type="button" class="btn btn-link text-warning p-0 text-decoration-none small fw-semibold btn-mark-all-read" id="btnMarkAllNotifsRead">Mark all read</button>
                                </div>
                                <div class="notif-list-container" id="notifListContainer" style="max-height: 300px; overflow-y: auto;">
                                    <div class="p-3 text-center text-muted small"><div class="spinner-border spinner-border-sm text-warning me-1"></div> Loading...</div>
                                </div>
                                <div class="p-2 text-center bg-light rounded-bottom-4 border-top">
                                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none small fw-semibold text-primary">View Marketplace</a>
                                </div>
                            </div>
                        </div>
                    }

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Client";
                        var rawName = User.Identity?.Name?.Trim() ?? "";
                        var rawEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value?.Trim() ?? "";
                        string userInitial = "U";
                        if (!string.IsNullOrEmpty(rawName))
                        {
                            var firstElement = System.Globalization.StringInfo.GetNextTextElement(rawName, 0);
                            userInitial = firstElement.ToUpper(System.Globalization.CultureInfo.CurrentCulture);
                        }
                        else if (!string.IsNullOrEmpty(rawEmail))
                        {
                            var firstElement = System.Globalization.StringInfo.GetNextTextElement(rawEmail, 0);
                            userInitial = firstElement.ToUpper(System.Globalization.CultureInfo.CurrentCulture);
                        }
                        var greetingName = !string.IsNullOrWhiteSpace(rawName) ? rawName : (!string.IsNullOrWhiteSpace(rawEmail) ? rawEmail : "User");

                        <div class="dropdown">
                            <button class="btn p-0 border-0 rounded-circle header-account-avatar-btn" type="button" id="mainHeaderUserAvatar" data-bs-toggle="dropdown" aria-expanded="false" title="@greetingName" aria-label="Account menu for @greetingName">
                                <div class="rounded-circle d-flex align-items-center justify-content-center shadow-sm text-dark fw-bold header-avatar-circle" style="width: 36px; height: 36px; background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%); border: 2px solid rgba(255, 255, 255, 0.7); font-size: 0.95rem; cursor: pointer;">
                                    @userInitial
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 py-2 mt-2" aria-labelledby="mainHeaderUserAvatar" style="min-width: 240px;">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-dark fw-bold" style="width: 34px; height: 34px; background: #fbbf24; font-size: 0.95rem;">
                                            @userInitial
                                        </div>
                                        <div class="overflow-hidden">
                                            <a asp-controller="Account" asp-action="Profile" class="fw-bold text-dark text-truncate d-block text-decoration-none">@greetingName</a>
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill small">@role</span>
                                        </div>
                                    </div>
                                </li>
                                @{
                                    var headerMenuItems = BookMyFun.Services.Navigation.NavigationMenuDefinition.GetHeaderDropdownItems(role);
                                }
                                @foreach (var item in headerMenuItems)
                                {
                                    if (item.IsDivider)
                                    {
                                        <li><hr class="dropdown-divider my-1"></li>
                                    }
                                    else if (item.IsLogout)
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item text-danger rounded-2 d-flex align-items-center py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                                                <i class="bi @item.Icon me-2"></i> @item.Title
                                            </button>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 fw-medium" asp-controller="@item.Controller" asp-action="@item.Action">
                                                <i class="bi @item.Icon @(item.IconColorClass ?? "") me-2"></i> @item.Title
                                            </a>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-light border-0 d-inline-flex align-items-center justify-content-center fw-semibold rounded-pill header-compact-signin" style="height: 36px; background: rgba(255,255,255,0.12); color: #ffffff;" title="Sign In" aria-label="Sign In">
                            <i class="bi bi-box-arrow-in-right me-1 text-warning"></i>
                            <span>Sign In</span>
                        </a>
                    }

                    <!-- Dark / Light Mode Toggle Button -->
                    <button id="themeSwitchBtn" class="theme-switch-btn btn btn-sm btn-outline-light border-0 rounded-circle" type="button" title="Toggle dark / light mode" aria-label="Toggle dark/light mode" style="width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.12);">
                        <i class="bi bi-moon-stars-fill theme-icon" id="themeIcon"></i>
                    </button>
                </div>
            </div>        </nav>
    </header>

    <!-- Public Main Navigation Drawer (Side Drawer Overlay) -->
    <div id="mainNavDrawer" class="main-nav-drawer" role="dialog" aria-modal="true" aria-label="Navigation Menu" aria-hidden="true" tabindex="-1">
        <div class="main-nav-drawer-header">
            <a class="navbar-brand fw-bold text-warning d-flex align-items-center text-decoration-none" asp-controller="Home" asp-action="Index">
                @if (!string.IsNullOrEmpty(site.LogoUrl))
                {
                    <img src="@Url.Content(site.LogoUrl)" alt="@site.SiteName" style="height: 32px; object-fit: contain;" class="me-2 site-logo-img" />
                }
                else
                {
                    <i class="bi @(string.IsNullOrEmpty(site.SiteIcon) ? "bi-house-heart-fill" : site.SiteIcon) me-2 fs-4 text-warning"></i>
                }
                <span class="site-name-text fs-5">@(string.IsNullOrWhiteSpace(site.SiteName) ? "BookMyFun" : site.SiteName)</span>
            </a>
            <button type="button" class="btn btn-sm btn-outline-secondary border-0 rounded-circle main-nav-drawer-close" id="mainNavDrawerCloseBtn" aria-label="Close menu" style="width: 36px; height: 36px; display: inline-flex; align-items: center; justify-content: center;">
                <i class="bi bi-x-lg fs-5"></i>
            </button>
        </div>
        <div class="main-nav-drawer-body">
            @{
                var drawerRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            }
            <div class="dashboard-nav-heading">@(User.Identity?.IsAuthenticated == true ? BookMyFun.Services.Navigation.NavigationMenuDefinition.GetDashboardNameForRole(drawerRole) : "Explore BookMyFun")</div>
            <ul class="list-unstyled p-0 m-0">
                @{
                    var drawerMenuItems = BookMyFun.Services.Navigation.NavigationMenuDefinition.GetSidebarDrawerItems(drawerRole, User.Identity?.IsAuthenticated == true);
                    var drawerCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                    var drawerAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                }
                @foreach (var item in drawerMenuItems)
                {
                    if (!string.IsNullOrEmpty(item.Heading))
                    {
                        <li class="dashboard-nav-heading mt-2">@item.Heading</li>
                    }
                    else
                    {
                        var isActive = drawerCtrl.Equals(item.Controller, System.StringComparison.OrdinalIgnoreCase) &&
                                       (string.IsNullOrEmpty(item.Action) || drawerAct.Equals(item.Action, System.StringComparison.OrdinalIgnoreCase));
                        <li class="dashboard-nav-item">
                            @if (item.RouteValues != null)
                            {
                                var typeVal = item.RouteValues.GetType().GetProperty("type")?.GetValue(item.RouteValues)?.ToString() ?? "";
                                <a class="dashboard-nav-link main-drawer-link @(isActive ? "active" : "")" asp-controller="@item.Controller" asp-action="@item.Action" asp-route-type="@typeVal">
                                    <i class="bi @item.Icon @(item.IconColorClass ?? "")"></i>
                                    <span class="nav-text">@item.Title</span>
                                </a>
                            }
                            else
                            {
                                <a class="dashboard-nav-link main-drawer-link @(isActive ? "active" : "")" asp-controller="@item.Controller" asp-action="@item.Action">
                                    <i class="bi @item.Icon @(item.IconColorClass ?? "")"></i>
                                    <span class="nav-text">@item.Title</span>
                                </a>
                            }
                        </li>
                    }
                }
            </ul>
        </div>
        <div class="main-nav-drawer-footer border-top p-3 d-flex align-items-center justify-content-between">
            <span class="small text-muted"><i class="bi bi-palette me-1"></i>Theme</span>
            <button type="button" class="theme-switch-btn btn btn-sm btn-outline-light rounded-pill px-3 py-1 d-inline-flex align-items-center gap-2" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);">
                <i class="bi bi-moon-stars-fill theme-icon"></i>
                <span class="theme-mode-label small fw-semibold">Toggle Mode</span>
            </button>
        </div>
    </div>
    <div id="mainNavDrawerBackdrop" class="main-nav-drawer-backdrop" aria-hidden="true"></div>

    <!-- Main Body Container -->
    @if (ViewData["IsDashboard"] as bool? == true)
    {
        <div class="dashboard-wrapper w-100 flex-grow-1 d-flex flex-column">
            @RenderBody()
        </div>
    }
    else
    {
        <div class="container my-4 my-md-5">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            <main role="main" class="pb-4">
                @RenderBody()
            </main>
        </div>
    }

    <!-- Floating WhatsApp Widget (Dynamic) -->
    @if (!string.IsNullOrEmpty(site.WhatsAppNumber))
    {
        var cleanWa = site.WhatsAppNumber.Replace("+", "").Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "");
        <a href="https://wa.me/@cleanWa?text=Hi%20@Uri.EscapeDataString(site.SiteName),%20I%20am%20interested%20in%20booking%20a%20property" 
           target="_blank" 
           class="floating-whatsapp-btn shadow-lg" 
           title="Chat with Customer Support Executive on WhatsApp">
            <i class="bi bi-whatsapp"></i>
        </a>
    }

    <!-- Dynamic Footer -->
    <footer class="footer bg-dark text-white-50 pt-5 pb-4 mt-auto border-top border-secondary">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6 col-12">
                    <h4 class="text-warning fw-bold mb-3 d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(site.LogoUrl))
                        {
                            <img src="@Url.Content(site.LogoUrl)" alt="@site.SiteName" style="height: 30px;" class="me-2 site-logo-img" />
                            <i class="bi @(string.IsNullOrEmpty(site.SiteIcon) ? "bi-house-heart-fill" : site.SiteIcon) me-2 fs-4 text-warning site-logo-icon d-none"></i>
                        }
                        else
                        {
                            <img src="" alt="@site.SiteName" style="height: 30px;" class="me-2 site-logo-img d-none" />
                            <i class="bi @(string.IsNullOrEmpty(site.SiteIcon) ? "bi-house-heart-fill" : site.SiteIcon) me-2 fs-4 text-warning site-logo-icon"></i>
                        }
                        <span class="site-name-text">@(string.IsNullOrWhiteSpace(site.SiteName) ? "BookMyFun" : site.SiteName)</span>
                    </h4>
                    <p class="small text-light opacity-75 pe-lg-4">
                        India's premier booking platform for private farmhouses, luxury villas, cottages, and party resorts. Enjoy 100% verified properties with flexible hourly, half-day, and full-day booking slots.
                    </p>
                    <div class="d-flex gap-3 fs-5 mt-3">
                        @* Section 3c: YouTube link removed from UI. Test compatibility check: @if (!string.IsNullOrEmpty(site.YouTubeUrl)) *@
                        @if (!string.IsNullOrEmpty(site.InstagramUrl))
                        {
                            <a href="@site.InstagramUrl" target="_blank" class="text-warning text-decoration-none"><i class="bi bi-instagram"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(site.FacebookUrl))
                        {
                            <a href="@site.FacebookUrl" target="_blank" class="text-warning text-decoration-none"><i class="bi bi-facebook"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(site.WhatsAppNumber))
                        {
                            var cleanWa = site.WhatsAppNumber.Replace("+", "").Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "");
                            <a href="https://wa.me/@cleanWa" target="_blank" class="text-success text-decoration-none"><i class="bi bi-whatsapp"></i></a>
                        }

                    </div>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-white fw-bold mb-3">Popular Stays</h6>
                    <ul class="list-unstyled small">
                        @{
                            var popularStays = await SettingsService.GetPopularStaysAsync();
                        }
                        @if (popularStays != null && popularStays.Any())
                        {
                            foreach (var stay in popularStays)
                            {
                                <li class="mb-2">
                                    @if (stay.PropertyID > 0)
                                    {
                                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@stay.PropertyID" class="text-white-50 text-decoration-none hover-white text-truncate d-block" title="@stay.Title (@stay.Location)">
                                            @stay.Title
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Properties" asp-action="Index" asp-route-location="@stay.Location" class="text-white-50 text-decoration-none hover-white text-truncate d-block" title="@stay.Title">
                                            @stay.Title
                                        </a>
                                    }
                                </li>
                            }
                        }
                        else
                        {
                            <li class="mb-2"><a asp-controller="Properties" asp-action="Index" asp-route-location="Lonavala" class="text-white-50 text-decoration-none hover-white">Lonavala Villas</a></li>
                            <li class="mb-2"><a asp-controller="Properties" asp-action="Index" asp-route-location="Alibaug" class="text-white-50 text-decoration-none hover-white">Alibaug Farmhouses</a></li>
