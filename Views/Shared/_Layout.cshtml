                    </ul>
                    <!-- Mobile Drawer Theme Switcher Row -->
                    <div class="d-lg-none pt-3 mt-3 border-top border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                        <span class="text-white-50 small"><i class="bi bi-palette me-2"></i>Display Theme</span>
                        <button type="button" class="theme-switch-btn btn btn-sm btn-outline-light d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill" style="background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.2);">
