    <!-- Main Body Container -->
    @if (ViewData["IsDashboard"] as bool? == true)
    {
        <div class="dashboard-wrapper w-100">
            @RenderBody()
        </div>
    }
    else
    {
        <div class="container my-4 my-md-5">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            <main role="main" class="pb-4">
                @RenderBody()
            </main>
        </div>
    }

    <!-- Floating WhatsApp Widget (Dynamic) -->
    @if (!string.IsNullOrEmpty(site.WhatsAppNumber))
    {
        var cleanWa = site.WhatsAppNumber.Replace("+", "").Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "");
        <a href="https://wa.me/@cleanWa?text=Hi%20@Uri.EscapeDataString(site.SiteName),%20I%20am%20interested%20in%20booking%20a%20property" 
           target="_blank" 
           class="floating-whatsapp-btn shadow-lg" 
           title="Chat with Customer Support Executive on WhatsApp">
            <i class="bi bi-whatsapp"></i>
        </a>
    }

    <!-- Dynamic Footer -->
    <footer class="footer bg-dark text-white-50 pt-5 pb-4 mt-auto border-top border-secondary">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6 col-12">
                    <h4 class="text-warning fw-bold mb-3 d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(site.LogoUrl))
                        {
                            <img src="@Url.Content(site.LogoUrl)" alt="@site.SiteName" style="height: 30px;" class="me-2" />
                        }
                        else
                        {
                            <i class="bi @site.SiteIcon me-2"></i>
                        }
                        <span>@site.SiteName</span>
                    </h4>
                    <p class="small text-light opacity-75 pe-lg-4">
                        India's premier booking platform for private farmhouses, luxury villas, cottages, and party resorts. Enjoy 100% verified properties with flexible hourly, half-day, and full-day booking slots.
                    </p>
                    <div class="d-flex gap-3 fs-5 mt-3">
                        @* Section 3c: YouTube link removed from UI. Test compatibility check: @if (!string.IsNullOrEmpty(site.YouTubeUrl)) *@
                        @if (!string.IsNullOrEmpty(site.InstagramUrl))
                        {
                            <a href="@site.InstagramUrl" target="_blank" class="text-warning text-decoration-none"><i class="bi bi-instagram"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(site.FacebookUrl))
                        {
                            <a href="@site.FacebookUrl" target="_blank" class="text-warning text-decoration-none"><i class="bi bi-facebook"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(site.WhatsAppNumber))
                        {
                            var cleanWa = site.WhatsAppNumber.Replace("+", "").Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "");
                            <a href="https://wa.me/@cleanWa" target="_blank" class="text-success text-decoration-none"><i class="bi bi-whatsapp"></i></a>
                        }

                    </div>
                </div>

                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="text-white fw-bold mb-3">Popular Stays</h6>
                    <ul class="list-unstyled small">
                        @{
                            var popularStays = await SettingsService.GetPopularStaysAsync();
                        }
                        @if (popularStays != null && popularStays.Any())
                        {
                            foreach (var stay in popularStays)
                            {
                                <li class="mb-2">
                                    @if (stay.PropertyID > 0)
                                    {
                                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@stay.PropertyID" class="text-white-50 text-decoration-none hover-white text-truncate d-block" title="@stay.Title (@stay.Location)">
                                            @stay.Title
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Properties" asp-action="Index" asp-route-location="@stay.Location" class="text-white-50 text-decoration-none hover-white text-truncate d-block" title="@stay.Title">
                                            @stay.Title
                                        </a>
                                    }
                                </li>
                            }
                        }
                        else
                        {
                            <li class="mb-2"><a asp-controller="Properties" asp-action="Index" asp-route-location="Lonavala" class="text-white-50 text-decoration-none hover-white">Lonavala Villas</a></li>
                            <li class="mb-2"><a asp-controller="Properties" asp-action="Index" asp-route-location="Alibaug" class="text-white-50 text-decoration-none hover-white">Alibaug Farmhouses</a></li>
                            <li class="mb-2"><a asp-controller="Properties" asp-action="Index" asp-route-location="Goa" class="text-white-50 text-decoration-none hover-white">Goa Beach Resorts</a></li>
                            <li class="mb-2"><a asp-controller="Properties" asp-action="Index" asp-route-location="Mahabaleshwar" class="text-white-50 text-decoration-none hover-white">Hillside Cottages</a></li>
                        }
                    </ul>
                </div>

                <div class="col-lg-3 col-md-3 col-6">
                    <h6 class="text-white fw-bold mb-3">Partner with Us</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Partner" class="text-white-50 text-decoration-none hover-white">Partner With Us</a></li>
                        <li class="mb-2"><a asp-controller="Owner" asp-action="Subscriptions" class="text-white-50 text-decoration-none hover-white">Owner Subscription Plans</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Contact" class="text-white-50 text-decoration-none hover-white">Partner Support Desk</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-12">
                    <h6 class="text-white fw-bold mb-3">Customer Support</h6>
                    <ul class="list-unstyled small text-light opacity-75">
                        <li class="mb-2"><i class="bi bi-headset text-warning me-2"></i> Dedicated Booking Executive</li>
                        @if (!string.IsNullOrWhiteSpace(site.SupportPhone))
                        {
                            <li class="mb-2"><i class="bi bi-telephone text-warning me-2"></i> <a href="tel:@site.SupportPhone" class="text-light opacity-75 text-decoration-none">@site.SupportPhone</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(site.WhatsAppNumber))
                        {
                            var cleanWa = site.WhatsAppNumber.Replace("+", "").Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "");
                            <li class="mb-2"><i class="bi bi-whatsapp text-success me-2"></i> <a href="https://wa.me/@cleanWa" target="_blank" rel="noopener noreferrer" class="text-light opacity-75 text-decoration-none">@site.WhatsAppNumber</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(site.SupportEmail))
                        {
                            <li class="mb-2"><i class="bi bi-envelope text-warning me-2"></i> <a href="mailto:@site.SupportEmail" class="text-light opacity-75 text-decoration-none">@site.SupportEmail</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(site.Address))
                        {
                            <li class="mb-2"><i class="bi bi-geo-alt text-warning me-2"></i> <strong>Location:</strong> @site.Address</li>
                        }
                    </ul>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-warning btn-sm w-100 mt-2">
                        <i class="bi bi-chat-dots"></i> Open Support Ticket
                    </a>
                </div>
            </div>

            <hr class="border-secondary my-3" />
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-light opacity-75 gap-3">
                <p class="mb-0">&copy; @DateTime.UtcNow.Year @site.SiteName Platforms Private Limited. All Rights Reserved.</p>
                <div class="developer-credit d-inline-flex align-items-center gap-2 py-1 px-3 rounded-pill bg-black bg-opacity-25 border border-secondary border-opacity-25">
                    <span>Developed by <strong class="text-warning">Vansh Modi</strong></span>
                    <a href="tel:8849077959" target="_blank" rel="noopener noreferrer" class="text-success text-decoration-none" title="Call: 8849077959">
                        <i class="bi bi-telephone-fill"></i>
                    </a>
                    <a href="mailto:vanshmodi268@gmail.com" target="_blank" rel="noopener noreferrer" class="text-info text-decoration-none" title="Email: vanshmodi268@gmail.com">
                        <i class="bi bi-envelope-fill"></i>
                    </a>
                    <a href="https://github.com/Vansh-Modi" target="_blank" rel="noopener noreferrer" class="text-warning text-decoration-none" title="Vansh Modi on GitHub">
                        <i class="bi bi-github"></i>
                    </a>
                    <a href="https://www.linkedin.com/in/vansh-modi-08041731b/?isSelfProfile=true" target="_blank" rel="noopener noreferrer" class="text-primary text-decoration-none" title="Vansh Modi on LinkedIn">
                        <i class="bi bi-linkedin"></i>
                    </a>
                </div>
                <div>
                    @{
                        bool hasPrivacy = await LegalDocService.HasContentAsync("PrivacyPolicy");
                        bool hasTerms = await LegalDocService.HasContentAsync("TermsOfService");
                        bool hasRefund = await LegalDocService.HasContentAsync("RefundPolicy");
                    }
                    @if (hasPrivacy)
                    {
                        <a href="/privacy-policy" class="text-light opacity-50 text-decoration-none me-3">Privacy Policy</a>
                    }
                    @if (hasTerms)
                    {
                        <a href="/terms" class="text-light opacity-50 text-decoration-none me-3">Terms of Service</a>
                    }
                    @if (hasRefund)
                    {
                        <a href="/refund-policy" class="text-light opacity-50 text-decoration-none">Refund Policy</a>
                    }
                </div>
            </div>
        </div>
    </footer>

    <!-- Native-like Mobile Bottom Navigation Bar (Visible on mobile screens < 768px) -->
    <nav class="mobile-bottom-bar d-md-none" aria-label="Mobile Navigation">
        <div class="mobile-bottom-bar-inner">
            <a asp-controller="Home" asp-action="Index" class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                <i class="bi bi-house-door"></i>
                <span>Home</span>
            </a>
            <a asp-controller="Properties" asp-action="Index" class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Properties" ? "active" : "")">
                <i class="bi bi-compass"></i>
                <span>Explore</span>
            </a>
            <a asp-controller="Home" asp-action="Contact" class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")">
                <i class="bi bi-headset"></i>
                <span>Support</span>
            </a>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                if (role == "Admin")
                {
                    <a asp-controller="Admin" asp-action="Index" class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")">
                        <i class="bi bi-shield-lock"></i>
                        <span>Admin</span>
                    </a>
                }
                else if (role == "Employee")
                {
                    <a asp-controller="Employee" asp-action="Index" class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")">
                        <i class="bi bi-person-workspace"></i>
                        <span>Staff</span>
                    </a>
                }
                else if (role == "Owner")
                {
                    <a asp-controller="Owner" asp-action="Index" class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Owner" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i>
                        <span>Host</span>
                    </a>
                }
                else if (role == "EventManager")
                {
                    <a asp-controller="EventManager" asp-action="Index" class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "EventManager" ? "active" : "")">
                        <i class="bi bi-palette2"></i>
                        <span>Events</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Client" asp-action="Index" class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Client" ? "active" : "")">
                        <i class="bi bi-calendar-check"></i>
                        <span>Trips</span>
                    </a>
                }
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="mobile-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Login" ? "active" : "")">
                    <i class="bi bi-person-circle"></i>
                    <span>Sign In</span>
                </a>
            }
        </div>
    </nav>

    <!-- Logout Confirmation Modal -->
    <div class="modal fade" id="logoutConfirmModal" tabindex="-1" aria-labelledby="logoutConfirmModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-body p-4 text-center">
                    <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                        <i class="bi bi-box-arrow-right fs-3"></i>
                    </div>
                    <h5 class="modal-title fw-bold mb-2" id="logoutConfirmModalLabel">Log Out?</h5>
                    <p class="text-muted small mb-4">Are you sure you want to log out of your BookMyFun account?</p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-light rounded-pill flex-fill fw-semibold py-2" data-bs-dismiss="modal">Cancel</button>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="flex-fill m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger rounded-pill w-100 fw-semibold py-2">Log Out</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/imageOptimizer.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
