    <script src="~/js/imageOptimizer.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Dashboard Sidebar Drawer & Universal Notification Scripts -->
    <script>
        (function() {
            // Sidebar Toggle
            const toggleBtn = document.getElementById('dashboardSidebarToggle');
            const sidebar = document.getElementById('desktopDashboardSidebar');
            const dashboardRoot = document.querySelector('.dashboard-root');

            function applySidebarState(open) {
                if (!sidebar) return;
                if (window.innerWidth >= 992) {
                    if (open) {
                        sidebar.classList.remove('sidebar-collapsed');
                        dashboardRoot?.classList.remove('sidebar-collapsed-layout');
                        toggleBtn?.setAttribute('aria-expanded', 'true');
                        try { localStorage.setItem('bmf-dashboard-sidebar-state', 'expanded'); } catch(e){}
                    } else {
                        sidebar.classList.add('sidebar-collapsed');
                        dashboardRoot?.classList.add('sidebar-collapsed-layout');
                        toggleBtn?.setAttribute('aria-expanded', 'false');
                        try { localStorage.setItem('bmf-dashboard-sidebar-state', 'collapsed'); } catch(e){}
                    }
                } else {
                    if (open) {
                        sidebar.classList.add('sidebar-mobile-drawer-open');
                        toggleBtn?.setAttribute('aria-expanded', 'true');
                        let backdrop = document.getElementById('sidebarDrawerBackdrop');
                        if (!backdrop) {
                            backdrop = document.createElement('div');
                            backdrop.id = 'sidebarDrawerBackdrop';
                            backdrop.className = 'sidebar-drawer-backdrop show';
                            backdrop.addEventListener('click', () => applySidebarState(false));
                            document.body.appendChild(backdrop);
                        } else {
                            backdrop.classList.add('show');
                        }
                    } else {
                        sidebar.classList.remove('sidebar-mobile-drawer-open');
                        toggleBtn?.setAttribute('aria-expanded', 'false');
                        const backdrop = document.getElementById('sidebarDrawerBackdrop');
                        if (backdrop) {
                            backdrop.classList.remove('show');
                            setTimeout(() => backdrop.remove(), 250);
                        }
                    }
                }
            }

            if (toggleBtn && sidebar) {
                try {
                    const saved = localStorage.getItem('bmf-dashboard-sidebar-state');
                    if (window.innerWidth >= 992 && saved === 'collapsed') {
                        applySidebarState(false);
                    } else if (window.innerWidth >= 992) {
                        applySidebarState(true);
                    }
                } catch(e) {}

                toggleBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    if (window.innerWidth >= 992) {
                        applySidebarState(sidebar.classList.contains('sidebar-collapsed'));
                    } else {
                        applySidebarState(!sidebar.classList.contains('sidebar-mobile-drawer-open'));
                    }
                });

                document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape' && sidebar.classList.contains('sidebar-mobile-drawer-open')) {
                        applySidebarState(false);
                    }
                });

                document.addEventListener('click', function(e) {
                    if (window.innerWidth < 992 && sidebar.classList.contains('sidebar-mobile-drawer-open')) {
                        if (!sidebar.contains(e.target) && e.target !== toggleBtn && !toggleBtn.contains(e.target)) {
                            applySidebarState(false);
                        }
                    }
                });
            }

            // Public Main Navigation Drawer (Accessible Slide Drawer Overlay)
            (function () {
                const drawerToggle = document.getElementById('mainNavDrawerToggle');
                const drawer = document.getElementById('mainNavDrawer');
                const drawerCloseBtn = document.getElementById('mainNavDrawerCloseBtn');
                const drawerBackdrop = document.getElementById('mainNavDrawerBackdrop');

                if (!drawerToggle || !drawer) return;

                function getFocusableElements() {
                    return drawer.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
                }

                function openDrawer() {
                    drawer.classList.add('open');
                    drawer.setAttribute('aria-hidden', 'false');
                    drawerToggle.setAttribute('aria-expanded', 'true');
                    if (drawerBackdrop) {
                        drawerBackdrop.classList.add('show');
                        drawerBackdrop.setAttribute('aria-hidden', 'false');
                    }
                    document.body.style.overflow = 'hidden';

                    const focusables = getFocusableElements();
                    if (focusables.length > 0) {
                        focusables[0].focus();
                    }
                }

                function closeDrawer() {
                    if (!drawer.classList.contains('open')) return;
                    drawer.classList.remove('open');
                    drawer.setAttribute('aria-hidden', 'true');
                    drawerToggle.setAttribute('aria-expanded', 'false');
                    if (drawerBackdrop) {
                        drawerBackdrop.classList.remove('show');
                        drawerBackdrop.setAttribute('aria-hidden', 'true');
                    }
                    document.body.style.overflow = '';
                    drawerToggle.focus();
                }

                drawerToggle.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (drawer.classList.contains('open')) {
                        closeDrawer();
                    } else {
                        openDrawer();
                    }
                });

                if (drawerCloseBtn) {
                    drawerCloseBtn.addEventListener('click', function (e) {
                        e.preventDefault();
                        closeDrawer();
                    });
                }

                if (drawerBackdrop) {
                    drawerBackdrop.addEventListener('click', function () {
                        closeDrawer();
                    });
                }

                drawer.querySelectorAll('a').forEach(function (link) {
                    link.addEventListener('click', function () {
                        closeDrawer();
                    });
                });

                document.addEventListener('keydown', function (e) {
                    if (!drawer.classList.contains('open')) return;

                    if (e.key === 'Escape') {
                        e.preventDefault();
                        closeDrawer();
                        return;
                    }

                    if (e.key === 'Tab') {
                        const focusables = getFocusableElements();
                        if (focusables.length === 0) return;
                        const first = focusables[0];
                        const last = focusables[focusables.length - 1];

                        if (e.shiftKey) {
                            if (document.activeElement === first) {
                                e.preventDefault();
                                last.focus();
                            }
                        } else {
                            if (document.activeElement === last) {
                                e.preventDefault();
                                first.focus();
                            }
                        }
                    }
                });
            })();

            // Notification loading & read actions
            async function fetchNotifs() {
                try {
                    const res = await fetch('/Notification/GetRecent');
                    if (!res.ok) return;
                    const data = await res.json();

                    const badges = document.querySelectorAll('#mainNotifBadge, .main-notif-badge-sync');
                    badges.forEach(b => {
                        if (data.unreadCount > 0) {
                            b.textContent = data.unreadCount > 9 ? '9+' : data.unreadCount;
                            b.style.display = 'inline-block';
                        } else {
                            b.style.display = 'none';
                        }
                    });

                    const panelBadge = document.getElementById('notifPanelUnreadBadge');
                    if (panelBadge) panelBadge.textContent = `${data.unreadCount} unread`;

                    const containers = document.querySelectorAll('.notif-list-container');
                    containers.forEach(c => {
                        if (!data.items || data.items.length === 0) {
                            c.innerHTML = '<div class="p-4 text-center text-muted small"><i class="bi bi-bell-slash fs-4 d-block mb-1 opacity-50"></i>No notifications yet</div>';
                            return;
                        }
                        c.innerHTML = data.items.map(n => {
                            const safeUrl = (n.actionUrl || '').replace(/'/g, "\\'");
                            return `
                            <div class="p-3 border-bottom d-flex gap-2.5 align-items-start ${n.isRead ? 'bg-body' : 'bg-primary-subtle bg-opacity-25'}" style="cursor: pointer;" onclick="onNotifClick(${n.notificationId}, '${safeUrl}')">
                                <div class="rounded-circle p-2 bg-warning-subtle text-warning flex-shrink-0" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                    <i class="bi bi-bell-fill small"></i>
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="fw-semibold small text-dark">${n.title}</div>
                                    <div class="small text-muted text-truncate">${n.message}</div>
                                    <div class="small text-muted mt-1" style="font-size: 0.7rem;">${n.timeAgo}</div>
                                </div>
                                ${!n.isRead ? '<span class="badge bg-primary rounded-circle p-1" style="width: 8px; height: 8px;"></span>' : ''}
                            </div>`;
                        }).join('');
                    });
                } catch(e) {}
            }

            window.onNotifClick = async function(id, url) {
                try {
                    const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                    const form = new FormData();
                    if (tokenEl) form.append('__RequestVerificationToken', tokenEl.value);
                    form.append('notificationId', id);
                    await fetch('/Notification/MarkAsRead?notificationId=' + id, { method: 'POST', body: form });
                } catch (e) {}

                if (url && url.trim().length > 0 && url.startsWith('/')) {
                    window.location.href = url;
                } else {
                    fetchNotifs();
                }
            };

            document.querySelectorAll('.btn-mark-all-read').forEach(btn => {
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    try {
                        const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                        const form = new FormData();
                        if (tokenEl) form.append('__RequestVerificationToken', tokenEl.value);
                        await fetch('/Notification/MarkAllAsRead', { method: 'POST', body: form });
                        fetchNotifs();
                    } catch(e) {}
                });
            });

            if (document.getElementById('mainHeaderNotifBell') || document.getElementById('mobileNotifBell')) {
                fetchNotifs();
                document.getElementById('mainHeaderNotifBell')?.addEventListener('show.bs.dropdown', fetchNotifs);
                document.getElementById('mobileNotifBell')?.addEventListener('show.bs.dropdown', fetchNotifs);
            }
        })();
    </script>

</body>
