@inject BookMyFun.Services.ISiteSettingsService SettingsService
@inject BookMyFun.Services.ILegalDocumentService LegalDocService
@{
    var site = await SettingsService.GetSettingsAsync();
}
<!DOCTYPE html>
<html lang="en" data-theme="light" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f172a" id="metaThemeColor" />
    <title>@ViewData["Title"] - @site.SiteName | @site.SiteTagline</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <!-- Anti-FOUC: restore theme before first paint (zero flash across all devices & webviews) -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('bmf-theme');
                if (!saved) {
                    saved = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
                }
                document.documentElement.setAttribute('data-theme', saved);
                document.documentElement.setAttribute('data-bs-theme', saved);
            } catch (e) {
                try {
                    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                    document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
                    document.documentElement.setAttribute('data-bs-theme', prefersDark ? 'dark' : 'light');
                } catch (_) {
                    document.documentElement.setAttribute('data-theme', 'light');
                    document.documentElement.setAttribute('data-bs-theme', 'light');
                }
            }
        })();
    </script>
</head>
<body>
    <!-- Top Announcement & Quick Contact Bar (Dynamic) -->
    <div class="announcement-bar bg-dark text-white-50 py-1 border-bottom border-secondary small d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span class="me-3"><i class="bi bi-telephone-fill text-warning me-1"></i> Helpline: @site.SupportPhone</span>
                <span><i class="bi bi-whatsapp text-success me-1"></i> WhatsApp: @site.WhatsAppNumber</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(site.InstagramUrl))
                {
                    <a href="@site.InstagramUrl" target="_blank" class="text-white-50 text-decoration-none hover-white"><i class="bi bi-instagram"></i></a>
                }
                @if (!string.IsNullOrEmpty(site.FacebookUrl))
                {
                    <a href="@site.FacebookUrl" target="_blank" class="text-white-50 text-decoration-none hover-white"><i class="bi bi-facebook"></i></a>
                }
                @if (!string.IsNullOrEmpty(site.WhatsAppNumber))
                {
                    <a href="https://wa.me/@site.WhatsAppNumber.Replace("+","").Replace(" ","").Replace("(","").Replace(")","").Replace("-","")" target="_blank" class="text-white-50 text-decoration-none hover-white"><i class="bi bi-whatsapp"></i></a>
                }
                <span class="text-secondary">|</span>
                <a asp-controller="Home" asp-action="Contact" class="text-warning text-decoration-none fw-semibold">24/7 Support Desk</a>
            </div>
        </div>
    </div>

