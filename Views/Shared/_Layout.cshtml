@inject BookMyFun.Services.ISiteSettingsService SettingsService
@{
    var site = await SettingsService.GetSettingsAsync();
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @site.SiteName | @site.SiteTagline</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Anti-FOUC: restore theme before first paint -->
    <script>
        (function () {
            var saved = localStorage.getItem('bmf-theme') || 'light';
            document.documentElement.setAttribute('data-theme', saved);
        })();
    </script>
</head>
<body>
    <!-- Top Announcement & Quick Contact Bar (Dynamic) -->
    <div class="announcement-bar bg-dark text-white-50 py-1 border-bottom border-secondary small d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span class="me-3"><i class="bi bi-telephone-fill text-warning me-1"></i> Helpline: @site.SupportPhone</span>
                <span><i class="bi bi-whatsapp text-success me-1"></i> WhatsApp: @site.WhatsAppNumber</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(site.InstagramUrl))
                {
                    <a href="@site.InstagramUrl" target="_blank" class="text-white-50 text-decoration-none hover-white"><i class="bi bi-instagram"></i></a>
                }
                @if (!string.IsNullOrEmpty(site.FacebookUrl))
                {
                    <a href="@site.FacebookUrl" target="_blank" class="text-white-50 text-decoration-none hover-white"><i class="bi bi-facebook"></i></a>
                }
                @if (!string.IsNullOrEmpty(site.WhatsAppNumber))
                {
                    <a href="https://wa.me/@site.WhatsAppNumber.Replace("+","").Replace(" ","").Replace("(","").Replace(")","").Replace("-","")" target="_blank" class="text-white-50 text-decoration-none hover-white"><i class="bi bi-whatsapp"></i></a>
                }
                <span class="text-secondary">|</span>
                <a asp-controller="Home" asp-action="Contact" class="text-warning text-decoration-none fw-semibold">24/7 Support Desk</a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Header (Dynamic Brand / Logo) -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold text-warning d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    @if (!string.IsNullOrEmpty(site.LogoUrl))
                    {
                        <img src="@site.LogoUrl" alt="@site.SiteName" style="height: 38px; object-fit: contain;" class="me-2" />
                    }
                    else
                    {
                        <i class="bi @site.SiteIcon me-2 fs-3 text-warning"></i>
                    }
                    <span>@site.SiteName</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-controller="Properties" asp-action="Index">
                                <i class="bi bi-compass"></i> Explore Stays
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-controller="Properties" asp-action="Index" asp-route-typeId="1">
                                Villas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-controller="Properties" asp-action="Index" asp-route-typeId="2">
                                Farmhouses
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-medium" asp-controller="Properties" asp-action="Index" asp-route-typeId="3">
                                Resorts
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold" asp-controller="Home" asp-action="Contact">
                                <i class="bi bi-headset"></i> Support & Help
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                            if (role == "Admin")
                            {
                                <li class="nav-item dropdown me-2">
                                    <a class="btn btn-warning text-dark fw-bold px-3 dropdown-toggle shadow-sm" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-lock-fill me-1"></i> Admin Console
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                        <li><a class="dropdown-item fw-semibold" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard</a></li>
                                        <li><a class="dropdown-item fw-semibold text-success" asp-controller="Admin" asp-action="DynamicAnalytics"><i class="bi bi-graph-up-arrow text-success me-2"></i>Dynamic Analytics & Reports</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header text-uppercase small text-muted">Operations Queues</h6></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="RefundsQueue"><i class="bi bi-arrow-counterclockwise text-info me-2"></i>Refunds Operations</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="PartnerLeads"><i class="bi bi-people text-success me-2"></i>Partner Onboarding Leads</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="DamageClaims"><i class="bi bi-shield-shaded text-danger me-2"></i>Damage Claims Adjudication</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="IdVerifications"><i class="bi bi-person-vcard text-primary me-2"></i>Guest KYC Verifications</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header text-uppercase small text-muted">Platform Management</h6></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="ManageProperties"><i class="bi bi-houses me-2"></i>Manage Properties</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="ManageBookings"><i class="bi bi-calendar-check me-2"></i>Manage Bookings</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="ManageOwners"><i class="bi bi-person-badge me-2"></i>Manage Hosts & Tiers</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Settings"><i class="bi bi-gear me-2"></i>System Settings</a></li>
                                    </ul>
                                </li>
                            }
                            else if (role == "Employee")
                            {
                                <li class="nav-item dropdown me-2">
                                    <a class="btn btn-info text-dark fw-bold px-3 dropdown-toggle shadow-sm" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-headset me-1"></i> Operations Staff
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                        <li><a class="dropdown-item fw-semibold" asp-controller="Employee" asp-action="Index"><i class="bi bi-speedometer2 text-primary me-2"></i>Dashboard</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><h6 class="dropdown-header text-uppercase small text-muted">Operational Queues</h6></li>
                                        <li><a class="dropdown-item" asp-controller="Employee" asp-action="RefundsQueue"><i class="bi bi-arrow-counterclockwise text-info me-2"></i>Refunds Operations</a></li>
                                        <li><a class="dropdown-item" asp-controller="Employee" asp-action="PartnerLeads"><i class="bi bi-people text-success me-2"></i>Partner Onboarding Leads</a></li>
                                        <li><a class="dropdown-item" asp-controller="Employee" asp-action="DamageClaims"><i class="bi bi-shield-shaded text-danger me-2"></i>Damage Claims</a></li>
                                        <li><a class="dropdown-item" asp-controller="Employee" asp-action="IdVerifications"><i class="bi bi-person-vcard text-primary me-2"></i>Guest KYC Verifications</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Employee" asp-action="ManageProperties"><i class="bi bi-houses me-2"></i>Manage Properties</a></li>
                                        <li><a class="dropdown-item" asp-controller="Employee" asp-action="ManageBookings"><i class="bi bi-calendar-check me-2"></i>Manage Bookings</a></li>
                                        <li><a class="dropdown-item" asp-controller="Employee" asp-action="ManageOwners"><i class="bi bi-person-badge me-2"></i>Manage Hosts</a></li>
                                    </ul>
                                </li>
                            }
                            else if (role == "Owner")
                            {
                                <li class="nav-item dropdown me-2">
                                    <a class="btn btn-outline-warning text-warning px-3 dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-speedometer2 me-1"></i> Host Dashboard
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                        <li><a class="dropdown-item fw-semibold" asp-controller="Owner" asp-action="Index"><i class="bi bi-grid-fill text-warning me-2"></i>Host Dashboard</a></li>
                                        <li><a class="dropdown-item text-success fw-semibold" asp-controller="Owner" asp-action="CreateProperty"><i class="bi bi-plus-circle-fill text-success me-2"></i>List New Farm</a></li>
                                        <li><a class="dropdown-item text-danger" asp-controller="Owner" asp-action="DamageClaims"><i class="bi bi-shield-exclamation text-danger me-2"></i>Security Deposit Claims</a></li>
                                        <li><a class="dropdown-item" asp-controller="Owner" asp-action="Subscriptions"><i class="bi bi-award text-primary me-2"></i>Subscription Plans</a></li>
                                    </ul>
                                </li>
                            }
                            else if (role == "EventManager")
                            {
                                <li class="nav-item dropdown me-2">
                                    <a class="btn btn-outline-warning text-warning px-3 dropdown-toggle shadow-sm" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-palette2 me-1"></i> Event Manager
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                        <li><a class="dropdown-item fw-semibold" asp-controller="EventManager" asp-action="Dashboard"><i class="bi bi-speedometer2 text-primary me-2"></i>Event Dashboard</a></li>
                                        <li><a class="dropdown-item fw-semibold text-success" asp-controller="EventManager" asp-action="Packages"><i class="bi bi-box-seam text-success me-2"></i>Décor Packages</a></li>
                                        <li><a class="dropdown-item fw-semibold text-warning" asp-controller="EventManager" asp-action="AssignedSetups"><i class="bi bi-calendar-event text-warning me-2"></i>Assigned Setups</a></li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item me-2">
                                    <a class="btn btn-outline-warning text-warning px-3" asp-controller="Client" asp-action="Index">
                                        <i class="bi bi-calendar-check me-1"></i> My Bookings & KYC
                                    </a>
                                </li>
                            }
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-light rounded-pill px-3">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link text-warning fw-medium" asp-controller="Home" asp-action="Partner">
                                    <i class="bi bi-tree-fill me-1"></i> List Your Farm
                                </a>
                            </li>
                            <li class="nav-item me-2">
                                <a class="nav-link text-light fw-medium" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-person"></i> Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning fw-bold px-3 shadow-sm rounded-pill" asp-controller="Account" asp-action="Register">
                                    Sign Up
                                </a>
                            </li>
                        }
                    </ul>
                    <!-- Dark / Light Mode Toggle -->
                    <button id="themeSwitchBtn" class="ms-3" title="Toggle dark / light mode" aria-label="Toggle dark/light mode">
                        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Body Container -->
    <div class="container my-4 my-md-5">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <!-- Floating WhatsApp Widget (Dynamic) -->
    @if (!string.IsNullOrEmpty(site.WhatsAppNumber))
    {
        var cleanWa = site.WhatsAppNumber.Replace("+", "").Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "");
        <a href="https://wa.me/@cleanWa?text=Hi%20@Uri.EscapeDataString(site.SiteName),%20I%20am%20interested%20in%20booking%20a%20property" 
           target="_blank" 
           class="floating-whatsapp-btn shadow-lg" 
           title="Chat with Customer Support Executive on WhatsApp">
            <i class="bi bi-whatsapp"></i>
        </a>
    }

    <!-- Dynamic Footer -->
    <footer class="footer bg-dark text-white-50 pt-5 pb-4 mt-auto border-top border-secondary">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <h4 class="text-warning fw-bold mb-3 d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(site.LogoUrl))
                        {
                            <img src="@site.LogoUrl" alt="@site.SiteName" style="height: 30px;" class="me-2" />
                        }
                        else
                        {
                            <i class="bi @site.SiteIcon me-2"></i>
                        }
                        <span>@site.SiteName</span>
                    </h4>
                    <p class="small text-light opacity-75 pe-lg-4">
                        India's premier booking platform for private farmhouses, luxury villas, cottages, and party resorts. Enjoy 100% verified properties with flexible hourly, half-day, and full-day booking slots.
                    </p>
                    <div class="d-flex gap-3 fs-5 mt-3">
                        @if (!string.IsNullOrEmpty(site.InstagramUrl))
                        {
                            <a href="@site.InstagramUrl" target="_blank" class="text-warning text-decoration-none"><i class="bi bi-instagram"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(site.FacebookUrl))
                        {
                            <a href="@site.FacebookUrl" target="_blank" class="text-warning text-decoration-none"><i class="bi bi-facebook"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(site.WhatsAppNumber))
                        {
                            var cleanWa = site.WhatsAppNumber.Replace("+", "").Replace(" ", "").Replace("(", "").Replace(")", "").Replace("-", "");
                            <a href="https://wa.me/@cleanWa" target="_blank" class="text-success text-decoration-none"><i class="bi bi-whatsapp"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(site.YouTubeUrl))
                        {
                            <a href="@site.YouTubeUrl" target="_blank" class="text-danger text-decoration-none"><i class="bi bi-youtube"></i></a>
                        }
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Popular Stays</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Properties" asp-action="Index" asp-route-location="Lonavala" class="text-white-50 text-decoration-none hover-white">Lonavala Villas</a></li>
                        <li class="mb-2"><a asp-controller="Properties" asp-action="Index" asp-route-location="Alibaug" class="text-white-50 text-decoration-none hover-white">Alibaug Farmhouses</a></li>
                        <li class="mb-2"><a asp-controller="Properties" asp-action="Index" asp-route-location="Goa" class="text-white-50 text-decoration-none hover-white">Goa Beach Resorts</a></li>
                        <li class="mb-2"><a asp-controller="Properties" asp-action="Index" asp-route-location="Mahabaleshwar" class="text-white-50 text-decoration-none hover-white">Hillside Cottages</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Host with Us</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Account" asp-action="Register" class="text-white-50 text-decoration-none hover-white">List Your Farmhouse</a></li>
                        <li class="mb-2"><a asp-controller="Owner" asp-action="Subscriptions" class="text-white-50 text-decoration-none hover-white">Owner Subscription Plans</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Contact" class="text-white-50 text-decoration-none hover-white">Partner Support Desk</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Customer Support</h6>
                    <ul class="list-unstyled small text-light opacity-75">
                        <li class="mb-2"><i class="bi bi-headset text-warning me-2"></i> Dedicated Booking Executive</li>
                        <li class="mb-2"><i class="bi bi-telephone text-warning me-2"></i> @site.SupportPhone</li>
                        <li class="mb-2"><i class="bi bi-whatsapp text-success me-2"></i> @site.WhatsAppNumber</li>
                        <li class="mb-2"><i class="bi bi-envelope text-warning me-2"></i> @site.SupportEmail</li>
                        @if (!string.IsNullOrEmpty(site.Address))
                        {
                            <li class="mb-2"><i class="bi bi-geo-alt text-warning me-2"></i> @site.Address</li>
                        }
                    </ul>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-warning btn-sm w-100 mt-2">
                        <i class="bi bi-chat-dots"></i> Open Support Ticket
                    </a>
                </div>
            </div>

            <hr class="border-secondary my-3" />
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-light opacity-50">
                <p class="mb-0">&copy; @DateTime.UtcNow.Year @site.SiteName Platforms Private Limited. All Rights Reserved.</p>
                <div>
                    <a asp-controller="Home" asp-action="Privacy" class="text-light opacity-50 text-decoration-none me-3">Privacy Policy</a>
                    <a href="#" class="text-light opacity-50 text-decoration-none">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
