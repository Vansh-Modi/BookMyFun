@model BookMyFun.Models.ViewModels.PartnerLeadCreateViewModel
@{
    ViewData["Title"] = "Partner With Us — Host Farms or Offer Event Décor";
    var initialType = ViewBag.InitialType as string ?? "Owner";
    bool isEventTab = string.Equals(initialType, "EventManager", StringComparison.OrdinalIgnoreCase);
}

<div class="py-5" style="background: linear-gradient(135deg, rgba(5, 150, 105, 0.05) 0%, rgba(217, 119, 6, 0.05) 100%);">
    <div class="container py-4">
        <!-- Top Hero Section -->
        <div class="row align-items-center mb-5">
            <div class="col-lg-7">
                <span class="badge px-3 py-2 rounded-pill bg-dark text-warning fw-bold mb-3 shadow-sm">
                    <i class="bi bi-handshake-fill me-1"></i> BookMyFun Partner Ecosystem
                </span>
                <h1 class="display-4 fw-black text-heading mb-3">Partner With Us &amp; Expand Your Reach</h1>
                <p class="lead text-muted mb-4">
                    Join India's premier luxury farmstay and celebration marketplace. Whether you own a private villa, farm retreat, or operate an event planning &amp; staging agency, BookMyFun connects you with verified high-intent guests.
                </p>
                <div class="d-flex flex-wrap gap-4 text-dark font-monospace small">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                        <span>Zero Upfront Onboarding Cost</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-shield-lock-fill text-warning fs-5 me-2"></i>
                        <span>Guaranteed Payout Security</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-graph-up-arrow text-primary fs-5 me-2"></i>
                        <span>Dedicated Digital Dashboard</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden position-relative p-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: white;">
                    <div class="card-body py-4">
                        <div class="d-flex justify-content-center gap-3 mb-3">
                            <span class="p-3 rounded-circle bg-success bg-opacity-25 text-success fs-2">
                                <i class="bi bi-house-door-fill"></i>
                            </span>
                            <span class="p-3 rounded-circle bg-warning bg-opacity-25 text-warning fs-2">
                                <i class="bi bi-palette2"></i>
                            </span>
                        </div>
                        <h3 class="fw-bold">Dual Partner Network</h3>
                        <p class="small text-white-50 mb-0">
                            Partner as a Property Host to rent stays, or partner as an Event Manager to curate celebration décor for guests.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-9">
                <!-- Partner Category Switcher Tabs -->
                <div class="card border-0 shadow-sm rounded-4 p-2 mb-4 bg-card">
                    <div class="row g-2 text-center" id="partnerTypeNav">
                        <div class="col-md-6">
                            <button type="button" class="btn w-100 py-3 rounded-3 fw-bold @(!isEventTab ? "btn-success shadow-sm" : "btn-light border-0 text-muted")" id="btnTabOwner" onclick="switchPartnerTab('Owner')" style="@(!isEventTab ? "background-color: #059669; border-color: #059669;" : "")">
                                <i class="bi bi-house-door-fill me-2 fs-5 align-middle"></i>
                                <span>I am a Farmhouse / Villa Owner</span>
                                <small class="d-block fw-normal opacity-75" style="font-size: 0.78rem;">List your private stay &amp; earn regular rental income</small>
                            </button>
                        </div>
                        <div class="col-md-6">
                            <button type="button" class="btn w-100 py-3 rounded-3 fw-bold @(isEventTab ? "btn-warning text-dark shadow-sm" : "btn-light border-0 text-muted")" id="btnTabEvent" onclick="switchPartnerTab('EventManager')">
                                <i class="bi bi-palette2 me-2 fs-5 align-middle"></i>
                                <span>I am an Event Manager / Decorator</span>
                                <small class="d-block fw-normal opacity-75" style="font-size: 0.78rem;">Provide theme staging, floral &amp; celebration setups</small>
                            </button>
                        </div>
                    </div>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-4 mb-4 p-4" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill fs-2 me-3 text-success"></i>
                            <div>
                                <h5 class="alert-heading fw-bold mb-1">Application Received Successfully!</h5>
                                <p class="mb-0">@TempData["Success"]</p>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Unified Dynamic Partner Intake Form -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-card">
                    <div class="card-header bg-white border-0 pt-4 px-4 px-md-5">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span id="partnerBadge" class="badge @(isEventTab ? "bg-warning-subtle text-dark border border-warning-subtle" : "bg-success-subtle text-success border border-success-subtle") px-3 py-1 rounded-pill small fw-semibold mb-2">
                                    <i id="partnerBadgeIcon" class="bi @(isEventTab ? "bi-palette2" : "bi-house-check") me-1"></i>
                                    <span id="partnerBadgeText">@(isEventTab ? "Event Manager & Décor Studio Intake" : "Farm & Villa Host Intake")</span>
                                </span>
                                <h4 id="partnerHeading" class="fw-bold mb-1 text-heading">@(isEventTab ? "Partner as Event Planner & Décor Studio" : "List Your Farmstay or Private Villa")</h4>
                                <p id="partnerSubtitle" class="text-muted small mb-0">@(isEventTab ? "Offer themed packages, stage decor, and floral styling to guests booking stays on BookMyFun." : "Fill out your farm details. Our onboarding team inspects submissions within 24-48 business hours.")</p>
                            </div>
                            <div id="partnerHeaderIconBox" class="d-none d-sm-block p-3 @(isEventTab ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success") rounded-4 fs-3">
                                <i id="partnerHeaderIcon" class="bi @(isEventTab ? "bi-balloon-heart" : "bi-tree")"></i>
                            </div>
                        </div>
                    </div>
                    <div class="card-body p-4 p-md-5">
                        <form asp-action="Partner" method="post" id="partnerForm" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="PartnerType" id="partnerTypeInput" value="@(isEventTab ? "EventManager" : "Owner")" />

                            <div asp-validation-summary="All" class="alert alert-danger rounded-3 @(ViewData.ModelState.IsValid ? "d-none" : "")" role="alert"></div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small text-muted" id="lblFullName">@(isEventTab ? "Lead Decorator / Planner Name" : "Owner Full Name") <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-person"></i></span>
                                        <input asp-for="FullName" id="inputFullName" class="form-control border-start-0 ps-0" placeholder="@(isEventTab ? "e.g. Aarti Sharma" : "e.g. Ramesh Patel")" required />
                                    </div>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small text-muted">Contact Phone / WhatsApp <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-whatsapp"></i></span>
                                        <input asp-for="Phone" class="form-control border-start-0 ps-0" placeholder="e.g. +91 98765 43210" required />
                                    </div>
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-semibold small text-muted" id="lblEmail">@(isEventTab ? "Business Email Address (for event manager dashboard)" : "Email Address (for host dashboard activation)") <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope"></i></span>
                                        <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="name@domain.com" required />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                    <small class="text-muted" id="lblEmailHelp">@(isEventTab ? "An automated invite with your Event Manager Dashboard login credentials will be dispatched to this email upon approval." : "An automated invite with your Host Dashboard login credentials will be dispatched to this email upon approval.")</small>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small text-muted" id="lblPropertyName">@(isEventTab ? "Décor Studio / Agency / Brand Name" : "Farm / Villa Property Name") <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i id="iconPropertyName" class="bi @(isEventTab ? "bi-stars" : "bi-house")"></i></span>
                                        <input asp-for="PropertyName" id="inputPropertyName" class="form-control border-start-0 ps-0" placeholder="@(isEventTab ? "e.g. Royal Bloom Celebration Staging" : "e.g. Whispering Palms Luxury Villa")" required />
                                    </div>
                                    <span asp-validation-for="PropertyName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small text-muted" id="lblLocation">@(isEventTab ? "Operating Cities / Service Regions" : "City / Region / Landmark") <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt"></i></span>
                                        <input asp-for="Location" id="inputLocation" class="form-control border-start-0 ps-0" placeholder="@(isEventTab ? "e.g. Lonavala, Pune, Alibaug, Mumbai" : "e.g. Lonavala, Maharashtra")" required />
                                    </div>
                                    <span asp-validation-for="Location" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-semibold small text-muted" id="lblAcreageOrType">@(isEventTab ? "Décor Specialization & Package Offerings" : "Acreage & Farm Type") <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0"><i id="iconAcreageOrType" class="bi @(isEventTab ? "bi-boxes" : "bi-aspect-ratio")"></i></span>
                                        <input asp-for="AcreageOrType" id="inputAcreageOrType" class="form-control border-start-0 ps-0" placeholder="@(isEventTab ? "e.g. Weddings, Birthday Themes, Poolside Stages, Neon Lights, Floral Gazebos" : "e.g. 4 Acres with Swimming Pool & Gazebo, 5 BHK")" required />
                                    </div>
                                    <span asp-validation-for="AcreageOrType" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-semibold small text-muted" id="lblMessage">@(isEventTab ? "Portfolio Links, Instagram Handle & Crew Details" : "Key Amenities & Caretaker Availability")</label>
                                    <textarea asp-for="Message" id="inputMessage" class="form-control" rows="4" placeholder="@(isEventTab ? "Share links to your Instagram, website, past work photos, crew sizes, staging equipment available (truss, sound, lights)..." : "Mention private pool, lawn capacity, music system, barbecue, caretaker availability, pricing expectations...")"></textarea>
                                    <span asp-validation-for="Message" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mt-4 pt-2">
                                <button type="submit" id="btnSubmitPartner" class="btn @(isEventTab ? "btn-warning text-dark" : "btn-success") btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm" style="@(!isEventTab ? "background-color: #059669; border-color: #059669;" : "")">
                                    <i class="bi bi-send-check me-2"></i>
                                    <span id="btnSubmitText">@(isEventTab ? "Submit Event Manager Application" : "Submit Farm Host Application")</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <p class="text-muted small">
                        Looking to book a stay or plan your getaway? <a asp-controller="Home" asp-action="Index" class="fw-semibold text-decoration-none text-success">Explore Stays &rarr;</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    function switchPartnerTab(tab) {
        const isEvent = (tab === 'EventManager');
        const ownerBtn = document.getElementById('btnTabOwner');
        const eventBtn = document.getElementById('btnTabEvent');
        const partnerTypeInput = document.getElementById('partnerTypeInput');

        partnerTypeInput.value = isEvent ? 'EventManager' : 'Owner';

        if (isEvent) {
            ownerBtn.className = 'btn w-100 py-3 rounded-3 fw-bold btn-light border-0 text-muted';
            ownerBtn.style.backgroundColor = '';
            ownerBtn.style.borderColor = '';

            eventBtn.className = 'btn w-100 py-3 rounded-3 fw-bold btn-warning text-dark shadow-sm';

            // Update badge & header
            document.getElementById('partnerBadge').className = 'badge bg-warning-subtle text-dark border border-warning-subtle px-3 py-1 rounded-pill small fw-semibold mb-2';
            document.getElementById('partnerBadgeIcon').className = 'bi bi-palette2 me-1';
            document.getElementById('partnerBadgeText').textContent = 'Event Manager & Décor Studio Intake';
            document.getElementById('partnerHeading').textContent = 'Partner as Event Planner & Décor Studio';
            document.getElementById('partnerSubtitle').textContent = 'Offer themed packages, stage decor, and floral styling to guests booking stays on BookMyFun.';
            document.getElementById('partnerHeaderIconBox').className = 'd-none d-sm-block p-3 bg-warning-subtle text-warning rounded-4 fs-3';
            document.getElementById('partnerHeaderIcon').className = 'bi bi-balloon-heart';

            // Update labels & placeholders
            document.getElementById('lblFullName').innerHTML = 'Lead Decorator / Planner Name <span class="text-danger">*</span>';
            document.getElementById('inputFullName').placeholder = 'e.g. Aarti Sharma';

            document.getElementById('lblEmail').innerHTML = 'Business Email Address (for event manager dashboard) <span class="text-danger">*</span>';
            document.getElementById('lblEmailHelp').textContent = 'An automated invite with your Event Manager Dashboard login credentials will be dispatched to this email upon approval.';

            document.getElementById('lblPropertyName').innerHTML = 'Décor Studio / Agency / Brand Name <span class="text-danger">*</span>';
            document.getElementById('iconPropertyName').className = 'bi bi-stars';
            document.getElementById('inputPropertyName').placeholder = 'e.g. Royal Bloom Celebration Staging';

            document.getElementById('lblLocation').innerHTML = 'Operating Cities / Service Regions <span class="text-danger">*</span>';
            document.getElementById('inputLocation').placeholder = 'e.g. Lonavala, Pune, Alibaug, Mumbai';

            document.getElementById('lblAcreageOrType').innerHTML = 'Décor Specialization & Package Offerings <span class="text-danger">*</span>';
            document.getElementById('iconAcreageOrType').className = 'bi bi-boxes';
            document.getElementById('inputAcreageOrType').placeholder = 'e.g. Weddings, Birthday Themes, Poolside Stages, Neon Lights, Floral Gazebos';

            document.getElementById('lblMessage').textContent = 'Portfolio Links, Instagram Handle & Crew Details';
            document.getElementById('inputMessage').placeholder = 'Share links to your Instagram, website, past work photos, crew sizes, staging equipment available (truss, sound, lights)...';

            // Update submit button
            const btnSubmit = document.getElementById('btnSubmitPartner');
            btnSubmit.className = 'btn btn-warning text-dark btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm';
            btnSubmit.style.backgroundColor = '';
            btnSubmit.style.borderColor = '';
            document.getElementById('btnSubmitText').textContent = 'Submit Event Manager Application';
        } else {
            eventBtn.className = 'btn w-100 py-3 rounded-3 fw-bold btn-light border-0 text-muted';

            ownerBtn.className = 'btn w-100 py-3 rounded-3 fw-bold btn-success shadow-sm';
            ownerBtn.style.backgroundColor = '#059669';
            ownerBtn.style.borderColor = '#059669';

            // Update badge & header
            document.getElementById('partnerBadge').className = 'badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill small fw-semibold mb-2';
            document.getElementById('partnerBadgeIcon').className = 'bi bi-house-check me-1';
            document.getElementById('partnerBadgeText').textContent = 'Farm & Villa Host Intake';
            document.getElementById('partnerHeading').textContent = 'List Your Farmstay or Private Villa';
            document.getElementById('partnerSubtitle').textContent = 'Fill out your farm details. Our onboarding team inspects submissions within 24-48 business hours.';
            document.getElementById('partnerHeaderIconBox').className = 'd-none d-sm-block p-3 bg-success-subtle text-success rounded-4 fs-3';
            document.getElementById('partnerHeaderIcon').className = 'bi bi-tree';

            // Update labels & placeholders
            document.getElementById('lblFullName').innerHTML = 'Owner Full Name <span class="text-danger">*</span>';
            document.getElementById('inputFullName').placeholder = 'e.g. Ramesh Patel';

            document.getElementById('lblEmail').innerHTML = 'Email Address (for host dashboard activation) <span class="text-danger">*</span>';
            document.getElementById('lblEmailHelp').textContent = 'An automated invite with your Host Dashboard login credentials will be dispatched to this email upon approval.';

            document.getElementById('lblPropertyName').innerHTML = 'Farm / Villa Property Name <span class="text-danger">*</span>';
            document.getElementById('iconPropertyName').className = 'bi bi-house';
            document.getElementById('inputPropertyName').placeholder = 'e.g. Whispering Palms Luxury Villa';

            document.getElementById('lblLocation').innerHTML = 'City / Region / Landmark <span class="text-danger">*</span>';
            document.getElementById('inputLocation').placeholder = 'e.g. Lonavala, Maharashtra';

            document.getElementById('lblAcreageOrType').innerHTML = 'Acreage & Farm Type <span class="text-danger">*</span>';
            document.getElementById('iconAcreageOrType').className = 'bi bi-aspect-ratio';
            document.getElementById('inputAcreageOrType').placeholder = 'e.g. 4 Acres with Swimming Pool & Gazebo, 5 BHK';

            document.getElementById('lblMessage').textContent = 'Key Amenities & Caretaker Availability';
            document.getElementById('inputMessage').placeholder = 'Mention private pool, lawn capacity, music system, barbecue, caretaker availability, pricing expectations...';

            // Update submit button
            const btnSubmit = document.getElementById('btnSubmitPartner');
            btnSubmit.className = 'btn btn-success btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm';
            btnSubmit.style.backgroundColor = '#059669';
            btnSubmit.style.borderColor = '#059669';
            document.getElementById('btnSubmitText').textContent = 'Submit Farm Host Application';
        }
    }
</script>
}
