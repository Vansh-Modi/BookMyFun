                            </button>
                        </form>
                    </div>

                    <!-- WhatsApp Form -->
                    @{
                        var wa = configs.FirstOrDefault(c => c.ServiceProvider == "WhatsApp") ?? new BookMyFun.Models.Entities.ApiConfiguration { ServiceProvider = "WhatsApp" };
                    }
                    <div class="tab-pane fade" id="tabWhatsApp">
                        <form asp-controller="Admin" asp-action="SaveApiConfig" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ServiceProvider" value="WhatsApp" />
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Meta Cloud API Access Token</label>
                                <input name="ApiKey" class="form-control" value="@wa.ApiKey" placeholder="Bearer EAAG..." required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Phone Number ID</label>
                                <input name="ApiSecret" class="form-control" value="@wa.ApiSecret" placeholder="e.g. 109823482716" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Webhook Secret / Parameters (JSON)</label>
                                <input name="ExtraParams" class="form-control" value="@wa.ExtraParams" placeholder='{"WabaId": "..."}' />
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="waActive" @(wa.IsActive ? "checked" : "")>
                                <label class="form-check-label fw-semibold" for="waActive">Enable Automated WhatsApp Alerts</label>
                            </div>
                            <button type="submit" class="btn btn-success fw-bold w-100">
                                <i class="bi bi-save me-1"></i> Update WhatsApp API
                            </button>
                        </form>
                    </div>

                    <!-- SMTP Form -->
                    @{
                        var smtp = configs.FirstOrDefault(c => c.ServiceProvider == "SMTP") ?? new BookMyFun.Models.Entities.ApiConfiguration { ServiceProvider = "SMTP" };
                    }
                    <div class="tab-pane fade" id="tabSMTP">
                        <form asp-controller="Admin" asp-action="SaveApiConfig" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ServiceProvider" value="SMTP" />
                            <div class="mb-3">
                                <label class="form-label fw-semibold">SMTP Username / Email</label>
                                <input name="ApiKey" class="form-control" value="@smtp.ApiKey" placeholder="notifications@bookmyfun.com" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">SMTP Password / App Password</label>
                                <input name="ApiSecret" type="password" class="form-control" value="@smtp.ApiSecret" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">SMTP Host & Port (JSON)</label>
                                <input name="ExtraParams" class="form-control" value="@(smtp.ExtraParams ?? "{\"Host\":\"smtp.gmail.com\",\"Port\":587}")" />
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="smtpActive" @(smtp.IsActive ? "checked" : "")>
                                <label class="form-check-label fw-semibold" for="smtpActive">Enable SMTP Email Service</label>
                            </div>
                            <button type="submit" class="btn btn-primary fw-bold w-100">
                                <i class="bi bi-save me-1"></i> Update SMTP Server
                            </button>
                        </form>
                    </div>

                    <!-- Cashfree Form -->
                    @{
                        var cashfree = configs.FirstOrDefault(c => c.ServiceProvider == "Cashfree") ?? new BookMyFun.Models.Entities.ApiConfiguration { ServiceProvider = "Cashfree" };
                    }
                    <div class="tab-pane fade" id="tabCashfree">
                        <form asp-controller="Admin" asp-action="SaveApiConfig" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ServiceProvider" value="Cashfree" />
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Cashfree App ID</label>
                                <input name="ApiKey" class="form-control" value="@cashfree.ApiKey" placeholder="CF_TEST_..." required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Cashfree Secret Key</label>
                                <input name="ApiSecret" type="password" class="form-control" value="@cashfree.ApiSecret" required />
