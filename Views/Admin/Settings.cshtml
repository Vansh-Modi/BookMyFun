                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const categorySelect = document.getElementById("settingsCategorySelect");
        const categoryPills = document.querySelectorAll(".category-pill");
        const cards = document.querySelectorAll(".config-card");

        function filterCategory(targetId) {
            if (targetId === "all") {
                cards.forEach(card => card.style.display = "");
            } else {
                cards.forEach(card => {
                    if (card.id === targetId) {
                        card.style.display = "";
                        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    } else {
                        card.style.display = "none";
                    }
                });
            }

            // Sync pill active state
            categoryPills.forEach(pill => {
                if (pill.getAttribute("data-target") === targetId) {
                    pill.classList.add("active", "btn-primary");
                    pill.classList.remove("btn-outline-primary");
                } else {
                    pill.classList.remove("active", "btn-primary");
                    pill.classList.add("btn-outline-primary");
                }
            });

            // Sync select value
            if (categorySelect.value !== targetId) {
                categorySelect.value = targetId;
            }
        }

        categorySelect.addEventListener("change", function () {
            filterCategory(this.value);
        });

        categoryPills.forEach(pill => {
            pill.addEventListener("click", function () {
                const target = this.getAttribute("data-target");
                filterCategory(target);
            });
        });

        // Real-time Logo Preview handling
        const fileInput = document.getElementById("logoFileInput");
        const urlInput = document.getElementById("logoUrlInput");
        const previewImg = document.getElementById("logoPreviewImg");
        const placeholder = document.getElementById("logoPreviewPlaceholder");

        if (fileInput) {
            fileInput.addEventListener("change", function () {
                if (this.files && this.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        previewImg.src = e.target.result;
                        previewImg.style.display = "block";
                        if (placeholder) placeholder.style.display = "none";
                    };
                    reader.readAsDataURL(this.files[0]);
                }
            });
        }

        if (urlInput) {
            urlInput.addEventListener("input", function () {
                if (this.value.trim().length > 5) {
                    previewImg.src = this.value.trim();
                    previewImg.style.display = "block";
                    if (placeholder) placeholder.style.display = "none";
                }
            });
        }
    });

    function filterEventTable() {
        const query = (document.getElementById("eventSearchInput")?.value || "").toLowerCase().trim();
        const rows = document.querySelectorAll(".event-pkg-row");
        rows.forEach(r => {
            const name = r.getAttribute("data-name") || "";
            const category = r.getAttribute("data-category") || "";
            if (!query || name.includes(query) || category.includes(query)) {
                r.style.display = "";
            } else {
                r.style.display = "none";
            }
        });
    }

    async function saveSpecificEventComm(packageId, packageName) {
        const input = document.getElementById(`input_pkg_${packageId}`);
        const statusCell = document.getElementById(`status_cell_${packageId}`);
        const standingInput = document.getElementById("standingEventCommInput");
        const standingVal = standingInput ? standingInput.value : "10";
        const val = input.value.trim();
        const rate = val !== "" ? parseFloat(val) : null;

        if (rate !== null && (isNaN(rate) || rate < 0 || rate > 100)) {
            alert("Please enter a valid commission percentage between 0 and 100.");
            return;
        }

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const resp = await fetch(`/Admin/UpdateEventCommission`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ packageId: packageId, commissionRate: rate })
            });
            const data = await resp.json();
            if (data.success) {
                if (rate !== null) {
                    statusCell.innerHTML = `<span class="badge bg-warning-subtle text-dark border border-warning"><i class="bi bi-star-fill text-warning me-1"></i>Custom: ${rate.toFixed(1)}%</span>`;
                } else {
                    statusCell.innerHTML = `<span class="badge bg-light text-muted border">Standing Default (${standingVal}%)</span>`;
                }
                showCommissionToast(`Commission for '${packageName}' updated to ${rate !== null ? rate + '%' : 'standing default (' + standingVal + '%)'}!`, true);
            } else {
                showCommissionToast(data.message || "Failed to update event commission.", false);
            }
        } catch (e) {
            showCommissionToast("Error updating event commission.", false);
        }
    }

    async function resetSpecificEventComm(packageId, packageName) {
        const input = document.getElementById(`input_pkg_${packageId}`);
        if (input) input.value = "";
        await saveSpecificEventComm(packageId, packageName);
    }

    function showCommissionToast(message, isSuccess) {
        let toastContainer = document.getElementById("commissionToastContainer");
        if (!toastContainer) {
            toastContainer = document.createElement("div");
            toastContainer.id = "commissionToastContainer";
            toastContainer.style.position = "fixed";
            toastContainer.style.bottom = "20px";
            toastContainer.style.right = "20px";
            toastContainer.style.zIndex = "9999";
            document.body.appendChild(toastContainer);
        }
        const toast = document.createElement("div");
        toast.className = `alert alert-${isSuccess ? 'success' : 'danger'} alert-dismissible fade show shadow-lg py-2 px-3 mb-2`;
        toast.innerHTML = `<i class="bi bi-${isSuccess ? 'check-circle-fill' : 'exclamation-circle-fill'} me-2"></i>${message}<button type="button" class="btn-close p-2" data-bs-dismiss="alert"></button>`;
        toastContainer.appendChild(toast);
        setTimeout(() => toast.remove(), 4000);
    }
</script>
}
