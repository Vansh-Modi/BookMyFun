                            <div class="mb-3">
                                <label class="form-label fw-semibold">Google Client ID</label>
                                <input name="ApiKey" class="form-control" value="@google.ApiKey" placeholder="e.g. 123456789-abc.apps.googleusercontent.com" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Google Client Secret</label>
                                <input name="ApiSecret" type="password" class="form-control" value="@google.ApiSecret" placeholder="••••••••••••" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Active Project Email / Parameters (JSON)</label>
                                <input name="ExtraParams" class="form-control" value="@(google.ExtraParams ?? "{\"ProjectEmail\":\"showsgarage@gmail.com\"}")" placeholder='{"ProjectEmail":"showsgarage@gmail.com"}' />
