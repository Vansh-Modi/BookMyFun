@model BookMyFun.Services.SiteSettingsModel
@{
    ViewData["Title"] = "Platform Settings";
    string activeSection = ViewBag.ActiveSection as string ?? "sec-commission";
}

<div class="dash-page-header">
    <div>
        <p class="dash-eyebrow">Admin Portal · Configuration</p>
        <h1 class="dash-title"><i class="bi bi-sliders text-primary me-2"></i>Platform Settings</h1>
        <p class="dash-subtitle">Manage commission rates, refund rules, payment gateways, notifications, footer details, legal compliance, and feature toggles.</p>
    </div>
    <div class="dash-actions">
        <a asp-action="Index" class="dash-btn dash-btn-outline"><i class="bi bi-arrow-left me-1"></i> Dashboard</a>
        <a asp-action="AuditLog" class="dash-btn dash-btn-outline"><i class="bi bi-journal-text me-1"></i> Audit Trail</a>
    </div>
</div>

<!-- Section Navigation Pills for Quick Access -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <a href="#sec-commission" class="btn btn-sm btn-outline-primary rounded-pill px-3 @(activeSection == "sec-commission" ? "active" : "")" onclick="openSection('collapseCommission')">
        <i class="bi bi-percent me-1"></i> Commission
    </a>
    <a href="#sec-refunds" class="btn btn-sm btn-outline-info rounded-pill px-3 @(activeSection == "sec-refunds" ? "active" : "")" onclick="openSection('collapseRefunds')">
        <i class="bi bi-arrow-counterclockwise me-1"></i> Refunds
    </a>
    <a href="#sec-payments" class="btn btn-sm btn-outline-success rounded-pill px-3 @(activeSection == "sec-payments" ? "active" : "")" onclick="openSection('collapsePayments')">
        <i class="bi bi-credit-card me-1"></i> Payments
    </a>
    <a href="#sec-notifications" class="btn btn-sm btn-outline-warning rounded-pill px-3 @(activeSection == "sec-notifications" ? "active" : "")" onclick="openSection('collapseNotifications')">
        <i class="bi bi-bell me-1"></i> Notifications
    </a>
    <a href="#sec-footer" class="btn btn-sm btn-outline-secondary rounded-pill px-3 @(activeSection == "sec-footer" ? "active" : "")" onclick="openSection('collapseFooter')">
        <i class="bi bi-layout-text-window-reverse me-1"></i> Footer
    </a>
    <a href="#sec-legal" class="btn btn-sm btn-outline-dark rounded-pill px-3 @(activeSection == "sec-legal" ? "active" : "")" onclick="openSection('collapseLegal')">
        <i class="bi bi-file-earmark-text me-1"></i> Legal
    </a>
    <a href="#sec-features" class="btn btn-sm btn-outline-danger rounded-pill px-3 @(activeSection == "sec-features" ? "active" : "")" onclick="openSection('collapseFeatures')">
        <i class="bi bi-toggle-on me-1"></i> Feature Flags
    </a>
</div>

<!-- Collapsible Accordion: Single Open Section at a Time (Item 1 STRICT) -->
<div class="accordion shadow-sm rounded-4 overflow-hidden" id="settingsAccordion">

    <!-- 1. COMMISSION SECTION -->
    <div class="accordion-item border-0 border-bottom" id="sec-commission">
        <h2 class="accordion-header">
            <button class="accordion-button @(activeSection == "sec-commission" ? "" : "collapsed") fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCommission" aria-expanded="@(activeSection == "sec-commission" ? "true" : "false")" aria-controls="collapseCommission">
                <i class="bi bi-percent text-primary fs-5 me-2"></i>
                <div class="d-flex flex-column text-start">
                    <span>1. Platform Commission &amp; Financial Cuts</span>
                    <small class="text-muted fw-normal">Configure baseline commission percentages retained from stays and event packages.</small>
                </div>
            </button>
        </h2>
        <div id="collapseCommission" class="accordion-collapse collapse @(activeSection == "sec-commission" ? "show" : "")" data-bs-parent="#settingsAccordion">
            <div class="accordion-body p-4 bg-body">
                <form asp-action="SaveCommissionSettings" method="post">
                    @Html.AntiForgeryToken()
                    <div class="alert alert-info py-2 px-3 small mb-4">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Commission applies automatically at booking checkout. Individual hosts and event packages can have custom rate overrides.
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Standard Property Commission (%)</label>
                            <div class="input-group">
                                <input type="number" step="0.01" min="0" max="100" name="platformCommission" value="@Model.PlatformCommissionPercent" class="form-control" required />
                                <span class="input-group-text">%</span>
                            </div>
                            <small class="text-muted">Standard cut deducted from property host gross reservation payout (Default: 10%).</small>
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Event Décor Package Commission (%)</label>
                            <div class="input-group">
                                <input type="number" step="0.01" min="0" max="100" name="eventCommission" value="@Model.EventPlatformCommissionPercent" class="form-control" required />
                                <span class="input-group-text">%</span>
                            </div>
                            <small class="text-muted">Platform fee retained from event decorator package price (Default: 10%).</small>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Commission Settings
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 2. REFUNDS SECTION -->
    <div class="accordion-item border-0 border-bottom" id="sec-refunds">
        <h2 class="accordion-header">
            <button class="accordion-button @(activeSection == "sec-refunds" ? "" : "collapsed") fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRefunds" aria-expanded="@(activeSection == "sec-refunds" ? "true" : "false")" aria-controls="collapseRefunds">
                <i class="bi bi-arrow-counterclockwise text-info fs-5 me-2"></i>
                <div class="d-flex flex-column text-start">
                    <span>2. Refunds, Cancellations &amp; Policy Matrix</span>
                    <small class="text-muted fw-normal">Configure free cancellation windows, penalty deductions, and refund parameters.</small>
                </div>
            </button>
        </h2>
        <div id="collapseRefunds" class="accordion-collapse collapse @(activeSection == "sec-refunds" ? "show" : "")" data-bs-parent="#settingsAccordion">
            <div class="accordion-body p-4 bg-body">
                <form asp-action="SaveRefundSettings" method="post">
                    @Html.AntiForgeryToken()
                    <p class="text-muted small mb-3">Enforces cancellation quotes generated by the 6-scenario automated Refund Engine.</p>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Free Cancellation Grace Window (Hours before check-in)</label>
                            <div class="input-group">
                                <input type="number" min="0" name="freeCancelHours" value="@Model.FreeCancellationWindowHours" class="form-control" required />
                                <span class="input-group-text">Hours</span>
                            </div>
                            <small class="text-muted">Guests receive 100% refund (minus 2% gateway fee) before this cutoff (Default: 48 hours).</small>
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Hard Cancellation Cutoff (Hours before check-in)</label>
                            <div class="input-group">
                                <input type="number" min="0" name="cutoffHours" value="@Model.CancellationCutoffHours" class="form-control" required />
                                <span class="input-group-text">Hours</span>
                            </div>
                            <small class="text-muted">Cancellations closer than this window are non-refundable (Default: 24 hours).</small>
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Default Cancellation Penalty Type</label>
                            <select name="feeType" class="form-select">
                                <option value="percentage" selected="@(Model.CancellationFeeType == "percentage")">Percentage (%)</option>
                                <option value="fixed" selected="@(Model.CancellationFeeType == "fixed")">Fixed Amount (₹)</option>
                            </select>
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Default Cancellation Penalty Value</label>
                            <input type="number" step="0.01" min="0" name="feeValue" value="@Model.CancellationFeeValue" class="form-control" required />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Standard Processing Timeline</label>
                            <input type="text" name="timeline" value="@Model.RefundProcessingTimeline" class="form-control" placeholder="5 to 7 business days" required />
                            <small class="text-muted">Shown in client confirmation alerts and refund queue.</small>
                        </div>
                    </div>

                    <!-- Open Decisions Placeholders (D1, D2, D3) -->
                    <div class="card border-warning border-opacity-50 bg-warning bg-opacity-10 rounded-3 p-3 mb-4">
                        <h6 class="fw-bold text-dark mb-2"><i class="bi bi-clock-history text-warning me-1"></i> Open Policy Decisions (Pending Platform Decision)</h6>
                        <div class="row g-3 small">
                            <div class="col-md-4 col-12">
                                <label class="fw-semibold text-dark">D1: Partial Refund Commission Policy</label>
                                <input type="text" name="d1Policy" value="@Model.D1_PartialCancellationCommissionPolicy" class="form-control form-control-sm bg-white" />
                                <span class="text-muted">Placeholder: KeepOnPaidHalf</span>
                            </div>
                            <div class="col-md-4 col-12">
                                <label class="fw-semibold text-dark">D2: Under 72h Host Policy Override</label>
                                <input type="text" name="d2Policy" value="@Model.D2_Under72hOwnerPolicyOverride" class="form-control form-control-sm bg-white" />
                                <span class="text-muted">Placeholder: NoRefundAll</span>
                            </div>
                            <div class="col-md-4 col-12">
                                <label class="fw-semibold text-dark">D3: Host Cancellation Penalty (₹)</label>
                                <input type="number" step="0.01" name="d3Penalty" value="@Model.D3_OwnerCancellationPenaltyAmount" class="form-control form-control-sm bg-white" />
                                <span class="text-muted">Placeholder: ₹500.00</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-info text-white px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Refund Settings
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 3. PAYMENTS SECTION -->
    <div class="accordion-item border-0 border-bottom" id="sec-payments">
        <h2 class="accordion-header">
            <button class="accordion-button @(activeSection == "sec-payments" ? "" : "collapsed") fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePayments" aria-expanded="@(activeSection == "sec-payments" ? "true" : "false")" aria-controls="collapsePayments">
                <i class="bi bi-credit-card text-success fs-5 me-2"></i>
                <div class="d-flex flex-column text-start">
                    <span>3. Payment Gateways &amp; Currency</span>
                    <small class="text-muted fw-normal">Configure Razorpay credentials, sandbox keys, and transaction currency symbol.</small>
                </div>
            </button>
        </h2>
        <div id="collapsePayments" class="accordion-collapse collapse @(activeSection == "sec-payments" ? "show" : "")" data-bs-parent="#settingsAccordion">
            <div class="accordion-body p-4 bg-body">
                <form asp-action="SavePaymentSettings" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Platform Currency Symbol</label>
                            <input type="text" name="currencySymbol" value="@Model.CurrencySymbol" class="form-control" placeholder="₹" required />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Razorpay Key ID</label>
                            <input type="text" name="razorpayKeyId" value="@Model.RazorpayKeyId" class="form-control" placeholder="rzp_live_... or rzp_test_..." />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Razorpay Key Secret</label>
                            <input type="password" name="razorpayKeySecret" value="@(string.IsNullOrEmpty(Model.RazorpayKeySecret) ? "" : "••••••••••••••••")" class="form-control" placeholder="Leave empty to retain existing secret" />
                            <small class="text-muted">Encrypted on persistence. Secrets are never rendered plaintext.</small>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-success px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Payment Settings
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 4. NOTIFICATIONS SECTION -->
    <div class="accordion-item border-0 border-bottom" id="sec-notifications">
        <h2 class="accordion-header">
            <button class="accordion-button @(activeSection == "sec-notifications" ? "" : "collapsed") fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseNotifications" aria-expanded="@(activeSection == "sec-notifications" ? "true" : "false")" aria-controls="collapseNotifications">
                <i class="bi bi-bell text-warning fs-5 me-2"></i>
                <div class="d-flex flex-column text-start">
                    <span>4. Notifications &amp; Messaging Gateways</span>
                    <small class="text-muted fw-normal">Manage automated SMTP email delivery and Meta/WhatsApp alert dispatch parameters.</small>
                </div>
            </button>
        </h2>
        <div id="collapseNotifications" class="accordion-collapse collapse @(activeSection == "sec-notifications" ? "show" : "")" data-bs-parent="#settingsAccordion">
            <div class="accordion-body p-4 bg-body">
                <form asp-action="SaveNotificationSettings" method="post">
                    @Html.AntiForgeryToken()
                    <h6 class="fw-bold text-primary mb-3"><i class="bi bi-envelope-at me-1"></i> SMTP Email Configuration</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">SMTP Host / Server</label>
                            <input type="text" name="smtpServer" value="@Model.SmtpServer" class="form-control" placeholder="smtp.gmail.com" />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">SMTP Port</label>
                            <input type="number" name="smtpPort" value="@Model.SmtpPort" class="form-control" placeholder="587" />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">SMTP Username</label>
                            <input type="text" name="smtpUsername" value="@Model.SmtpUsername" class="form-control" placeholder="noreply@bookmyfun.com" />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">SMTP Password</label>
                            <input type="password" name="smtpPassword" value="@(string.IsNullOrEmpty(Model.SmtpPassword) ? "" : "••••••••••••••••")" class="form-control" placeholder="Leave empty to retain existing password" />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Sender Display Email</label>
                            <input type="email" name="smtpSenderEmail" value="@Model.SmtpSenderEmail" class="form-control" placeholder="bookings@bookmyfun.com" />
                        </div>
                    </div>

                    <h6 class="fw-bold text-success mb-3"><i class="bi bi-whatsapp me-1"></i> WhatsApp Business API Settings</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">WhatsApp Cloud API Key / Token</label>
                            <input type="text" name="whatsAppApiKey" value="@Model.WhatsAppApiKey" class="form-control" placeholder="EAAB..." />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">WhatsApp Verified Sender Number ID</label>
                            <input type="text" name="whatsAppSenderPhone" value="@Model.WhatsAppSenderPhone" class="form-control" placeholder="+91 99999 00001" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-warning text-dark px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Notification Settings
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 5. FOOTER SECTION -->
    <div class="accordion-item border-0 border-bottom" id="sec-footer">
        <h2 class="accordion-header">
            <button class="accordion-button @(activeSection == "sec-footer" ? "" : "collapsed") fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFooter" aria-expanded="@(activeSection == "sec-footer" ? "true" : "false")" aria-controls="collapseFooter">
                <i class="bi bi-layout-text-window-reverse text-secondary fs-5 me-2"></i>
                <div class="d-flex flex-column text-start">
                    <span>5. Footer &amp; Official Contact Coordinates</span>
                    <small class="text-muted fw-normal">Configure business address, phone, email, and social media links displayed in the footer.</small>
                </div>
            </button>
        </h2>
        <div id="collapseFooter" class="accordion-collapse collapse @(activeSection == "sec-footer" ? "show" : "")" data-bs-parent="#settingsAccordion">
            <div class="accordion-body p-4 bg-body">
                <form asp-action="SaveFooterSettings" method="post">
                    @Html.AntiForgeryToken()
                    <div class="alert alert-warning py-2 px-3 small mb-4">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>
                        <strong>Hide If Empty Rule:</strong> If the Business Address or any social/contact field is left empty, its respective block is completely hidden from the footer on all pages.
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Corporate Business Office Address</label>
                            <textarea name="address" class="form-control" rows="2" placeholder="Leave empty to hide the address block from footer completely">@Model.Address</textarea>
                            <small class="text-muted">Leave empty to completely hide the physical address block from the public footer.</small>
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Support Phone Helpline</label>
                            <input type="text" name="supportPhone" value="@Model.SupportPhone" class="form-control" placeholder="+91 (020) 4567-8900" />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">WhatsApp Customer Support Number</label>
                            <input type="text" name="whatsAppNumber" value="@Model.WhatsAppNumber" class="form-control" placeholder="+91 99999 00001" />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Official Support Email</label>
                            <input type="email" name="supportEmail" value="@Model.SupportEmail" class="form-control" placeholder="support@bookmyfun.com" />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Facebook Page URL</label>
                            <input type="url" name="facebookUrl" value="@Model.FacebookUrl" class="form-control" placeholder="https://facebook.com/..." />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">Instagram Profile URL</label>
                            <input type="url" name="instagramUrl" value="@Model.InstagramUrl" class="form-control" placeholder="https://instagram.com/..." />
                        </div>
                        <div class="col-md-6 col-12">
                            <label class="form-label fw-semibold">YouTube Channel URL</label>
                            <input type="url" name="youtubeUrl" value="@Model.YouTubeUrl" class="form-control" placeholder="https://youtube.com/..." />
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-secondary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Footer Settings
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 6. LEGAL SECTION -->
    <div class="accordion-item border-0 border-bottom" id="sec-legal">
        <h2 class="accordion-header">
            <button class="accordion-button @(activeSection == "sec-legal" ? "" : "collapsed") fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLegal" aria-expanded="@(activeSection == "sec-legal" ? "true" : "false")" aria-controls="collapseLegal">
                <i class="bi bi-file-earmark-text text-dark fs-5 me-2"></i>
                <div class="d-flex flex-column text-start">
                    <span>6. Legal Documents &amp; Policy Versions</span>
                    <small class="text-muted fw-normal">Preview and access the rich text Legal Pages editor for Terms, Privacy, and Refunds.</small>
                </div>
            </button>
        </h2>
        <div id="collapseLegal" class="accordion-collapse collapse @(activeSection == "sec-legal" ? "show" : "")" data-bs-parent="#settingsAccordion">
            <div class="accordion-body p-4 bg-body">
                <div class="row g-3 mb-4">
                    <div class="col-md-4 col-12">
                        <div class="card p-3 border-0 bg-light rounded-3 text-center">
                            <i class="bi bi-shield-check text-primary fs-2 mb-2"></i>
                            <h6 class="fw-bold mb-1">Privacy Policy</h6>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-2">v@(Model.PrivacyPolicyVersion) Active</span>
                            <a asp-controller="Home" asp-action="Privacy" target="_blank" class="small text-decoration-none">View Public Page &raquo;</a>
                        </div>
                    </div>
                    <div class="col-md-4 col-12">
                        <div class="card p-3 border-0 bg-light rounded-3 text-center">
                            <i class="bi bi-file-earmark-ruled text-success fs-2 mb-2"></i>
                            <h6 class="fw-bold mb-1">Terms of Service</h6>
                            <span class="badge bg-success-subtle text-success border border-success-subtle mb-2">v@(Model.TermsOfServiceVersion) Active</span>
                            <a href="/terms" target="_blank" class="small text-decoration-none">View Public Page &raquo;</a>
                        </div>
                    </div>
                    <div class="col-md-4 col-12">
                        <div class="card p-3 border-0 bg-light rounded-3 text-center">
                            <i class="bi bi-arrow-counterclockwise text-warning fs-2 mb-2"></i>
                            <h6 class="fw-bold mb-1">Refund &amp; Cancellation</h6>
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle mb-2">v@(Model.RefundPolicyVersion) Active</span>
                            <a href="/refund-policy" target="_blank" class="small text-decoration-none">View Public Page &raquo;</a>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 bg-light rounded-3 border">
                    <div>
                        <div class="fw-bold text-dark">Need to edit policy text, effective dates, or publish new versions?</div>
                        <div class="small text-muted">Use the dedicated Legal Pages editor to draft, version, and publish legally binding policies.</div>
                    </div>
                    <a asp-action="LegalPages" class="btn btn-dark fw-semibold px-4 shadow-sm">
                        <i class="bi bi-pencil-square me-1"></i> Open Legal Pages Editor
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 7. FEATURE FLAGS SECTION -->
    <div class="accordion-item border-0" id="sec-features">
        <h2 class="accordion-header">
            <button class="accordion-button @(activeSection == "sec-features" ? "" : "collapsed") fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFeatures" aria-expanded="@(activeSection == "sec-features" ? "true" : "false")" aria-controls="collapseFeatures">
                <i class="bi bi-toggle-on text-danger fs-5 me-2"></i>
                <div class="d-flex flex-column text-start">
                    <span>7. Platform Feature Flags &amp; Runtime Toggles</span>
                    <small class="text-muted fw-normal">Enable or disable authentication providers, instant checkout, and real-time alerts.</small>
                </div>
            </button>
        </h2>
        <div id="collapseFeatures" class="accordion-collapse collapse @(activeSection == "sec-features" ? "show" : "")" data-bs-parent="#settingsAccordion">
            <div class="accordion-body p-4 bg-body">
                <form asp-action="SaveFeatureFlags" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-12">
                            <div class="card p-3 border rounded-3 h-100">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" role="switch" id="googleLoginSwitch" name="googleLoginEnabled" value="true" checked="@(Model.GoogleLoginEnabled)" />
                                    <label class="form-check-label fw-bold text-dark" for="googleLoginSwitch">Enable Google OAuth Sign-In</label>
                                </div>
                                <small class="text-muted">Displays "Sign in with Google" button on login &amp; registration portals.</small>
                            </div>
                        </div>

                        <div class="col-md-6 col-12">
                            <div class="card p-3 border rounded-3 h-100">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" role="switch" id="instantBookingSwitch" name="instantOnlineBookingEnabled" value="true" checked="@(Model.InstantOnlineBookingEnabled)" />
                                    <label class="form-check-label fw-bold text-dark" for="instantBookingSwitch">Enable Instant Online Checkout</label>
                                </div>
                                <small class="text-muted">Allows guests to complete reservations immediately via Razorpay without waiting for host pre-approval.</small>
                            </div>
                        </div>

                        <div class="col-md-6 col-12">
                            <div class="card p-3 border rounded-3 h-100">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" role="switch" id="whatsappSwitch" name="whatsAppNotificationsEnabled" value="true" checked="@(Model.WhatsAppNotificationsEnabled)" />
                                    <label class="form-check-label fw-bold text-dark" for="whatsappSwitch">Enable Real-Time WhatsApp Alerts</label>
                                </div>
                                <small class="text-muted">Automatically triggers transactional WhatsApp receipts on booking confirmations &amp; cancellations.</small>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-danger px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Feature Flags
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function openSection(collapseId) {
            const el = document.getElementById(collapseId);
            if (el) {
                const bsCollapse = bootstrap.Collapse.getOrCreateInstance(el);
                bsCollapse.show();
            }
        }

        // On load check hash or active section
        document.addEventListener("DOMContentLoaded", function () {
            const hash = window.location.hash;
            if (hash) {
                const targetMap = {
                    '#sec-commission': 'collapseCommission',
                    '#sec-refunds': 'collapseRefunds',
                    '#sec-payments': 'collapsePayments',
                    '#sec-notifications': 'collapseNotifications',
                    '#sec-footer': 'collapseFooter',
                    '#sec-legal': 'collapseLegal',
                    '#sec-features': 'collapseFeatures'
                };
                if (targetMap[hash]) {
                    openSection(targetMap[hash]);
                }
            }
        });
    </script>
}
