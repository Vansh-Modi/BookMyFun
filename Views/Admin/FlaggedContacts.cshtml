@model List<BookMyFun.Models.Entities.FlaggedContactAttempt>
@{
    ViewData["Title"] = "Flagged Contact Violations";
}

<div class="dash-page-header mb-4">
    <div>
        <p class="dash-eyebrow">Platform Administration · Trust &amp; Safety</p>
        <h1 class="dash-title">Flagged Contact Sharing Violations</h1>
        <p class="dash-subtitle">Monitors off-platform contact sharing attempts (phone numbers, emails, solicitation words, external links) in event manager profiles and descriptions.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-card">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-shield-x text-danger me-2"></i>Intercepted Violations (@Model.Count)
        </h5>
        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
            Auto-Masked: [Contact Details Masked]
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ref #</th>
                    <th>User ID</th>
                    <th>Content Type</th>
                    <th>Detected Pattern(s)</th>
                    <th>Raw Content Snippet</th>
                    <th>Logged At</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-shield-check fs-1 text-success d-block mb-2"></i>
                            No contact leakage violations detected. All partner profiles are compliant.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">#@item.FlagID</td>
                        <td>
                            <span class="badge bg-light text-dark border">User #@item.UserID</span>
                        </td>
                        <td>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@item.ContentType</span>
                        </td>
                        <td>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle font-monospace">@item.FlaggedPatterns</span>
                        </td>
                        <td>
                            <div class="small text-danger font-monospace text-truncate" style="max-width: 320px;" title="@item.RawContent">
                                @item.RawContent
                            </div>
                        </td>
                        <td class="small text-muted">
                            @item.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1.5">
                                <form asp-action="DismissFlaggedContact" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="attemptId" value="@item.FlagID" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-0.5" style="font-size: 0.75rem;">
                                        Dismiss
                                    </button>
                                </form>
                                <form asp-action="SuspendUserFromFlaggedContact" method="post" class="d-inline" onsubmit="return confirm('Suspend User #@item.UserID for contact detail violation?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="attemptId" value="@item.FlagID" />
                                    <input type="hidden" name="userId" value="@item.UserID" />
                                    <input type="hidden" name="reason" value="Off-platform contact sharing violation" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-0.5" style="font-size: 0.75rem;">
                                        <i class="bi bi-slash-circle me-1"></i> Suspend
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
