@model BookMyFun.Models.ViewModels.PropertyEditViewModel
@{
    ViewData["Title"] = "Add Property for Owner";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-house-add"></i> Create Property Listing (Proxy Admin Action)</h5>
            </div>
            <div class="card-body">
                <form asp-action="CreateProperty" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Select Owner</label>
                            <select asp-for="OwnerID" class="form-select" required>
                                <option value="">-- Choose Owner --</option>
                                @foreach (var o in Model.AvailableOwners)
                                {
                                    <option value="@o.UserID">@o.FullName (@o.Email)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Property Type</label>
                            <select asp-for="PropertyTypeID" class="form-select" required>
                                @foreach (var t in Model.AvailableTypes)
                                {
                                    <option value="@t.PropertyTypeID">@t.TypeName</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Property Title</label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. Royal Heritage Villa & Pool" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Location / Address</label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Lonavala, Maharashtra" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Base Price Per Night (₹)</label>
                            <input asp-for="PricePerNight" type="number" step="0.01" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Max Guests</label>
                            <input asp-for="MaxGuests" type="number" class="form-control" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Image URL</label>
                            <input asp-for="ImageUrlInput" class="form-control" placeholder="https://images.unsplash.com/photo-..." />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Description & Amenities</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Suitable Occasions</label>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var occ in Model.AvailableOccasions)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedOccasionIDs" value="@occ.OccasionID" id="occ_@occ.OccasionID">
                                        <label class="form-check-label" for="occ_@occ.OccasionID">
                                            @occ.OccasionName
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="ManageProperties" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Save & Publish Listing</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
