@model BookMyFun.Models.ViewModels.PropertyEditViewModel
@{
    var isEmployee = User.IsInRole("Employee");
    var controllerName = isEmployee ? "Employee" : "Admin";
    ViewData["Title"] = isEmployee ? "Add Property (Employee Ops)" : "Add Property (Admin Action)";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-11">
            <!-- Header Banner -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-gradient text-white p-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold mb-2">Platform Operations</span>
                        <h2 class="fw-bold mb-1"><i class="bi bi-house-add-fill me-2 text-warning"></i>Create Property Listing (Proxy Action)</h2>
                        <p class="mb-0 text-white-50">Create, configure, and publish a farm or villa listing on behalf of an active host partner.</p>
                    </div>
                    <a asp-controller="@controllerName" asp-action="ManageProperties" class="btn btn-outline-light rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to Properties
                    </a>
                </div>
            </div>

            <form asp-controller="@controllerName" asp-action="CreateProperty" method="post" id="adminPropertyForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="additionalMediaJson" name="AdditionalMediaJson" value="[]" />

                <!-- SECTION 1: HOST & ESSENTIAL DETAILS -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-person-badge-fill text-warning me-2"></i>1. Host Assignment & Essential Info</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Assign Host / Property Owner <span class="text-danger">*</span></label>
                                <select asp-for="OwnerID" class="form-select form-select-lg rounded-3" required>
                                    <option value="">-- Select Active Owner --</option>
                                    @foreach (var o in Model.AvailableOwners)
                                    {
                                        <option value="@o.UserID">@o.FullName (@o.Email)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Property Type <span class="text-danger">*</span></label>
                                <select asp-for="PropertyTypeID" class="form-select form-select-lg rounded-3" required>
                                    <option value="">-- Select Type --</option>
                                    @foreach (var t in Model.AvailableTypes)
                                    {
                                        <option value="@t.PropertyTypeID">@t.TypeName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Listing Title <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control rounded-3" placeholder="e.g. Royal Emerald Heritage Farm & Pool" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Max Guests <span class="text-danger">*</span></label>
                                <input asp-for="MaxGuests" type="number" min="1" max="1000" class="form-control rounded-3" placeholder="15" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">About Property <span class="text-danger">*</span></label>
                                <textarea asp-for="Description" class="form-control rounded-3" rows="3" required></textarea>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Base Price Per Night (₹) <span class="text-danger">*</span></label>
                                <input asp-for="PricePerNight" type="number" step="0.01" min="100" class="form-control" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Security Deposit Hold (₹)</label>
                                <input asp-for="SecurityDepositAmount" type="number" step="0.01" min="0" class="form-control" placeholder="2000" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Stay Commission Override (%)</label>
                                <input asp-for="CommissionRate" type="number" step="0.1" min="0" max="100" class="form-control" placeholder="Default: Host/Global Rate" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Event Commission Override (%)</label>
                                <input asp-for="EventCommissionRate" type="number" step="0.1" min="0" max="100" class="form-control" placeholder="Default: Global Event Rate" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 2: LOCATION & GEOLOCATION -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light-subtle d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-geo-alt-fill text-danger me-2"></i>2. Location & Geolocation</h5>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" id="btnDetectLocation">
                            <i class="bi bi-crosshair me-1"></i> Detect Coordinates
                        </button>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">City / Region <span class="text-danger">*</span></label>
                                <input asp-for="Location" class="form-control rounded-3" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Formatted Address</label>
                                <input asp-for="FormattedAddress" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Latitude</label>
                                <input asp-for="Latitude" id="latitude" type="number" step="0.0000001" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Longitude</label>
                                <input asp-for="Longitude" id="longitude" type="number" step="0.0000001" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold"><i class="bi bi-pin-map-fill text-danger me-1"></i>Direct Map / Location URL</label>
                                <input asp-for="MapUrl" class="form-control rounded-3" placeholder="https://maps.app.goo.gl/... or https://goo.gl/maps/..." />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 3: CANCELLATION POLICIES -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-shield-check text-primary me-2"></i>3. Cancellation & Refund Policy</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Free Cancellation Window (Hours)</label>
                                <input asp-for="FreeCancellationWindowHours" type="number" min="0" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Cancellation Cutoff Deadline (Hours)</label>
                                <input asp-for="CancellationCutoffHours" type="number" min="0" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Fee Type</label>
                                <select asp-for="CancellationFeeType" class="form-select">
                                    <option value="percentage">Percentage (%)</option>
                                    <option value="fixed">Fixed (₹)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Fee Value</label>
                                <input asp-for="CancellationFeeValue" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 4: AMENITIES & OCCASIONS -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-grid-fill text-warning me-2"></i>4. Amenities Taxonomy & Occasions</h5>
                    </div>
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 text-secondary">Amenities Master</h6>
                        <div class="row row-cols-2 row-cols-md-4 g-2 mb-4">
                            @foreach (var am in Model.AvailableAmenities)
                            {
                                <div class="col">
                                    <div class="form-check p-2 border rounded-3 bg-light">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" name="SelectedAmenityIDs" value="@am.AmenityID" id="am_@am.AmenityID">
                                        <label class="form-check-label small" for="am_@am.AmenityID"><i class="bi @am.IconClass text-success me-1"></i> @am.AmenityName</label>
                                    </div>
                                </div>
                            }
                        </div>

                        <h6 class="fw-bold mb-3 text-secondary">Occasions</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var occ in Model.AvailableOccasions)
                            {
                                <div class="form-check form-check-inline p-2 border rounded-pill px-3 bg-light">
                                    <input class="form-check-input ms-0 me-2" type="checkbox" name="SelectedOccasionIDs" value="@occ.OccasionID" id="occ_@occ.OccasionID">
                                    <label class="form-check-label fw-medium" for="occ_@occ.OccasionID">@occ.OccasionName</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- SECTION 5: DUAL MEDIA MANAGER -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light-subtle d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-images text-info me-2"></i>5. Media & Cover Image</h5>
                        <span class="badge bg-secondary fs-6 px-3 py-2 rounded-pill" id="photoBadge">Photos: <span id="photoCount">0</span> / 5 Minimum</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Cover Image URL</label>
                            <input asp-for="ImageUrlInput" id="primaryImageUrlInput" class="form-control rounded-3" placeholder="https://..." />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Direct File Upload (Photos or Video)</label>
                                <input type="file" id="adminFileInput" class="form-control" accept=".jpg,.jpeg,.png,.webp,.mp4,.mov" multiple />
                                <button type="button" class="btn btn-sm btn-outline-success mt-2 rounded-pill" id="btnAdminUpload">
                                    <i class="bi bi-upload me-1"></i> Upload File
                                </button>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">External URL / Embed</label>
                                <div class="input-group">
                                    <input type="url" id="adminUrlInput" class="form-control" placeholder="https://..." />
                                    <button type="button" class="btn btn-outline-primary" id="btnAdminAddUrl">Add URL</button>
                                </div>
                            </div>
                        </div>

                        <div id="mediaGallery" class="row row-cols-2 row-cols-md-4 g-3 mt-3"></div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4 mb-5">
                    <a asp-controller="@controllerName" asp-action="ManageProperties" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm fw-bold">Publish Listing</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const mediaList = [];
        const photoCountEl = document.getElementById("photoCount");
        const photoBadge = document.getElementById("photoBadge");
        const mediaGallery = document.getElementById("mediaGallery");
        const hiddenMediaJson = document.getElementById("additionalMediaJson");
        const primaryInput = document.getElementById("primaryImageUrlInput");

        function updateGallery() {
            mediaGallery.innerHTML = "";
            let photos = 0;
            mediaList.forEach((m, idx) => {
                if (m.mediaType === "photo") photos++;
                const col = document.createElement("div");
                col.className = "col";
                col.innerHTML = `
                    <div class="card h-100 border shadow-sm rounded-3">
                        <img src="${m.url}" class="card-img-top object-fit-cover" style="height: 120px;" onerror="this.src='/images/property-placeholder.jpg';" />
                        <div class="card-body p-2 d-flex justify-content-between align-items-center">
                            <span class="badge bg-secondary small">${m.mediaType}</span>
                            <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 btn-del" data-index="${idx}"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>
                `;
                mediaGallery.appendChild(col);
            });

            photoCountEl.textContent = photos;
            photoBadge.className = photos >= 5 ? "badge bg-success fs-6 px-3 py-2 rounded-pill" : "badge bg-danger fs-6 px-3 py-2 rounded-pill";
            hiddenMediaJson.value = JSON.stringify(mediaList.map(i => ({ mediaType: i.mediaType, sourceType: i.sourceType, storageUrl: i.url, isPrimary: false })));
        }

        mediaGallery.addEventListener("click", function(e) {
            const btn = e.target.closest(".btn-del");
            if (btn) {
                const idx = parseInt(btn.getAttribute("data-index"));
                mediaList.splice(idx, 1);
                updateGallery();
            }
        });

        document.getElementById("btnAdminUpload").addEventListener("click", async function () {
            const fi = document.getElementById("adminFileInput");
            if (!fi.files.length) return alert("Select a file");
            const btn = this;
            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Optimizing & Uploading...`;
            for (let i = 0; i < fi.files.length; i++) {
                let file = fi.files[i];
                if (window.ImageOptimizer && window.ImageOptimizer.isOptimizable(file)) {
                    file = await window.ImageOptimizer.compressAndConvertToWebP(file, { maxWidth: 1920, maxHeight: 1080, quality: 0.82 });
                }
                const fd = new FormData();
                fd.append("file", file);
                fd.append("mediaType", file.type.startsWith("video") ? "video" : "photo");
                fd.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]')?.value || '');
                const res = await (await fetch("/api/media/upload-file", { method: "POST", body: fd })).json();
                if (res.success) {
                    mediaList.push({ url: res.url, mediaType: res.mediaType, sourceType: "file" });
                    if (!primaryInput.value && res.mediaType === "photo") primaryInput.value = res.url;
                }
            }
            btn.disabled = false;
            btn.innerHTML = `<i class="bi bi-upload me-1"></i> Upload File`;
            fi.value = "";
            updateGallery();
        });

        document.getElementById("btnAdminAddUrl").addEventListener("click", async function () {
            const inp = document.getElementById("adminUrlInput");
            if (!inp.value) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await (await fetch("/api/media/verify-url", {
                method: "POST",
                headers: { "Content-Type": "application/json", "RequestVerificationToken": token },
                body: JSON.stringify({ url: inp.value, mediaType: "photo" })
            })).json();
            if (res.success) {
                mediaList.push({ url: res.url, mediaType: "photo", sourceType: "url" });
                if (!primaryInput.value) primaryInput.value = res.url;
                inp.value = "";
                updateGallery();
            } else {
                alert("Invalid or unsafe URL");
            }
        });

        document.getElementById("btnDetectLocation")?.addEventListener("click", function () {
            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition(function (pos) {
                    document.getElementById("latitude").value = pos.coords.latitude.toFixed(6);
                    document.getElementById("longitude").value = pos.coords.longitude.toFixed(6);
                });
            }
        });
    });
</script>
}
