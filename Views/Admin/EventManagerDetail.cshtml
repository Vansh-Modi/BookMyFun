@model BookMyFun.Models.ViewModels.EventManagerDetailViewModel
@{
    ViewData["Title"] = $"Event Manager Review: {Model.Manager.FullName}";
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Admin";
    var manager = Model.Manager;
}

<div class="dash-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="@currentCtrl" asp-action="EventManagerVerifications" class="text-decoration-none">Event Managers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Review #@manager.UserID</li>
                </ol>
            </nav>
            <h1 class="dash-title d-flex align-items-center gap-2">
                @manager.FullName
                @if (manager.VerificationStatus == "Verified" && manager.IsActive)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-1 rounded-pill">
                        <i class="bi bi-patch-check-fill me-1"></i> Verified
                    </span>
                }
                else if (manager.VerificationStatus == "Suspended" || !manager.IsActive)
                {
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-6 px-3 py-1 rounded-pill">
                        <i class="bi bi-slash-circle me-1"></i> Suspended
                    </span>
                }
                else if (manager.VerificationStatus == "Rejected")
                {
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6 px-3 py-1 rounded-pill">
                        <i class="bi bi-x-circle me-1"></i> Rejected
                    </span>
                }
                else
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-3 py-1 rounded-pill">
                        <i class="bi bi-hourglass-split me-1"></i> Pending
                    </span>
                }
            </h1>
            <p class="dash-subtitle">Partner verification adjudication, service area management, package review, and portfolio moderation.</p>
        </div>
        <div>
            <a asp-controller="@currentCtrl" asp-action="EventManagerVerifications" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Back to Queue
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-xs" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-xs" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-xs" role="alert">
        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Checklist Warning Callout (Warns but never blocks action) -->
<div class="card border-0 shadow-sm rounded-4 mb-4 @(Model.Warnings.Any() ? "border-start border-4 border-warning bg-light" : "border-start border-4 border-success bg-light")">
    <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold mb-0">
                <i class="bi @(Model.Warnings.Any() ? "bi-shield-exclamation text-warning" : "bi-shield-check text-success") me-2"></i>
                Adjudication Checklist
            </h5>
            <span class="badge @(Model.Warnings.Any() ? "bg-warning text-dark" : "bg-success text-white") rounded-pill px-3 py-1">
                @(Model.Warnings.Any() ? $"{Model.Warnings.Count} Notice(s)" : "All Requirements Met")
            </span>
        </div>

        <div class="row g-3">
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-3 border d-flex align-items-center gap-2">
                    <i class="bi @(Model.HasDocumentsUploaded ? "bi-check-circle-fill text-success fs-5" : "bi-exclamation-triangle-fill text-warning fs-5")"></i>
                    <div>
                        <div class="small fw-bold">Identity Documents</div>
                        <div class="small text-muted">@(Model.HasDocumentsUploaded ? "Uploaded" : "Missing")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-3 border d-flex align-items-center gap-2">
                    <i class="bi @(Model.HasActivePackage ? "bi-check-circle-fill text-success fs-5" : "bi-exclamation-triangle-fill text-warning fs-5")"></i>
                    <div>
                        <div class="small fw-bold">Active Package</div>
                        <div class="small text-muted">@(Model.HasActivePackage ? $"{Model.Packages.Count(p => p.IsActive)} Active" : "None published")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-3 border d-flex align-items-center gap-2">
                    <i class="bi @(Model.HasApprovedPortfolio ? "bi-check-circle-fill text-success fs-5" : "bi-exclamation-triangle-fill text-warning fs-5")"></i>
                    <div>
                        <div class="small fw-bold">Approved Portfolio</div>
                        <div class="small text-muted">@(Model.HasApprovedPortfolio ? $"{Model.Portfolios.Count(p => p.IsApproved)} Approved" : "None approved")</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-white rounded-3 border d-flex align-items-center gap-2">
                    <i class="bi @(Model.HasServiceAreas ? "bi-check-circle-fill text-success fs-5" : "bi-exclamation-triangle-fill text-warning fs-5")"></i>
                    <div>
                        <div class="small fw-bold">Service Areas</div>
                        <div class="small text-muted">@(Model.HasServiceAreas ? "Configured" : "None configured")</div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Warnings.Any())
        {
            <div class="mt-3 pt-3 border-top">
                <div class="small text-dark fw-semibold mb-1"><i class="bi bi-info-circle me-1"></i> Important Guidelines:</div>
                <ul class="mb-0 small text-muted ps-3">
                    @foreach (var warning in Model.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
                <div class="small text-muted mt-2 fst-italic">
                    Note: An approved portfolio item and active package in the property area are required by the Stay &amp; Celebrate eligibility engine for checkout matching. This checklist provides guidance and does not block administrative actions.
                </div>
            </div>
        }
    </div>
</div>

<!-- Primary Actions Toolbar -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-card">
    <div class="card-header bg-white py-3 border-bottom">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-gear-wide-connected text-primary me-2"></i>Adjudication Actions</h5>
    </div>
    <div class="card-body p-4">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (manager.VerificationStatus != "Verified" || !manager.IsActive)
            {
                <form asp-controller="@currentCtrl" asp-action="ApproveEventManagerVerification" method="post" class="d-inline"
                      onsubmit="return confirm('Confirm verification approval for @manager.FullName?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@manager.UserID" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("EventManagerDetail", currentCtrl, new { id = manager.UserID })" />
                    <button type="submit" class="btn btn-success rounded-pill px-4">
                        <i class="bi bi-check-circle me-1"></i> Verify Partner
                    </button>
                </form>
            }

            <button type="button" class="btn btn-danger rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#rejectModal">
                <i class="bi bi-x-circle me-1"></i> Reject
            </button>

            @if (manager.VerificationStatus != "Pending")
            {
                <form asp-controller="@currentCtrl" asp-action="ReturnToPendingEventManager" method="post" class="d-inline"
                      onsubmit="return confirm('Return @manager.FullName to Pending status?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@manager.UserID" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("EventManagerDetail", currentCtrl, new { id = manager.UserID })" />
                    <button type="submit" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Return to Pending
                    </button>
                </form>
            }

            @if (manager.VerificationStatus == "Suspended" || !manager.IsActive)
            {
                <form asp-controller="@currentCtrl" asp-action="ReactivateEventManager" method="post" class="d-inline"
                      onsubmit="return confirm('Reactivate account for @manager.FullName?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@manager.UserID" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("EventManagerDetail", currentCtrl, new { id = manager.UserID })" />
                    <button type="submit" class="btn btn-outline-success rounded-pill px-3">
                        <i class="bi bi-play-circle me-1"></i> Reactivate
                    </button>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-outline-warning rounded-pill px-3 text-dark" data-bs-toggle="modal" data-bs-target="#suspendModal">
                    <i class="bi bi-pause-circle me-1"></i> Suspend
                </button>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Profile, Documents, Service Areas -->
    <div class="col-lg-5">
        <!-- Read-only Profile -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-card">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-person-badge text-primary me-2"></i>Profile Information</h5>
            </div>
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <img src="@(manager.ProfilePictureUrl ?? "/images/default-avatar.svg")" class="rounded-circle shadow-xs" style="width: 64px; height: 64px; object-fit: cover;" onerror="this.src='/images/placeholder.jpg';" />
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">@manager.FullName</h5>
                        <div class="small text-muted">ID: #@manager.UserID &bull; Role: @manager.Role</div>
                        <div class="small text-muted">Joined: @manager.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small text-muted text-uppercase fw-bold">Email Address</label>
                    <div class="form-control bg-light">@manager.Email</div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted text-uppercase fw-bold">Phone Number</label>
                    <div class="form-control bg-light">@(string.IsNullOrWhiteSpace(manager.Phone) ? "Not provided" : manager.Phone)</div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted text-uppercase fw-bold">Experience</label>
                    <div class="form-control bg-light">@(manager.YearsOfExperience ?? 3) Years</div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted text-uppercase fw-bold">Bio</label>
                    <div class="form-control bg-light" style="min-height: 80px; white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(manager.Bio) ? "No bio provided" : manager.Bio)</div>
                </div>
            </div>
        </div>

        <!-- Editable Service Areas -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-card">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-geo-alt text-danger me-2"></i>Service Areas</h5>
                <span class="badge bg-light text-muted border">Editable</span>
            </div>
            <div class="card-body p-4">
                <form asp-controller="@currentCtrl" asp-action="UpdateManagerServiceAreas" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@manager.UserID" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("EventManagerDetail", currentCtrl, new { id = manager.UserID })" />

                    <div class="mb-3">
                        <label class="form-label small text-muted fw-bold">Areas Covered (One "City, State" per line)</label>
                        @{
                            string formattedAreas = string.Empty;
                            if (!string.IsNullOrWhiteSpace(manager.ServiceAreas))
                            {
                                var areaItems = manager.ServiceAreas.Split(new[] { ';', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                formattedAreas = string.Join(Environment.NewLine, areaItems);
                            }
                        }
                        <textarea name="serviceAreas" class="form-control" rows="4" placeholder="Surat, Gujarat&#10;Mumbai, Maharashtra">@formattedAreas</textarea>
                        <div class="form-text small">
                            Normalize to "City, State", one per line. Entries without both city and state will be reported and excluded.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-save me-1"></i> Save &amp; Normalize Areas
                    </button>
                </form>
            </div>
        </div>

        <!-- Uploaded Documents (Served via secure endpoint) -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-card">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-file-earmark-lock text-info me-2"></i>Uploaded Documents</h5>
            </div>
            <div class="card-body p-4">
                @if (Model.VerificationDoc != null && !string.IsNullOrWhiteSpace(Model.VerificationDoc.DocumentStorageKey))
                {
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold text-dark"><i class="bi bi-file-earmark-pdf text-danger me-1"></i>@(Model.VerificationDoc.DocumentType ?? "Identity Document")</div>
                                <div class="small text-muted">Submitted: @Model.VerificationDoc.CreatedAt.ToString("dd MMM yyyy, HH:mm")</div>
                                <div class="small text-muted">Status: <span class="badge bg-secondary">@Model.VerificationDoc.VerificationStatus</span></div>
                            </div>
                            <a asp-controller="@currentCtrl" asp-action="ViewManagerDocument" asp-route-userId="@manager.UserID" asp-route-docType="@Model.VerificationDoc.DocumentType" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-eye me-1"></i> View Secure Document
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-file-earmark-x fs-1 d-block mb-2 opacity-50"></i>
                        No identity or verification documents uploaded yet.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Packages and Portfolio -->
    <div class="col-lg-7">
        <!-- Event Packages -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-card">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-box-seam text-success me-2"></i>Published Packages (@Model.Packages.Count)</h5>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                    @Model.Packages.Count(p => p.IsActive) Active
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Package Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Packages.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No packages created by this event manager yet.
                                </td>
                            </tr>
                        }
                        @foreach (var pkg in Model.Packages)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@pkg.Name</div>
                                    <div class="small text-muted text-truncate" style="max-width: 250px;">@pkg.Description</div>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info-emphasis border rounded-pill">@pkg.Category</span>
                                </td>
                                <td class="fw-semibold text-dark">
                                    ₹@pkg.BasePrice.ToString("N0")
                                </td>
                                <td>
                                    @if (pkg.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted border rounded-pill px-2.5 py-1">Inactive</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Showcase Portfolio Moderation -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-card">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-images text-info me-2"></i>Showcase Portfolio (@Model.Portfolios.Count)</h5>
                    <small class="text-muted">Approval required for checkout visibility.</small>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                        @Model.Portfolios.Count(p => p.IsApproved) Approved
                    </span>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">
                        @Model.Portfolios.Count(p => !p.IsApproved) Pending
                    </span>
                </div>
            </div>
            <div class="card-body p-4">
                @if (!Model.Portfolios.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-collection fs-1 d-block mb-2 opacity-50"></i>
                        No showcase portfolio items uploaded yet.
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var item in Model.Portfolios)
                        {
                            <div class="col-md-6">
                                <div class="card h-100 border rounded-3 overflow-hidden shadow-xs">
                                    <div class="ratio ratio-16x9 bg-light">
                                        @if (item.MediaType == "video")
                                        {
                                            <video src="@item.MediaUrl" preload="metadata" controls class="w-100 h-100 object-fit-cover"></video>
                                        }
                                        else
                                        {
                                            <img src="@item.MediaUrl" alt="@item.Title" class="w-100 h-100 object-fit-cover" onerror="this.src='/images/placeholder.jpg';" />
                                        }
                                    </div>
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="fw-bold mb-0 text-dark text-truncate" title="@item.Title">@item.Title</h6>
                                            @if (item.IsApproved)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-0.5" style="font-size: 0.75rem;">
                                                    Approved
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2 py-0.5" style="font-size: 0.75rem;">
                                                    Pending
                                                </span>
                                            }
                                        </div>
                                        <p class="small text-muted mb-3 text-truncate" title="@item.Description">
                                            @(string.IsNullOrWhiteSpace(item.Description) ? "No caption" : item.Description)
                                        </p>

                                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                                            @if (!item.IsApproved)
                                            {
                                                <form asp-controller="@currentCtrl" asp-action="ApprovePortfolioItem" method="post" class="d-inline"
                                                      onsubmit="return confirm('Approve portfolio item #@item.PortfolioID for public showcase?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="portfolioId" value="@item.PortfolioID" />
                                                    <input type="hidden" name="returnUrl" value="@Url.Action("EventManagerDetail", currentCtrl, new { id = manager.UserID })" />
                                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                                        <i class="bi bi-check-lg me-1"></i> Approve
                                                    </button>
                                                </form>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                    onclick="openRejectPortfolioModal(@item.PortfolioID, '@Html.Encode(item.Title)')">
                                                <i class="bi bi-x-lg me-1"></i> Reject
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal: Reject Event Manager -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-controller="@currentCtrl" asp-action="RejectEventManagerVerification" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@manager.UserID" />
                <input type="hidden" name="returnUrl" value="@Url.Action("EventManagerDetail", currentCtrl, new { id = manager.UserID })" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger" id="rejectModalLabel">
                        <i class="bi bi-x-circle me-1"></i> Reject Event Manager Verification
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">Please provide a specific reason for rejecting this event manager. This reason is required and will be logged in the audit record.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rejection Reason <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" required placeholder="e.g., Incomplete KYC documents or insufficient portfolio evidence"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Suspend Event Manager -->
<div class="modal fade" id="suspendModal" tabindex="-1" aria-labelledby="suspendModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-controller="@currentCtrl" asp-action="SuspendEventManager" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" value="@manager.UserID" />
                <input type="hidden" name="returnUrl" value="@Url.Action("EventManagerDetail", currentCtrl, new { id = manager.UserID })" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-warning-emphasis" id="suspendModalLabel">
                        <i class="bi bi-pause-circle me-1"></i> Suspend Event Manager
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">Suspending this manager will immediately remove their celebration packages from guest checkout matching.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason for Suspension (Optional)</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="e.g., Pending complaint review or temporary operational freeze"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning rounded-pill px-4 text-dark">Confirm Suspension</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Reject Portfolio Item -->
<div class="modal fade" id="rejectPortfolioModal" tabindex="-1" aria-labelledby="rejectPortfolioModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-controller="@currentCtrl" asp-action="RejectPortfolioItem" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="portfolioId" id="rejectPortfolioId" value="" />
                <input type="hidden" name="returnUrl" value="@Url.Action("EventManagerDetail", currentCtrl, new { id = manager.UserID })" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger" id="rejectPortfolioModalLabel">
                        <i class="bi bi-x-circle me-1"></i> Reject Portfolio Item
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted" id="rejectPortfolioTitleText">Please provide a reason for rejecting this showcase item.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Rejection Reason <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control" rows="3" required placeholder="e.g., Image resolution below threshold, missing watermarking, or inappropriate content"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openRejectPortfolioModal(id, title) {
            document.getElementById('rejectPortfolioId').value = id;
            document.getElementById('rejectPortfolioTitleText').textContent = 'Rejecting item #' + id + ' ("' + title + '"). Reason is required:';
            var modal = new bootstrap.Modal(document.getElementById('rejectPortfolioModal'));
            modal.show();
        }
    </script>
}
