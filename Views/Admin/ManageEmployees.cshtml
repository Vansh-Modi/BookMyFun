@model IEnumerable<BookMyFun.Models.Entities.User>
@{
    ViewData["Title"] = "Manage Employees - Admin Console";
    var isEmployee = User.IsInRole("Employee");
    var controllerName = isEmployee ? "Employee" : "Admin";

    var search = ViewBag.Search as string ?? "";
    var sort = ViewBag.Sort as string ?? "id";
    var dir = ViewBag.Dir as string ?? "desc";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 25;
    var totalCount = ViewBag.TotalCount as int? ?? (Model?.Count() ?? 0);
    var totalPages = ViewBag.TotalPages as int? ?? Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Staff Management</li>
            </ol>
        </nav>
        <h2 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-person-workspace text-primary me-2"></i>Employee &amp; Operations Staff Management
        </h2>
        <p class="text-muted mb-0">Onboard operations staff, manage administrative permissions, and audit internal staff actions.</p>
    </div>
    <div>
        <a asp-action="CreateEmployee" class="btn btn-primary shadow-sm px-3 py-2 rounded-3 fw-semibold">
            <i class="bi bi-person-plus-fill me-1"></i> Add New Employee
        </a>
    </div>
</div>

<!-- Search & Controls Card -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="ManageEmployees" class="row g-2 align-items-center">
            <input type="hidden" name="sort" value="@sort" />
            <input type="hidden" name="dir" value="@dir" />

            <div class="col-md-8 col-sm-12">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search by name, email, phone or staff ID..." value="@search" />
                </div>
            </div>
            <div class="col-md-2 col-6">
                <select name="pageSize" class="form-select" onchange="this.form.submit()">
                    <option value="10" selected="@(pageSize == 10)">10 per page</option>
                    <option value="25" selected="@(pageSize == 25)">25 per page</option>
                    <option value="50" selected="@(pageSize == 50)">50 per page</option>
                    <option value="100" selected="@(pageSize == 100)">100 per page</option>
                </select>
            </div>
            <div class="col-md-2 col-6 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">Filter</button>
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <a asp-action="ManageEmployees" class="btn btn-outline-secondary" title="Clear Filters"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-uppercase small fw-semibold text-muted">
                <tr>
                    <th class="ps-4">
                        <a asp-action="ManageEmployees" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="id" asp-route-dir="@(sort == "id" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-muted d-inline-flex align-items-center">
                            Staff ID @(sort == "id" ? (dir == "asc" ? "▲" : "▼") : "")
                        </a>
                    </th>
                    <th>
                        <a asp-action="ManageEmployees" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="name" asp-route-dir="@(sort == "name" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-muted d-inline-flex align-items-center">
                            Full Name @(sort == "name" ? (dir == "asc" ? "▲" : "▼") : "")
                        </a>
                    </th>
                    <th>
                        <a asp-action="ManageEmployees" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="email" asp-route-dir="@(sort == "email" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-muted d-inline-flex align-items-center">
                            Email (Login ID) @(sort == "email" ? (dir == "asc" ? "▲" : "▼") : "")
                        </a>
                    </th>
                    <th>Contact Phone</th>
                    <th>Status</th>
                    <th>
                        <a asp-action="ManageEmployees" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="date" asp-route-dir="@(sort == "date" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-muted d-inline-flex align-items-center">
                            Onboarded Date @(sort == "date" ? (dir == "asc" ? "▲" : "▼") : "")
                        </a>
                    </th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2 text-muted opacity-50"></i>
                            <h5 class="text-dark">No employees found</h5>
                            <p class="small text-muted mb-0">No staff accounts matched your search terms.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">#@emp.UserID</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3 fw-bold" style="width: 38px; height: 38px;">
                                        @(string.IsNullOrEmpty(emp.FullName) ? "E" : emp.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <span class="fw-bold text-dark d-block">@emp.FullName</span>
                                        <small class="text-muted">Operations Staff</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="mailto:@emp.Email" class="text-decoration-none text-muted">
                                    <i class="bi bi-envelope me-1"></i>@emp.Email
                                </a>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(emp.Phone))
                                {
                                    <span class="text-muted"><i class="bi bi-telephone me-1"></i>@emp.Phone</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Not provided</span>
                                }
                            </td>
                            <td>
                                @if (emp.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                        <i class="bi bi-check-circle me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill">
                                        <i class="bi bi-x-circle me-1"></i>Suspended
                                    </span>
                                }
                            </td>
                            <td>@emp.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="EditEmployee" asp-route-id="@emp.UserID" class="btn btn-sm btn-outline-primary rounded-3" title="Edit Profile & Permissions">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <form asp-action="DeleteEmployee" asp-route-id="@emp.UserID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate employee account @emp.FullName? They will immediately lose access to all operational consoles.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Deactivate Account">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-top d-flex flex-wrap justify-content-between align-items-center py-3">
            <div class="small text-muted">
                Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, totalCount)) of @totalCount employees
            </div>
            <nav aria-label="Employees pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="ManageEmployees" asp-route-search="@search" asp-route-sort="@sort" asp-route-dir="@dir" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">Previous</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="ManageEmployees" asp-route-search="@search" asp-route-sort="@sort" asp-route-dir="@dir" asp-route-page="@i" asp-route-pageSize="@pageSize">@i</a>
                            </li>
                        }
                        else if (i == currentPage - 3 || i == currentPage + 3)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="ManageEmployees" asp-route-search="@search" asp-route-sort="@sort" asp-route-dir="@dir" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
