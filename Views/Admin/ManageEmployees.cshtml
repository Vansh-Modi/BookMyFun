@model IEnumerable<BookMyFun.Models.Entities.User>
@{
    ViewData["Title"] = "Manage Employees - Admin Console";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Staff Management</li>
            </ol>
        </nav>
        <h2 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-person-workspace text-primary me-2"></i>Employee & Operations Staff Management
        </h2>
        <p class="text-muted mb-0">Onboard new operations employees, manage access, and oversee staff accounts.</p>
    </div>
    <div>
        <a asp-action="CreateEmployee" class="btn btn-primary shadow-sm px-3 py-2 rounded-3 fw-semibold">
            <i class="bi bi-person-plus-fill me-1"></i> Add New Employee
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 border-bottom border-light-subtle d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark">
            <i class="bi bi-people-fill text-primary me-2"></i>Operations Team Members
        </h5>
        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill">
            Total Staff: @(Model?.Count() ?? 0)
        </span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="p-5 text-center">
            <div class="display-6 text-muted mb-3"><i class="bi bi-person-x"></i></div>
            <h5 class="fw-bold text-dark">No Employee Accounts Found</h5>
            <p class="text-muted mb-4">No staff members have been onboarded yet. Click the button below to add your first employee.</p>
            <a asp-action="CreateEmployee" class="btn btn-primary rounded-3 px-4">
                <i class="bi bi-person-plus-fill me-1"></i> Add First Employee
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small fw-semibold text-muted">
                    <tr>
                        <th class="ps-4">Staff ID</th>
                        <th>Full Name</th>
                        <th>Email (Login ID)</th>
                        <th>Contact Phone</th>
                        <th>Status</th>
                        <th>Onboarded Date</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-secondary">#@emp.UserID</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center me-3" style="width: 38px; height: 38px; font-size: 0.95rem;">
                                        @(string.IsNullOrWhiteSpace(emp.FullName) ? "E" : emp.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark">@emp.FullName</div>
                                        <div class="small text-muted"><i class="bi bi-shield-check text-success me-1"></i>Operations Staff</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <a href="mailto:@emp.Email" class="text-decoration-none fw-medium text-dark">
                                    <i class="bi bi-envelope me-1 text-muted"></i>@emp.Email
                                </a>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(emp.Phone))
                                {
                                    <a href="tel:@emp.Phone" class="text-decoration-none text-muted">
                                        <i class="bi bi-telephone me-1"></i>@emp.Phone
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Not Provided</span>
                                }
                            </td>
                            <td>
                                @if (emp.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1.5 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1.5 rounded-pill">
                                        <i class="bi bi-dash-circle-fill me-1"></i>Deactivated
                                    </span>
                                }
                            </td>
                            <td class="text-muted small">
                                <i class="bi bi-calendar3 me-1"></i>@emp.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="EditEmployee" asp-route-id="@emp.UserID" class="btn btn-sm btn-outline-primary rounded-2 me-1" title="Edit Employee">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>
                                <form asp-action="DeleteEmployee" asp-route-id="@emp.UserID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove employee @emp.FullName (ID #@emp.UserID)? This will deactivate their staff credentials.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-2" title="Remove Employee">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
