@model BookMyFun.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Page Header -->
<div class="dash-page-header">
    <div>
        <p class="dash-eyebrow">Admin Portal · Operations</p>
        <h1 class="dash-title">Super Admin Dashboard</h1>
        <p class="dash-subtitle">Real-time overview of property inventory, owner partnerships, guest reservations, and platform revenue.</p>
    </div>
    <div class="dash-actions">
        <a asp-action="DynamicAnalytics" class="dash-btn dash-btn-primary">
            <i class="bi bi-graph-up-arrow"></i> Financial Analytics
        </a>
        <a asp-action="ManageBookings" class="dash-btn dash-btn-accent">
            <i class="bi bi-calendar-check"></i> Reservations
        </a>
        <a asp-action="PartnerLeads" class="dash-btn dash-btn-outline">
            <i class="bi bi-people"></i> Partner Leads
        </a>
        <a asp-action="ManageProperties" class="dash-btn dash-btn-outline">
            <i class="bi bi-building"></i> Properties
        </a>
        <a asp-action="ManageOwners" class="dash-btn dash-btn-outline">
            <i class="bi bi-person-badge"></i> Hosts
        </a>
        <a asp-action="ManageEmployees" class="dash-btn dash-btn-outline">
            <i class="bi bi-person-workspace text-primary"></i> Staff
        </a>
        <a asp-action="SupportQueries" class="dash-btn dash-btn-outline">
            <i class="bi bi-headset"></i> Queries
        </a>
        <a asp-controller="EventManager" asp-action="Index" class="dash-btn dash-btn-outline">
            <i class="bi bi-palette2 text-warning"></i> Event Manager
        </a>
        <a asp-action="Settings" class="dash-btn dash-btn-outline" title="Settings">
            <i class="bi bi-gear"></i>
        </a>
    </div>
</div>

<!-- Stat Cards Grid: 6 Summary Cards linking to filtered lists (Item 1) -->
<div class="dash-stat-grid mb-4">
    <!-- 1. Bookings Today -->
    <a asp-action="ManageBookings" asp-route-filter="today" class="dash-stat-card text-decoration-none">
        <div class="dash-stat-top">
            <span class="dash-stat-label">Bookings Today</span>
            <span class="dash-stat-icon icon-blue"><i class="bi bi-calendar-day-fill"></i></span>
        </div>
        <div class="dash-stat-val">@Model.BookingsTodayCount</div>
        <div class="dash-stat-sub text-primary fw-medium"><i class="bi bi-arrow-right-circle me-1"></i>View today's bookings</div>
    </a>

    <!-- 2. Pending Refunds -->
    <a asp-action="RefundsQueue" asp-route-status="Pending" class="dash-stat-card text-decoration-none">
        <div class="dash-stat-top">
            <span class="dash-stat-label">Pending Refunds</span>
            <span class="dash-stat-icon icon-cyan" style="background: rgba(13, 202, 240, 0.15); color: #0dcaf0;"><i class="bi bi-arrow-counterclockwise"></i></span>
        </div>
        <div class="dash-stat-val @(Model.PendingRefundsCount > 0 ? "text-danger" : "")">@Model.PendingRefundsCount</div>
        <div class="dash-stat-sub">
            @if (Model.PendingRefundsCount > 0)
            {
                <span class="text-danger fw-semibold"><i class="bi bi-exclamation-triangle-fill me-1"></i>Action required</span>
            }
            else
            {
                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>All clear</span>
            }
        </div>
    </a>

    <!-- 3. Pending KYC -->
    <a asp-action="IdVerifications" asp-route-status="PendingReview" class="dash-stat-card text-decoration-none">
        <div class="dash-stat-top">
            <span class="dash-stat-label">Pending KYC</span>
            <span class="dash-stat-icon icon-violet"><i class="bi bi-person-vcard-fill"></i></span>
        </div>
        <div class="dash-stat-val @(Model.PendingKycCount > 0 ? "text-warning" : "")">@Model.PendingKycCount</div>
        <div class="dash-stat-sub">
            @if (Model.PendingKycCount > 0)
            {
                <span class="text-warning fw-semibold"><i class="bi bi-clock-fill me-1"></i>Awaiting review</span>
            }
            else
            {
                <span class="text-success"><i class="bi bi-shield-check me-1"></i>Verified</span>
            }
        </div>
    </a>

    <!-- 4. Pending Partner Leads -->
    <a asp-action="PartnerLeads" asp-route-status="New" class="dash-stat-card text-decoration-none">
        <div class="dash-stat-top">
            <span class="dash-stat-label">Pending Partner Leads</span>
            <span class="dash-stat-icon icon-emerald"><i class="bi bi-person-plus-fill"></i></span>
        </div>
        <div class="dash-stat-val">@Model.PendingPartnerLeadsCount</div>
        <div class="dash-stat-sub text-success fw-medium"><i class="bi bi-people-fill me-1"></i>Review host applicants</div>
    </a>

    <!-- 5. Held Payouts Total -->
    <a asp-action="ManageBookings" asp-route-status="Confirmed" class="dash-stat-card text-decoration-none">
        <div class="dash-stat-top">
            <span class="dash-stat-label">Held Payouts Total</span>
            <span class="dash-stat-icon icon-amber"><i class="bi bi-wallet2"></i></span>
        </div>
        <div class="dash-stat-val">₹@Model.HeldPayoutsTotal.ToString("N2")</div>
        <div class="dash-stat-sub text-muted small">Confirmed stays prior to checkout</div>
    </a>

    <!-- 6. New Messages -->
    <a asp-action="SupportQueries" asp-route-status="New" class="dash-stat-card text-decoration-none">
        <div class="dash-stat-top">
            <span class="dash-stat-label">New Messages</span>
            <span class="dash-stat-icon" style="background: rgba(239, 68, 68, 0.12); color: #ef4444;"><i class="bi bi-headset"></i></span>
        </div>
        <div class="dash-stat-val">@Model.NewMessagesCount</div>
        <div class="dash-stat-sub">
            @if (Model.NewMessagesCount > 0)
            {
                <span class="text-danger fw-semibold"><i class="bi bi-envelope-exclamation-fill me-1"></i>Unresolved queries</span>
            }
            else
            {
                <span class="text-success"><i class="bi bi-check2-all me-1"></i>Inbox resolved</span>
            }
        </div>
    </a>
</div>

<!-- Details Grid -->
<div class="row g-4">
    <!-- Recent Properties Added -->
    <div class="col-lg-7">
        <div class="dash-card">
            <div class="dash-card-header">
                <h3 class="dash-card-title"><i class="bi bi-building me-2 text-primary"></i>Recent Properties Added</h3>
                <a asp-action="CreateProperty" class="dash-btn dash-btn-primary" style="padding: .35rem .85rem; font-size: .8rem;">
                    <i class="bi bi-plus-lg"></i> Add Property
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Property</th>
                            <th>Owner</th>
                            <th>Price / Night</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentProperties.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No properties found.</td>
                            </tr>
                        }
                        @foreach (var p in Model.RecentProperties)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@p.Title</div>
                                    <small class="text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@p.Location</small>
                                </td>
                                <td><span class="text-muted">@p.OwnerName</span></td>
                                <td><strong>₹@p.PricePerNight.ToString("N0")</strong></td>
                                <td>
                                    @if (p.ListingStatus == "Deactivated")
                                    {
                                        <span class="dash-badge dash-badge-secondary"><i class="bi bi-pause-circle-fill"></i> Deactivated</span>
                                    }
                                    else if (p.ListingStatus == "Rejected")
                                    {
                                        <span class="dash-badge dash-badge-danger text-danger"><i class="bi bi-x-circle-fill"></i> Rejected</span>
                                    }
                                    else if (p.IsApproved && p.ListingStatus == "Active")
                                    {
                                        <span class="dash-badge dash-badge-success"><i class="bi bi-check-circle-fill"></i> Approved</span>
                                    }
                                    else
                                    {
                                        <span class="dash-badge dash-badge-warning"><i class="bi bi-clock-fill"></i> Pending</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!p.IsApproved || p.ListingStatus != "Active")
                                    {
                                        <form asp-action="ApproveProperty" asp-route-id="@p.PropertyID" asp-route-approve="true" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" method="post" class="d-inline me-1">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success" style="border-radius: 8px; padding: .25rem .55rem; font-size: .78rem;" title="Approve & Publish Listing">
                                                <i class="bi bi-check-circle me-1"></i>Approve
                                            </button>
                                        </form>
                                        @if (p.ListingStatus != "Rejected")
                                        {
                                            <form asp-action="ApproveProperty" asp-route-id="@p.PropertyID" asp-route-approve="false" asp-route-status="Rejected" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" method="post" class="d-inline me-1" onsubmit="return confirm('Reject listing for property #@p.PropertyID?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px; padding: .25rem .55rem; font-size: .78rem;" title="Reject Listing">
                                                    <i class="bi bi-x-circle me-1"></i>Reject
                                                </button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        <form asp-action="ApproveProperty" asp-route-id="@p.PropertyID" asp-route-approve="false" asp-route-status="Draft" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" method="post" class="d-inline me-1" onsubmit="return confirm('Revoke approval for property #@p.PropertyID?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-warning" style="border-radius: 8px; padding: .25rem .55rem; font-size: .78rem;" title="Revoke Approval">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i>Revoke
                                            </button>
                                        </form>
                                    }

                                    @if (p.ListingStatus == "Deactivated")
                                    {
                                        <form asp-action="DeactivateProperty" asp-route-id="@p.PropertyID" asp-route-deactivate="false" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" method="post" class="d-inline me-1">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success" style="border-radius: 8px; padding: .25rem .55rem; font-size: .78rem;" title="Activate">Activate</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="DeactivateProperty" asp-route-id="@p.PropertyID" asp-route-deactivate="true" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" method="post" class="d-inline me-1" onsubmit="return confirm('Deactivate property #@p.PropertyID?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" style="border-radius: 8px; padding: .25rem .55rem; font-size: .78rem;" title="Deactivate">Deactivate</button>
                                        </form>
                                    }
                                    <a asp-action="EditProperty" asp-route-id="@p.PropertyID" class="dash-btn dash-btn-outline" style="padding: .25rem .65rem; font-size: .78rem;">
                                        Edit
                                    </a>
                                    <form asp-action="DeleteProperty" asp-route-id="@p.PropertyID" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" method="post" class="d-inline" onsubmit="return confirm('Permanently delete property #@p.PropertyID?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 8px; padding: .25rem .55rem; font-size: .78rem;">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Recent Bookings -->
    <div class="col-lg-5">
        <div class="dash-card">
            <div class="dash-card-header">
                <h3 class="dash-card-title"><i class="bi bi-calendar-check me-2 text-success"></i>Recent Bookings</h3>
                <a asp-action="ManageBookings" class="text-decoration-none small text-muted">View all &rarr;</a>
            </div>
            <div class="list-group list-group-flush">
                @if (!Model.RecentBookings.Any())
                {
                    <div class="p-4 text-center text-muted">No bookings recorded yet.</div>
                }
                @foreach (var b in Model.RecentBookings)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center p-3">
                        <div>
                            <div class="fw-bold">@b.PropertyTitle</div>
                            <small class="text-muted d-block">
                                <i class="bi bi-person me-1"></i>@b.ClientName · <span class="badge bg-secondary">@b.BookingType</span>
                            </small>
                        </div>
                        <div class="text-end">
                            <span class="fw-bold text-success fs-6">₹@b.TotalAmount.ToString("N2")</span>
                            <div class="mt-1">
                                <span class="dash-badge dash-badge-success">@b.Status</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

