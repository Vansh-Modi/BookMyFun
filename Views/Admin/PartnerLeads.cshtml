@model IEnumerable<BookMyFun.Models.Entities.PartnerLead>
@{
    var isEmployee = User.IsInRole("Employee");
    var controllerName = isEmployee ? "Employee" : "Admin";
    ViewData["Title"] = "Partner Onboarding Pipeline";

    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    var search = ViewBag.Search as string ?? "";
    var sort = ViewBag.Sort as string ?? "id";
    var dir = ViewBag.Dir as string ?? "desc";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 25;
    var totalCount = ViewBag.TotalCount as int? ?? (Model?.Count() ?? 0);
    var totalPages = ViewBag.TotalPages as int? ?? Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));
}

<div class="container-fluid py-4 px-lg-4">
    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-gradient text-white p-4" style="background: linear-gradient(135deg, #059669 0%, #064e3b 100%);">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-white text-success px-3 py-2 rounded-pill fw-bold mb-2">Partner Intake Pipeline</span>
                <h2 class="fw-bold mb-1"><i class="bi bi-people-fill me-2"></i>Partner Onboarding Pipeline</h2>
                <p class="mb-0 text-white-50">Review inbound 'Partner With Us' candidate submissions (Farm Hosts &amp; Event Managers), vet capabilities, and issue activation invitations.</p>
            </div>
            <a asp-controller="@controllerName" asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a asp-controller="@controllerName" asp-action="PartnerLeads" asp-route-search="@search" class="btn rounded-pill px-3 @(string.IsNullOrEmpty(selectedStatus) || selectedStatus == "All" ? "btn-success" : "btn-light border")">
            All Inbound Leads
        </a>
        <a asp-controller="@controllerName" asp-action="PartnerLeads" asp-route-status="New" asp-route-search="@search" class="btn rounded-pill px-3 @(selectedStatus == "New" ? "btn-warning text-dark fw-bold" : "btn-light border")">
            <i class="bi bi-bell-fill me-1"></i> New Leads
        </a>
        <a asp-controller="@controllerName" asp-action="PartnerLeads" asp-route-status="Approved" asp-route-search="@search" class="btn rounded-pill px-3 @(selectedStatus == "Approved" ? "btn-success fw-bold text-white" : "btn-light border")">
            <i class="bi bi-check-circle me-1"></i> Approved &amp; Invited
        </a>
        <a asp-controller="@controllerName" asp-action="PartnerLeads" asp-route-status="Rejected" asp-route-search="@search" class="btn rounded-pill px-3 @(selectedStatus == "Rejected" ? "btn-danger fw-bold text-white" : "btn-light border")">
            <i class="bi bi-x-circle me-1"></i> Rejected
        </a>
    </div>

    <!-- Search & Controls Card -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-controller="@controllerName" asp-action="PartnerLeads" class="row g-2 align-items-center">
                <input type="hidden" name="status" value="@selectedStatus" />
                <input type="hidden" name="sort" value="@sort" />
                <input type="hidden" name="dir" value="@dir" />

                <div class="col-md-8 col-sm-12">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Search by lead #, name, email, property or location..." value="@search" />
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <select name="pageSize" class="form-select" onchange="this.form.submit()">
                        <option value="10" selected="@(pageSize == 10)">10 per page</option>
                        <option value="25" selected="@(pageSize == 25)">25 per page</option>
                        <option value="50" selected="@(pageSize == 50)">50 per page</option>
                        <option value="100" selected="@(pageSize == 100)">100 per page</option>
                    </select>
                </div>
                <div class="col-md-2 col-6 d-flex gap-2">
                    <button type="submit" class="btn btn-success w-100 fw-semibold">Filter</button>
                    @if (!string.IsNullOrWhiteSpace(search) || (!string.IsNullOrEmpty(selectedStatus) && selectedStatus != "All"))
                    {
                        <a asp-controller="@controllerName" asp-action="PartnerLeads" class="btn btn-outline-secondary" title="Clear Filters"><i class="bi bi-x-lg"></i></a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">
                                    <a asp-controller="@controllerName" asp-action="PartnerLeads" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="id" asp-route-dir="@(sort == "id" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-dark d-inline-flex align-items-center">
                                        Lead # @(sort == "id" ? (dir == "asc" ? "▲" : "▼") : "")
                                    </a>
                                </th>
                                <th>Partner Type</th>
                                <th>
                                    <a asp-controller="@controllerName" asp-action="PartnerLeads" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="name" asp-route-dir="@(sort == "name" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-dark d-inline-flex align-items-center">
                                        Candidate Info @(sort == "name" ? (dir == "asc" ? "▲" : "▼") : "")
                                    </a>
                                </th>
                                <th>Property / Studio Name</th>
                                <th>Location</th>
                                <th>Size / Specialization</th>
                                <th>Message</th>
                                <th>
                                    <a asp-controller="@controllerName" asp-action="PartnerLeads" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="status" asp-route-dir="@(sort == "status" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-dark d-inline-flex align-items-center">
                                        Status @(sort == "status" ? (dir == "asc" ? "▲" : "▼") : "")
                                    </a>
                                </th>
                                <th>
                                    <a asp-controller="@controllerName" asp-action="PartnerLeads" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="date" asp-route-dir="@(sort == "date" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-dark d-inline-flex align-items-center">
                                        Submitted Date @(sort == "date" ? (dir == "asc" ? "▲" : "▼") : "")
                                    </a>
                                </th>
                                <th class="pe-4 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in Model)
                            {
                                var badgeClass = l.Status switch
                                {
                                    "New" => "bg-warning text-dark",
                                    "Approved" => "bg-success",
                                    "Rejected" => "bg-danger",
                                    "Contacted" => "bg-info text-dark",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td class="ps-4 fw-bold">#@l.LeadID</td>
                                    <td>
                                        @if (l.PartnerType == "EventManager")
                                        {
                                            <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-1 rounded-pill">
                                                <i class="bi bi-palette2 me-1"></i>Event Manager
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                                <i class="bi bi-house-door-fill me-1"></i>Farm Host
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@l.FullName</div>
                                        <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@l.Email</div>
                                        <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@l.Phone</div>
                                    </td>
                                    <td class="fw-medium text-dark">@l.PropertyName</td>
                                    <td>@l.Location</td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">@(string.IsNullOrEmpty(l.AcreageOrType) ? "Standard Farm" : l.AcreageOrType)</span>
                                    </td>
                                    <td class="small text-muted" style="max-width: 250px;">
                                        @(string.IsNullOrEmpty(l.Message) ? "--" : l.Message)
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass px-3 py-2 rounded-pill">@l.Status</span>
                                    </td>
                                    <td class="text-muted small">@l.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="pe-4 text-end">
                                        @if (l.Status == "New" || l.Status == "Contacted")
                                        {
                                            <div class="btn-group">
                                                <form asp-controller="@controllerName" asp-action="ApprovePartnerLead" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="leadId" value="@l.LeadID" />
                                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 me-1" onclick="return confirm('Approve partner lead and dispatch encrypted host activation link?');">
                                                        <i class="bi bi-send-check me-1"></i> Approve &amp; Invite
                                                    </button>
                                                </form>
                                                <form asp-controller="@controllerName" asp-action="RejectPartnerLead" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="leadId" value="@l.LeadID" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2" onclick="return confirm('Reject this partner lead?');">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else if (l.Status == "Approved")
                                        {
                                            <span class="text-success small fw-semibold"><i class="bi bi-check2-all me-1"></i>Invite Dispatched</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Rejected</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                @if (totalPages > 1)
                {
                    <div class="card-footer bg-white border-top d-flex flex-wrap justify-content-between align-items-center py-3 px-4">
                        <div class="small text-muted">
                            Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, totalCount)) of @totalCount leads
                        </div>
                        <nav aria-label="Partner leads pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" asp-controller="@controllerName" asp-action="PartnerLeads" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-sort="@sort" asp-route-dir="@dir" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">Previous</a>
                                </li>
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                                    {
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                            <a class="page-link" asp-controller="@controllerName" asp-action="PartnerLeads" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-sort="@sort" asp-route-dir="@dir" asp-route-page="@i" asp-route-pageSize="@pageSize">@i</a>
                                        </li>
                                    }
                                    else if (i == currentPage - 3 || i == currentPage + 3)
                                    {
                                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                    }
                                }
                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link" asp-controller="@controllerName" asp-action="PartnerLeads" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-sort="@sort" asp-route-dir="@dir" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <div class="empty-state-box py-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-circle p-4 mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-people-fill fs-1"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">No Partner Leads Found</h4>
                        <p class="text-muted small mb-3" style="max-width: 420px; margin: 0 auto;">
                            No partner lead inquiries or onboarding applications match the selected criteria.
                        </p>
                        <a asp-controller="@controllerName" asp-action="PartnerLeads" class="btn btn-outline-success rounded-pill px-4 py-2 fw-semibold">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters &amp; View All Leads
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
