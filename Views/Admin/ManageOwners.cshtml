@model IEnumerable<BookMyFun.Models.Entities.User>
@{
    ViewData["Title"] = "Manage Owners - Staff Oversight";
    var isEmployee = User.IsInRole("Employee");
    var controllerName = isEmployee ? "Employee" : "Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-people-fill text-primary"></i> Owner Management</h2>
        <p class="text-muted mb-0">Create, edit, or delete property owners directly on their behalf.</p>
    </div>
    <a asp-action="CreateOwner" class="btn btn-primary"><i class="bi bi-person-plus-fill"></i> Add New Owner</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Owner ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Registered On</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var owner in Model)
                {
                    <tr>
                        <td>#@owner.UserID</td>
                        <td class="fw-semibold">@owner.FullName</td>
                        <td>@owner.Email</td>
                        <td>@(owner.Phone ?? "N/A")</td>
                        <td>@owner.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <a asp-action="EditOwner" asp-route-id="@owner.UserID" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            <form asp-action="DeleteOwner" asp-route-id="@owner.UserID" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this owner?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
