@model IEnumerable<BookMyFun.Models.Entities.ContactUs>
@{
    ViewData["Title"] = "Customer Support Queries";
    var isEmployee = User.IsInRole("Employee");
    var controllerName = isEmployee ? "Employee" : "Admin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-headset text-primary"></i> Customer Support Queries</h2>
        <p class="text-muted mb-0">Help customers with questions, booking requests, or special arrangements.</p>
    </div>
    <a asp-controller="@controllerName" asp-action="Index" class="btn btn-outline-dark">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ticket #</th>
                    <th>Customer Name</th>
                    <th>Contact Info</th>
                    <th>Subject / Occasion</th>
                    <th>Message</th>
                    <th>Received At</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">No customer inquiries found.</td>
                    </tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>#@c.ContactID</strong></td>
                        <td class="fw-bold">@c.Name</td>
                        <td>
                            <div><i class="bi bi-envelope"></i> @c.Email</div>
                            @if (!string.IsNullOrEmpty(c.Phone))
                            {
                                <div><i class="bi bi-whatsapp text-success"></i> <a href="https://wa.me/@c.Phone.Replace("+","").Replace(" ","")" target="_blank" class="text-decoration-none">@c.Phone</a></div>
                            }
                        </td>
                        <td><span class="badge bg-light text-dark border">@(c.Subject ?? "General Inquiry")</span></td>
                        <td style="max-width: 320px;" class="small text-secondary">@c.Message</td>
                        <td>@c.CreatedAt.ToString("MMM dd, hh:mm tt")</td>
                        <td>
                            @if (c.Status == "Responded")
                            {
                                <span class="badge bg-success">Responded</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">New Query</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-controller="@controllerName" asp-action="UpdateContactStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contactId" value="@c.ContactID" />
                                <input type="hidden" name="status" value="@(c.Status == "Responded" ? "New" : "Responded")" />
                                <button type="submit" class="btn btn-sm @(c.Status == "Responded" ? "btn-outline-secondary" : "btn-success")">
                                    <i class="bi bi-check2"></i> Mark @(c.Status == "Responded" ? "New" : "Resolved")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
