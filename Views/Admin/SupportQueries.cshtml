@model IEnumerable<BookMyFun.Models.Entities.ContactUs>
@{
    ViewData["Title"] = "Customer Support Queries";
    var isEmployee = User.IsInRole("Employee");
    var controllerName = isEmployee ? "Employee" : "Admin";

    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    var search = ViewBag.Search as string ?? "";
    var sort = ViewBag.Sort as string ?? "id";
    var dir = ViewBag.Dir as string ?? "desc";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 25;
    var totalCount = ViewBag.TotalCount as int? ?? (Model?.Count() ?? 0);
    var totalPages = ViewBag.TotalPages as int? ?? Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="@controllerName" asp-action="Index">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Support Queries</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1"><i class="bi bi-headset text-primary me-2"></i>Customer Support Queries</h2>
        <p class="text-muted mb-0">Help customers with questions, booking requests, or special arrangements with staff accountability.</p>
    </div>
    <a asp-controller="@controllerName" asp-action="Index" class="btn btn-outline-dark rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Dashboard
    </a>
</div>

<!-- Filter Pills -->
<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-controller="@controllerName" asp-action="SupportQueries" asp-route-search="@search" class="btn rounded-pill px-3 @(selectedStatus == "All" || string.IsNullOrEmpty(selectedStatus) ? "btn-primary" : "btn-light border")">
        All Queries
    </a>
    <a asp-controller="@controllerName" asp-action="SupportQueries" asp-route-status="New" asp-route-search="@search" class="btn rounded-pill px-3 @(selectedStatus == "New" ? "btn-warning text-dark fw-bold" : "btn-light border")">
        <i class="bi bi-bell-fill me-1"></i> New Queries
    </a>
    <a asp-controller="@controllerName" asp-action="SupportQueries" asp-route-status="Responded" asp-route-search="@search" class="btn rounded-pill px-3 @(selectedStatus == "Responded" ? "btn-success fw-bold text-white" : "btn-light border")">
        <i class="bi bi-check-circle-fill me-1"></i> Responded
    </a>
</div>

<!-- Search & Controls Card -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-controller="@controllerName" asp-action="SupportQueries" class="row g-2 align-items-center">
            <input type="hidden" name="status" value="@selectedStatus" />
            <input type="hidden" name="sort" value="@sort" />
            <input type="hidden" name="dir" value="@dir" />

            <div class="col-md-8 col-sm-12">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search by ticket #, name, email, subject, or message content..." value="@search" />
                </div>
            </div>
            <div class="col-md-2 col-6">
                <select name="pageSize" class="form-select" onchange="this.form.submit()">
                    <option value="10" selected="@(pageSize == 10)">10 per page</option>
                    <option value="25" selected="@(pageSize == 25)">25 per page</option>
                    <option value="50" selected="@(pageSize == 50)">50 per page</option>
                    <option value="100" selected="@(pageSize == 100)">100 per page</option>
                </select>
            </div>
            <div class="col-md-2 col-6 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">Filter</button>
                @if (!string.IsNullOrWhiteSpace(search) || (!string.IsNullOrEmpty(selectedStatus) && selectedStatus != "All"))
                {
                    <a asp-controller="@controllerName" asp-action="SupportQueries" class="btn btn-outline-secondary" title="Clear Filters"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">
                        <a asp-controller="@controllerName" asp-action="SupportQueries" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="id" asp-route-dir="@(sort == "id" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-dark d-inline-flex align-items-center">
                            Ticket # @(sort == "id" ? (dir == "asc" ? "▲" : "▼") : "")
                        </a>
                    </th>
                    <th>
                        <a asp-controller="@controllerName" asp-action="SupportQueries" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="name" asp-route-dir="@(sort == "name" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-dark d-inline-flex align-items-center">
                            Customer Name @(sort == "name" ? (dir == "asc" ? "▲" : "▼") : "")
                        </a>
                    </th>
                    <th>Contact Info</th>
                    <th>Subject</th>
                    <th>Message</th>
                    <th>
                        <a asp-controller="@controllerName" asp-action="SupportQueries" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="date" asp-route-dir="@(sort == "date" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-dark d-inline-flex align-items-center">
                            Received At @(sort == "date" ? (dir == "asc" ? "▲" : "▼") : "")
                        </a>
                    </th>
                    <th>
                        <a asp-controller="@controllerName" asp-action="SupportQueries" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="status" asp-route-dir="@(sort == "status" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-dark d-inline-flex align-items-center">
                            Status @(sort == "status" ? (dir == "asc" ? "▲" : "▼") : "")
                        </a>
                    </th>
                    <th>Support Agent</th>
                    <th class="text-end pe-3">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-muted opacity-50"></i>
                            <h5 class="text-dark">No inquiries found</h5>
                            <p class="small text-muted mb-0">No customer support inquiries match your criteria.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-muted">#@c.ContactID</td>
                            <td class="fw-bold text-dark">@c.Name</td>
                            <td>
                                <div><i class="bi bi-envelope me-1"></i><a href="mailto:@c.Email" class="text-decoration-none">@c.Email</a></div>
                                @if (!string.IsNullOrEmpty(c.Phone))
                                {
                                    <div><i class="bi bi-whatsapp text-success me-1"></i><a href="https://wa.me/@c.Phone.Replace("+","").Replace(" ","")" target="_blank" class="text-decoration-none">@c.Phone</a></div>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@(c.Subject ?? "General Inquiry")</span></td>
                            <td style="max-width: 280px;" class="small text-secondary">
                                <div class="text-truncate">@c.Message</div>
                                @if (!string.IsNullOrEmpty(c.ResponseNotes))
                                {
                                    <div class="mt-1 p-1 bg-light rounded text-muted" style="font-size: 0.75rem;">
                                        <strong>Resolution Note:</strong> @c.ResponseNotes
                                    </div>
                                }
                            </td>
                            <td>@c.CreatedAt.ToString("MMM dd, hh:mm tt")</td>
                            <td>
                                @if (c.Status == "Responded")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Responded</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">New Query</span>
                                }
                            </td>
                            <td>
                                @if (c.Status == "Responded" && !string.IsNullOrEmpty(c.RespondedByUserName))
                                {
                                    <div>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="bi bi-person-badge-fill me-1"></i>@c.RespondedByUserName
                                        </span>
                                    </div>
                                    <span class="badge bg-secondary-subtle text-secondary small" style="font-size: 0.7rem;">@c.RespondedByUserRole</span>
                                    @if (c.RespondedAt.HasValue)
                                    {
                                        <div class="text-muted small" style="font-size: 0.7rem;">@c.RespondedAt.Value.ToString("MMM dd, hh:mm tt")</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small"><em>Awaiting response</em></span>
                                }
                            </td>
                            <td class="text-end pe-3">
                                <form asp-controller="@controllerName" asp-action="UpdateContactStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="contactId" value="@c.ContactID" />
                                    <input type="hidden" name="status" value="@(c.Status == "Responded" ? "New" : "Responded")" />
                                    <button type="submit" class="btn btn-sm @(c.Status == "Responded" ? "btn-outline-secondary" : "btn-success") rounded-pill px-3">
                                        <i class="bi bi-check2"></i> Mark @(c.Status == "Responded" ? "New" : "Resolved")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-top d-flex flex-wrap justify-content-between align-items-center py-3 px-3">
            <div class="small text-muted">
                Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, totalCount)) of @totalCount queries
            </div>
            <nav aria-label="Support queries pagination">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-controller="@controllerName" asp-action="SupportQueries" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-sort="@sort" asp-route-dir="@dir" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">Previous</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-controller="@controllerName" asp-action="SupportQueries" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-sort="@sort" asp-route-dir="@dir" asp-route-page="@i" asp-route-pageSize="@pageSize">@i</a>
                            </li>
                        }
                        else if (i == currentPage - 3 || i == currentPage + 3)
                        {
                            <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                        }
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-controller="@controllerName" asp-action="SupportQueries" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-sort="@sort" asp-route-dir="@dir" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
