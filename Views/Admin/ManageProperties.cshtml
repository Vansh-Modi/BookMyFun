@model IEnumerable<BookMyFun.Models.Entities.Property>
@{
    ViewData["Title"] = "Manage Properties - Staff Oversight";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-building text-primary"></i> Property Listings Management</h2>
        <p class="text-muted mb-0">Create, edit, approve, or remove properties on behalf of owners.</p>
    </div>
    <a asp-action="CreateProperty" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Property for Owner</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Property</th>
                    <th>Type</th>
                    <th>Owner</th>
                    <th>Location</th>
                    <th>Price/Night</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="@p.PrimaryImageUrl" class="rounded me-2" style="width: 50px; height: 50px; object-fit: cover;" onerror="this.src='/images/placeholder.jpg';" />
                                <div>
                                    <div class="fw-bold">@p.Title</div>
                                    <small class="text-muted">Max @p.MaxGuests Guests</small>
                                </div>
                            </div>
                        </td>
                        <td>@p.PropertyTypeName</td>
                        <td>@p.OwnerName</td>
                        <td>@p.Location</td>
                        <td>₹@p.PricePerNight.ToString("N2")</td>
                        <td>
                            @if (p.IsApproved)
                            {
                                <span class="badge bg-success">Active & Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending Review</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="ApproveProperty" asp-route-id="@p.PropertyID" asp-route-approve="@(!p.IsApproved)" method="post" class="d-inline me-1">
                                <button type="submit" class="btn btn-sm @(p.IsApproved ? "btn-outline-warning" : "btn-outline-success")">
                                    @(p.IsApproved ? "Revoke" : "Approve")
                                </button>
                            </form>
                            <a asp-action="EditProperty" asp-route-id="@p.PropertyID" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                            <form asp-action="DeleteProperty" asp-route-id="@p.PropertyID" method="post" class="d-inline" onsubmit="return confirm('Delete this property?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
