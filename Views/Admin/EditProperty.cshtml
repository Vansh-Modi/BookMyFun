@model BookMyFun.Models.ViewModels.PropertyEditViewModel
@{
    var isEmployee = User.IsInRole("Employee");
    var controllerName = isEmployee ? "Employee" : "Admin";
    ViewData["Title"] = "Edit Property #" + Model.PropertyID;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-11">
            <!-- Header Banner -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-gradient text-white p-4" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <span class="badge bg-primary px-3 py-2 rounded-pill fw-bold mb-2">Edit Listing #@Model.PropertyID</span>
                        <h2 class="fw-bold mb-1"><i class="bi bi-pencil-square me-2"></i>Edit Property Listing</h2>
                        <p class="mb-0 text-white-50">Manage status, owner association, amenities taxonomy, policy windows, and media.</p>
                    </div>
                    <a asp-controller="@controllerName" asp-action="ManageProperties" class="btn btn-outline-light rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to Properties
                    </a>
                </div>
            </div>

            <form asp-controller="@controllerName" asp-action="EditProperty" method="post" id="adminEditPropertyForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PropertyID" />
                <input type="hidden" id="additionalMediaJson" name="AdditionalMediaJson" value="[]" />

                <!-- SECTION 1: ESSENTIAL DETAILS & STATUS -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-sliders text-primary me-2"></i>1. Core Settings & Host</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Assigned Host</label>
                                <select asp-for="OwnerID" class="form-select rounded-3" required>
                                    @foreach (var o in Model.AvailableOwners)
                                    {
                                        <option value="@o.UserID" selected="@(Model.OwnerID == o.UserID)">@o.FullName (@o.Email)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Property Type</label>
                                <select asp-for="PropertyTypeID" class="form-select rounded-3" required>
                                    @foreach (var t in Model.AvailableTypes)
                                    {
                                        <option value="@t.PropertyTypeID" selected="@(Model.PropertyTypeID == t.PropertyTypeID)">@t.TypeName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Listing Status</label>
                                <select asp-for="ListingStatus" class="form-select rounded-3">
                                    <option value="Active">Active (Publicly Visible)</option>
                                    <option value="Draft">Draft (Hidden)</option>
                                    <option value="Expired">Expired</option>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Property Title <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control rounded-3" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Max Guests</label>
                                <input asp-for="MaxGuests" type="number" min="1" class="form-control rounded-3" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Description</label>
                                <textarea asp-for="Description" class="form-control rounded-3" rows="3" required></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Base Price Per Night (₹)</label>
                                <input asp-for="PricePerNight" type="number" step="0.01" min="100" class="form-control rounded-3" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Security Deposit (₹)</label>
                                <input asp-for="SecurityDepositAmount" type="number" step="0.01" min="0" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Commission Override (%)</label>
                                <input asp-for="CommissionRate" type="number" step="0.1" min="0" max="100" class="form-control rounded-3" placeholder="Leave empty for default" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 2: LOCATION & COORDINATES -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-geo-alt-fill text-danger me-2"></i>2. Location & Geolocation</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">City / Location</label>
                                <input asp-for="Location" class="form-control rounded-3" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Formatted Address</label>
                                <input asp-for="FormattedAddress" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Latitude</label>
                                <input asp-for="Latitude" type="number" step="0.0000001" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Longitude</label>
                                <input asp-for="Longitude" type="number" step="0.0000001" class="form-control rounded-3" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 3: CANCELLATION POLICIES -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-shield-check text-primary me-2"></i>3. Cancellation Policies</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Free Cancellation Window (Hours)</label>
                                <input asp-for="FreeCancellationWindowHours" type="number" min="0" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Cancellation Cutoff Deadline (Hours)</label>
                                <input asp-for="CancellationCutoffHours" type="number" min="0" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Fee Type</label>
                                <select asp-for="CancellationFeeType" class="form-select">
                                    <option value="percentage">Percentage (%)</option>
                                    <option value="fixed">Fixed (₹)</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Fee Value</label>
                                <input asp-for="CancellationFeeValue" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SECTION 4: AMENITIES & OCCASIONS -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-grid-fill text-warning me-2"></i>4. Amenities Taxonomy & Occasions</h5>
                    </div>
                    <div class="card-body p-4">
                        <h6 class="fw-bold mb-3 text-secondary">Amenities</h6>
                        <div class="row row-cols-2 row-cols-md-4 g-2 mb-4">
                            @foreach (var am in Model.AvailableAmenities)
                            {
                                <div class="col">
                                    <div class="form-check p-2 border rounded-3 bg-light">
                                        <input class="form-check-input ms-0 me-2" type="checkbox" name="SelectedAmenityIDs" value="@am.AmenityID" id="am_@am.AmenityID" @(Model.SelectedAmenityIDs != null && Model.SelectedAmenityIDs.Contains(am.AmenityID) ? "checked" : "")>
                                        <label class="form-check-label small" for="am_@am.AmenityID"><i class="bi @am.IconClass text-success me-1"></i> @am.AmenityName</label>
                                    </div>
                                </div>
                            }
                        </div>

                        <h6 class="fw-bold mb-3 text-secondary">Occasions</h6>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var occ in Model.AvailableOccasions)
                            {
                                <div class="form-check form-check-inline p-2 border rounded-pill px-3 bg-light">
                                    <input class="form-check-input ms-0 me-2" type="checkbox" name="SelectedOccasionIDs" value="@occ.OccasionID" id="occ_@occ.OccasionID" @(Model.SelectedOccasionIDs != null && Model.SelectedOccasionIDs.Contains(occ.OccasionID) ? "checked" : "")>
                                    <label class="form-check-label fw-medium" for="occ_@occ.OccasionID">@occ.OccasionName</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- SECTION 5: MEDIA -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                        <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-images text-info me-2"></i>5. Media Gallery</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Cover Image URL</label>
                            <input asp-for="ImageUrlInput" class="form-control rounded-3" />
                        </div>

                        <!-- Existing Media List -->
                        <h6 class="fw-bold text-secondary mb-3">Saved Media</h6>
                        <div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
                            @if (Model.ExistingMedia != null && Model.ExistingMedia.Any())
                            {
                                foreach (var m in Model.ExistingMedia)
                                {
                                    <div class="col" id="media-card-@m.MediaID">
                                        <div class="card h-100 border shadow-sm rounded-3 overflow-hidden">
                                            <img src="@m.StorageUrl" class="card-img-top object-fit-cover" style="height: 120px;" onerror="this.src='/images/property-placeholder.jpg';" />
                                            <div class="card-body p-2 d-flex justify-content-between align-items-center">
                                                <span class="badge @(m.MediaType == "video" ? "bg-primary" : "bg-secondary") small">@m.MediaType</span>
                                                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 btn-del-existing" data-media-id="@m.MediaID"><i class="bi bi-trash"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-12 text-muted small">No media saved.</div>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4 mb-5">
                    <a asp-controller="@controllerName" asp-action="ManageProperties" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm fw-bold">Update Property</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll(".btn-del-existing").forEach(b => {
        b.addEventListener("click", async function () {
            const id = this.getAttribute("data-media-id");
            if (!confirm("Delete this media?")) return;
            const res = await (await fetch(`/api/media/delete/${id}`, { method: "DELETE" })).json();
            if (res.success) {
                document.getElementById(`media-card-${id}`)?.remove();
            }
        });
    });
</script>
}
