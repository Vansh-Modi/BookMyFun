@model IEnumerable<BookMyFun.Models.Entities.BookingRefund>
@{
    var isEmployee = User.IsInRole("Employee");
    var controllerName = isEmployee ? "Employee" : "Admin";
    ViewData["Title"] = "Refund Operations Queue";

    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
    var search = ViewBag.Search as string ?? "";
    var sort = ViewBag.Sort as string ?? "id";
    var dir = ViewBag.Dir as string ?? "desc";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var pageSize = ViewBag.PageSize as int? ?? 25;
    var totalCount = ViewBag.TotalCount as int? ?? (Model?.Count() ?? 0);
    var totalPages = ViewBag.TotalPages as int? ?? Math.Max(1, (int)Math.Ceiling((double)totalCount / pageSize));
}

<div class="container-fluid py-4 px-lg-4">
    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-gradient text-white p-4" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold mb-2">Finance &amp; Triage</span>
                <h2 class="fw-bold mb-1"><i class="bi bi-arrow-counterclockwise me-2"></i>Refund Operations Queue</h2>
                <p class="mb-0 text-white-50">Review automated policy window quotes, audit gateway fees, and execute manual overrides or gateway refund dispatches.</p>
            </div>
            <a asp-controller="@controllerName" asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a asp-controller="@controllerName" asp-action="RefundsQueue" asp-route-search="@search" class="btn rounded-pill px-3 @(string.IsNullOrEmpty(selectedStatus) || selectedStatus == "All" ? "btn-primary" : "btn-light border")">
            All Refunds
        </a>
        <a asp-controller="@controllerName" asp-action="RefundsQueue" asp-route-status="Pending" asp-route-search="@search" class="btn rounded-pill px-3 @(selectedStatus == "Pending" ? "btn-warning text-dark fw-bold" : "btn-light border")">
            <i class="bi bi-clock-history me-1"></i> Pending Review
        </a>
        <a asp-controller="@controllerName" asp-action="RefundsQueue" asp-route-status="Approved" asp-route-search="@search" class="btn rounded-pill px-3 @(selectedStatus == "Approved" ? "btn-success fw-bold text-white" : "btn-light border")">
            <i class="bi bi-check-circle me-1"></i> Approved
        </a>
        <a asp-controller="@controllerName" asp-action="RefundsQueue" asp-route-status="Processed" asp-route-search="@search" class="btn rounded-pill px-3 @(selectedStatus == "Processed" ? "btn-info text-dark fw-bold" : "btn-light border")">
            <i class="bi bi-check-all me-1"></i> Processed via Gateway
        </a>
        <a asp-controller="@controllerName" asp-action="RefundsQueue" asp-route-status="Rejected" asp-route-search="@search" class="btn rounded-pill px-3 @(selectedStatus == "Rejected" ? "btn-danger fw-bold text-white" : "btn-light border")">
            <i class="bi bi-x-circle me-1"></i> Rejected
        </a>
    </div>

    <!-- Search & Pagination Controls -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-controller="@controllerName" asp-action="RefundsQueue" class="row g-2 align-items-center">
                <input type="hidden" name="status" value="@selectedStatus" />
                <input type="hidden" name="sort" value="@sort" />
                <input type="hidden" name="dir" value="@dir" />

                <div class="col-md-8 col-sm-12">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Search by refund #, booking #, guest name, property, or reason..." value="@search" />
                    </div>
                </div>
                <div class="col-md-2 col-6">
                    <select name="pageSize" class="form-select" onchange="this.form.submit()">
                        <option value="10" selected="@(pageSize == 10)">10 per page</option>
                        <option value="25" selected="@(pageSize == 25)">25 per page</option>
                        <option value="50" selected="@(pageSize == 50)">50 per page</option>
                        <option value="100" selected="@(pageSize == 100)">100 per page</option>
                    </select>
                </div>
                <div class="col-md-2 col-6 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">Filter</button>
                    @if (!string.IsNullOrWhiteSpace(search) || (!string.IsNullOrEmpty(selectedStatus) && selectedStatus != "All"))
                    {
                        <a asp-controller="@controllerName" asp-action="RefundsQueue" class="btn btn-outline-secondary" title="Clear Filters"><i class="bi bi-x-lg"></i></a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">
                                    <a asp-controller="@controllerName" asp-action="RefundsQueue" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="id" asp-route-dir="@(sort == "id" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-dark d-inline-flex align-items-center">
                                        Refund # @(sort == "id" ? (dir == "asc" ? "▲" : "▼") : "")
                                    </a>
                                </th>
                                <th>
                                    <a asp-controller="@controllerName" asp-action="RefundsQueue" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="booking" asp-route-dir="@(sort == "booking" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-dark d-inline-flex align-items-center">
                                        Booking Ref @(sort == "booking" ? (dir == "asc" ? "▲" : "▼") : "")
                                    </a>
                                </th>
                                <th>Guest Details</th>
                                <th>Total Paid</th>
                                <th>Gateway Fee</th>
                                <th>Cancellation Fee</th>
                                <th>
                                    <a asp-controller="@controllerName" asp-action="RefundsQueue" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="amount" asp-route-dir="@(sort == "amount" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-dark d-inline-flex align-items-center">
                                        Calculated Refund @(sort == "amount" ? (dir == "asc" ? "▲" : "▼") : "")
                                    </a>
                                </th>
                                <th>Host / Penalty</th>
                                <th>Policy Rule</th>
                                <th>
                                    <a asp-controller="@controllerName" asp-action="RefundsQueue" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-pageSize="@pageSize" asp-route-sort="status" asp-route-dir="@(sort == "status" && dir == "asc" ? "desc" : "asc")" class="text-decoration-none text-dark d-inline-flex align-items-center">
                                        Status @(sort == "status" ? (dir == "asc" ? "▲" : "▼") : "")
                                    </a>
                                </th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">#@r.RefundID</td>
                                    <td>
                                        <div class="fw-semibold text-primary">#@r.BookingID</div>
                                        <small class="text-muted">@(r.PropertyTitle ?? "Stay")</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@(r.ClientName ?? "Guest")</div>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width: 140px;">@(r.ClientEmail ?? "")</small>
                                    </td>
                                    <td>₹@r.GrossBookingAmount.ToString("N2")</td>
                                    <td class="text-muted">₹@r.GatewayFeeDeducted.ToString("N2")</td>
                                    <td class="text-muted">₹@r.CancellationFeeDeducted.ToString("N2")</td>
                                    <td>
                                        <span class="fw-bold text-success">₹@r.NetRefundAmount.ToString("N2")</span>
                                    </td>
                                    <td>
                                        @if (r.OwnerShareAmount > 0)
                                        {
                                            <span class="text-dark small">Payout: ₹@r.OwnerShareAmount.ToString("N2")</span>
                                        }
                                        else if (r.ShortfallAmount > 0)
                                        {
                                            <span class="text-danger small fw-bold">Penalty: ₹@r.ShortfallAmount.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">₹0.00</span>
                                        }
                                    </td>
                                    <td>
                                        @if (r.RuleApplied.HasValue)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                Rule #@r.RuleApplied
                                                @if (r.RuleApplied == 1) { <span class="ms-1 text-success">&gt;72h</span> }
                                                else if (r.RuleApplied == 2) { <span class="ms-1 text-warning">24-72h</span> }
                                                else if (r.RuleApplied == 3) { <span class="ms-1 text-danger">&lt;24h</span> }
                                                else if (r.RuleApplied == 4) { <span class="ms-1 text-danger">Host Cancel</span> }
                                                else if (r.RuleApplied == 5) { <span class="ms-1 text-primary">Mismatch</span> }
                                                else if (r.RuleApplied == 6) { <span class="ms-1 text-secondary">Force Majeure</span> }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Manual</span>
                                        }
                                    </td>
                                    <td>
                                        @if (r.Status == "Pending" || r.Status == "Initiated")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pending</span>
                                        }
                                        else if (r.Status == "Approved")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check me-1"></i>Approved</span>
                                        }
                                        else if (r.Status == "Processed" || r.Status == "Completed")
                                        {
                                            <span class="badge bg-info text-dark"><i class="bi bi-check-all me-1"></i>Processed</span>
                                        }
                                        else if (r.Status == "Rejected" || r.Status == "Failed")
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x me-1"></i>Rejected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@r.Status</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            @if (r.RuleApplied == 5 || r.RuleApplied == 6)
                                            {
                                                <button type="button" class="btn btn-sm btn-warning text-dark fw-bold btn-adjudicate"
                                                        data-bs-toggle="modal" data-bs-target="#adjudicateModal"
                                                        data-refund-id="@r.RefundID"
                                                        data-booking-id="@r.BookingID"
                                                        data-amount="@r.NetRefundAmount.ToString("N2")"
                                                        data-gross="@r.GrossBookingAmount.ToString("N2")"
                                                        data-rule="@r.RuleApplied"
                                                        data-reason="@(r.RefundReason ?? "")">
                                                    <i class="bi bi-shield-check me-1"></i>Adjudicate
                                                </button>
                                            }
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-override"
                                                    data-bs-toggle="modal" data-bs-target="#overrideModal"
                                                    data-refund-id="@r.RefundID"
                                                    data-booking-id="@r.BookingID"
                                                    data-amount="@r.NetRefundAmount.ToString("N2")">
                                                <i class="bi bi-sliders"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                @if (totalPages > 1)
                {
                    <div class="card-footer bg-white border-top d-flex flex-wrap justify-content-between align-items-center py-3 px-4">
                        <div class="small text-muted">
                            Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, totalCount)) of @totalCount refund records
                        </div>
                        <nav aria-label="Refunds pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                    <a class="page-link" asp-controller="@controllerName" asp-action="RefundsQueue" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-sort="@sort" asp-route-dir="@dir" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize">Previous</a>
                                </li>
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                                    {
                                        <li class="page-item @(i == currentPage ? "active" : "")">
                                            <a class="page-link" asp-controller="@controllerName" asp-action="RefundsQueue" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-sort="@sort" asp-route-dir="@dir" asp-route-page="@i" asp-route-pageSize="@pageSize">@i</a>
                                        </li>
                                    }
                                    else if (i == currentPage - 3 || i == currentPage + 3)
                                    {
                                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                    }
                                }
                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    <a class="page-link" asp-controller="@controllerName" asp-action="RefundsQueue" asp-route-status="@selectedStatus" asp-route-search="@search" asp-route-sort="@sort" asp-route-dir="@dir" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="p-5 text-center">
                    <div class="empty-state-box py-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-circle p-4 mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-arrow-counterclockwise fs-1"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">No Refund Operations Found</h4>
                        <p class="text-muted small mb-3" style="max-width: 420px; margin: 0 auto;">
                            There are currently no cancellation or refund tickets matching your selected criteria. All guest refund requests are up to date.
                        </p>
                        <a asp-controller="@controllerName" asp-action="RefundsQueue" class="btn btn-outline-success rounded-pill px-4 py-2 fw-semibold">
                            <i class="bi bi-arrow-clockwise me-1"></i>Reset Filters &amp; Refresh Queue
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Override Modal -->
<div class="modal fade" id="overrideModal" tabindex="-1" aria-labelledby="overrideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="overrideModalLabel"><i class="bi bi-sliders me-2"></i>Refund Operations Override</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="@controllerName" asp-action="OverrideRefund" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalRefundId" name="refundId" />

                <div class="modal-body p-4">
                    <div class="p-3 bg-light rounded-3 mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Refund Request:</span>
                            <span class="fw-bold" id="modalRefundTitle">#</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Refund Amount:</span>
                            <span class="fw-bold text-success fs-6" id="modalRefundAmount">₹0.00</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Action / Status Update <span class="text-danger">*</span></label>
                        <select name="status" class="form-select rounded-3" required>
                            <option value="Approved">Approve Refund (Queue for Gateway Payout)</option>
                            <option value="Processed">Mark Processed (Confirmed by Gateway)</option>
                            <option value="Rejected">Reject Refund (Policy Ineligible)</option>
                            <option value="Pending">Revert to Pending</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Operational Audit Notes</label>
                        <textarea name="notes" class="form-control rounded-3" rows="3" placeholder="Document reason for override or transaction reference..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Confirm Override</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Adjudication Modal for Scenario 5 & 6 Review -->
<div class="modal fade" id="adjudicateModal" tabindex="-1" aria-labelledby="adjudicateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-warning text-dark rounded-top-4">
                <h5 class="modal-title fw-bold" id="adjudicateModalLabel"><i class="bi bi-shield-check me-2"></i>Admin Refund Adjudication (Scenarios 5 &amp; 6)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="@controllerName" asp-action="AdjudicateRefund" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="adjRefundId" name="refundId" />

                <div class="modal-body p-4">
                    <div class="p-3 bg-light rounded-3 mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Target Record:</span>
                            <span class="fw-bold" id="adjRefundTitle">#</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Gross Booking Amount:</span>
                            <span class="fw-bold text-dark" id="adjGrossAmount">₹0.00</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Applicable Policy Rule:</span>
                            <span class="badge bg-primary-subtle text-primary border" id="adjPolicyRule">Rule #5</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Adjudication Decision <span class="text-danger">*</span></label>
                        <select name="action" class="form-select rounded-3" required>
                            <option value="Approve">Approve Refund (Process Gateway Refund / Deduct Host)</option>
                            <option value="Reject">Reject Dispute (No Money Disbursed)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Approved Refund Amount (₹) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0" class="form-control rounded-3" id="adjRefundAmount" name="refundAmount" required />
                        <div class="form-text">For Row 5 (Listing Mismatch), enter approved customer refund (owner absorbs cost). For Row 6, full refund or credit.</div>
                    </div>

                    <div class="mb-3 form-check" id="adjCreditOption" style="display: none;">
                        <input type="checkbox" class="form-check-input" id="adjIssueCredit" name="issueAsCredit" value="true" />
                        <label class="form-check-label fw-semibold small" for="adjIssueCredit">Issue as Platform Booking Credit (Force Majeure)</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mandatory Adjudication Reason <span class="text-danger">*</span></label>
                        <textarea name="reason" id="adjReason" class="form-control rounded-3" rows="3" placeholder="Provide detailed findings and justification for guest and host..." required minlength="5"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark rounded-pill px-4 fw-bold">Submit Adjudication</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll(".btn-adjudicate").forEach(btn => {
        btn.addEventListener("click", function () {
            const id = this.getAttribute("data-refund-id");
            const bId = this.getAttribute("data-booking-id");
            const amt = this.getAttribute("data-amount");
            const gross = this.getAttribute("data-gross");
            const rule = this.getAttribute("data-rule");
            const rsn = this.getAttribute("data-reason");

            document.getElementById("adjRefundId").value = id;
            document.getElementById("adjRefundTitle").textContent = `Refund #${id} (Booking #${bId})`;
            document.getElementById("adjGrossAmount").textContent = `₹${gross}`;
            document.getElementById("adjRefundAmount").value = amt.replace(/,/g, '');
            document.getElementById("adjPolicyRule").textContent = `Rule #${rule} (${rule == 5 ? 'Listing Mismatch' : (rule == 6 ? 'Force Majeure' : 'Customer')})`;
            if (rsn) document.getElementById("adjReason").value = rsn;

            const creditOption = document.getElementById("adjCreditOption");
            if (rule == 6) {
                creditOption.style.display = 'block';
            } else {
                creditOption.style.display = 'none';
            }
        });
    });

    document.querySelectorAll(".btn-override").forEach(btn => {
        btn.addEventListener("click", function () {
            const id = this.getAttribute("data-refund-id");
            const bId = this.getAttribute("data-booking-id");
            const amt = this.getAttribute("data-amount");

            document.getElementById("modalRefundId").value = id;
            document.getElementById("modalRefundTitle").textContent = `Refund #${id} (Booking #${bId})`;
            document.getElementById("modalRefundAmount").textContent = `₹${amt}`;
        });
    });
</script>
}
