@model BookMyFun.Models.ViewModels.AdminSubscriptionPlansViewModel
@{
    ViewData["Title"] = "Subscription Plans";
}

<div class="dash-page-header mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <p class="dash-eyebrow">Platform Administration · Monetization &amp; Plans</p>
            <h1 class="dash-title">Subscription Plans</h1>
            <p class="dash-subtitle">Configure listing plans for property owners and manage complimentary access.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#modalGrantPlan">
                <i class="bi bi-gift-fill me-1"></i> Grant Plan
            </button>
            <button type="button" class="btn btn-primary rounded-pill px-3.5 py-2 fw-semibold shadow-xs" data-bs-toggle="modal" data-bs-target="#modalCreatePlan">
                <i class="bi bi-plus-lg me-1"></i> Create Plan
            </button>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Term Guarantee Notice Banner -->
<div class="alert alert-info border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center gap-3">
    <div class="rounded-circle bg-info bg-opacity-25 p-2 text-info flex-shrink-0">
        <i class="bi bi-shield-check fs-4"></i>
    </div>
    <div>
        <h6 class="fw-bold mb-1 text-dark">Plan Term Protection</h6>
        <div class="small text-muted">
            Changes apply to new purchases only. Existing subscriptions keep their current terms.
        </div>
    </div>
</div>

<!-- Plans Table Card -->
<div class="card border-0 shadow-sm rounded-4 bg-card overflow-hidden mb-5">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-award text-primary me-2"></i>All Subscription Plans (@Model.Plans.Count)
        </h5>
        <span class="badge bg-light text-dark border">@Model.Plans.Count(p => p.IsActive) Active</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Plan Name</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Duration</th>
                    <th>Listing Limit</th>
                    <th>Status</th>
                    <th>Subscribed Owners</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Plans.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No subscription plans configured yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var plan in Model.Plans)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@plan.PlanName</div>
                                @if (!string.IsNullOrWhiteSpace(plan.Description))
                                {
                                    <small class="text-muted d-block text-truncate" style="max-width: 250px;" title="@plan.Description">@plan.Description</small>
                                }
                            </td>
                            <td>
                                @if (string.Equals(plan.PlanType, "Trial", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-2.5 py-1">Trial</span>
                                }
                                else if (string.Equals(plan.PlanType, "AdminGranted", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-purple-subtle text-dark border rounded-pill px-2.5 py-1" style="background-color: #f3e8ff;">Admin-granted</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1">Paid</span>
                                }
                            </td>
                            <td>
                                @if (plan.Price == 0)
                                {
                                    <span class="fw-bold text-success">Free</span>
                                }
                                else
                                {
                                    <span class="fw-bold text-dark">₹@plan.Price.ToString("N0")</span>
                                }
                            </td>
                            <td>
                                <span class="fw-semibold">@plan.DurationInDays</span> <span class="text-muted small">days</span>
                            </td>
                            <td>
                                <span class="fw-semibold">@plan.MaxListings</span> <span class="text-muted small">listing@(plan.MaxListings > 1 ? "s" : "")</span>
                            </td>
                            <td>
                                @if (plan.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2.5 py-1">
                                        <i class="bi bi-dash-circle me-1"></i>Inactive
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2.5 py-1 rounded-pill">
                                    <i class="bi bi-people me-1"></i>@plan.OwnerCount owners
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1.5 align-items-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1"
                                            data-bs-toggle="modal" data-bs-target="#modalEditPlan_@plan.PlanID" title="Edit Plan Terms">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </button>
                                    @if (plan.IsActive)
                                    {
                                        <form asp-action="DeactivateSubscriptionPlan" method="post" class="d-inline" onsubmit="return confirm('Deactivate @plan.PlanName? It will remain in existing owner histories, but cannot be purchased.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="planId" value="@plan.PlanID" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2.5 py-1" title="Deactivate Plan">
                                                <i class="bi bi-slash-circle me-1"></i>Deactivate
                                            </button>
                                        </form>
                                    }
                                </div>

                                <!-- Modal: Edit Plan -->
                                <div class="modal fade" id="modalEditPlan_@plan.PlanID" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered text-start">
                                        <div class="modal-content border-0 shadow-lg rounded-4">
                                            <div class="modal-header border-bottom py-3">
                                                <h5 class="modal-title fw-bold mb-0">
                                                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Plan — @plan.PlanName
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form asp-action="SaveSubscriptionPlan" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="PlanID" value="@plan.PlanID" />
                                                <div class="modal-body p-4">
                                                    <div class="alert alert-info border-0 rounded-3 small mb-3">
                                                        <i class="bi bi-info-circle-fill me-1"></i> Changes apply to new purchases only. Existing subscriptions keep their current terms.
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold text-dark">Plan Name <span class="text-danger">*</span></label>
                                                        <input type="text" name="PlanName" class="form-control" value="@plan.PlanName" required maxlength="100" />
                                                    </div>
                                                    <div class="row g-3 mb-3">
                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-semibold text-dark">Plan Type <span class="text-danger">*</span></label>
                                                            <select name="PlanType" class="form-select">
                                                                <!option value="Paid" @(string.Equals(plan.PlanType, "Paid", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Paid</!option>
                                                                <!option value="Trial" @(string.Equals(plan.PlanType, "Trial", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>Trial</!option>
                                                                <!option value="AdminGranted" @(string.Equals(plan.PlanType, "AdminGranted", StringComparison.OrdinalIgnoreCase) ? "selected" : "")>AdminGranted</!option>
                                                            </select>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-semibold text-dark">Price (₹) <span class="text-danger">*</span></label>
                                                            <div class="input-group">
                                                                <span class="input-group-text bg-light">₹</span>
                                                                <input type="number" step="0.01" min="0" max="1000000" name="Price" class="form-control" value="@plan.Price" required />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row g-3 mb-3">
                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-semibold text-dark">Duration (Days) <span class="text-danger">*</span></label>
                                                            <input type="number" min="1" max="730" name="DurationInDays" class="form-control" value="@plan.DurationInDays" required />
                                                            <small class="text-muted">1 to 730 days</small>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <label class="form-label small fw-semibold text-dark">Listing Limit <span class="text-danger">*</span></label>
                                                            <input type="number" min="1" max="50" name="MaxListings" class="form-control" value="@plan.MaxListings" required />
                                                            <small class="text-muted">1 to 50 listings</small>
                                                        </div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold text-dark">Description</label>
                                                        <textarea name="Description" class="form-control" rows="2" maxlength="500">@plan.Description</textarea>
                                                    </div>
                                                    <div class="form-check form-switch">
                                                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editActive_@plan.PlanID" @(plan.IsActive ? "checked" : "") />
                                                        <label class="form-check-label small fw-semibold text-dark" for="editActive_@plan.PlanID">Plan is Active for new purchases</label>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-top py-2.5 bg-light">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold">Save Changes</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Create New Plan -->
<div class="modal fade" id="modalCreatePlan" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered text-start">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold mb-0">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Create New Subscription Plan
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveSubscriptionPlan" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="PlanID" value="0" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Plan Name <span class="text-danger">*</span></label>
                        <input type="text" name="PlanName" class="form-control" placeholder="e.g. Plan 999" required maxlength="100" />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Plan Type <span class="text-danger">*</span></label>
                            <select name="PlanType" class="form-select">
                                <option value="Paid" selected>Paid</option>
                                <option value="Trial">Trial</option>
                                <option value="AdminGranted">AdminGranted</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Price (₹) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₹</span>
                                <input type="number" step="0.01" min="0" max="1000000" name="Price" class="form-control" value="0" required />
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Duration (Days) <span class="text-danger">*</span></label>
                            <input type="number" min="1" max="730" name="DurationInDays" class="form-control" value="60" required />
                            <small class="text-muted">1 to 730 days</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Listing Limit <span class="text-danger">*</span></label>
                            <input type="number" min="1" max="50" name="MaxListings" class="form-control" value="3" required />
                            <small class="text-muted">1 to 50 listings</small>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Description</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Brief plan details or benefits" maxlength="500"></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="createActive" checked />
                        <label class="form-check-label small fw-semibold text-dark" for="createActive">Active immediately for purchases</label>
                    </div>
                </div>
                <div class="modal-footer border-top py-2.5 bg-light">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold">Create Plan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Grant Plan to Owner -->
<div class="modal fade" id="modalGrantPlan" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered text-start">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold mb-0">
                    <i class="bi bi-gift-fill text-primary me-2"></i>Grant Plan to Property Owner
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="GrantSubscriptionPlan" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="alert alert-secondary border-0 rounded-3 small mb-3">
                        <i class="bi bi-info-circle-fill me-1"></i> Creates an admin-granted subscription with no payment required. Overrides apply to this one grant only.
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Select Property Owner <span class="text-danger">*</span></label>
                        <select name="OwnerID" class="form-select" required>
                            <option value="">-- Choose an Owner --</option>
                            @foreach (var owner in Model.Owners)
                            {
                                <option value="@owner.UserID">@owner.FullName (@owner.Email)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Select Base Plan <span class="text-danger">*</span></label>
                        <select name="PlanID" class="form-select" required id="grantPlanSelect">
                            <option value="">-- Choose a Plan --</option>
                            @foreach (var plan in Model.Plans)
                            {
                                <option value="@plan.PlanID" data-duration="@plan.DurationInDays" data-limit="@plan.MaxListings">
                                    @plan.PlanName (@plan.DurationInDays days, limit: @plan.MaxListings)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Start Date <span class="text-danger">*</span></label>
                            <input type="date" name="StartDate" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Explicit End Date (Optional)</label>
                            <input type="date" name="EndDate" class="form-control" />
                            <small class="text-muted">Overrides calculated duration</small>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Override Duration (Days)</label>
                            <input type="number" min="1" max="730" name="OverrideDurationDays" class="form-control" placeholder="Default from plan" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-dark">Override Listing Limit</label>
                            <input type="number" min="1" max="50" name="OverrideMaxListings" class="form-control" placeholder="Default from plan" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Reason for Grant <span class="text-danger">*</span></label>
                        <textarea name="GrantReason" class="form-control" rows="2" placeholder="e.g. VIP Host Complimentary Onboarding, Promotional waiver, etc." required maxlength="300"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top py-2.5 bg-light">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold">Grant Plan Now</button>
                </div>
            </form>
        </div>
    </div>
</div>
