@model IEnumerable<BookMyFun.Models.Entities.ClientIdVerification>
@{
    var isEmployee = User.IsInRole("Employee");
    var controllerName = isEmployee ? "Employee" : "Admin";
    ViewData["Title"] = "Client ID Verification & KYC Governance";
    var selectedStatus = ViewBag.SelectedStatus as string;
}

<div class="container-fluid py-4 px-lg-4">
    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-gradient text-white p-4" style="background: linear-gradient(135deg, #4338ca 0%, #312e81 100%);">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <span class="badge bg-white text-indigo px-3 py-2 rounded-pill fw-bold mb-2 text-primary">Trust & Safety Governance</span>
                <h2 class="fw-bold mb-1"><i class="bi bi-person-vcard-fill me-2"></i>Guest ID Verification (KYC) Queue</h2>
                <p class="mb-0 text-white-50">Private document storage with 15-minute cryptographically signed streaming tokens. Confidential from hosts.</p>
            </div>
            <a asp-controller="@controllerName" asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Filter Pills -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        <a asp-controller="@controllerName" asp-action="IdVerifications" class="btn rounded-pill px-3 @(string.IsNullOrEmpty(selectedStatus) ? "btn-primary" : "btn-light border")">
            All KYC Submissions
        </a>
        <a asp-controller="@controllerName" asp-action="IdVerifications" asp-route-status="PendingReview" class="btn rounded-pill px-3 @(selectedStatus == "PendingReview" ? "btn-warning text-dark fw-bold" : "btn-light border")">
            <i class="bi bi-clock-history me-1"></i> Pending Verification
        </a>
        <a asp-controller="@controllerName" asp-action="IdVerifications" asp-route-status="Verified" class="btn rounded-pill px-3 @(selectedStatus == "Verified" ? "btn-success fw-bold" : "btn-light border")">
            <i class="bi bi-patch-check-fill me-1"></i> Verified Guests
        </a>
        <a asp-controller="@controllerName" asp-action="IdVerifications" asp-route-status="Rejected" class="btn rounded-pill px-3 @(selectedStatus == "Rejected" ? "btn-danger fw-bold" : "btn-light border")">
            <i class="bi bi-x-circle me-1"></i> Rejected KYC
        </a>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">KYC #</th>
                                <th>Guest (User)</th>
                                <th>Document Type</th>
                                <th>Masked ID / Details</th>
                                <th>Secure Vault File</th>
                                <th>Status</th>
                                <th>Submitted Date</th>
                                <th class="pe-4 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model)
                            {
                                var badgeClass = v.VerificationStatus switch
                                {
                                    "PendingReview" => "bg-warning text-dark",
                                    "Verified" => "bg-success",
                                    "Rejected" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                <tr>
                                    <td class="ps-4 fw-bold">#@v.VerificationID</td>
                                    <td>
                                        <div class="fw-semibold">@v.ClientName</div>
                                        <span class="text-muted small">Guest #@v.ClientID</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-card-heading me-1"></i> @v.DocumentType
                                        </span>
                                    </td>
                                    <td class="font-monospace small text-muted">
                                        @(string.IsNullOrEmpty(v.MaskedIdentifier) ? "••••••••" : v.MaskedIdentifier)
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 btn-view-doc" data-key="@v.DocumentStorageKey">
                                            <i class="bi bi-shield-lock-fill me-1"></i> Open Signed Doc (15m)
                                        </button>
                                    </td>
                                    <td>
                                        <span class="badge @badgeClass px-3 py-2 rounded-pill">@v.VerificationStatus</span>
                                    </td>
                                    <td class="text-muted small">@v.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td class="pe-4 text-end">
                                        @if (v.VerificationStatus == "PendingReview")
                                        {
                                            <div class="btn-group">
                                                <form asp-controller="@controllerName" asp-action="ReviewIdVerification" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="verificationId" value="@v.VerificationID" />
                                                    <input type="hidden" name="action" value="Verified" />
                                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 me-1" onclick="return confirm('Verify this guest ID and assign Verified Guest badge?');">
                                                        <i class="bi bi-check-lg me-1"></i> Verify
                                                    </button>
                                                </form>
                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2 btn-reject-kyc"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#rejectKycModal"
                                                        data-id="@v.VerificationID"
                                                        data-name="@v.ClientName">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@v.RejectionReason</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-shield-check fs-1 text-success d-block mb-3"></i>
                    <h5 class="fw-bold text-secondary">No ID Verifications in this Queue</h5>
                    <p class="text-muted small mb-0">No verification submissions require review.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Reject KYC Modal -->
<div class="modal fade" id="rejectKycModal" tabindex="-1" aria-labelledby="rejectKycModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-danger text-white rounded-top-4">
                <h5 class="modal-title fw-bold" id="rejectKycModalLabel"><i class="bi bi-x-circle me-2"></i>Reject Guest Verification</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="@controllerName" asp-action="ReviewIdVerification" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="modalKycId" name="verificationId" />
                <input type="hidden" name="action" value="Rejected" />

                <div class="modal-body p-4">
                    <p class="text-muted">You are rejecting the ID verification for <strong id="modalKycGuest"></strong>.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason for Rejection <span class="text-danger">*</span></label>
                        <select name="reason" class="form-select rounded-3 mb-2" required>
                            <option value="Document blurry or illegible">Document blurry or illegible</option>
                            <option value="Expired government identification">Expired government identification</option>
                            <option value="Name on ID does not match profile">Name on ID does not match profile</option>
                            <option value="Unsupported document format">Unsupported document format</option>
                            <option value="Other / Suspected tampering">Other / Suspected tampering</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Reject Verification</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll(".btn-view-doc").forEach(btn => {
        btn.addEventListener("click", async function () {
            const key = this.getAttribute("data-key");
            const btnEl = this;
            btnEl.disabled = true;
            btnEl.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Signing Token...`;

            try {
                const res = await (await fetch(`/@controllerName/GetDocumentSignedUrl?storageKey=${encodeURIComponent(key)}`)).json();
                if (res.success && res.url) {
                    window.open(res.url, "_blank");
                } else {
                    alert("Could not generate secure signed URL for document.");
                }
            } catch {
                alert("Error requesting secure document stream.");
            }

            btnEl.disabled = false;
            btnEl.innerHTML = `<i class="bi bi-shield-lock-fill me-1"></i> Open Signed Doc (15m)`;
        });
    });

    document.querySelectorAll(".btn-reject-kyc").forEach(btn => {
        btn.addEventListener("click", function () {
            const id = this.getAttribute("data-id");
            const name = this.getAttribute("data-name");
            document.getElementById("modalKycId").value = id;
            document.getElementById("modalKycGuest").textContent = name;
        });
    });
</script>
}
