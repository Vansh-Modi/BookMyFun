@model BookMyFun.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "My Account Profile";
}

<div class="container py-4">
    <!-- Header Banner -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-gradient text-white p-4" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%) !important; color: #ffffff !important;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning text-dark fw-bold d-flex align-items-center justify-content-center shadow" style="width: 64px; height: 64px; font-size: 1.75rem;">
                    @(!string.IsNullOrEmpty(Model.FullName) ? Model.FullName.Substring(0, 1).ToUpper() : "U")
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <h2 class="fw-bold mb-0" style="color: #ffffff !important;">@Model.FullName</h2>
                        <span class="badge @(Model.Role switch {
                            "Admin" => "bg-danger",
                            "Employee" => "bg-info text-dark",
                            "Owner" => "bg-warning text-dark",
                            "EventManager" => "bg-primary",
                            _ => "bg-success"
                        }) px-3 py-1 rounded-pill fw-semibold">
                            @(Model.Role == "Client" ? "Traveler" : Model.Role)
                        </span>
                    </div>
                    <p class="mb-0 small" style="color: rgba(255, 255, 255, 0.85) !important;">
                        <span style="color: rgba(255, 255, 255, 0.85) !important;"><i class="bi bi-envelope me-1"></i> @Model.Email</span>
                        @if (!string.IsNullOrEmpty(Model.Phone))
                        {
                            <span class="ms-3" style="color: rgba(255, 255, 255, 0.85) !important;"><i class="bi bi-telephone me-1"></i> @Model.Phone</span>
                        }
                        <span class="ms-3" style="color: rgba(255, 255, 255, 0.85) !important;"><i class="bi bi-calendar3 me-1"></i> Member since @Model.CreatedAt.ToString("MMM yyyy")</span>
                    </p>
                </div>
            </div>
            <div>
                @if (Model.Role == "Client")
                {
                    <a asp-controller="Client" asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                        <i class="bi bi-compass me-1"></i> My Dashboard
                    </a>
                }
                else if (Model.Role == "Owner")
                {
                    <a asp-controller="Owner" asp-action="Index" class="btn btn-outline-warning text-warning rounded-pill px-4">
                        <i class="bi bi-speedometer2 me-1"></i> Host Dashboard
                    </a>
                }
                else if (Model.Role == "EventManager")
                {
                    <a asp-controller="EventManager" asp-action="Dashboard" class="btn btn-outline-warning text-warning rounded-pill px-4">
                        <i class="bi bi-palette2 me-1"></i> Event Dashboard
                    </a>
                }
                else if (Model.Role == "Employee")
                {
                    <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-info text-info rounded-pill px-4">
                        <i class="bi bi-speedometer2 me-1"></i> Operations Dashboard
                    </a>
                }
                else if (Model.Role == "Admin")
                {
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-danger text-danger rounded-pill px-4">
                        <i class="bi bi-shield-shaded me-1"></i> Admin Portal
                    </a>
                }
            </div>
        </div>
    </div>

    @if (TempData["PasswordError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["PasswordError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Role == "Client" && Model.KycStatus == "Rejected")
    {
        <!-- In-App Notification: Identity Verification (KYC) Rejection Notice -->
        <div class="alert alert-danger border-0 shadow-sm rounded-4 p-4 mb-4" role="alert">
            <div class="d-flex align-items-start gap-3">
                <div class="rounded-circle bg-danger text-white p-2 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                    <i class="bi bi-shield-x fs-4"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <h5 class="fw-bold text-danger mb-0"><i class="bi bi-bell-fill me-1"></i>Identity Verification Notice: Rejected</h5>
                        <span class="badge bg-danger text-white px-3 py-1 rounded-pill">Status: Rejected</span>
                    </div>
                    <p class="text-dark small mb-2">
                        Your submitted identity verification document was reviewed by compliance staff and could not be verified.
                    </p>
                    <div class="bg-white border border-danger-subtle rounded-3 p-3 mb-3">
                        <div class="small text-muted mb-1 fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">Rejection Reason</div>
                        <div class="text-danger fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.KycRejectionReason) ? "Submitted identification document was unclear, expired, or did not match registered traveler profile name." : Model.KycRejectionReason)
                        </div>
                    </div>
                    <div class="small text-muted mb-3">
                        <strong class="text-dark"><i class="bi bi-info-circle-fill me-1 text-primary"></i>Instructions to Resubmit:</strong>
                        <ol class="mb-2 ps-3 mt-1 text-dark">
                            <li>Ensure the document image is sharp, clear, and completely legible with all text and borders visible.</li>
                            <li>Verify that the document is non-expired and that the name matches your profile name (<strong>@Model.FullName</strong>).</li>
                            <li>Accepted government documents: Aadhaar Card, Passport, or Driver's License.</li>
                            <li>Resubmit your document using the panel below, or re-upload during your next reservation checkout.</li>
                        </ol>
                    </div>
                    <button type="button" class="btn btn-sm btn-danger rounded-pill px-3 fw-semibold" data-bs-toggle="collapse" data-bs-target="#kycResubmitCollapse" aria-expanded="false">
                        <i class="bi bi-upload me-1"></i> Resubmit Identity Document Now
                    </button>
                    <div class="collapse mt-3" id="kycResubmitCollapse">
                        <div class="card card-body border border-danger-subtle rounded-3 bg-white">
                            <form id="profileKycResubmitForm" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <div class="row g-2 align-items-end">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-semibold">Document Type</label>
                                        <select name="documentType" id="profileDocType" class="form-select form-select-sm" required>
                                            <option value="Aadhaar">Aadhaar Card</option>
                                            <option value="Passport">Passport</option>
                                            <option value="DrivingLicense">Driving License</option>
                                        </select>
                                    </div>
                                    <div class="col-md-5">
                                        <label class="form-label small fw-semibold">New ID File (PDF, PNG, JPG - max 6MB)</label>
                                        <input type="file" name="file" id="profileDocFile" class="form-control form-control-sm" accept=".pdf,.png,.jpg,.jpeg" required />
                                    </div>
                                    <div class="col-md-3">
                                        <button type="button" class="btn btn-sm btn-primary w-100 fw-semibold" onclick="resubmitKycDocument()">
                                            <i class="bi bi-cloud-arrow-up me-1"></i> Upload &amp; Resubmit
                                        </button>
                                    </div>
                                </div>
                                <div class="mt-3">
                                    <partial name="_PolicyConsentCheckbox" />
                                </div>
                                <div id="profileKycResubmitAlert" class="mt-2 small" style="display: none;"></div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: Personal Information & Account Overview -->
        <div class="col-lg-6">
            <!-- Edit Personal Profile Information -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Personal Information</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserID" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
                                <input asp-for="FullName" class="form-control rounded-3" required />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Contact Phone Number</label>
                                <input asp-for="Phone" class="form-control rounded-3" placeholder="+91 9876543210" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label fw-semibold small">Primary Email Address</label>
                                <input asp-for="Email" class="form-control rounded-3 bg-light" readonly />
                                <div class="form-text small">Email cannot be changed directly for security and cryptographic authentication auditability.</div>
                            </div>
                        </div>

                        <div class="text-end mt-4">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Account Summary & Status -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-person-badge text-primary me-2"></i>Account Overview</h5>
                
                <ul class="list-group list-group-flush small">
                    @if (Model.Role == "Admin")
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                            <span class="text-muted">Account ID:</span>
                            <code class="fw-bold text-dark">#@Model.UserID</code>
                        </li>
                    }
                    @if (Model.Role != "Client")
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                            <span class="text-muted">Role Scope:</span>
                            <span class="fw-semibold text-dark">@Model.Role Access</span>
                        </li>
                    }
                    @if (Model.Role == "Client")
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                            <span class="text-muted">Reservations Made:</span>
                            <span class="badge bg-primary rounded-pill">@Model.TotalBookingsCount</span>
                        </li>
                        @if (Model.KycStatus == "Rejected")
                        {
                            <li class="list-group-item px-0 py-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-muted">Identity (KYC) Status:</span>
                                    <span class="badge bg-danger px-3 py-1 rounded-pill"><i class="bi bi-x-circle-fill me-1"></i>Rejected</span>
                                </div>
                                <div class="p-2 rounded-3 bg-danger-subtle border border-danger-subtle mt-1 small">
                                    <div class="fw-semibold text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Rejection Reason:</div>
                                    <div class="text-dark mb-1">@(string.IsNullOrWhiteSpace(Model.KycRejectionReason) ? "Document could not be verified by compliance staff." : Model.KycRejectionReason)</div>
                                    <div class="text-muted" style="font-size: 0.8rem;">
                                        <strong>Instructions to resubmit:</strong> Upload a clear, valid government ID matching your profile name during checkout or via the resubmit panel above.
                                    </div>
                                </div>
                            </li>
                        }
                    }
                    else if (Model.Role == "Owner")
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                            <span class="text-muted">Active Properties:</span>
                            <span class="badge bg-success rounded-pill">@Model.TotalPropertiesCount Listed</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                            <span class="text-muted">Total Guest Orders:</span>
                            <span class="badge bg-primary rounded-pill">@Model.TotalBookingsCount</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                            <span class="text-muted">Host Tier:</span>
                            <span class="badge bg-warning text-dark">@(Model.SubscriptionTier ?? "Complimentary")</span>
                        </li>
                    }
                    else if (Model.Role == "EventManager")
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                            <span class="text-muted">Role Description:</span>
                            <span class="badge bg-primary">Event Decor &amp; Celebration Manager</span>
                        </li>
                    }
                    else
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                            <span class="text-muted">Security Clearance:</span>
                            <span class="badge bg-danger">Staff Management Authorized</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Right Column: Security & Password & Quick Actions -->
        <div class="col-lg-6">
            <!-- Change Password & Security -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-shield-lock text-danger me-2"></i>Security &amp; Password</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label fw-semibold small">Current Password <span class="text-danger">*</span></label>
                                <input type="password" name="CurrentPassword" class="form-control rounded-3" required autocomplete="current-password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">New Password (Min 6 Characters) <span class="text-danger">*</span></label>
                                <input type="password" name="NewPassword" class="form-control rounded-3" required minlength="6" autocomplete="new-password" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Confirm New Password <span class="text-danger">*</span></label>
                                <input type="password" name="ConfirmPassword" class="form-control rounded-3" required minlength="6" autocomplete="new-password" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="ForgotPassword" asp-controller="Account" class="btn btn-outline-secondary rounded-pill px-3 fw-medium btn-sm">
                                <i class="bi bi-question-circle me-1"></i> Forgot Password?
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold shadow-sm">
                                <i class="bi bi-key-fill me-1"></i> Update Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Quick Access Navigation -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-grid-fill text-warning me-2"></i>Quick Actions &amp; Shortcuts</h5>
                <div class="d-grid gap-2">
                    @if (Model.Role == "Client")
                    {
                        <a asp-controller="Properties" asp-action="Index" class="btn btn-outline-primary rounded-3 text-start p-2.5">
                            <i class="bi bi-search me-2"></i> Browse Farmhouse Rentals
                        </a>
                        <a asp-controller="Client" asp-action="Index" class="btn btn-outline-secondary rounded-3 text-start p-2.5">
                            <i class="bi bi-calendar-check me-2"></i> View My Reservations
                        </a>
                    }
                    else if (Model.Role == "Owner")
                    {
                        <a asp-controller="Owner" asp-action="CreateProperty" class="btn btn-outline-success rounded-3 text-start p-2.5">
                            <i class="bi bi-plus-circle me-2"></i> Add New Property Listing
                        </a>
                        <a asp-controller="Owner" asp-action="DamageClaims" class="btn btn-outline-danger rounded-3 text-start p-2.5">
                            <i class="bi bi-shield-exclamation me-2"></i> File Damage Claims
                        </a>
                        <a asp-controller="Owner" asp-action="Subscriptions" class="btn btn-outline-primary rounded-3 text-start p-2.5">
                            <i class="bi bi-gem me-2"></i> Upgrade Subscription
                        </a>
                    }
                    else if (Model.Role == "EventManager")
                    {
                        <a asp-controller="EventManager" asp-action="Dashboard" class="btn btn-outline-warning text-dark rounded-3 text-start p-2.5">
                            <i class="bi bi-palette2 me-2"></i> Decor Packages &amp; Orders
                        </a>
                    }
                    else if (Model.Role == "Employee" || Model.Role == "Admin")
                    {
                        var controller = Model.Role == "Admin" ? "Admin" : "Employee";
                        <a asp-controller="@controller" asp-action="ManageProperties" class="btn btn-outline-primary rounded-3 text-start p-2.5">
                            <i class="bi bi-houses me-2"></i> Manage All Properties
                        </a>
                        <a asp-controller="@controller" asp-action="ManageOwners" class="btn btn-outline-success rounded-3 text-start p-2.5">
                            <i class="bi bi-people me-2"></i> Manage Hosts &amp; Tiers
                        </a>
                        @if (Model.Role == "Admin")
                        {
                            <a asp-controller="Admin" asp-action="ManageEmployees" class="btn btn-outline-secondary rounded-3 text-start p-2.5">
                                <i class="bi bi-person-workspace me-2"></i> Manage Staff &amp; Employees
                            </a>
                        }
                        <a asp-controller="@controller" asp-action="RefundsQueue" class="btn btn-outline-info text-dark rounded-3 text-start p-2.5">
                            <i class="bi bi-arrow-counterclockwise me-2"></i> Refund Operations
                        </a>
                    }
                </div>
            </div>
            <!-- Notification Preferences -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-bell-fill text-warning me-2"></i>Notification Preferences</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-column gap-3">
                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0">
                            <div>
                                <label class="form-check-label fw-semibold text-dark d-block" for="notifBooking">Booking Confirmations &amp; Receipts</label>
                                <span class="text-muted small">Receive instant transactional emails and invoices for stays.</span>
                            </div>
                            <input class="form-check-input ms-auto" type="checkbox" id="notifBooking" checked />
                        </div>
                        <hr class="my-1 border-light-subtle" />
                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0">
                            <div>
                                <label class="form-check-label fw-semibold text-dark d-block" for="notifWhatsapp">WhatsApp Check-in Alerts</label>
                                <span class="text-muted small">Receive gate pass, caretaker phone &amp; direct GPS maps on WhatsApp.</span>
                            </div>
                            <input class="form-check-input ms-auto" type="checkbox" id="notifWhatsapp" checked />
                        </div>
                        <hr class="my-1 border-light-subtle" />
                        <div class="form-check form-switch d-flex justify-content-between align-items-center ps-0">
                            <div>
                                <label class="form-check-label fw-semibold text-dark d-block" for="notifOffers">Exclusive Promotions &amp; Discounts</label>
                                <span class="text-muted small">Get member-only weekend retreat discounts and festive offers.</span>
                            </div>
                            <input class="form-check-input ms-auto" type="checkbox" id="notifOffers" />
                        </div>
                    </div>
                    <div class="text-end mt-3">
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" onclick="alert('Notification preferences updated successfully.')">
                            <i class="bi bi-check2 me-1"></i> Save Preferences
                        </button>
                    </div>
                </div>
            </div>

            <!-- Saved Payment & ID Verification Summary -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white py-3 border-bottom border-light-subtle">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-shield-check text-success me-2"></i>Saved Payment &amp; ID Details</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light border mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-white shadow-xs p-2 text-primary d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                <i class="bi bi-person-vcard fs-5"></i>
                            </div>
                            <div>
                                <strong class="d-block text-dark small">Government Identity (KYC)</strong>
                                <span class="text-muted small">Status: <strong>@(Model.Role == "Client" ? (Model.KycStatus ?? "Not Submitted") : "Verified Host")</strong></span>
                            </div>
                        </div>
                        <span class="badge @(Model.KycVerifiedAt.HasValue || Model.Role != "Client" ? "bg-success" : (Model.KycStatus == "Rejected" ? "bg-danger" : "bg-warning text-dark")) rounded-pill px-3 py-1.5">
                            @(Model.Role != "Client" ? "Verified" : (Model.KycStatus ?? "Pending"))
                        </span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light border">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-white shadow-xs p-2 text-success d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                <i class="bi bi-credit-card-2-front fs-5"></i>
                            </div>
                            <div>
                                <strong class="d-block text-dark small">Payment Methods &amp; Gateway</strong>
                                <span class="text-muted small">Razorpay Secure Tokenization (UPI, NetBanking, Cards)</span>
                            </div>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5">PCI-DSS Active</span>
                    </div>
                </div>
            </div>

            <!-- Account Session & Logout -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-danger-subtle bg-opacity-25 border border-danger-subtle">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h6 class="fw-bold text-danger mb-1"><i class="bi bi-box-arrow-right me-1"></i>Account Session</h6>
                        <p class="text-muted small mb-0">Sign out of your active BookMyFun session across this device.</p>
                    </div>
                    <button type="button" class="btn btn-outline-danger rounded-pill px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#logoutConfirmModal">
                        <i class="bi bi-box-arrow-right me-1"></i> Log Out
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function resubmitKycDocument() {
        const fileInput = document.getElementById('profileDocFile');
        const docTypeSelect = document.getElementById('profileDocType');
        const alertDiv = document.getElementById('profileKycResubmitAlert');
        if (!fileInput || !fileInput.files || fileInput.files.length === 0) {
            alertDiv.className = 'mt-2 alert alert-warning py-1 px-2';
            alertDiv.textContent = 'Please choose an identification file to upload.';
            alertDiv.style.display = 'block';
            return;
        }

        const consentCheck = document.querySelector('#profileKycResubmitForm input[name="PolicyConsent"]:checked');
        if (!consentCheck) {
            alertDiv.className = 'mt-2 alert alert-warning py-1 px-2';
            alertDiv.textContent = 'You must agree to the Terms of Service, Privacy Policy, and Refund Policy before submitting your identification document.';
            alertDiv.style.display = 'block';
            return;
        }

        const formData = new FormData();
        formData.append('file', fileInput.files[0]);
        formData.append('documentType', docTypeSelect.value);
        formData.append('PolicyConsent', 'true');

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        alertDiv.className = 'mt-2 alert alert-info py-1 px-2';
        alertDiv.textContent = 'Uploading and submitting document securely...';
        alertDiv.style.display = 'block';

        try {
            const resp = await fetch('/Media/upload-id-document', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: formData
            });
            const data = await resp.json();
            if (data.success) {
                alertDiv.className = 'mt-2 alert alert-success py-1 px-2';
                alertDiv.textContent = 'Document successfully resubmitted. Refreshing page...';
                setTimeout(() => window.location.reload(), 1500);
            } else {
                alertDiv.className = 'mt-2 alert alert-danger py-1 px-2';
                alertDiv.textContent = data.message || 'Failed to submit document. Please try again.';
            }
        } catch (err) {
            alertDiv.className = 'mt-2 alert alert-danger py-1 px-2';
            alertDiv.textContent = 'Network error while submitting document. Please try again.';
        }
    }
</script>
}
