@model BookMyFun.Models.ViewModels.RegisterViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Register with OTP Verification";
    bool isGoogleLoginEnabled = Configuration.GetValue<bool>("GoogleLogin:Enabled", false);
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-lg border-0 p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="dash-stat-icon icon-blue mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <h3 class="fw-bold mb-1">Create Account</h3>
                <p class="text-muted small mb-0">Create your account to explore stays and manage bookings</p>
            </div>

            @if (isGoogleLoginEnabled)
            {
                <!-- Google One-Click Registration & Instant Login -->
                <div class="mb-4">
                    <a asp-controller="Account" asp-action="ExternalLogin" asp-route-provider="Google" 
                       class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2 rounded-3 shadow-sm social-auth-btn">
                        <svg width="20" height="20" viewBox="0 0 48 48">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                            <path fill="none" d="M0 0h48v48H0z"/>
                        </svg>
                        <span class="fw-semibold text-heading">Sign Up with Google</span>
                    </a>
                </div>

                <!-- Clean Divider -->
                <hr class="border-secondary opacity-25 my-4" />
            }

            <div>
                <form asp-action="Register" method="post" id="registerForm">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2">
                            @Html.ValidationSummary(true, "")
                            <span asp-validation-for="OtpCode" class="text-danger d-block"></span>
                            <span asp-validation-for="Email" class="text-danger d-block"></span>
                        </div>
                    }

                    <input type="hidden" asp-for="Role" value="Client" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="John Doe" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address (for OTP Verification)</label>
                        <div class="input-group">
                            <input asp-for="Email" id="emailInput" type="email" class="form-control" placeholder="name@example.com" required />
                            <button type="button" class="btn btn-outline-warning text-dark fw-bold" id="btnSendOtp" onclick="requestOtp()">
                                <i class="bi bi-send"></i> Send OTP
                            </button>
                        </div>
                        <!-- Alert notification container for success and error messages -->
                        <div id="otpStatus" class="mt-2" style="display: none;"></div>
                    </div>

                    <div class="mb-3" id="otpGroup">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0">Enter 6-Digit Verification OTP</label>
                            <!-- Visible Countdown Timer -->
                            <div id="otpTimerContainer" class="small fw-semibold text-danger d-none">
                                <i class="bi bi-clock-history me-1"></i>Expires in: <span id="countdownTimer">02:30</span>
                            </div>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key-fill text-warning"></i></span>
                            <input asp-for="OtpCode" id="otpCodeInput" class="form-control letter-spacing-2" placeholder="e.g. 123456" maxlength="6" required />
                            <!-- Resend OTP button when timer reaches zero -->
                            <button type="button" class="btn btn-outline-secondary d-none fw-semibold" id="btnResendOtp" onclick="requestOtp()">
                                <i class="bi bi-arrow-repeat"></i> Resend OTP
                            </button>
                        </div>
                        <div id="otpExpiryNotice" class="small text-danger fw-semibold mt-1 d-none">
                            <i class="bi bi-exclamation-circle-fill me-1"></i> OTP has expired. Please click "Resend OTP" to get a new code.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone Number</label>
                        <input asp-for="Phone" class="form-control" placeholder="+91 9876543210" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Password</label>
                        <input asp-for="Password" type="password" class="form-control" required />
                    </div>

                    <!-- Mandatory Legal & Compliance Consent (Item 3e) -->
                    <partial name="_PolicyConsentCheckbox" />

                    <div class="d-grid mb-3">
                        <button type="submit" id="btnSubmitRegister" class="btn btn-warning fw-bold py-2">
                            <i class="bi bi-check2-circle"></i> Verify & Create Account
                        </button>
                    </div>

                    <div class="text-center">
                        <span class="text-muted">Already have an account?</span>
                        <a asp-action="Login" class="text-primary text-decoration-none fw-semibold">Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let countdownInterval = null;
    const OTP_EXPIRY_SECONDS = 150;

    function formatTime(seconds) {
        const m = Math.floor(seconds / 60).toString().padStart(2, '0');
        const s = (seconds % 60).toString().padStart(2, '0');
        return `${m}:${s}`;
    }

    function startOtpCountdown(durationSeconds = OTP_EXPIRY_SECONDS) {
        clearInterval(countdownInterval);

        const timerContainer = document.getElementById('otpTimerContainer');
        const timerSpan = document.getElementById('countdownTimer');
        const submitBtn = document.getElementById('btnSubmitRegister');
        const resendBtn = document.getElementById('btnResendOtp');
        const expiryNotice = document.getElementById('otpExpiryNotice');
        const sendBtn = document.getElementById('btnSendOtp');

        if (timerContainer) timerContainer.classList.remove('d-none');
        if (expiryNotice) expiryNotice.classList.add('d-none');
        if (resendBtn) resendBtn.classList.add('d-none');
        if (submitBtn) submitBtn.disabled = false;
        if (sendBtn) sendBtn.disabled = true;

        let remaining = durationSeconds;
        if (timerSpan) timerSpan.textContent = formatTime(remaining);

        countdownInterval = setInterval(() => {
            remaining--;
            if (remaining > 0) {
                if (timerSpan) timerSpan.textContent = formatTime(remaining);
            } else {
                clearInterval(countdownInterval);
                if (timerSpan) timerSpan.textContent = "00:00";
                if (timerContainer) timerContainer.classList.add('d-none');
                if (expiryNotice) expiryNotice.classList.remove('d-none');

                // When timer reaches zero: disable verify button and show Resend OTP button
                if (submitBtn) submitBtn.disabled = true;
                if (resendBtn) resendBtn.classList.remove('d-none');
                if (sendBtn) {
                    sendBtn.disabled = false;
                    sendBtn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Resend OTP';
                }
            }
        }, 1000);
    }

    async function requestOtp() {
        const email = document.getElementById('emailInput').value.trim();
        const statusDiv = document.getElementById('otpStatus');
        const sendBtn = document.getElementById('btnSendOtp');
        const resendBtn = document.getElementById('btnResendOtp');
        const submitBtn = document.getElementById('btnSubmitRegister');

        if (!email) {
            statusDiv.style.display = 'block';
            statusDiv.innerHTML = `
                <div class="alert alert-danger alert-dismissible fade show shadow-sm py-2 px-3 mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Please enter your email address first.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
            return;
        }

        sendBtn.disabled = true;
        sendBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Sending...';
        if (resendBtn) {
            resendBtn.disabled = true;
            resendBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Resending...';
        }

        statusDiv.style.display = 'block';
        statusDiv.innerHTML = `
            <div class="alert alert-info py-2 px-3 mb-0" role="alert">
                <span class="spinner-border spinner-border-sm me-2"></span> Sending verification OTP...
            </div>`;

        try {
            const response = await fetch('/Account/SendOtp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ contact: email, purpose: 'Registration' })
            });

            let data;
            const text = await response.text();
            try {
                data = JSON.parse(text);
            } catch (parseErr) {
                data = { success: false, message: response.statusText || 'Unexpected server response format.' };
            }

            if (response.ok && data.success) {
                let devInfo = '';
                if (data.devOtp) {
                    devInfo = `<div class="mt-1 small text-dark fw-bold"><i class="bi bi-info-circle-fill text-warning me-1"></i> Development OTP: <code>${data.devOtp}</code> (Auto-filled below)</div>`;
                    const otpInput = document.getElementById('otpCodeInput');
                    if (otpInput) {
                        otpInput.value = data.devOtp;
                    }
                }

                // Prominent success notification
                statusDiv.innerHTML = `
                    <div class="alert alert-success alert-dismissible fade show shadow-sm py-2 px-3 mb-0" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> <strong>OTP Sent!</strong> ${data.message}
                        ${devInfo}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;

                const otpInput = document.getElementById('otpCodeInput');
                if (otpInput && !data.devOtp) {
                    otpInput.value = '';
                    otpInput.focus();
                }

                // Start 150-second countdown timer
                startOtpCountdown(data.expirySeconds || OTP_EXPIRY_SECONDS);
            } else {
                const errMsg = data.message || (data.error && data.error.message) || 'Unable to dispatch verification code.';
                statusDiv.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm py-2 px-3 mb-0" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> <strong>Failed to Send OTP:</strong> ${errMsg}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>`;
                sendBtn.disabled = false;
                sendBtn.innerHTML = '<i class="bi bi-send"></i> Send OTP';
            }
        } catch (err) {
            statusDiv.innerHTML = `
                <div class="alert alert-danger alert-dismissible fade show shadow-sm py-2 px-3 mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Failed to connect to server. Please try again.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>`;
            sendBtn.disabled = false;
            sendBtn.innerHTML = '<i class="bi bi-send"></i> Send OTP';
        } finally {
            if (resendBtn) {
                resendBtn.disabled = false;
                resendBtn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Resend OTP';
            }
        }
    }
</script>
}
