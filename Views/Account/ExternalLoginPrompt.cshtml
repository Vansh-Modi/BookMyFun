@model BookMyFun.Models.ViewModels.ExternalLoginPromptViewModel
@{
    ViewData["Title"] = "Sign in with " + Model.Provider;
    var activeEmail = !string.IsNullOrWhiteSpace(Model.ActiveProjectEmail) ? Model.ActiveProjectEmail : "showsgarage@gmail.com";
}

<div class="row justify-content-center my-4 my-md-5">
    <div class="col-11 col-sm-9 col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5 bg-card">
            <!-- Provider Brand Header -->
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm p-3" style="background: rgba(66, 133, 244, 0.1);">
                    <svg width="36" height="36" viewBox="0 0 48 48">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                        <path fill="none" d="M0 0h48v48H0z"/>
                    </svg>
                </div>
                <h3 class="fw-bold mb-1 text-heading">Google Account Sign-In</h3>
                <p class="text-muted small mb-0">Google OAuth is not currently configured for this environment</p>
            </div>

            <!-- Active Project Google Credentials Status Pill -->
            <div class="alert alert-light border d-flex align-items-center justify-content-between py-2 px-3 rounded-3 small mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check text-success fs-5"></i>
                    <div>
                        <div class="text-muted" style="font-size: 0.72rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Active Project Account</div>
                        <strong class="text-dark">@activeEmail</strong>
                    </div>
                </div>
                @if (Model.IsConfiguredInDatabase)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Configured</span>
                }
            </div>

            <!-- Notice: Direct login disabled / standard OAuth required -->
            <div class="alert alert-warning border d-flex align-items-center mb-4 py-3 px-3 rounded-3 shadow-sm">
                <i class="bi bi-shield-exclamation text-warning fs-3 me-3"></i>
                <div class="small">
                    <div class="fw-bold text-dark">Google Sign-In Pending Configuration</div>
                    <div class="text-muted">Standard Google OAuth credentials have not been configured for this environment. Please sign in using your email and password, or contact the site administrator.</div>
                </div>
            </div>

            <!-- Return to Standard Login Button -->
            <div class="d-grid mb-3">
                <a asp-action="Login" class="btn btn-primary btn-lg fw-bold rounded-3 shadow-sm py-2">
                    <i class="bi bi-box-arrow-in-left me-1"></i> Return to Sign In
                </a>
            </div>

            <!-- Admin Setup Guide Accordion/Card -->
            <div class="border rounded-3 p-3 bg-light mt-3 small">
                <div class="d-flex align-items-center justify-content-between cursor-pointer" data-bs-toggle="collapse" data-bs-target="#oauthConfigGuide" aria-expanded="false" style="cursor: pointer;">
                    <span class="fw-semibold text-heading"><i class="bi bi-gear-fill text-primary me-2"></i>Google OAuth Setup Guide</span>
                    <i class="bi bi-chevron-down text-muted"></i>
                </div>
                <div class="collapse mt-2 pt-2 border-top" id="oauthConfigGuide">
                    <p class="text-muted mb-2">
                        To enable live Google OAuth redirect across your domain, create an OAuth 2.0 Web Client in <a href="https://console.cloud.google.com/apis/credentials" target="_blank" class="text-primary text-decoration-none fw-semibold">Google Cloud Console</a> using active project email <strong class="text-dark">@activeEmail</strong>:
                    </p>
                    <ol class="ps-3 mb-2 text-muted">
                        <li>Set Authorized redirect URI to: <code class="text-warning">/signin-google</code></li>
                        <li>Add your Client ID &amp; Secret into <strong class="text-dark">Admin &rarr; Settings &rarr; Google OAuth</strong> or <code class="text-info">appsettings.json</code></li>
                    </ol>
                    <div class="p-2 rounded bg-dark text-white font-monospace small" style="font-size: 0.78rem;">
                        "Authentication": {<br />
                        &nbsp;&nbsp;"Google": {<br />
                        &nbsp;&nbsp;&nbsp;&nbsp;"ClientId": "YOUR_GOOGLE_CLIENT_ID",<br />
                        &nbsp;&nbsp;&nbsp;&nbsp;"ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET",<br />
                        &nbsp;&nbsp;&nbsp;&nbsp;"ProjectEmail": "@activeEmail"<br />
                        &nbsp;&nbsp;}<br />
                        }
                    </div>
                </div>
            </div>

            <!-- Back to standard login -->
            <div class="text-center mt-4">
                <a asp-action="Login" class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Standard Login
                </a>
            </div>
        </div>
    </div>
</div>


