@model BookMyFun.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center my-4">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-lg border-0 p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="dash-stat-icon icon-amber mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
                    <i class="bi bi-box-arrow-in-right"></i>
                </div>
                <h3 class="fw-bold mb-1">Welcome Back</h3>
                <p class="text-muted small mb-0">Sign in to manage your bookings and properties</p>
            </div>
            <div>
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2">
                            @Html.ValidationSummary(true, "")
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" required />
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold mb-0">Password</label>
                            <a asp-action="ForgotPassword" class="small text-decoration-none text-warning">Forgot password?</a>
                        </div>
                        <input asp-for="Password" type="password" class="form-control" required />
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-warning fw-bold py-2">Sign In</button>
                    </div>

                    <div class="text-center">
                        <span class="text-muted">Don't have an account?</span>
                        <a asp-action="Register" class="text-primary text-decoration-none fw-semibold">Register here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
