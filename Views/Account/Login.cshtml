@model BookMyFun.Models.ViewModels.LoginViewModel
@inject BookMyFun.Services.ISiteSettingsService SettingsService
@{
    ViewData["Title"] = "Sign In";
    var site = await SettingsService.GetSettingsAsync();
    var brandName = string.IsNullOrWhiteSpace(site?.SiteName) ? "BookMyFun" : site.SiteName;
    var logoUrl = site?.LogoUrl ?? "";
    var iconClass = string.IsNullOrWhiteSpace(site?.SiteIcon) ? "bi-house-heart-fill" : site.SiteIcon;
}

<div class="row justify-content-center my-4 my-md-5">
    <div class="col-11 col-sm-9 col-md-6 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5 bg-card">
            <!-- Brand / Logo Header -->
            <div class="text-center mb-4">
                <a asp-controller="Home" asp-action="Index" class="d-inline-flex flex-column align-items-center text-decoration-none mb-2">
                    @if (!string.IsNullOrEmpty(logoUrl))
                    {
                        <img src="@Url.Content(logoUrl)" alt="@brandName" style="height: 48px; max-width: 180px; object-fit: contain;" class="mb-2" />
                    }
                    else
                    {
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2 shadow-sm" style="width: 56px; height: 56px; background: rgba(217, 119, 6, 0.12); color: #d97706; font-size: 1.6rem;">
                            <i class="bi @iconClass"></i>
                        </div>
                    }
                    <h3 class="fw-bold mb-0 text-heading">@brandName</h3>
                </a>
                <p class="text-muted small mb-0">Sign in to your @brandName account or continue with Google</p>
            </div>

            <!-- Shared Google Identity Services Sign-In -->
            <partial name="_GoogleAuthButton" view-data='new ViewDataDictionary(ViewData) { { "IsSignUp", false }, { "ReturnUrl", Model?.ReturnUrl } }' />

            <form asp-action="Login" method="post" id="loginForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 rounded-3 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        @Html.ValidationSummary(true, "")
                    </div>
                }

                <!-- Email Field -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small text-muted">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input asp-for="Email" type="email" id="userEmail" class="form-control border-start-0 ps-0" placeholder="name@example.com" required autofocus autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Password Field -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label fw-semibold small text-muted mb-0">Password</label>
                        <a asp-action="ForgotPassword" class="small text-decoration-none text-warning fw-semibold">Forgot password?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                        <input asp-for="Password" id="userPassword" type="password" class="form-control border-start-0 border-end-0 ps-0" placeholder="••••••••" required />
                        <button class="btn btn-outline-light border border-start-0 text-muted" type="button" onclick="togglePasswordVisibility('userPassword', this)">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <!-- Remember Me -->
                <div class="mb-4 d-flex align-items-center">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                        <label class="form-check-label small text-muted" for="rememberMe">
                            Keep me signed in
                        </label>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="d-grid mb-4">
                    <button type="submit" id="btnLoginSubmit" class="btn btn-warning btn-lg fw-bold rounded-3 shadow-sm py-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </div>

                <!-- Bottom Links -->
                <div class="border-top pt-3 text-center">
                    <p class="text-muted small mb-2">
                        Don't have an account?
                        <a asp-action="Register" class="text-primary text-decoration-none fw-semibold">Register</a>
                    </p>
                    <p class="text-muted small mb-0">
                        Want to partner as a Farm Host or Event Manager?
                        <a asp-controller="Home" asp-action="Partner" class="text-success text-decoration-none fw-semibold">Partner With Us &rarr;</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        if (!input) return;
        const icon = btn.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            if (icon) icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            if (icon) icon.className = 'bi bi-eye';
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const loginForm = document.getElementById('loginForm');
        const submitBtn = document.getElementById('btnLoginSubmit');
        const emailInput = document.getElementById('userEmail');
        const passwordInput = document.getElementById('userPassword');

        function handleEnterKey(e) {
            if (e.key === 'Enter' || e.keyCode === 13) {
                e.preventDefault();
                if (submitBtn) {
                    submitBtn.click();
                } else if (loginForm) {
                    if (loginForm.requestSubmit) {
                        loginForm.requestSubmit();
                    } else {
                        loginForm.submit();
                    }
                }
            }
        }

        if (emailInput) {
            emailInput.addEventListener('keydown', handleEnterKey);
        }
        if (passwordInput) {
            passwordInput.addEventListener('keydown', handleEnterKey);
        }
    });
</script>
}
