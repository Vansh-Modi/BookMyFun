@model BookMyFun.Models.ViewModels.ActivateOwnerViewModel
@{
    ViewData["Title"] = "Set Partner Password";
    string? tokenError = ViewBag.TokenError as string;
    string? resendSuccess = ViewBag.ResendSuccess as string;
    string? prefillEmail = (ViewBag.PrefillEmail as string) ?? Model?.Email;
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="rounded-circle d-inline-flex p-3 mb-3 bg-success bg-opacity-10 text-success">
                    <i class="bi bi-shield-lock display-6"></i>
                </div>
                <h3 class="fw-bold mb-1 text-dark">Set Your Partner Password</h3>
                <p class="text-muted small mb-0">Choose a secure password to access your Nayesta Partner Dashboard</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(resendSuccess))
            {
                <div class="alert alert-success rounded-3" role="alert">
                    <i class="bi bi-envelope-check me-2"></i>@resendSuccess
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(tokenError))
            {
                <div class="alert alert-warning rounded-3 mb-4" role="alert">
                    <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Link Unavailable</div>
                    <div class="small">@tokenError</div>
                </div>

                <form action="/account/request-set-password-link" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="resendEmail" class="form-label fw-semibold">Registered Partner Email</label>
                        <input id="resendEmail" name="email" type="email" value="@prefillEmail" class="form-control" placeholder="Enter your registered email" required />
                    </div>
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-outline-success btn-lg fw-semibold rounded-3">
                            <i class="bi bi-send me-2"></i>Request New Setup Link
                        </button>
                    </div>
                </form>

                <div class="text-center mt-2">
                    <a asp-action="Login" class="text-decoration-none small text-muted">Back to Login</a>
                </div>
            }
            else if (string.IsNullOrWhiteSpace(resendSuccess))
            {
                <form action="/account/set-password" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                        <input asp-for="Email" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">New Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Minimum 6 characters" minlength="6" required autofocus />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" minlength="6" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-success btn-lg fw-bold rounded-3 shadow-sm" style="background-color: #059669; border-color: #059669;">
                            <i class="bi bi-check2-circle me-2"></i>Set Password &amp; Activate
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
