@model BookMyFun.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white p-3 text-center">
                <h4 class="mb-0 fw-bold"><i class="bi bi-key-fill text-warning"></i> Reset Your Password</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="ForgotPassword" method="post" id="forgotPasswordForm">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2">
                            @Html.ValidationSummary(true, "")
                            <span asp-validation-for="Email" class="text-danger d-block"></span>
                            <span asp-validation-for="OtpCode" class="text-danger d-block"></span>
                            <span asp-validation-for="NewPassword" class="text-danger d-block"></span>
                            <span asp-validation-for="ConfirmPassword" class="text-danger d-block"></span>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Registered Email Address</label>
                        <div class="input-group">
                            <input asp-for="Email" id="emailInput" type="email" class="form-control" placeholder="name@example.com" required />
                            <button type="button" class="btn btn-outline-warning text-dark fw-bold" id="btnSendOtp" onclick="requestResetOtp()">
                                <i class="bi bi-send"></i> Send OTP
                            </button>
                        </div>
                        <div id="otpStatus" class="form-text mt-1"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Enter 6-Digit OTP</label>
                        <input asp-for="OtpCode" id="otpCodeInput" class="form-control" placeholder="Enter OTP received" maxlength="6" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password</label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Minimum 6 characters" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter new password" required />
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-warning fw-bold py-2">
                            <i class="bi bi-shield-check"></i> Reset Password
                        </button>
                    </div>

                    <div class="text-center">
                        <a asp-action="Login" class="text-muted text-decoration-none">
                            <i class="bi bi-arrow-left"></i> Back to Login
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function requestResetOtp() {
        const email = document.getElementById('emailInput').value.trim();
        const statusDiv = document.getElementById('otpStatus');
        const sendBtn = document.getElementById('btnSendOtp');

        if (!email) {
            statusDiv.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-circle"></i> Please enter your registered email.</span>';
            return;
        }

        sendBtn.disabled = true;
        sendBtn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Sending...';
        statusDiv.innerHTML = '<span class="text-muted">Sending OTP...</span>';

        try {
            const response = await fetch('/Account/SendOtp', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ contact: email, purpose: 'ForgotPassword' })
            });

            const data = await response.json();
            if (data.success) {
                statusDiv.innerHTML = `<span class="text-success"><i class="bi bi-check-circle"></i> ${data.message} ${data.previewOtp ? `(Demo OTP: <strong>${data.previewOtp}</strong>)` : ''}</span>`;
                if (data.previewOtp) {
                    document.getElementById('otpCodeInput').value = data.previewOtp;
                }
            } else {
                statusDiv.innerHTML = `<span class="text-danger"><i class="bi bi-x-circle"></i> ${data.message}</span>`;
            }
        } catch (err) {
            statusDiv.innerHTML = '<span class="text-danger">Failed to send OTP. Please try again.</span>';
        } finally {
            sendBtn.disabled = false;
            sendBtn.innerHTML = '<i class="bi bi-arrow-repeat"></i> Resend OTP';
        }
    }
</script>
}
